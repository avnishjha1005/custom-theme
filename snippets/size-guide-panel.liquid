<div id="vendor-{{ index }}" class="sg-vendor-content {% if has_any_measurement == false and is_first %}active{% endif %}">

  <p class="sg-disclaimer">
    {{ guide.disclaimer | default: "Each item is measured with care to help you select the most accurate fit. We recommend referring to the product's specific measurements below, or the brand's size guide, when choosing your size." }}
  </p>
  <p class="sg-disclaimer">
    For personalised assistance or custom sizing, our <a href="/blogs/care-guide" style="text-decoration: underline;">Customer Care</a> team will be happy to assist you.
  </p>

  {%- if guide.image -%}
    <div class="sg-illustration">
      <img src="{{ guide.image | image_url: width: 700 }}" loading="lazy" alt="Measurement Guide" height="auto" width="auto">
    </div>
  {%- endif -%}

  {%- assign has_cm = guide.sizes.value.centimeters | size | plus: 0 -%}
  {%- assign has_in = guide.sizes.value.inches | size | plus: 0 -%}

  {%- if has_cm > 0 and has_in > 0 -%}
    <div class="sg-unit-toggle">
      <button class="unit-btn active" data-unit="cm" data-index="{{ index }}">CM</button>
      <button class="unit-btn" data-unit="in" data-index="{{ index }}">IN</button>
    </div>
  {%- endif -%}

  <div class="sg-table-container-{{ index }}">
    {%- if has_cm > 0 or has_in > 0 -%}
      {%- if has_cm > 0 -%}
        <div class="sg-unit-table unit-cm" style="display: block;">
          <table>
            <thead>
              <tr>
                {%- for col in guide.sizes.value.centimeters[0] -%}
                  <th>{{ col[0] }}</th>
                {%- endfor -%}
              </tr>
            </thead>
            <tbody>
              {%- for row in guide.sizes.value.centimeters -%}
                <tr>
                  {%- for cell in row -%}<td>{{ cell[1] }}</td>{%- endfor -%}
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      {%- endif -%}

      {%- if has_in > 0 -%}
        <div class="sg-unit-table unit-in" style="display: {% if has_cm > 0 %}none{% else %}block{% endif %};">
          <table>
            <thead>
              <tr>
                {%- for col in guide.sizes.value.inches[0] -%}
                  <th>{{ col[0] }}</th>
                {%- endfor -%}
              </tr>
            </thead>
            <tbody>
              {%- for row in guide.sizes.value.inches -%}
                <tr>
                  {%- for cell in row -%}<td>{{ cell[1] }}</td>{%- endfor -%}
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      {%- endif -%}
    {%- else -%}
      {% comment %} Fallback: flat JSON array format (no centimeters/inches nesting) {% endcomment %}
      {%- assign flat_rows = guide.sizes.value -%}
      {%- if flat_rows and flat_rows.size > 0 -%}
        <div class="sg-unit-table" style="display: block;">
          <table>
            <thead>
              <tr>
                {%- for col in flat_rows[0] -%}
                  <th>{{ col[0] }}</th>
                {%- endfor -%}
              </tr>
            </thead>
            <tbody>
              {%- for row in flat_rows -%}
                <tr>
                  {%- for cell in row -%}<td>{{ cell[1] }}</td>{%- endfor -%}
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
