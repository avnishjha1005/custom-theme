{%- doc -%}
  Renders a default variant picker with mobile drawer for swatches
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% unless product_resource.has_only_default_variant %}
  {% liquid
    assign button_background_brightness = section.settings.color_scheme.settings.foreground | color_brightness
    if button_background_brightness < 105
      assign strikethrough_color_mix = '#000'
    else
      assign strikethrough_color_mix = '#fff'
    endif
  %}
  <variant-picker
    class="variant-picker spacing-style variant-picker--{{ block_settings.alignment }}"
    style="--color-strikethrough-mix: {{ strikethrough_color_mix }}; {% render 'spacing-style', settings: block_settings %}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product_resource.id }}"
    data-block-id="{{ block.id }}"
    data-product-url="{{ product_resource.url }}"
    ref="mainVariantPicker"
    {% if product.id == product_resource.id %}
      data-template-product-match="true"
    {% endif %}
    {{ block.shopify_attributes }}
    {% if request.visual_preview_mode %}
      data-shopify-visual-preview
    {% endif %}
  >
    <form class="variant-picker__form">
      {%- for product_option in product_resource.options_with_values -%}
        {%- liquid
          assign swatch_count = product_option.values | map: 'swatch' | compact | size
          assign variant_style = 'block_settings.variant_style'

          if swatch_count > 0 and block_settings.show_swatches
            if block_settings.variant_style == 'dropdown'
              assign variant_style = 'swatch_dropdown'
            else
              assign variant_style = 'swatch'
            endif
          endif

          if variant_style == 'buttons' and settings.variant_button_width == 'equal-width-buttons'
            assign fieldset_id = section.id | append: '-' | append: product_resource.id | append: '-' | append: product_option.name | handleize
            assign option_id_attribute = 'data-option-id="' | append: fieldset_id | append: '"'
            assign longest_value = 0
          endif
        -%}

        {%- if variant_style == 'swatch' or block_settings.variant_style == 'buttons' -%}
          {%- assign fieldset_index = forloop.index0 -%}
          {%- if variant_style == 'swatch' -%}
            {%- assign is_swatch = 'true' -%}
          {%- else -%}
            {%- assign is_swatch = 'false' -%}
          {%- endif -%}
          <fieldset
            class="variant-option variant-option--buttons{% if variant_style == 'swatch' %} variant-option--swatches{% else %} variant-option--{{ settings.variant_button_width }}{% endif %}"
            data-fieldset-index="{{ fieldset_index }}"
            data-is-swatch= {{is_swatch}}
            ref="fieldsets[]"
            {{ option_id_attribute }}
          >
            <legend>
              {%- if variant_style == 'swatch' -%}
                <span class="variant-option__swatch-value" style="font-style:italic;">{{ product_option.selected_value }}</span>
              {%- endif %}
            </legend>
            
            {%- if variant_style == 'swatch' -%}
              <div class="swatch-mobile-trigger">
                {%- for product_option_value in product_option.values limit: 1 -%}
                  {% liquid
                    assign featured_media = product_option_value.variant.featured_media
                    if featured_media == blank and product_option_value.product_url
                      assign featured_media = product_option_value.variant.product.featured_media
                    endif
                  %}
                  {% render 'swatch',
                    swatch: product_option_value.swatch,
                    variant_image: featured_media,
                    mode: 'unscaled'
                  %}
                {%- endfor -%}
                {%- assign remaining_count = product_option.values.size | minus: 1 -%}
                {%- if remaining_count > 0 -%}
                  <span class="swatch-count">+{{ remaining_count }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}

            <div class="swatch-container{% if variant_style == 'swatch' %} swatch-container--mobile-hidden{% endif %}">
              {%- for product_option_value in product_option.values -%}
                {% if product_option_value.size > longest_value and option_id_attribute %}
                  {% assign longest_value = product_option_value.size %}
                {% endif %}
                <label
                  class="variant-option__button-label{% if variant_style == 'swatch' %} variant-option__button-label--has-swatch{% endif %}"
                >
                  <input
                    type="radio"
                    name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
                    value="{{ product_option_value | escape }}"
                    aria-label="{{ product_option_value.name }}"
                    {% if product_option_value.available == false %}
                      aria-disabled="true"
                    {% endif %}
                    data-previous-checked="false"
                    data-fieldset-index="{{ fieldset_index }}"
                    data-input-index="{{ forloop.index0 }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-option-available="{{ product_option_value.available }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {% if product_option_value.variant.id %}
                      data-variant-id="{{ product_option_value.variant.id }}"
                    {% endif %}
                    {% if product_option_value.selected %}
                      data-current-checked="true"
                      checked
                    {% else %}
                      data-current-checked="false"
                    {% endif %}
                  >
                  {% if variant_style == 'swatch' %}
                    {% liquid
                      assign featured_media = product_option_value.variant.featured_media
                      if featured_media == blank and product_option_value.product_url
                        assign featured_media = product_option_value.variant.product.featured_media
                      endif
                    %}
                    {% render 'swatch',
                      swatch: product_option_value.swatch,
                      variant_image: featured_media,
                      mode: 'unscaled'
                    %}
                  {% else %}
                    {% if product_option_value.available == true %}
                      <span class="variant-option__button-label__pill"></span>
                    {% endif %}
                    <span class="variant-option__button-label__text">{{ product_option_value | escape }}</span>
                  {% endif %}
                  {% render 'strikethrough-variant', product_option: product_option_value %}
                </label>
              {%- endfor -%}
            </div>
            
            {% if option_id_attribute %}
              {% style %}
                [data-option-id="{{ fieldset_id }}"] {
                  --variant-ch: {{ longest_value }}ch;
                }
              {% endstyle %}
            {% endif %}
          </fieldset>
        {%- elsif block_settings.variant_style == 'dropdowns' -%}
          {% liquid
            assign property_being_updated = false
            if settings.variant_swatch_width != settings.variant_swatch_height
              assign property_being_updated = true
              assign new_width = settings.variant_swatch_width | times: 1.0 | divided_by: settings.variant_swatch_height | times: 20
            endif
          %}

          <div class="variant-option variant-option--dropdowns">
            <label for="Option-{{ block.id }}-{{ forloop.index0 }}">{{ product_option.name | escape }}</label>
            <div
              class="variant-option__select-wrapper"
              style="
                {%- if property_being_updated  -%}
                  --variant-picker-swatch-width: clamp(10px,{{ new_width }}px, 50px);
                {%- endif -%}
              "
            >
              <select
                id="Option-{{ block.id }}-{{ forloop.index0 }}"
                name="options[{{ product_option.name | escape }}]"
                class="variant-option__select"
              >
                {%- for product_option_value in product_option.values -%}
                  <option
                    value="{{ product_option_value | escape }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-variant-id="{{ product_option_value.variant.id }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {% if product_option_value.selected %}
                      selected="selected"
                    {% endif %}
                  >
                    {% if product_option_value.available == false %}
                      {{ product_option_value | escape }} - {{ 'content.unavailable' | t }}
                    {% else %}
                      {{ product_option_value | escape }}
                    {% endif %}
                  </option>
                {%- endfor -%}
              </select>
              <svg
                aria-hidden="true"
                focusable="false"
                class="icon icon-caret"
                viewBox="0 0 10 6"
              >
                {%- render 'icon', icon: 'caret' -%}
              </svg>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <script type="application/json">
        {{ product_resource.selected_or_first_available_variant | json }}
      </script>
    </form>

    {%- comment -%} Mobile Swatch Drawer {%- endcomment -%}
    <div class="swatch-drawer" id="swatch-drawer">
      <div class="swatch-drawer__overlay"></div>
      <div class="swatch-drawer__content">
        <div class="swatch-drawer__header">
          <h3 class="swatch-drawer__title">Select Option</h3>
          <button class="swatch-drawer__close" aria-label="Close">×</button>
        </div>
        <div class="swatch-drawer__body"></div>
      </div>
    </div>
  </variant-picker>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const variantPicker = document.querySelector('variant-picker');
      if (!variantPicker) return;

      const drawer = document.getElementById('swatch-drawer');
      const drawerBody = drawer.querySelector('.swatch-drawer__body');
      const drawerTitle = drawer.querySelector('.swatch-drawer__title');
      const closeBtn = drawer.querySelector('.swatch-drawer__close');
      const overlay = drawer.querySelector('.swatch-drawer__overlay');

      // Open drawer when mobile trigger is clicked
      variantPicker.addEventListener('click', function(e) {
        const trigger = e.target.closest('.swatch-mobile-trigger');
        if (!trigger) return;

        const fieldset = trigger.closest('fieldset');
        const legend = fieldset.querySelector('legend').textContent.trim();
        const swatchContainer = fieldset.querySelector('.swatch-container');

        // Clone the swatch options into the drawer
        drawerTitle.textContent = legend || 'Select Option';
        drawerBody.innerHTML = swatchContainer.innerHTML;

        // Open drawer
        drawer.classList.add('swatch-drawer--active');
        document.body.style.overflow = 'hidden';

        // Handle selections in drawer
        drawerBody.querySelectorAll('input[type="radio"]').forEach(input => {
          input.addEventListener('change', function() {
            // Find the corresponding input in the main form
            const mainInput = swatchContainer.querySelector(`input[value="${this.value}"]`);
            if (mainInput) {
              mainInput.checked = true;
              mainInput.dispatchEvent(new Event('change', { bubbles: true }));
            }
            // Close drawer after selection
            closeDrawer();
          });
        });
      });

      // Close drawer functions
      function closeDrawer() {
        drawer.classList.remove('swatch-drawer--active');
        document.body.style.overflow = '';
      }

      closeBtn.addEventListener('click', closeDrawer);
      overlay.addEventListener('click', closeDrawer);
    });
  </script>
{% endunless %}

{% stylesheet %}
  /* Mobile Swatch Trigger - Only visible on mobile for swatches */
  .swatch-mobile-trigger {
    display: none;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    padding: 8px 12px;
    border: 1px solid var(--color-variant-border, #ddd);
    border-radius: 8px;
    background: var(--color-variant-background, #fff);
  }

  .swatch-count {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-foreground, #000);
  }

  @media (max-width: 749px) {
    .variant-option--swatches .swatch-mobile-trigger {
      display: flex;
    }

    .variant-option--swatches .swatch-container {
      display: none !important;
    }
  }

  /* Swatch Drawer Styles */
  .swatch-drawer {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .swatch-drawer--active {
    pointer-events: auto;
    opacity: 1;
  }

  .swatch-drawer__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
  }

  .swatch-drawer__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: white;
    border-radius: 16px 16px 0 0;
    max-height: 70vh;
    transform: translateY(100%);
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .swatch-drawer--active .swatch-drawer__content {
    transform: translateY(0);
  }

  .swatch-drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    border-bottom: 1px solid #eee;
  }

  .swatch-drawer__title {
    font-size: 18px;
    font-weight: 600;
    margin: 0;
  }

  .swatch-drawer__close {
    background: none;
    border: none;
    font-size: 32px;
    line-height: 1;
    cursor: pointer;
    padding: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .swatch-drawer__body {
    padding: 20px;
    overflow-y: auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(60px, 1fr));
    gap: 12px;
  }

  /* Original styles preserved below */
  .variant-picker {
    width: 100%;
  }

  .variant-picker__form {
    display: flex;
    flex-direction: column;
    gap: var(--padding-lg);
    width: 100%;
  }

  .variant-option--buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-sm);
    margin: 0;
    padding: 0;
    border: none;
  }

  .variant-option--buttons legend {
    padding: 0;
    margin-block-end: var(--margin-xs);
  }

  .variant-option__button-label {
    cursor: pointer;
    display: flex;
    align-items: center;
    position: relative;
    padding-block: var(--padding-sm);
    padding-inline: var(--padding-sm);
    border: var(--options-border-width) solid var(--color-variant-border);
    border-radius: var(--options-border-radius);
    background-color: var(--color-variant-background);
    color: var(--color-variant-text);
    min-height: 44px;
    transition: all 0.2s ease;
  }

  .variant-option__button-label input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
    margin: 0;
  }

  .variant-option__button-label:not(.variant-option__button-label--has-swatch):has(input:checked) {
    border-color: var(--color-selected-variant-border, #000);
    color: var(--color-selected-variant-text, #000);
  }

  .variant-option__button-label:not(.variant-option__button-label--has-swatch):has(input:checked) .variant-option__button-label__text {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  .variant-option__button-label:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .variant-option__button-label--has-swatch {
    border: none;
    padding: 2px;
  }

  .variant-option__button-label--has-swatch:has(input:checked) {
    border-bottom: 1px solid black;
  }

  .variant-option__button-label__text {
    pointer-events: none;
    z-index: 2;
  }

  /* Hide complex animations */
  .variant-option__button-label__pill,
  .variant-option__button-label::before,
  .variant-option__button-label::after,
  .variant-option__button-label svg {
    display: none !important;
  }
{% endstylesheet %}