{%- doc -%}
  Renders a default variant picker with mobile drawer for swatches
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% comment %} Check if this is a bundle product {% endcomment %}
{% liquid
  assign bundle_products = product_resource.metafields.custom.bundle_products.value
  assign is_bundle = false
  if bundle_products and bundle_products.size > 0
    assign is_bundle = true
  endif
%}

{% comment %} Hide entire variant picker for bundle products - sizes are selected in the bundle drawer {% endcomment %}
{% unless is_bundle %}
{% unless product_resource.has_only_default_variant %}
  {% liquid
    assign button_background_brightness = section.settings.color_scheme.settings.foreground | color_brightness
    if button_background_brightness < 105
      assign strikethrough_color_mix = '#000'
    else
      assign strikethrough_color_mix = '#fff'
    endif
  %}
  <variant-picker
    class="variant-picker spacing-style variant-picker--{{ block_settings.alignment }}"
    style="--color-strikethrough-mix: {{ strikethrough_color_mix }}; {% render 'spacing-style', settings: block_settings %}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product_resource.id }}"
    data-block-id="{{ block.id }}"
    data-product-url="{{ product_resource.url }}"
    ref="mainVariantPicker"
    {% if product.id == product_resource.id %}
      data-template-product-match="true"
    {% endif %}
    {{ block.shopify_attributes }}
    {% if request.visual_preview_mode %}
      data-shopify-visual-preview
    {% endif %}
  >
    <form class="variant-picker__form">
      {%- for product_option in product_resource.options_with_values -%}
        {%- liquid
          assign swatch_count = product_option.values | map: 'swatch' | compact | size
          assign variant_style = 'block_settings.variant_style'

          if swatch_count > 0 and block_settings.show_swatches
            if block_settings.variant_style == 'dropdown'
              assign variant_style = 'swatch_dropdown'
            else
              assign variant_style = 'swatch'
            endif
          endif

          if variant_style == 'buttons' and settings.variant_button_width == 'equal-width-buttons'
            assign fieldset_id = section.id | append: '-' | append: product_resource.id | append: '-' | append: product_option.name | handleize
            assign option_id_attribute = 'data-option-id="' | append: fieldset_id | append: '"'
            assign longest_value = 0
          endif
        -%}

        {%- if variant_style == 'swatch' or block_settings.variant_style == 'buttons' -%}
          {%- assign fieldset_index = forloop.index0 -%}
          {%- if variant_style == 'swatch' -%}
            {%- assign is_swatch = 'true' -%}
          {%- else -%}
            {%- assign is_swatch = 'false' -%}
          {%- endif -%}
          <fieldset
            class="variant-option variant-option--buttons{% if variant_style == 'swatch' %} variant-option--swatches{% else %} variant-option--{{ settings.variant_button_width }}{% endif %}"
            data-fieldset-index="{{ fieldset_index }}"
            data-is-swatch= {{is_swatch}}
            ref="fieldsets[]"
            {{ option_id_attribute }}
          >
             <legend style="visibility:hidden;">
              {%- if variant_style == 'swatch' -%}
                <span class="variant-option__swatch-value" style="font-style:italic;">{{ product_option.selected_value }}</span>
              {%- endif %}
            </legend> 
            
            {%- if variant_style == 'swatch' -%}
                <span class="variant-option__swatch-value" style="font-style:italic;">{{ product_option.selected_value }}</span>
              <div class="swatch-mobile-trigger">
                {%- for product_option_value in product_option.values limit: 1 -%}
                  {% liquid
                    assign featured_media = product_option_value.variant.featured_media
                    if featured_media == blank and product_option_value.product_url
                      assign featured_media = product_option_value.variant.product.featured_media
                    endif
                  %}
                  {% render 'swatch',
                    swatch: product_option_value.swatch,
                    variant_image: featured_media,
                    mode: 'unscaled'
                  %}
                {%- endfor -%}
                {%- assign remaining_count = product_option.values.size | minus: 1 -%}
                {%- if remaining_count > 0 -%}
                  <span class="swatch-count">+{{ remaining_count }}</span>
                {%- endif -%}
              </div>
            {%- else -%}
              {%- assign size_max_visible = 1 -%}
              {%- if product_option.values.size > size_max_visible -%}
                <div class="size-mobile-trigger" data-option-name="{{ product_option.name | escape }}">
                  {%- for product_option_value in product_option.values limit: size_max_visible -%}
                    <span class="size-mobile-trigger__item{% if product_option_value.selected %} size-mobile-trigger__item--selected{% endif %}">{{ product_option_value | escape }}</span>
                  {%- endfor -%}
                  {%- assign size_remaining = product_option.values.size | minus: size_max_visible -%}
                  <span class="swatch-count">+{{ size_remaining }}</span>
                </div>
              {%- endif -%}
            {%- endif -%}

            <div class="swatch-container{% if variant_style == 'swatch' %} swatch-container--mobile-hidden{% endif %}{% if variant_style != 'swatch' and product_option.values.size > 1 %} swatch-container--size-hidden{% endif %}" {% if variant_style != 'swatch' and product_option.values.size > 1 %}style="display:none"{% endif %}>
              {%- for product_option_value in product_option.values -%}
                {% if product_option_value.size > longest_value and option_id_attribute %}
                  {% assign longest_value = product_option_value.size %}
                {% endif %}
                <label
                  class="variant-option__button-label{% if variant_style == 'swatch' %} variant-option__button-label--has-swatch{% endif %}"
                >
                  <input
                    type="radio"
                    name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
                    value="{{ product_option_value | escape }}"
                    aria-label="{{ product_option_value.name }}"
                    {% if product_option_value.available == false %}
                      aria-disabled="true"
                    {% endif %}
                    data-previous-checked="false"
                    data-fieldset-index="{{ fieldset_index }}"
                    data-input-index="{{ forloop.index0 }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-option-available="{{ product_option_value.available }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {% if product_option_value.variant.id %}
                      data-variant-id="{{ product_option_value.variant.id }}"
                    {% endif %}
                    {% if product_option_value.selected %}
                      data-current-checked="true"
                      checked
                    {% else %}
                      data-current-checked="false"
                    {% endif %}
                  >
                  {% if variant_style == 'swatch' %}
                    {% liquid
                      assign featured_media = product_option_value.variant.featured_media
                      if featured_media == blank and product_option_value.product_url
                        assign featured_media = product_option_value.variant.product.featured_media
                      endif
                    %}
                    {% render 'swatch',
                      swatch: product_option_value.swatch,
                      variant_image: featured_media,
                      mode: 'unscaled'
                    %}
                  {% else %}
                    {% if product_option_value.available == true %}
                      <span class="variant-option__button-label__pill"></span>
                    {% endif %}
                    <span class="variant-option__button-label__text">{{ product_option_value | escape }}</span>
                  {% endif %}
                  {% render 'strikethrough-variant', product_option: product_option_value %}
                </label>
              {%- endfor -%}
            </div>
            
            {% if option_id_attribute %}
              {% style %}
                [data-option-id="{{ fieldset_id }}"] {
                  --variant-ch: {{ longest_value }}ch;
                }
              {% endstyle %}
            {% endif %}
          </fieldset>
        {%- elsif block_settings.variant_style == 'dropdowns' -%}
          {% liquid
            assign property_being_updated = false
            if settings.variant_swatch_width != settings.variant_swatch_height
              assign property_being_updated = true
              assign new_width = settings.variant_swatch_width | times: 1.0 | divided_by: settings.variant_swatch_height | times: 20
            endif
          %}

          <div class="variant-option variant-option--dropdowns">
            <label for="Option-{{ block.id }}-{{ forloop.index0 }}">{{ product_option.name | escape }}</label>
            <div
              class="variant-option__select-wrapper"
              style="
                {%- if property_being_updated  -%}
                  --variant-picker-swatch-width: clamp(10px,{{ new_width }}px, 50px);
                {%- endif -%}
              "
            >
              <select
                id="Option-{{ block.id }}-{{ forloop.index0 }}"
                name="options[{{ product_option.name | escape }}]"
                class="variant-option__select"
              >
                {%- for product_option_value in product_option.values -%}
                  <option
                    value="{{ product_option_value | escape }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-variant-id="{{ product_option_value.variant.id }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {% if product_option_value.selected %}
                      selected="selected"
                    {% endif %}
                  >
                    {% if product_option_value.available == false %}
                      {{ product_option_value | escape }} - {{ 'content.unavailable' | t }}
                    {% else %}
                      {{ product_option_value | escape }}
                    {% endif %}
                  </option>
                {%- endfor -%}
              </select>
              <svg
                aria-hidden="true"
                focusable="false"
                class="icon icon-caret"
                viewBox="0 0 10 6"
              >
                {%- render 'icon', icon: 'caret' -%}
              </svg>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <script type="application/json">
        {{ product_resource.selected_or_first_available_variant | json }}
      </script>
    </form>

    <style>
      .swatch-drawer{position:fixed;inset:0;z-index:9999;pointer-events:none;opacity:0;transition:opacity .3s ease}
      .swatch-drawer--active{pointer-events:auto;opacity:1}
      .swatch-drawer__overlay{position:absolute;inset:0;background:rgba(0,0,0,.5)}
      .swatch-drawer__content{position:absolute;bottom:0;left:0;right:0;background:#fff;max-height:70vh;transform:translateY(100%);transition:transform .3s ease;display:flex;flex-direction:column}
      .swatch-drawer--active .swatch-drawer__content{transform:translateY(0)}
      .swatch-drawer__header{display:flex;justify-content:space-between;align-items:center;padding:16px 20px}
      .swatch-drawer__title{font-family:'Inter',sans-serif;font-size:16px;font-weight:400;margin:0;color:#000}
      .swatch-drawer__close{background:none;border:none;font-size:24px;line-height:1;cursor:pointer;padding:0;width:32px;height:32px;display:flex;align-items:center;justify-content:center;color:#000}
      .swatch-drawer__color-label{padding:0 20px 14px;margin-bottom:18px}
      .swatch-drawer__color-prefix,.swatch-drawer__color-value{font-family:'Inter',sans-serif;font-size:14px;font-weight:400;color:#000}
      .swatch-drawer__body{padding:0 20px 20px;overflow-y:auto;display:flex;flex-wrap:wrap;gap:12px}
      .swatch-drawer__body .variant-option__button-label{display:flex;align-items:center;padding:8px 12px;border:1px solid #e5e5e5;min-height:44px;cursor:pointer;position:relative}
      .swatch-drawer__body .variant-option__button-label:has(input:checked){border-color:#000}
      .swatch-drawer__body .variant-option__button-label input{position:absolute;opacity:0;width:100%;height:100%;cursor:pointer;margin:0}
      .size-drawer__content{bottom:0;left:auto;right:0;top:0;width:450px;max-width:100%;max-height:none;height:100%;transform:translateX(100%);box-shadow:-10px 0 20px rgba(0,0,0,.05)}
      .size-drawer.swatch-drawer--active .size-drawer__content{transform:translateX(0)}
      @media(max-width:749px){.size-drawer__content{width:100%;top:auto;bottom:0;left:0;right:0;height:auto;max-height:70vh;transform:translateY(100%);box-shadow:none}.size-drawer.swatch-drawer--active .size-drawer__content{transform:translateY(0)}}
    </style>

    {%- comment -%} Mobile Swatch Drawer {%- endcomment -%}
    <div class="swatch-drawer" id="swatch-drawer">
      <div class="swatch-drawer__overlay"></div>
      <div class="swatch-drawer__content">
        <div class="swatch-drawer__header">
          <h3 class="swatch-drawer__title">Select color</h3>
          <button class="swatch-drawer__close" aria-label="Close">×</button>
        </div>
        <div class="swatch-drawer__color-label">
          <span class="swatch-drawer__color-prefix">Colour:</span>
          <span class="swatch-drawer__color-value">Blue</span>
        </div>
        <div class="swatch-drawer__body"></div>
      </div>
    </div>

    {%- comment -%} Size Drawer - slides from right {%- endcomment -%}
    <div class="swatch-drawer size-drawer" id="size-drawer">
      <div class="swatch-drawer__overlay"></div>
      <div class="swatch-drawer__content size-drawer__content">
        <div class="swatch-drawer__header">
          <h3 class="swatch-drawer__title">Select size</h3>
          <button class="swatch-drawer__close" aria-label="Close">×</button>
        </div>
        <div class="swatch-drawer__color-label">
          <span class="swatch-drawer__color-prefix">Size:</span>
          <span class="swatch-drawer__color-value" id="size-drawer-value"></span>
        </div>
        <div class="swatch-drawer__body" id="size-drawer-body"></div>
      </div>
    </div>

  </variant-picker>

  <script>
    // Swatch drawer
    document.addEventListener('click', function(e) {
      var trigger = e.target.closest('.swatch-mobile-trigger');
      if (!trigger) return;
      var drawer = document.getElementById('swatch-drawer');
      if (!drawer) return;
      var fieldset = trigger.closest('fieldset');
      var selectedValue = fieldset.querySelector('.variant-option__swatch-value');
      var swatchContainer = fieldset.querySelector('.swatch-container');
      var drawerBody = drawer.querySelector('.swatch-drawer__body');
      var drawerColorValue = drawer.querySelector('.swatch-drawer__color-value');
      drawerColorValue.textContent = selectedValue ? selectedValue.textContent.trim() : 'Select';
      drawerBody.innerHTML = swatchContainer.innerHTML;
      drawer.classList.add('swatch-drawer--active');
      document.body.style.overflow = 'hidden';

      drawerBody.querySelectorAll('input[type="radio"]').forEach(function(input) {
        input.addEventListener('change', function() {
          drawerColorValue.textContent = this.value;
          var mainInput = swatchContainer.querySelector('input[value="' + CSS.escape(this.value) + '"]');
          if (mainInput) {
            mainInput.checked = true;
            mainInput.dispatchEvent(new Event('change', { bubbles: true }));
          }
          drawer.classList.remove('swatch-drawer--active');
          document.body.style.overflow = '';
        });
      });
    });

    // Size drawer
    document.addEventListener('click', function(e) {
      var sizeTrigger = e.target.closest('.size-mobile-trigger');
      if (!sizeTrigger) return;
      var sizeDrawer = document.getElementById('size-drawer');
      if (!sizeDrawer) return;
      var fieldset = sizeTrigger.closest('fieldset');
      var swatchContainer = fieldset.querySelector('.swatch-container');
      var sizeDrawerBody = document.getElementById('size-drawer-body');
      var sizeDrawerValue = document.getElementById('size-drawer-value');
      var checkedInput = swatchContainer.querySelector('input[type="radio"]:checked');
      sizeDrawerValue.textContent = checkedInput ? checkedInput.value : '';
      sizeDrawerBody.innerHTML = swatchContainer.innerHTML;

      sizeDrawer.classList.add('swatch-drawer--active');
      document.body.style.overflow = 'hidden';

      if (checkedInput) {
        var drawerInput = sizeDrawerBody.querySelector('input[value="' + CSS.escape(checkedInput.value) + '"]');
        if (drawerInput) drawerInput.checked = true;
      }

      sizeDrawerBody.querySelectorAll('input[type="radio"]').forEach(function(input) {
        input.addEventListener('change', function() {
          sizeDrawerValue.textContent = this.value;
          var mainInput = swatchContainer.querySelector('input[value="' + CSS.escape(this.value) + '"]');
          if (mainInput) {
            mainInput.checked = true;
            mainInput.dispatchEvent(new Event('change', { bubbles: true }));
          }
          sizeDrawer.classList.remove('swatch-drawer--active');
          document.body.style.overflow = '';
        });
      });
    });

    // Close drawers via overlay or close button
    document.addEventListener('click', function(e) {
      if (e.target.closest('.swatch-drawer__close') || e.target.closest('.swatch-drawer__overlay')) {
        var drawer = e.target.closest('.swatch-drawer');
        if (drawer) {
          drawer.classList.remove('swatch-drawer--active');
          document.body.style.overflow = '';
        }
      }
    });

    // Move drawers to body so they aren't clipped by parent overflow/stacking
    (function() {
      var swatchDrawer = document.getElementById('swatch-drawer');
      var sizeDrawer = document.getElementById('size-drawer');
      if (swatchDrawer) document.body.appendChild(swatchDrawer);
      if (sizeDrawer) document.body.appendChild(sizeDrawer);
    })();
  </script>
{% endunless %}
{% endunless %}

{% stylesheet %}
  /* Mobile Swatch Trigger - Only visible on mobile for swatches */
  legend{
    height:0px;
  }
  .swatch-mobile-trigger {
    display: none;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    background: var(--color-variant-background, #fff);
  }

  .swatch-count {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-foreground, #000);
  }

  /* Size trigger */
  .size-mobile-trigger {
    padding-bottom: 10px;
    justify-content: end;
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    flex-wrap: wrap;
  }

  .size-mobile-trigger__item {
    font-size: 14px;
    color: var(--color-foreground, #000);
  }

  @media (max-width: 749px) {
    .size-mobile-trigger__item {
      font-size: 10px;
    }
    .swatch-count {
    font-size: 10px;
    font-weight: 500;
    color: var(--color-foreground, #000);
  }
  }

  .size-mobile-trigger__item--selected {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  /* Hide full size list when trigger is present (all breakpoints) */
  .variant-option--buttons .swatch-container--mobile-hidden {
    display: none !important;
  }

  @media (max-width: 749px) {
    .variant-option--swatches .swatch-mobile-trigger {
      display: flex;
    }

    /* Swatch container hidden on mobile for swatches only */
    .variant-option--swatches .swatch-container--mobile-hidden {
      display: none !important;
    }

    .variant-option--buttons{
         flex-direction: column;
      align-items: flex-end;
    }
  }

  /* Swatch Drawer Styles */
  .swatch-drawer {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .swatch-drawer--active {
    pointer-events: auto;
    opacity: 1;
  }

  .swatch-drawer__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
  }

  .swatch-drawer__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: white;
    max-height: 70vh;
    transform: translateY(100%);
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .swatch-drawer--active .swatch-drawer__content {
    transform: translateY(0);
  }

  .swatch-drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    border-bottom: none;
  }

  .swatch-drawer__title {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 400;
    margin: 0;
    color: #000;
  }

  .swatch-drawer__close {
    background: none;
    border: none;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    padding: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000;
  }

  .swatch-drawer__color-label {
    padding: 0 20px 14px;
    margin-bottom: 18px;
  }

  .swatch-drawer__color-prefix {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #000;
  }

  .swatch-drawer__color-value {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #000;
  }

  .swatch-drawer__body {
    padding: 0 20px 20px;
    overflow-y: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Size drawer - slide from right */
  .size-drawer__content {
    bottom: 0;
    left: auto;
    right: 0;
    top: 0;
    width: 450px;
    max-width: 100%;
    max-height: none;
    height: 100%;
    transform: translateX(100%);
    box-shadow: -10px 0 20px rgba(0,0,0,0.05);
  }

  .size-drawer.swatch-drawer--active .size-drawer__content {
    transform: translateX(0);
  }

  @media (max-width: 749px) {
    .size-drawer__content {
      width: 100%;
      top: auto;
      bottom: 0;
      left: 0;
      right: 0;
      height: auto;
      max-height: 70vh;
      transform: translateY(100%);
      box-shadow: none;
    }

    .size-drawer.swatch-drawer--active .size-drawer__content {
      transform: translateY(0);
    }
  }

  .swatch-drawer__body .variant-option__button-label {
    display: flex;
    align-items: center;
    padding: 8px 12px;
    border: 1px solid #e5e5e5;
    border-radius: 0;
    min-height: 44px;
    cursor: pointer;
    position: relative;
  }

  .swatch-drawer__body .variant-option__button-label:has(input:checked) {
    border-color: #000;
  }

  .swatch-drawer__body .variant-option__button-label input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
    margin: 0;
  }

  /* Original styles preserved below */
  .variant-picker {
    width: 100%;
    @media screen and (max-width:768px){
      padding-top:10px;
      padding-bottom:0px;
    }
  }

  .variant-picker__form {
    display: flex;
    flex-direction: column;
    /* gap: var(--padding-lg); */
    width: 100%;
    padding-top:0px;
  }

  .variant-option--buttons {
    display: flex;
    flex-wrap: wrap;
    flex-direction: column;
    margin: 0;
    padding: 0;
    border: none;
  }

  @media screen and (max-width:768px){
    .variant-option--buttons{
    align-items: end;
    justify-content: flex-end;
    }
  }

  .variant-option--buttons legend {
    padding: 0;
    /* margin-block-end: var(--margin-xs); */
  }

  .variant-option__button-label {
    cursor: pointer;
    display: flex;
    align-items: end;
    position: relative;
    padding-block: var(--padding-sm);
    padding-inline: var(--padding-sm);
    padding-right: 0px;
    border: var(--options-border-width) solid var(--color-variant-border);
    border-radius: var(--options-border-radius);
    background-color: var(--color-variant-background);
    padding-top: 0px !important;
    padding-bottom: 0px !important;
    padding-left:0px;
    min-height: 44px;
    transition: all 0.2s ease;
  }

  .variant-option__button-label input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
    margin: 0;
  }

  .variant-option__button-label:not(.variant-option__button-label--has-swatch):has(input:checked) {
  }

  .variant-option__button-label:not(.variant-option__button-label--has-swatch):has(input:checked) .variant-option__button-label__text {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  .variant-option__button-label:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .variant-option__button-label--has-swatch {
    border: none;
    padding: 2px;
  }

  .variant-option__button-label--has-swatch:has(input:checked) {
    border-bottom: 1px solid black;
  }

  .variant-option__button-label__text {
    pointer-events: none;
    z-index: 2;
  }

  .swatch-container {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: 10px;
    column-gap: 10px;
    justify-content: flex-end;
  }

  /* Hide complex animations */
  .variant-option__button-label__pill,
  .variant-option__button-label::before,
  .variant-option__button-label::after,
  .variant-option__button-label svg {
    display: none !important;
  }
