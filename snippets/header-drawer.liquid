<header-drawer>
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary class="header__icon header__icon--menu header__icon--summary focus-inset" aria-label="{{ 'sections.shop_the_look.view_product' | t }}">
      <span class="menu-drawer-icon-wrapper">
        <span class="header-drawer-icon header-drawer-icon--open icon-hamburger-container">
          {{- 'icon-menu.svg' | inline_asset_content -}}
        </span>
        <span class="icon-close-container">
          {{- 'icon-menu.svg' | inline_asset_content -}}
        </span>
      </span>
    </summary>

    <div id="menu-drawer" class="menu-drawer gradient motion-reduce" tabindex="-1">
      <div class="menu-drawer__inner-container">
        
        {% comment %} Header Actions (Internal Back/Close) {% endcomment %}
        <div class="drawer-header-actions">
          <button type="button" class="drawer-back-btn is-hidden" id="Drawer-Back-Btn" aria-label="Back">
            <span class="arrow-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            </span>
          </button>
          <button type="button" class="drawer-close-btn" id="Drawer-Close-Btn" aria-label="Close">
             <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>

        {% comment %} Level 1: Horizontal Pill Navigation {% endcomment %}
        <nav class="drawer-l1-nav">
          <div class="l1-nav-inner" id="L1-Pill-Container">
            {%- assign first_with_links = true -%}
            {%- for link in linklist.links -%}
              {%- if link.links != blank -%}
                <button type="button"
                  class="pill-item {% if first_with_links %}is-active{% endif %}"
                  data-l1-index="{{ forloop.index }}"
                  data-original-title="{{ link.title | escape }}">
                  {{ link.title | escape }}
                </button>
                {%- assign first_with_links = false -%}
              {%- else -%}
                <a href="{{ link.url }}" class="pill-item pill-item--link">
                  {{ link.title | escape }}
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </nav>

        {% comment %} Main Content Panels {% endcomment %}
        <div class="drawer-panels-container">
          {%- assign first_panel_with_links = true -%}
          {%- for l1_link in linklist.links -%}
            {%- if l1_link.links == blank -%}
              {%- continue -%}
            {%- endif -%}
            {% liquid
              assign drawer_featured_image = nil
              assign drawer_featured_url = nil
              assign drawer_featured_title = nil

              if menu_content_type == 'featured_collections' or menu_content_type == 'collection_images'
                if l1_link.type == 'collection_link' and l1_link.object.featured_image
                  assign drawer_featured_image = l1_link.object.featured_image
                  assign drawer_featured_url = l1_link.url
                  assign drawer_featured_title = l1_link.object.title
                elsif l1_link.type == 'catalog_link' or l1_link.type == 'collections_link'
                  assign drawer_featured_image = collections.all.featured_image
                  assign drawer_featured_url = l1_link.url
                  assign drawer_featured_title = l1_link.title
                endif

                if drawer_featured_image == nil
                  for child_link in l1_link.links
                    if child_link.type == 'collection_link' and child_link.object.featured_image
                      assign drawer_featured_image = child_link.object.featured_image
                      assign drawer_featured_url = child_link.url
                      assign drawer_featured_title = child_link.object.title
                      break
                    endif
                  endfor
                endif

              elsif menu_content_type == 'featured_products'
                if l1_link.type == 'collection_link'
                  assign featured_product = l1_link.object.products | first
                elsif l1_link.type == 'catalog_link' or l1_link.type == 'collections_link'
                  assign featured_product = collections.all.products | first
                else
                  for child_link in l1_link.links
                    if child_link.type == 'collection_link'
                      assign featured_product = child_link.object.products | first
                      break
                    endif
                  endfor
                endif

                if featured_product and featured_product.featured_image
                  assign drawer_featured_image = featured_product.featured_image
                  assign drawer_featured_url = featured_product.url
                  assign drawer_featured_title = featured_product.title
                endif
              endif
            %}
            <div class="drawer-panel {% if first_panel_with_links %}is-active{% endif %}" data-panel-l1="{{ forloop.index }}">
            {%- assign first_panel_with_links = false -%}
              <ul class="drawer-links-list" role="list">
                {%- for l2_link in l1_link.links -%}
                  <li class="drawer-item-container">
                    {%- if l2_link.links != blank -%}
                      <button type="button" class="drawer-link-btn"
                        data-drill-down
                        data-target="Panel-{{ forloop.parentloop.index }}-{{ forloop.index }}"
                        data-path="{{ l1_link.title | escape }} / {{ l2_link.title | escape }}">
                        <span class="link-text">{{ l2_link.title | escape }}</span>
                        <span class="arrow-icon">
                          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </span>
                      </button>

                      {% comment %} Level 3: Nested Slide-in Panel {% endcomment %}
                      <div class="drawer-panel-nested" id="Panel-{{ forloop.parentloop.index }}-{{ forloop.index }}">
                        <ul class="drawer-links-list" role="list">
                          {%- for l3_link in l2_link.links -%}
                            <li>
                              <a href="{{ l3_link.url }}" class="drawer-link-btn">
                                {{ l3_link.title | escape }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>

                        {% comment %} L3 featured image - fallback to L1 image if no L3-specific image found {% endcomment %}
                        {% liquid
                          assign l3_featured_image = nil
                          assign l3_featured_url = nil
                          assign l3_featured_title = nil

                          if menu_content_type == 'featured_collections' or menu_content_type == 'collection_images'
                            if l2_link.type == 'collection_link' and l2_link.object.featured_image
                              assign l3_featured_image = l2_link.object.featured_image
                              assign l3_featured_url = l2_link.url
                              assign l3_featured_title = l2_link.object.title
                            endif
                            if l3_featured_image == nil
                              for l3_child in l2_link.links
                                if l3_child.type == 'collection_link' and l3_child.object.featured_image
                                  assign l3_featured_image = l3_child.object.featured_image
                                  assign l3_featured_url = l3_child.url
                                  assign l3_featured_title = l3_child.object.title
                                  break
                                endif
                              endfor
                            endif
                          elsif menu_content_type == 'featured_products'
                            if l2_link.type == 'collection_link'
                              assign l3_product = l2_link.object.products | first
                            else
                              for l3_child in l2_link.links
                                if l3_child.type == 'collection_link'
                                  assign l3_product = l3_child.object.products | first
                                  break
                                endif
                              endfor
                            endif
                            if l3_product and l3_product.featured_image
                              assign l3_featured_image = l3_product.featured_image
                              assign l3_featured_url = l3_product.url
                              assign l3_featured_title = l3_product.title
                            endif
                          endif

                          comment
                            Fallback to L1-level featured image if no L3-specific image was found
                          endcomment
                          if l3_featured_image == nil and drawer_featured_image
                            assign l3_featured_image = drawer_featured_image
                            assign l3_featured_url = drawer_featured_url
                            assign l3_featured_title = drawer_featured_title
                          endif
                        %}
                        {% if l3_featured_image %}
                          <a href="{{ l3_featured_url }}" class="drawer-featured-card" style="--drawer-image-border-radius: {{ image_border_radius | default: 0 }}px; {% if content_aspect_ratio and content_aspect_ratio != 'adapt' %}--drawer-image-aspect-ratio: {{ content_aspect_ratio }};{% endif %}">
                            <div class="drawer-featured-image-wrap">
                              {{ l3_featured_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'drawer-featured-image' }}
                            </div>
                            <span class="drawer-featured-title">{{ l3_featured_title | escape }}</span>
                          </a>
                        {% endif %}
                      </div>
                    {%- else -%}
                      <a href="{{ l2_link.url }}" class="drawer-link-btn">
                        {{ l2_link.title | escape }}
                      </a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>

              {% comment %} L2 featured image at bottom {% endcomment %}
              {% if drawer_featured_image %}
                <a href="{{ drawer_featured_url }}" class="drawer-featured-card" style="--drawer-image-border-radius: {{ image_border_radius | default: 0 }}px; {% if content_aspect_ratio and content_aspect_ratio != 'adapt' %}--drawer-image-aspect-ratio: {{ content_aspect_ratio }};{% endif %}">
                  <div class="drawer-featured-image-wrap">
                    {{ drawer_featured_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'drawer-featured-image' }}
                  </div>
                  <span class="drawer-featured-title">{{ drawer_featured_title | escape }}</span>
                </a>
              {% endif %}
            </div>
          {%- endfor -%}
        </div>

        <div class="drawer-footer">
          {% comment %} insert localisation button {% endcomment %}
           <div class="drawer-footer-localization">
  {% if shop.published_locales.size > 1 %}
    <div class="drawer-locale-selector">
      <button type="button" class="drawer-locale-btn" id="Drawer-Language-Btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        <span>{{ localization.language.iso_code | upcase }}</span>
        <svg class="drawer-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
      
      <div class="drawer-locale-panel" id="Drawer-Language-Panel">
        <div class="drawer-locale-header">
          <button type="button" class="drawer-locale-back" id="Language-Back-Btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
          </button>
          <span class="drawer-locale-title">Language</span>
        </div>
        
        {%- form 'localization', id: 'DrawerLanguageForm', class: 'drawer-locale-form' -%}
          <input type="hidden" name="return_to" value="{{ request.path }}#drawer-open">
          <ul class="drawer-locale-list">
            {% for language in shop.published_locales %}
              <li>
                <button 
                  type="submit" 
                  class="drawer-locale-option {% if language.iso_code == localization.language.iso_code %}is-active{% endif %}"
                  name="locale_code"
                  value="{{ language.iso_code }}"
                >
                  {{ language.endonym_name }}
                  {% if language.iso_code == localization.language.iso_code %}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  {% endif %}
                </button>
              </li>
            {% endfor %}
          </ul>
        {%- endform -%}
      </div>
    </div>
  {% endif %}

  {% if shop.enabled_currencies.size > 1 %}
    <div class="drawer-locale-selector">
      <button type="button" class="drawer-locale-btn" id="Drawer-Currency-Btn">
        {% comment %} <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="1" x2="12" y2="23"></line>
          <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
        </svg> {% endcomment %}
        <span>{{ localization.country.currency.iso_code }}</span>
        <svg class="drawer-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
      
      <div class="drawer-locale-panel" id="Drawer-Currency-Panel">
        <div class="drawer-locale-header">
          <button type="button" class="drawer-locale-back" id="Currency-Back-Btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
          </button>
          <span class="drawer-locale-title">Currency</span>
        </div>
        
        {%- form 'localization', id: 'DrawerCurrencyForm', class: 'drawer-locale-form' -%}
          <input type="hidden" name="return_to" value="{{ request.path }}#drawer-open">
          <ul class="drawer-locale-list">
            {% for country in localization.available_countries %}
              <li>
                <button 
                  type="submit" 
                  class="drawer-locale-option {% if country.iso_code == localization.country.iso_code %}is-active{% endif %}"
                  name="country_code"
                  value="{{ country.iso_code }}"
                >
                  {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                  {% if country.iso_code == localization.country.iso_code %}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  {% endif %}
                </button>
              </li>
            {% endfor %}
          </ul>
        {%- endform -%}
      </div>
    </div>
  {% endif %}
</div>

          <a href="/pages/contact">CONTACT US</a>
        </div>
      </div>
    </div>
  </details>
</header-drawer>
<style>
  .drawer-footer-localization {
    display: flex;
    gap: 12px;
  }

  .drawer-locale-selector {
    flex: 1;
    position: relative;
  }

  .drawer-locale-btn {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 8px;
    border:none;
    background:none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    color: #000;
    cursor: pointer;
    transition: all 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .drawer-locale-btn:hover {
    background: #f0f0f0;
  }

  .drawer-locale-btn svg:first-child {
    flex-shrink: 0;
  }

  .drawer-locale-btn span {
    flex: 1;
    text-align: left;
  }

  .drawer-chevron {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .drawer-locale-btn.is-open .drawer-chevron {
    transform: rotate(180deg);
  }

  /* Slide-in Panel */
  .drawer-locale-panel {
    --bottom-nav-height: 56px;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: calc(var(--bottom-nav-height) + env(safe-area-inset-bottom, 0px));
    background: #fff;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    visibility: hidden;
    z-index: 1100;
    display: flex;
    flex-direction: column;
  }

  .drawer-locale-panel.is-open {
    transform: translateX(0);
    visibility: visible;
    box-shadow: -5px 0 10px rgba(0, 0, 0, 0.1);
  }

  .drawer-locale-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid #f2f2f2;
    background: #fff;
    min-height: 50px;
  }

  .drawer-locale-back {
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000;
    -webkit-tap-highlight-color: transparent;
  }

  .drawer-locale-title {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .drawer-locale-form {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .drawer-locale-list {
    list-style: none;
    padding: 10px 16px;
    margin: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    flex: 1;
  }

  .drawer-locale-list li {
    border-bottom: 1px solid #f8f8f8;
  }

  .drawer-locale-list li:last-child {
    border-bottom: none;
  }

  .drawer-locale-option {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    background: none;
    border: none;
    font-size: 16px;
    text-align: left;
    color: #000;
    cursor: pointer;
    transition: opacity 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .drawer-locale-option:hover {
    opacity: 0.7;
  }

  .drawer-locale-option.is-active {
    font-weight: 600;
  }

  .drawer-locale-option svg {
    flex-shrink: 0;
    color: #000;
  }
</style>

<script>
  class DrawerLocalization {
    constructor() {
      this.languageBtn = document.getElementById('Drawer-Language-Btn');
      this.currencyBtn = document.getElementById('Drawer-Currency-Btn');
      this.languagePanel = document.getElementById('Drawer-Language-Panel');
      this.currencyPanel = document.getElementById('Drawer-Currency-Panel');
      this.languageBackBtn = document.getElementById('Language-Back-Btn');
      this.currencyBackBtn = document.getElementById('Currency-Back-Btn');
      
      this.init();
      this.checkHashAndOpen();
    }

    init() {
      if (this.languageBtn) {
        this.languageBtn.addEventListener('click', () => this.togglePanel(this.languagePanel, this.languageBtn));
        this.languageBackBtn.addEventListener('click', () => this.closePanel(this.languagePanel, this.languageBtn));
      }

      if (this.currencyBtn) {
        this.currencyBtn.addEventListener('click', () => this.togglePanel(this.currencyPanel, this.currencyBtn));
        this.currencyBackBtn.addEventListener('click', () => this.closePanel(this.currencyPanel, this.currencyBtn));
      }
    }

    checkHashAndOpen() {
      // Check if we returned from localization form submission
      if (window.location.hash === '#drawer-open') {
        const menuDrawer = document.querySelector('header-drawer');
        if (menuDrawer && !menuDrawer.isOpen) {
          // Open the drawer
          const details = menuDrawer.querySelector('details');
          if (details) {
            details.setAttribute('open', '');
          }
        }
        // Remove the hash without scrolling
        history.replaceState(null, null, ' ');
      }
    }

    togglePanel(panel, button) {
      if (panel.classList.contains('is-open')) {
        this.closePanel(panel, button);
      } else {
        this.openPanel(panel, button);
      }
    }

    openPanel(panel, button) {
      // Close other panel if open
      document.querySelectorAll('.drawer-locale-panel').forEach(p => {
        if (p !== panel) {
          p.classList.remove('is-open');
        }
      });
      document.querySelectorAll('.drawer-locale-btn').forEach(b => {
        if (b !== button) {
          b.classList.remove('is-open');
        }
      });

      panel.classList.add('is-open');
      button.classList.add('is-open');
    }

    closePanel(panel, button) {
      panel.classList.remove('is-open');
      button.classList.remove('is-open');
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new DrawerLocalization());
  } else {
    new DrawerLocalization();
  }
</script>

<style>
  /* Header Icon Fix */
  .icon-close-container { display: none; }
  details[open] .icon-hamburger-container { display: none; }
  details[open] .icon-close-container { display: block; }

  .menu-drawer-icon-wrapper svg {
    display: block;
  }

  /* iOS Safari fix - prevent blue color on interactive elements */
  .header__icon--summary {
    color: inherit;
    -webkit-tap-highlight-color: transparent;
  }

  .menu-drawer-icon-wrapper {
    color: inherit;
  }

  /* Drawer Styling - use top/bottom positioning for robust viewport handling */
  .menu-drawer {
    --bottom-nav-height: 56px;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: calc(var(--bottom-nav-height) + env(safe-area-inset-bottom, 0px));
    width: 100%;
    background: #fff;
    z-index: 1000;
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.1, 0.9, 0.2, 1);
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    overflow: hidden;
  }

  details[open] > .menu-drawer { transform: translateY(0); }

  .menu-drawer__inner-container {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .drawer-header-actions {
    flex-shrink: 0;
    display: flex;
    justify-content: space-between;
    padding: 10px;
    min-height: 50px;
  }

  .drawer-back-btn, .drawer-close-btn {
    background: none; border: none; cursor: pointer; padding: 12px;
    color: #000;
    -webkit-tap-highlight-color: transparent;
  }

  /* L1 Pills */
  .drawer-l1-nav {
    flex-shrink: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .drawer-l1-nav::-webkit-scrollbar { display: none; }
  .l1-nav-inner { display: flex; padding: 19px 1px 1px 16px; gap: 10px; }

  .pill-item {
    white-space: nowrap; background: #fff; border: none; border-radius: 20px;
    padding: 0; font-size: 10px; font-weight: medium; cursor: pointer; color: #000;
    text-transform: uppercase;
    -webkit-tap-highlight-color: transparent;
  }
  .pill-item.is-active { text-decoration: underline; font-weight: bold; }
  .pill-item--link { text-decoration: none; color: inherit; }

  /* Content */
  .drawer-panels-container {
    flex: 1;
    position: relative;
    overflow: hidden;
    min-height: 0;
  }

  .drawer-panel {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: none;
    flex-direction: column;
    padding: 20px 16px;
    -webkit-overflow-scrolling: touch;
  }

  .drawer-panel.is-active {
    display: flex;
  }

  .drawer-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    flex-shrink: 0;
  }

  .drawer-link-btn {
    width: 100%; display: flex; justify-content: space-between; align-items: center;
    padding: 0 0 12px 0; background: none; border: none;
    font-size: 16px; text-align: left; color: #000; text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .arrow-icon {
    display: flex;
    align-items: center;
    color: inherit;
  }

  /* L3 Drill-down */
  .drawer-panel-nested {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: #fff;
    padding: 20px 16px;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    visibility: hidden;
    z-index: 10;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    display: flex;
    flex-direction: column;
  }
  .drawer-panel-nested.is-open { transform: translateX(0); visibility: visible; }

  .drawer-footer {
    flex-shrink: 0;
    padding: 20px 16px;
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: #888;
    border-top: 1px solid #f2f2f2;
    background: #fff;
  }

  .is-hidden { visibility: hidden; pointer-events: none; }

  /* Featured image card in mobile drawer */
  .drawer-featured-card {
    display: inline-block;
    text-decoration: none;
    color: #000;
    margin-top: auto;
    padding-top: 20px;
    width: 171px;
    flex-shrink: 0;
  }

  .drawer-featured-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: var(--drawer-image-aspect-ratio, 3 / 4);
    overflow: hidden;
    border-radius: var(--drawer-image-border-radius, 0px);
    background-color: #f5f5f5;
  }

  .drawer-featured-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .drawer-featured-title {
    display: block;
    margin-top: 8px;
    font-size: 12px;
    font-weight: 500;
    text-align: left;
    line-height: 1.3;
  }
</style>

<script>
  if (!customElements.get('header-drawer')) {
  customElements.define('header-drawer', class extends HTMLElement {
    constructor() {
      super();
      this.details = this.querySelector('details');
      this.backBtn = this.querySelector('#Drawer-Back-Btn');
      this.closeBtn = this.querySelector('#Drawer-Close-Btn');
      this.pillBtns = this.querySelectorAll('button.pill-item');
      this.drillBtns = this.querySelectorAll('[data-drill-down]');
      this.panels = this.querySelectorAll('.drawer-panel');
      this.nestedPanels = this.querySelectorAll('.drawer-panel-nested');
      this.init();
    }

    init() {
      // Listen for when drawer opens
      this.details.addEventListener('toggle', (e) => {
        if (this.details.open) {
          // Close search when menu opens
          const searchDialog = document.querySelector('dialog-component');
          if (searchDialog?.refs?.dialog?.open) {
            searchDialog.closeDialog();
          }
        }
      });

      // Close drawer when search opens
      document.addEventListener('searchDropdown:open', () => {
        if (this.isOpen) {
          this.close();
        }
      });

      // Pill Navigation logic
      this.pillBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          this.resetMenuState();
          this.pillBtns.forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          this.panels.forEach(p => p.classList.remove('is-active'));
          const target = this.querySelector(`[data-panel-l1="${btn.dataset.l1Index}"]`);
          if (target) target.classList.add('is-active');
        });
      });

      // Drill down to L3 logic
      this.drillBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const targetId = btn.dataset.target;
          const nested = this.querySelector(`#${targetId}`);
          const activePill = this.querySelector('.pill-item.is-active');
          if (nested && activePill) {
            nested.classList.add('is-open');
            activePill.innerText = btn.dataset.path;
            this.backBtn.classList.remove('is-hidden');
          }
        });
      });

      this.backBtn.addEventListener('click', () => this.resetMenuState());
      this.closeBtn.addEventListener('click', () => {
        this.close();
      });
    }

    // Add a close method for external access
    close() {
      console.log('Closing menu drawer');
      this.details.removeAttribute('open');
      this.resetMenuState();
    }

    // Add isOpen getter for external access
    get isOpen() {
      return this.details.hasAttribute('open');
    }

    resetMenuState() {
      this.nestedPanels.forEach(p => p.classList.remove('is-open'));
      this.backBtn.classList.add('is-hidden');
      this.pillBtns.forEach(btn => {
        btn.innerText = btn.dataset.originalTitle;
      });
    }
  });
}
</script>