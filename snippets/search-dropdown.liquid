<script
  src="{{ 'search-dropdown.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<search-dropdown-component
  id="search-dropdown"
  class="search-dropdown mobile:hidden"
  data-desktop-only
>
  <div
    class="search-dropdown__panel"
    ref="dropdownPanel"
  >
    <h2 class="visually-hidden">
      {{ 'content.search' | t }}
    </h2>
    {% render 'predictive-search',
      input_id: 'desktop-search-input',
      search_test_id: 'search-component--dropdown',
      products_test_id: 'products-list-default--dropdown'
    %}
  </div>
</search-dropdown-component>

{% stylesheet %}
  search-dropdown-component {
    display: none;
  }

  @media screen and (min-width: 750px) {
    search-dropdown-component {
      --search-border-radius: var(--style-border-radius-popover);
      --search-border-width: var(--style-border-width);

      display: block;
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      width: 100%;
      z-index: var(--layer-header-menu);
      pointer-events: none;
    }

    search-dropdown-component:has(.search-dropdown__panel[data-open]) {
      pointer-events: auto;
    }

    .search-dropdown__panel {
      width: 100%;
      background-color: var(--color-background);
      box-shadow: var(--shadow-popover);
      overflow: hidden;
      visibility: hidden;
      pointer-events: none;
      opacity: var(--search-dropdown-opacity, 0);
      transition: opacity 200ms var(--ease-out-cubic);
    }

    .search-dropdown__panel[data-open] {
      visibility: visible;
      pointer-events: auto;
    }

    /* Constrain content to page width while background stretches full */
    search-dropdown-component .predictive-search-form {
      max-width: var(--normal-page-width, 1440px);
      margin-inline: auto;
      padding-inline: var(--page-margin, 40px);
    }

    /* Override predictive-search styles inside dropdown */
    search-dropdown-component .predictive-search-form__content-wrapper {
      position: relative;
      top: auto;
      max-height: calc(80vh - var(--header-height, 60px));
    }

    search-dropdown-component .predictive-search-form__content {
      max-height: calc(70vh - var(--header-height, 60px));
    }

    /* Show the close button on desktop as X to dismiss search */
    search-dropdown-component .predictive-search__close-modal-button {
      display: flex;
    }

    /* Search header overlays the header row */
    search-dropdown-component .predictive-search-form__header {
      border: none;
      border-bottom: var(--search-border-width, 1px) solid var(--color-border);
      border-radius: 0;
      padding-inline: 0;
    }

    search-dropdown-component .predictive-search-form__header:focus-within {
      border-color: var(--color-border);
    }

    /* Ensure predictive-search fills the dropdown */
    search-dropdown-component predictive-search-component {
      background-color: var(--color-background);
    }

    /* Smooth the footer gradient inside dropdown */
    search-dropdown-component .predictive-search-form__footer {
      position: sticky;
      bottom: 0;
    }
  }
{% endstylesheet %}
