<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
  data-store-currency="{{ cart.currency.iso_code | default: shop.currency | upcase }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.shopify.com">
    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script
      src="{{ 'critical.js' | asset_url }}"
      type="module"
      async
    ></script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <script>
      // Prefetch pages for faster navigations
      (function () {
        const prefetched = new Set();
        const prerendered = new Set();

        function getInternalUrl(anchor) {
          if (!anchor) return null;
          try {
            const url = new URL(anchor.href);
            if (url.origin !== location.origin) return null;
            if (url.pathname === location.pathname && url.search === location.search) return null;
            if (url.hash && url.pathname === location.pathname) return null;
            return url.href;
          } catch { return null; }
        }

        // On hover: prefetch the HTML immediately
        function onHover(e) {
          const url = getInternalUrl(e.target.closest('a[href]'));
          if (!url || prefetched.has(url)) return;
          prefetched.add(url);
          const link = document.createElement('link');
          link.rel = 'prefetch';
          link.href = url;
          link.as = 'document';
          document.head.appendChild(link);
        }

        // On pointerdown/touchstart: high-priority fetch to warm cache before click fires
        function onPointerDown(e) {
          const url = getInternalUrl(e.target.closest('a[href]'));
          if (!url || prerendered.has(url)) return;
          prerendered.add(url);
          fetch(url, { credentials: 'include' }).catch(() => {});
        }

        document.addEventListener('pointerenter', onHover, { capture: true, passive: true });
        document.addEventListener('pointerdown', onPointerDown, { capture: true, passive: true });
        document.addEventListener('touchstart', onPointerDown, { capture: true, passive: true });
      })();
    </script>

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    {%- comment -%}
      Mobile Tab Bar Section
      Sticky bottom navigation for mobile devices
    {%- endcomment -%}
     
    {% sections 'mobile-tab-bar' %}


    {% if settings.wishlist-floating-button-position %}
      <a href="/pages/wishlist" class="button-floating">
        <svg width="30px" height="30px" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <rect x="0" fill="none" width="24" height="24"/>

          <g>

          <path d="M16.5 4.5c2.206 0 4 1.794 4 4 0 4.67-5.543 8.94-8.5 11.023C9.043 17.44 3.5 13.17 3.5 8.5c0-2.206 1.794-4 4-4 1.298 0 2.522.638 3.273 1.706L12 7.953l1.227-1.746c.75-1.07 1.975-1.707 3.273-1.707m0-1.5c-1.862 0-3.505.928-4.5 2.344C11.005 3.928 9.362 3 7.5 3 4.462 3 2 5.462 2 8.5c0 5.72 6.5 10.438 10 12.85 3.5-2.412 10-7.13 10-12.85C22 5.462 19.538 3 16.5 3z"/>

          </g>
        </svg>
        <p class="wishlist_text">Your Wishlist</p>
      </a>
    {% endif %}

  </body>
</html>

