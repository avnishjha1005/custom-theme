{% liquid
  assign phone_raw = section.settings.phone | strip
  assign phone = phone_raw | replace: ' ', '' | replace: '+', '' | replace: '-', '' | replace: '(', '' | replace: ')', ''
  assign encoded_message = section.settings.message | url_encode
  assign chat_url = 'https://wa.me/' | append: phone | append: '?text=' | append: encoded_message
%}

{% if section.settings.enabled and phone != '' %}
  <div id="WA-Widget-{{ section.id }}" class="wa-widget-container" style="display:none;">
    <button
      type="button"
      class="wa-dismiss"
      aria-label="Dismiss WhatsApp button"
    >&times;</button>
    <a
      href="{{ chat_url }}"
      class="wa-button"
      target="_blank"
      rel="noopener"
      aria-label="Chat on WhatsApp"
    >
      <div class="wa-icon-fab">
        {{- 'icon-whatsapp.svg' | inline_asset_content -}}
      </div>
      <div class="wa-label-pill">
        <span>{{ section.settings.label_text | default: 'Chat with us' }}</span>
      </div>
    </a>
  </div>

  <style>
    .wa-widget-container {
      position: fixed;
      right: max(20px, env(safe-area-inset-right));
      bottom: max(20px, env(safe-area-inset-bottom));
      z-index: {{ section.settings.z_index }};
      transform: translate({{ section.settings.offset_x }}px, {{ section.settings.offset_y }}px);
      font-family: system-ui, -apple-system, sans-serif;
    }

    .wa-dismiss {
      position: absolute;
      top: -8px;
      right: -8px;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: none;
      background: #f5f5f5;
      color: rgba(0, 0, 0, 0.7);
      font-size: 14px;
      font-weight: 500;
      line-height: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 10;
      padding: 0;
      pointer-events: auto;
    }

    .wa-dismiss:hover {
      color: rgba(0, 0, 0, 1);
    }

    .wa-widget-container.wa-hidden {
      display: none !important;
    }

    .wa-button {
      display: flex;
      align-items: center;
      flex-direction: row-reverse; /* Keeps icon on the right */
      text-decoration: none;
      transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .wa-icon-fab {
      width: 36px;
      height: 36px;
      background: black;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      box-shadow: 0 4px 15px rgba(0,0,0,0.2);
      position: relative;
      z-index: 2;
      transition: background 0.3s ease;
    }

    .wa-icon-fab svg { width: 18px; height: 18px; }

    .wa-label-pill {
      background: white;
      height: 36px;
      display: flex;
      align-items: center;
      padding: 0 0 0 20px;
      margin-right: -25px; /* Overlap with FAB */
      border-radius: 18px 0 0 18px;
      box-shadow: -4px 4px 10px rgba(0,0,0,0.1);
      overflow: hidden;
      
      /* Hidden by default */
      max-width: 0;
      opacity: 0;
      pointer-events: none;
      transition: max-width 0.4s ease, opacity 0.3s ease, padding 0.3s ease;
    }

    .wa-label-pill span {
      color: #333;
      font-weight: 600;
      font-size: 14px;
      white-space: nowrap;
      padding-right: 35px; /* Space for the overlap */
    }

    /* Desktop Hover Logic */
    @media (hover: hover) {
      .wa-button:hover .wa-label-pill {
        max-width: 300px;
        opacity: 1;
        padding: 0 0 0 20px;
        pointer-events: auto;
      }
    }

    /* Mobile Logic */
    @media (max-width: 767px) {
      {% unless section.settings.show_on_mobile %}
        .wa-widget-container { display: none !important; }
      {% endunless %}

      /* State when toggled open on mobile */
      .wa-button.is-expanded .wa-label-pill {
        max-width: 250px;
        opacity: 1;
        pointer-events: auto;
      }
    }
  </style>

  <script>
    (function() {
      var STORAGE_KEY = 'wa_fab_dismissed';
      var widget = document.getElementById('WA-Widget-{{ section.id }}');
      if (!widget) return;

      // Clear dismissed state on page load and show widget
      try {
        localStorage.removeItem(STORAGE_KEY);
      } catch(e) {}
      widget.style.display = '';

      var btn = widget.querySelector('.wa-button');
      var icon = widget.querySelector('.wa-icon-fab');
      var dismissBtn = widget.querySelector('.wa-dismiss');

      // Dismiss handler
      dismissBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        widget.style.display = 'none';
        try {
          localStorage.setItem(STORAGE_KEY, 'true');
        } catch(e) {}
      });

      // Mobile expand logic
      btn.addEventListener('click', function(e) {
        if (window.innerWidth <= 767 && icon.contains(e.target)) {
          e.preventDefault();
          btn.classList.toggle('is-expanded');
        }
      });

      document.addEventListener('click', function(e) {
        if (!widget.contains(e.target)) {
          btn.classList.remove('is-expanded');
        }
      });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "WhatsApp Floating Button",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Enable button", "default": true },
    { "type": "text", "id": "phone", "label": "Phone (Ex: 919972320665)", "default": "919972320665" },
    { "type": "text", "id": "message", "label": "Default message", "default": "Hi! I have a question." },
    { "type": "text", "id": "label_text", "label": "Label text", "default": "Chat on WhatsApp" },
    { "type": "range", "id": "offset_x", "min": -100, "max": 100, "step": 2, "unit": "px", "label": "Horizontal Offset", "default": 0 },
    { "type": "range", "id": "offset_y", "min": -100, "max": 100, "step": 2, "unit": "px", "label": "Vertical Offset", "default": 0 },
    { "type": "checkbox", "id": "show_on_mobile", "label": "Show on mobile", "default": true },
    { "type": "number", "id": "z_index", "label": "Z-index", "default": 9999 }
  ],
  "presets": [{ "name": "WhatsApp Floating Button" }]
}
{% endschema %}