{%- style -%}
  .bundle-section-{{ section.id }} {
    max-width: 1440px;
    margin: 0 auto;
    padding: 60px 20px;
    box-sizing: border-box;
  }
  .bundle-wrapper {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
  }
  .bundle-item {
    display: flex;
    flex-direction: column;
    justify-content: stretch;
  }
  .bundle-visual {
    position: relative;
    width: 100%;
    aspect-ratio: 1.2/1;
    overflow: hidden;
    background: #f8f8f8;
    display: flex;
    align-items: stretch;
    min-height: 400px;
  }
  .bundle-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hotspot-trigger {
    position: absolute;
    width: 32px;
    height: 32px;
    background: rgba(255,255,255,0.8);
    border: 1px solid #000;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    cursor: pointer;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: bold;
  }
  .bundle-item--hero {
        grid-column: 1 / span 2;
        grid-row: auto;
      }
      @media (max-width: 768px) {
        .bundle-item--hero {
          grid-column: 1 / -1;
          grid-row: auto;
        }
      }
  .bundle-meta {
    padding-top: 20px;
  }
  .bundle-name {
    font-size: 24px;
    text-transform: uppercase;
    margin: 0 0 10px 0;
  }
  .bundle-desc {
    font-size: 16px;
    line-height: 1.6;
    color: #333;
  }
  @media (max-width: 768px) {
    .bundle-wrapper {
      grid-template-columns: 1fr;
    }
    .bundle-item {
      flex-direction: column;
    }
    .bundle-visual {
      min-height: 250px;
    }
  }
{%- endstyle -%}

<div class="bundle-section-{{ section.id }}">
  <div class="bundle-wrapper">
    {% assign hero_indices = "3,6" | split: "," %}
    {% for block in section.blocks %}
      {% if block.type == 'bundle' %}
        {% assign idx = forloop.index | append: '' %}
        {% assign is_hero = false %}
        {% for h in hero_indices %}
          {% if h == idx %}{% assign is_hero = true %}{% endif %}
        {% endfor %}
        <div class="bundle-item {% if is_hero %}bundle-item--hero{% endif %}" {{ block.shopify_attributes }}>
          {% if is_hero %}
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; grid-column: span 2;">
              <div class="bundle-visual" style="order: {% if idx == 3 %}1{% else %}2{% endif %};">
                {% if block.settings.product != blank %}
                  {{ block.settings.product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
                {% else %}
                  {{ 'collection-1' | placeholder_svg_tag }}
                {% endif %}
                {% for i in (1..5) %}
                  {% capture hs_show %}show_hs_{{ i }}{% endcapture %}
                  {% capture hs_label %}hs_{{ i }}_label{% endcapture %}
                  {% capture hs_x %}hs_{{ i }}_x{% endcapture %}
                  {% capture hs_y %}hs_{{ i }}_y{% endcapture %}
                  {% capture hs_bg %}hs_{{ i }}_bg{% endcapture %}
                  {% capture hs_border %}hs_{{ i }}_border{% endcapture %}
                  {% capture hs_product %}hs_{{ i }}_product{% endcapture %}
                  {% assign product = block.settings[hs_product] %}
                  {% if block.settings[hs_show] %}
                    <div class="hotspot-trigger" 
                      data-hs-index="{{ i }}"
                      data-product-title="{{ product.title | escape }}"
                      data-product-price="{{ product.price | money }}"
                      data-product-url="{{ product.url }}"
                      style="left: {{ block.settings[hs_x] }}%; top: {{ block.settings[hs_y] }}%; background: {{ block.settings[hs_bg] }}; border-color: {{ block.settings[hs_border] }};">
                      {{ block.settings[hs_label] }}
                      <div class="hotspot-overlay" style="display:none; position:absolute; left:50%; top:100%; transform:translate(-50%, 10px); color:#fff; text-align:left; font-size:18px; font-weight:400; pointer-events:none; white-space:nowrap;">
                        <div class="hotspot-overlay-title" style="font-weight:500;">{{ product.title }}</div>
                        <div class="hotspot-overlay-price" style="font-size:16px; margin-top:2px;">{{ product.price | money }}</div>
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
              <div class="bundle-meta" style="order: {% if idx == 3 %}2{% else %}1{% endif %};">
                <h3 class="bundle-name">{{ block.settings.product.title }}</h3>
                <div class="bundle-desc">{{ block.settings.product.description }}</div>
              </div>
            </div>
          {% else %}
            <div class="bundle-visual">
              {% if block.settings.product != blank %}
                {{ block.settings.product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag }}
              {% endif %}
              {% for i in (1..5) %}
                {% capture hs_show %}show_hs_{{ i }}{% endcapture %}
                {% capture hs_label %}hs_{{ i }}_label{% endcapture %}
                {% capture hs_x %}hs_{{ i }}_x{% endcapture %}
                {% capture hs_y %}hs_{{ i }}_y{% endcapture %}
                {% capture hs_bg %}hs_{{ i }}_bg{% endcapture %}
                {% capture hs_border %}hs_{{ i }}_border{% endcapture %}
                {% capture hs_product %}hs_{{ i }}_product{% endcapture %}
                {% assign product = block.settings[hs_product] %}
                {% if block.settings[hs_show] %}
                  <div class="hotspot-trigger" 
                    data-hs-index="{{ i }}"
                    data-product-title="{{ product.title | escape }}"
                    data-product-price="{{ product.price | money }}"
                    data-product-url="{{ product.url }}"
                    style="left: {{ block.settings[hs_x] }}%; top: {{ block.settings[hs_y] }}%; background: {{ block.settings[hs_bg] }}; border-color: {{ block.settings[hs_border] }};">
                    {{ block.settings[hs_label] }}
                    <div class="hotspot-overlay" style="display:none; position:absolute; left:50%; top:100%; transform:translate(-50%, 10px); color:#fff; text-align:left; font-size:18px; font-weight:400; pointer-events:none; white-space:nowrap;">
                      <div class="hotspot-overlay-title" style="font-weight:500;">{{ product.title }}</div>
                      <div class="hotspot-overlay-price" style="font-size:16px; margin-top:2px;">{{ product.price | money }}</div>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
            <div class="bundle-meta">
              <h3 class="bundle-name">{{ block.settings.product.title }}</h3>
              <div class="bundle-desc">{{ block.settings.product.description }}</div>
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>
<script>
  (function() {
    if (window.matchMedia('(pointer: fine)').matches) {
      var lastOverlay = null;
      var lastHotspot = null;
      document.querySelectorAll('.hotspot-trigger').forEach(function(hotspot) {
        hotspot.addEventListener('click', function(e) {
          e.stopPropagation();
          // Hide previous overlay
          if (lastOverlay && lastOverlay !== hotspot.querySelector('.hotspot-overlay')) {
            lastOverlay.style.display = 'none';
          }
          var overlay = hotspot.querySelector('.hotspot-overlay');
          if (overlay.style.display === 'block') {
            // Second click: go to product
            var url = hotspot.getAttribute('data-product-url');
            if (url) window.location.href = url;
            return;
          }
          overlay.style.display = 'block';
          lastOverlay = overlay;
          lastHotspot = hotspot;
        });
      });
      document.addEventListener('click', function() {
        if (lastOverlay) lastOverlay.style.display = 'none';
        lastOverlay = null;
        lastHotspot = null;
      });
    }
  })();
</script>

