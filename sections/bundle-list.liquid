{%- style -%}
  .bundle-section-{{ section.id }} {
    display: grid;
    justify-content: center;
    max-width: 1440px;
    margin: 0 auto;
    padding: 60px 20px;
    box-sizing: border-box;
  }
  .bundle-wrapper {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
    max-width: 1000px;
  }
  .bundle-item {
    display: flex;
    flex-direction: column;
  }
  .bundle-visual {
    position: relative;
    width: 100%;
    aspect-ratio: 0.74;
    overflow: hidden;
    background: #f4f4f4;
  }
  .bundle-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.4s ease;
  }

  .bundle-visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.5);
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    z-index: 2;
    pointer-events: none;
  }

  .bundle-visual.has-active-hotspot::after {
    opacity: 1;
    visibility: visible;
  }

  .hotspot-node {
    position: absolute;
    display: flex;
    align-items: center;
    z-index: 10;
    transform: translate(-50%, -50%);
    cursor: pointer;
  }

  .hotspot-dot {
    width: 28px;
    height: 28px;
    background: transparent;
    border: 2px solid var(--hs-border, #fff);
    border-radius: 50%;
    position: relative;
    font-size: 0;
    color: transparent;
    flex-shrink: 0;
    z-index: 11;
  }

  .hotspot-dot::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 12px;
    height: 12px;
    background: var(--hs-bg, #fff);
    border-radius: 50%;
  }

  .hotspot-text {
    position: absolute;
    color: #fff;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    pointer-events: none;
    width: max-content;
    max-width: 160px;
  }

  .hotspot-node.is-active .hotspot-text {
    opacity: 1;
    visibility: visible;
  }

  /* Text below dot (middle 50%: x 25–75) */
  .hotspot-text--bottom {
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(-5px);
    text-align: center;
  }
  .hotspot-node.is-active .hotspot-text--bottom {
    transform: translateX(-50%) translateY(0);
  }

  /* Text right of dot (left quarter: x 0–25) */
  .hotspot-text--right {
    left: calc(100% + 15px);
    top: 50%;
    transform: translate(-10px, -50%);
    text-align: left;
  }
  .hotspot-node.is-active .hotspot-text--right {
    transform: translate(0, -50%);
  }

  /* Text left of dot (right quarter: x 75–100) */
  .hotspot-text--left {
    right: calc(100% + 15px);
    top: 50%;
    transform: translate(10px, -50%);
    text-align: right;
  }
  .hotspot-node.is-active .hotspot-text--left {
    transform: translate(0, -50%);
  }
  
  .hotspot-node.is-active { z-index: 15; }

  .hs-title { font-size: 18px; font-weight: 500; display: block; text-transform: uppercase; }
  .hs-price { font-size: 16px; display: block; }

  /* Hero Layout Styles */
  .bundle-item--hero {
    grid-column: 1 / span 2;
  }

  .hero-grid {
    display: grid;
    /* Image column takes 70%, Description column takes 30% */
    grid-template-columns: 7fr 3fr; 
    gap: 40px;
    align-items: start;
  }

  /* Alternating layout for hero items */
  .bundle-item--hero:nth-of-type(even) .hero-grid {
    direction: rtl;
  }
  .bundle-item--hero:nth-of-type(even) .hero-grid > div {
    direction: ltr;
  }

  .bundle-meta { padding-top: 20px; }
  .bundle-name { font-size: 16px; text-transform: uppercase; margin: 0 0 10px 0; }
  .bundle-desc { font-size: 16px; line-height: 1.6; color: #333; }

  @media (max-width: 768px) {
    .bundle-wrapper { 
      grid-template-columns: repeat(2, 1fr); 
      gap: 20px 15px; /* Adjust gap for smaller screens */
      font-size:16px;
    }
    .bundle-name{
      font-size:12px;
    }

    /* Force the Hero item to span across both columns */
    .hero-grid { 
      grid-template-columns: 7fr 3fr !important; 
      gap: 15px; 
      align-items: center; /* Keeps text aligned with the image center if preferred */
    }
    /* Keep internal Hero layout logic as is */
    .hero-grid { 
      grid-template-columns: 1fr; 
      gap: 20px; 
    }
    .hero-grid { grid-template-columns: 1fr; gap: 20px; }
    .bundle-item--hero:nth-of-type(even) .hero-grid { direction: ltr; }
    .hs-title { font-size: 10px; font-weight: 500; display: block; text-transform: uppercase; }
  .hs-price { font-size: 10px; display: block; }
  .hotspot-dot {
    width: 18px;
    height: 18px;
    background: transparent;
    border: 1.5px solid #fff;
    border-radius: 50%;
    position: relative;
    font-size: 0;
    color: transparent;
    flex-shrink: 0;
    z-index: 11;
  }

  .hotspot-dot::after {
    width: 8px;
    height: 8px;
  }
  }
{%- endstyle -%}

<div class="bundle-section-{{ section.id }}">
  <div class="bundle-wrapper">
    {% assign hero_indices = "3,6" | split: "," %}
    
    {% for block in section.blocks %}
      {% if block.type == 'bundle' %}
        {% assign idx = forloop.index | append: '' %}
        {% assign is_hero = false %}
        {% for h in hero_indices %}{% if h == idx %}{% assign is_hero = true %}{% endif %}{% endfor %}

        <div class="bundle-item {% if is_hero %}bundle-item--hero{% endif %}" {{ block.shopify_attributes }}>
          
          {% capture visual_part %}
            <div class="bundle-visual">
              {% if block.settings.product != blank %}
                {{ block.settings.product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag }}
              {% endif %}

              {% for i in (1..5) %}
                {% capture hs_show %}show_hs_{{ i }}{% endcapture %}
                {% capture hs_product_setting %}hs_{{ i }}_product{% endcapture %}
                {% assign hs_product = block.settings[hs_product_setting] %}

                {% if block.settings[hs_show] and hs_product != blank %}
                  {% capture hs_x %}hs_{{ i }}_x{% endcapture %}
                  {% capture hs_y %}hs_{{ i }}_y{% endcapture %}
                  {% capture hs_bg %}hs_{{ i }}_bg{% endcapture %}
                  {% capture hs_border %}hs_{{ i }}_border{% endcapture %}

                  <div class="hotspot-node"
                       data-url="{{ hs_product.url }}"
                       style="left: {{ block.settings[hs_x] }}%; top: {{ block.settings[hs_y] }}%;">
                    <div class="hotspot-dot" style="--hs-border: {{ block.settings[hs_border] }}; --hs-bg: {{ block.settings[hs_bg] }};">
                    </div>
                    {% if block.settings[hs_x] <= 25 %}
                      {% assign hs_text_pos = 'hotspot-text--right' %}
                    {% elsif block.settings[hs_x] >= 75 %}
                      {% assign hs_text_pos = 'hotspot-text--left' %}
                    {% else %}
                      {% assign hs_text_pos = 'hotspot-text--bottom' %}
                    {% endif %}
                    <div class="hotspot-text {{ hs_text_pos }}">
                      <span class="hs-title">{{ hs_product.title }}</span>
                      <span class="hs-price">{{ hs_product.price | money }}</span>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% endcapture %}

          {% capture title_part %}
            <div class="bundle-name">{{ block.settings.product.title }}</div>
          {% endcapture %}

          {% if is_hero %}
            <div class="hero-grid">
               <div class="hero-main-col">
                  {{ visual_part }}
                  <div class="bundle-meta">
                    {{ title_part }}
                  </div>
               </div>
               <div class="hero-side-col">
                  <div class="bundle-meta">
                    <div class="bundle-desc">{{ block.settings.product.description }}</div>
                  </div>
               </div>
            </div>
          {% else %}
            {{ visual_part }}
            <div class="bundle-meta">
              {{ title_part }}
              {% comment %} Description is hidden for non-hero elements {% endcomment %}
            </div>
          {% endif %}
          
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const nodes = document.querySelectorAll('.hotspot-node');

    nodes.forEach(node => {
      node.addEventListener('click', function(e) {
        e.stopPropagation();
        const parentVisual = this.closest('.bundle-visual');
        const isActive = this.classList.contains('is-active');

        document.querySelectorAll('.hotspot-node').forEach(n => n.classList.remove('is-active'));
        document.querySelectorAll('.bundle-visual').forEach(v => v.classList.remove('has-active-hotspot'));

        if (!isActive) {
          this.classList.add('is-active');
          parentVisual.classList.add('has-active-hotspot');
        } else {
          const url = this.getAttribute('data-url');
          if (url) window.location.href = url;
        }
      });
    });

    document.addEventListener('click', function() {
      document.querySelectorAll('.hotspot-node').forEach(n => n.classList.remove('is-active'));
      document.querySelectorAll('.bundle-visual').forEach(v => v.classList.remove('has-active-hotspot'));
    });
  });
</script>
