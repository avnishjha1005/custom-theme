{%- style -%}
  .bundle-list-section--{{ section.id }} {
    max-width: 1440px;
    margin: 0 auto;
    padding: 60px 20px;
  }

  /* The 2-Column Grid Layout */
  .bundle-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 40px;
    row-gap: 80px; /* Space between rows of bundles */
  }

  .bundle-item-block {
    display: flex;
    flex-direction: column;
  }

  /* 1. Image & Hotspot Part */
  .bundle-visual-wrapper {
    position: relative;
    width: 100%;
    margin-bottom: 24px;
    line-height: 0;
  }

  .bundle-visual-wrapper img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }

  .hotspot-point {
    position: absolute;
    width: 28px;
    height: 28px;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid #000;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    cursor: pointer;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    transition: transform 0.2s ease;
  }

  .hotspot-point:hover {
    transform: translate(-50%, -50%) scale(1.2);
    background: #fff;
  }

  .hotspot-tooltip {
    visibility: hidden;
    position: absolute;
    bottom: 125%;
    left: 50%;
    transform: translateX(-50%);
    background: #fff;
    padding: 10px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    white-space: nowrap;
    z-index: 10;
    text-align: center;
  }

  .hotspot-point:hover .hotspot-tooltip {
    visibility: visible;
  }

  /* 2. Content Part (Name & Description) */
  .bundle-info-header {
    margin-bottom: 8px;
  }

  .bundle-product-name {
    font-size: 1.5rem;
    text-transform: uppercase;
    margin: 0 0 10px 0;
    font-family: inherit;
  }

  .bundle-product-description {
    font-size: 1rem;
    line-height: 1.5;
    color: #555;
    margin-bottom: 15px;
  }

  .bundle-link {
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: bold;
    color: #000;
  }

  /* Mobile Responsive: Switch to 1 column */
  @media (max-width: 768px) {
    .bundle-grid {
      grid-template-columns: 1fr;
      row-gap: 50px;
    }
  }
{%- endstyle -%}

<section class="bundle-list-section--{{ section.id }}">
  {% if section.settings.title != blank %}
    <h2 style="text-align: center; margin-bottom: 40px;">{{ section.settings.title }}</h2>
  {% endif %}

  <div class="bundle-grid">
    {% for block in section.blocks %}
      {%- assign bundle_prod = block.settings.main_product -%}
      
      <div class="bundle-item-block" {{ block.shopify_attributes }}>
        
        <div class="bundle-visual-wrapper">
          {% if block.settings.custom_image != blank %}
            {{ block.settings.custom_image | image_url: width: 800 | image_tag: loading: 'lazy' }}
          {% elsif bundle_prod.featured_image != blank %}
            {{ bundle_prod.featured_image | image_url: width: 800 | image_tag: loading: 'lazy' }}
          {% else %}
            {{ 'product-1' | placeholder_svg_tag }}
          {% endif %}

          {% comment %} Loop through hotspots (Configurable in block) {% endcomment %}
          {% for i in (1..3) %}
            {% capture hs_show %}show_hs_{{ i }}{% endcapture %}
            {% capture hs_x %}hs_{{ i }}_x{% endcapture %}
            {% capture hs_y %}hs_{{ i }}_y{% endcapture %}
            {% capture hs_p %}hs_{{ i }}_product{% endcapture %}

            {% if block.settings[hs_show] %}
              {% assign target_p = block.settings[hs_p] %}
              <div class="hotspot-point" style="left: {{ block.settings[hs_x] }}%; top: {{ block.settings[hs_y] }}%;">
                +
                {% if target_p != blank %}
                  <div class="hotspot-tooltip">
                    <strong>{{ target_p.title }}</strong><br>
                    <span>{{ target_p.price | money }}</span>
                  </div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <div class="bundle-info-header">
          <h3 class="bundle-product-name">
            {% if block.settings.custom_name != blank %}{{ block.settings.custom_name }}{% else %}{{ bundle_prod.title }}{% endif %}
          </h3>
          <div class="bundle-product-description">
            {% if block.settings.custom_desc != blank %}
              {{ block.settings.custom_desc }}
            {% else %}
              {{ bundle_prod.description | strip_html | truncate: 120 }}
            {% endif %}
          </div>
          {% if bundle_prod != blank %}
            <a href="{{ bundle_prod.url }}" class="bundle-link">Shop the look</a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Bundle Grid List",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading"
    },
    {
      "type": "collection",
      "id": "context_collection",
      "label": "Select Collection",
      "info": "This provides context for which products belong here."
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle Block",
      "settings": [
        {
          "type": "header",
          "content": "Bundle Basics"
        },
        {
          "type": "product",
          "id": "main_product",
          "label": "Link to Bundle Product"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Bundle Image (Overwrites Product Image)"
        },
        {
          "type": "text",
          "id": "custom_name",
          "label": "Bundle Display Name"
        },
        {
          "type": "richtext",
          "id": "custom_desc",
          "label": "Bundle Description"
        },
        {
          "type": "header",
          "content": "Hotspot 1 Settings"
        },
        { "type": "checkbox", "id": "show_hs_1", "label": "Enable Hotspot 1", "default": false },
        { "type": "product", "id": "hs_1_product", "label": "Product for Hotspot 1" },
        { "type": "range", "id": "hs_1_x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Horizontal Position", "default": 50 },
        { "type": "range", "id": "hs_1_y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Vertical Position", "default": 50 },
        {
          "type": "header",
          "content": "Hotspot 2 Settings"
        },
        { "type": "checkbox", "id": "show_hs_2", "label": "Enable Hotspot 2", "default": false },
        { "type": "product", "id": "hs_2_product", "label": "Product for Hotspot 2" },
        { "type": "range", "id": "hs_2_x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Horizontal Position", "default": 40 },
        { "type": "range", "id": "hs_2_y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Vertical Position", "default": 40 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle Grid List",
      "blocks": [
        { "type": "bundle" },
        { "type": "bundle" }
      ]
    }
  ]
}
{% endschema %}