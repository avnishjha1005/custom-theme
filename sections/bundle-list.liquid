{%- style -%}
  .bundle-section-{{ section.id }} {
    max-width: 1440px;
    margin: 0 auto;
    padding: 60px 20px;
    box-sizing: border-box;
  }
  .bundle-wrapper {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
  }
  .bundle-item {
    display: flex;
    flex-direction: column;
  }
  .bundle-visual {
    position: relative; /* Keeps hotspots and overlays contained here */
    width: 100%;
    aspect-ratio: 1.2/1;
    overflow: hidden;
    background: #f8f8f8;
    min-height: 400px;
  }
  .bundle-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  
  /* The Dot Trigger */
  .hotspot-trigger {
    position: absolute;
    width: 32px;
    height: 32px;
    background: rgba(255,255,255,0.9);
    border: 1px solid #000;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    cursor: pointer;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    transition: transform 0.2s ease;
  }
  .hotspot-trigger:hover { transform: translate(-50%, -50%) scale(1.1); }

  /* The Full-Image Overlay */
  .hotspot-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4); /* Dims the image */
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }
  
  .hotspot-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  /* The White Box in the Center */
  .hotspot-card {
    background: #fff;
    padding: 30px 40px;
    text-align: center;
    min-width: 220px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    cursor: default;
  }
  .hotspot-card-title {
    font-size: 20px;
    font-weight: 500;
    margin-bottom: 5px;
    text-transform: uppercase;
    color: #000;
  }
  .hotspot-card-price {
    font-size: 16px;
    color: #666;
    margin-bottom: 15px;
  }
  .hotspot-card-link {
    display: inline-block;
    font-size: 14px;
    text-decoration: underline;
    color: #000;
    text-underline-offset: 4px;
  }

  .bundle-item--hero { grid-column: 1 / span 2; }
  .bundle-meta { padding-top: 20px; }
  .bundle-name { font-size: 24px; text-transform: uppercase; margin: 0 0 10px 0; }
  .bundle-desc { font-size: 16px; line-height: 1.6; color: #333; }

  @media (max-width: 768px) {
    .bundle-wrapper { grid-template-columns: 1fr; }
    .bundle-item--hero { grid-column: 1 / -1; }
    .bundle-visual { min-height: 300px; }
  }
{%- endstyle -%}

<div class="bundle-section-{{ section.id }}">
  <div class="bundle-wrapper">
    {% assign hero_indices = "3,6" | split: "," %}
    {% for block in section.blocks %}
      {% if block.type == 'bundle' %}
        {% assign idx = forloop.index | append: '' %}
        {% assign is_hero = false %}
        {% for h in hero_indices %}{% if h == idx %}{% assign is_hero = true %}{% endif %}{% endfor %}

        <div class="bundle-item {% if is_hero %}bundle-item--hero{% endif %}" {{ block.shopify_attributes }}>
          {% capture item_content %}
            <div class="bundle-visual">
              {% if block.settings.product != blank %}
                {{ block.settings.product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag }}
              {% endif %}

              {% for i in (1..5) %}
                {% capture hs_show %}show_hs_{{ i }}{% endcapture %}
                {% capture hs_product_setting %}hs_{{ i }}_product{% endcapture %}
                {% assign hs_product = block.settings[hs_product_setting] %}

                {% if block.settings[hs_show] and hs_product != blank %}
                  {% capture hs_label %}hs_{{ i }}_label{% endcapture %}
                  {% capture hs_x %}hs_{{ i }}_x{% endcapture %}
                  {% capture hs_y %}hs_{{ i }}_y{% endcapture %}
                  {% capture hs_bg %}hs_{{ i }}_bg{% endcapture %}
                  {% capture hs_border %}hs_{{ i }}_border{% endcapture %}

                  <div class="hotspot-trigger" 
                       data-target="hs-{{ block.id }}-{{ i }}"
                       style="left: {{ block.settings[hs_x] }}%; top: {{ block.settings[hs_y] }}%; background: {{ block.settings[hs_bg] }}; border-color: {{ block.settings[hs_border] }};">
                    {{ block.settings[hs_label] }}
                  </div>

                  <div id="hs-{{ block.id }}-{{ i }}" class="hotspot-overlay">
                    <div class="hotspot-card">
                      <div class="hotspot-card-title">{{ hs_product.title }}</div>
                      <div class="hotspot-card-price">{{ hs_product.price | money }}</div>
                      <a href="{{ hs_product.url }}" class="hotspot-card-link">View Details</a>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>

            <div class="bundle-meta">
              <h3 class="bundle-name">{{ block.settings.product.title }}</h3>
              <div class="bundle-desc">{{ block.settings.product.description }}</div>
            </div>
          {% endcapture %}

          {% if is_hero %}
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; width: 100%;">
               {{ item_content }}
            </div>
          {% else %}
            {{ item_content }}
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const triggers = document.querySelectorAll('.hotspot-trigger');
    const overlays = document.querySelectorAll('.hotspot-overlay');

    triggers.forEach(trigger => {
      trigger.addEventListener('click', function(e) {
        e.stopPropagation();
        const targetId = this.getAttribute('data-target');
        const targetOverlay = document.getElementById(targetId);
        
        // Hide all others
        overlays.forEach(o => o.classList.remove('is-active'));
        
        // Show this one
        if (targetOverlay) targetOverlay.classList.add('is-active');
      });
    });

    // Close when clicking the dark background area
    overlays.forEach(overlay => {
      overlay.addEventListener('click', function(e) {
        // If clicking the background (not the white card)
        if (e.target === this) {
          this.classList.remove('is-active');
        }
      });
    });
  });
</script>
