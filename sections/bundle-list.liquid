{%- style -%}
  .bundle-section-{{ section.id }} {
    max-width: 1440px;
    margin: 0 auto;
    padding: 60px 20px;
    box-sizing: border-box;
  }
  .bundle-wrapper {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
  }
  .bundle-item {
    display: flex;
    flex-direction: column;
    justify-content: stretch;
  }
  .bundle-visual {
    position: relative;
    width: 100%;
    aspect-ratio: 1.2/1;
    overflow: hidden;
    background: #f8f8f8;
    display: flex;
    align-items: stretch;
    min-height: 400px;
  }
  .bundle-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hotspot-trigger {
    position: absolute;
    width: 32px;
    height: 32px;
    background: rgba(255,255,255,0.8);
    border: 1px solid #000;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    cursor: pointer;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: bold;
  }
  .bundle-meta {
    padding-top: 20px;
  }
  .bundle-name {
    font-size: 24px;
    text-transform: uppercase;
    margin: 0 0 10px 0;
  }
  .bundle-desc {
    font-size: 16px;
    line-height: 1.6;
    color: #333;
  }
  @media (max-width: 768px) {
    .bundle-wrapper {
      grid-template-columns: 1fr;
    }
    .bundle-item {
      flex-direction: column;
    }
    .bundle-visual {
      min-height: 250px;
    }
  }
{%- endstyle -%}

<div class="bundle-section-{{ section.id }}">
  <div class="bundle-wrapper">
    {% assign hero_indices = "3,6" | split: "," %}
    {% for block in section.blocks %}
      {% if block.type == 'bundle' %}
        {% assign idx = forloop.index | append: '' %}
        {% assign is_hero = false %}
        {% for h in hero_indices %}
          {% if h == idx %}{% assign is_hero = true %}{% endif %}
        {% endfor %}
        <div class="bundle-item {% if is_hero %}bundle-item--hero{% endif %}" {{ block.shopify_attributes }}>
          {% if is_hero %}
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center;">
              <div class="bundle-visual" style="order: {% if idx == 3 %}1{% else %}2{% endif %};">
                {% if block.settings.product != blank %}
                  {{ block.settings.product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
                {% else %}
                  {{ 'collection-1' | placeholder_svg_tag }}
                {% endif %}
                {% for hs in section.blocks %}
                  {% if hs.type == 'hotspot' and hs.settings.bundle_index == idx %}
                    <div class="hotspot-trigger" style="left: {{ hs.settings.x }}%; top: {{ hs.settings.y }}%; background: {{ hs.settings.bg }}; border-color: {{ hs.settings.border }};">{{ hs.settings.label }}</div>
                  {% endif %}
                {% endfor %}
              </div>
              <div class="bundle-meta" style="order: {% if idx == 3 %}2{% else %}1{% endif %};">
                <h3 class="bundle-name">{{ block.settings.product.title }}</h3>
                <div class="bundle-desc">{{ block.settings.product.description }}</div>
              </div>
            </div>
          {% else %}
            <div class="bundle-visual">
              {% if block.settings.product != blank %}
                {{ block.settings.product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag }}
              {% endif %}
              {% for hs in section.blocks %}
                {% if hs.type == 'hotspot' and hs.settings.bundle_index == idx %}
                  <div class="hotspot-trigger" style="left: {{ hs.settings.x }}%; top: {{ hs.settings.y }}%; background: {{ hs.settings.bg }}; border-color: {{ hs.settings.border }};">{{ hs.settings.label }}</div>
                {% endif %}
              {% endfor %}
            </div>
            <div class="bundle-meta">
              <h3 class="bundle-name">{{ block.settings.product.title }}</h3>
              <div class="bundle-desc">{{ block.settings.product.description }}</div>
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Bundle List",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection Context"
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" }
      ]
    },
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        { "type": "number", "id": "bundle_index", "label": "Bundle Index (1-based)", "default": 1 },
        { "type": "text", "id": "label", "label": "Hotspot Label", "default": "+" },
        { "type": "range", "id": "x", "label": "X Position (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "type": "range", "id": "y", "label": "Y Position (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "type": "color", "id": "bg", "label": "Background Color", "default": "#fff" },
        { "type": "color", "id": "border", "label": "Border Color", "default": "#000" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle List",
      "blocks": [
        { "type": "bundle", "settings": { "product": "" } },
        { "type": "bundle", "settings": { "product": "" } },
        { "type": "bundle", "settings": { "product": "" } }
      ]
    }
  ]
}
{% endschema %}