{%- style -%}
  .bundle-section-{{ section.id }} {
    max-width: 1440px;
    margin: 0 auto;
    padding: 60px 20px;
    box-sizing: border-box;
  }
  .bundle-wrapper {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
  }
  .bundle-item {
    display: flex;
    flex-direction: column;
  }
  .bundle-visual {
    position: relative;
    width: 100%;
    aspect-ratio: 1.2/1;
    overflow: hidden;
    background: #000;
    min-height: 400px;
  }
  .bundle-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.4s ease;
  }

  /* The Dimmer Overlay (spans the image) */
  .bundle-visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.5);
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    z-index: 2;
    pointer-events: none;
  }

  /* When any hotspot is active, dim the image */
  .bundle-visual.has-active-hotspot::after {
    opacity: 1;
    visibility: visible;
  }

  .hotspot-node {
    position: absolute;
    display: flex;
    align-items: center;
    z-index: 10;
    transform: translate(-16px, -16px);
    cursor: pointer;
    transition: z-index 0s;
  }

  .hotspot-dot {
    width: 32px;
    height: 32px;
    background: #fff;
    border: 1px solid #000;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: bold;
    flex-shrink: 0;
    z-index: 11;
  }

  .hotspot-text {
    margin-left: 15px;
    color: #fff;
    opacity: 0;
    visibility: hidden;
    transform: translateX(-10px);
    transition: all 0.3s ease;
    white-space: nowrap;
    pointer-events: none;
  }

  /* Active State Styles */
  .hotspot-node.is-active .hotspot-text {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
  }
  
  .hotspot-node.is-active {
    z-index: 15; /* Ensure active text is on top of everything */
  }

  .hs-title {
    font-size: 18px;
    font-weight: 500;
    display: block;
    text-transform: uppercase;
  }
  .hs-price {
    font-size: 16px;
    display: block;
  }

  .bundle-item--hero { grid-column: 1 / span 2; }
  .bundle-meta { padding-top: 20px; }
  .bundle-name { font-size: 24px; text-transform: uppercase; margin: 0 0 10px 0; }
  .bundle-desc { font-size: 16px; line-height: 1.6; color: #333; }

  @media (max-width: 768px) {
    .bundle-wrapper { grid-template-columns: 1fr; }
    .bundle-visual { min-height: 300px; }
  }
{%- endstyle -%}

<div class="bundle-section-{{ section.id }}">
  <div class="bundle-wrapper">
    {% assign hero_indices = "3,6" | split: "," %}
    {% for block in section.blocks %}
      {% if block.type == 'bundle' %}
        {% assign idx = forloop.index | append: '' %}
        {% assign is_hero = false %}
        {% for h in hero_indices %}{% if h == idx %}{% assign is_hero = true %}{% endif %}{% endfor %}

        <div class="bundle-item {% if is_hero %}bundle-item--hero{% endif %}" {{ block.shopify_attributes }}>
          {% capture item_content %}
            <div class="bundle-visual">
              {% if block.settings.product != blank %}
                {{ block.settings.product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag }}
              {% endif %}

              {% for i in (1..5) %}
                {% capture hs_show %}show_hs_{{ i }}{% endcapture %}
                {% capture hs_product_setting %}hs_{{ i }}_product{% endcapture %}
                {% assign hs_product = block.settings[hs_product_setting] %}

                {% if block.settings[hs_show] and hs_product != blank %}
                  {% capture hs_label %}hs_{{ i }}_label{% endcapture %}
                  {% capture hs_x %}hs_{{ i }}_x{% endcapture %}
                  {% capture hs_y %}hs_{{ i }}_y{% endcapture %}
                  {% capture hs_bg %}hs_{{ i }}_bg{% endcapture %}
                  {% capture hs_border %}hs_{{ i }}_border{% endcapture %}

                  <div class="hotspot-node" 
                       data-url="{{ hs_product.url }}"
                       style="left: {{ block.settings[hs_x] }}%; top: {{ block.settings[hs_y] }}%;">
                    <div class="hotspot-dot" style="background: {{ block.settings[hs_bg] }}; border-color: {{ block.settings[hs_border] }};">
                      {{ block.settings[hs_label] }}
                    </div>
                    <div class="hotspot-text">
                      <span class="hs-title">{{ hs_product.title }}</span>
                      <span class="hs-price">{{ hs_product.price | money }}</span>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>

            <div class="bundle-meta">
              <h3 class="bundle-name">{{ block.settings.product.title }}</h3>
              <div class="bundle-desc">{{ block.settings.product.description }}</div>
            </div>
          {% endcapture %}

          {% if is_hero %}
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; width: 100%;">
               {{ item_content }}
            </div>
          {% else %}
            {{ item_content }}
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const nodes = document.querySelectorAll('.hotspot-node');

    nodes.forEach(node => {
      node.addEventListener('click', function(e) {
        e.stopPropagation();
        const parentVisual = this.closest('.bundle-visual');
        const isActive = this.classList.contains('is-active');

        // Remove active from everything
        document.querySelectorAll('.hotspot-node').forEach(n => n.classList.remove('is-active'));
        document.querySelectorAll('.bundle-visual').forEach(v => v.classList.remove('has-active-hotspot'));

        if (!isActive) {
          // First click: Activate this hotspot and dim image
          this.classList.add('is-active');
          parentVisual.classList.add('has-active-hotspot');
        } else {
          // Second click: Navigate
          const url = this.getAttribute('data-url');
          if (url) window.location.href = url;
        }
      });
    });

    // Reset when clicking anywhere else
    document.addEventListener('click', function() {
      document.querySelectorAll('.hotspot-node').forEach(n => n.classList.remove('is-active'));
      document.querySelectorAll('.bundle-visual').forEach(v => v.classList.remove('has-active-hotspot'));
    });
  });
</script>