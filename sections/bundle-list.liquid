{%- style -%}
  .bundle-section-{{ section.id }} {
    max-width: 1440px;
    margin: 0 auto;
    padding: 60px 20px;
    box-sizing: border-box;
  }

  .bundle-wrapper {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
  }

  /* --- Layout 1: Grid (1/2 Width) --- */
  .bundle-item--grid {
    grid-column: span 1;
  }

  /* --- Layout 2: Editorial (Full Width - 2 columns) --- */
  .bundle-item--editorial {
    grid-column: span 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    margin-top: 40px;
  }

  /* Alternating Logic for Editorial */
  .bundle-item--editorial.is-reversed {
    direction: rtl;
  }
  .bundle-item--editorial.is-reversed .editorial-main-col,
  .bundle-item--editorial.is-reversed .editorial-side-col {
    direction: ltr;
  }

  /* Image & Hotspots */
  .bundle-visual {
    position: relative;
    line-height: 0;
  }
  .bundle-visual img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Hotspot Styling */
  .hotspot-trigger {
    position: absolute;
    width: 32px;
    height: 32px;
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid #000;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    cursor: pointer;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Content Logic */
  .bundle-meta {
    padding-top: 20px;
  }
  .bundle-name {
    font-size: 24px;
    text-transform: uppercase;
    margin: 0 0 10px 0;
  }
  .bundle-desc {
    font-size: 14px;
    line-height: 1.6;
    color: #333;
  }
  .editorial-side-col {
    font-size: 16px;
    line-height: 1.8;
  }

  @media (max-width: 768px) {
    .bundle-wrapper, .bundle-item--editorial {
      grid-template-columns: 1fr;
      direction: ltr !important;
    }
    .bundle-item--grid, .bundle-item--editorial {
      grid-column: span 1;
    }
  }
{%- endstyle -%}

<div class="bundle-section-{{ section.id }}">
  <div class="bundle-wrapper">
    {% for block in section.blocks %}
      {%- assign bundle_p = block.settings.product -%}
      
      {% comment %} 
        Determine if this is an editorial block and if it should be reversed. 
        We track the editorial count to alternate left/right.
      {% endcomment %}
      {% if block.settings.layout_style == 'editorial' %}
        {% assign editorial_count = editorial_count | plus: 1 %}
        {% assign is_even = editorial_count | modulo: 2 %}
      {% endif %}

      <div class="bundle-item bundle-item--{{ block.settings.layout_style }} {% if is_even == 0 %}is-reversed{% endif %}" {{ block.shopify_attributes }}>
        
        <div class="editorial-main-col">
          <div class="bundle-visual">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag }}
            {% endif %}

            {%- comment -%} Configurable Hotspots {%- endcomment -%}
            {% for i in (1..3) %}
              {% capture hs_show %}show_hs_{{ i }}{% endcapture %}
              {% capture hs_x %}hs_{{ i }}_x{% endcapture %}
              {% capture hs_y %}hs_{{ i }}_y{% endcapture %}
              {% if block.settings[hs_show] %}
                <div class="hotspot-trigger" style="left: {{ block.settings[hs_x] }}%; top: {{ block.settings[hs_y] }}%;">+</div>
              {% endif %}
            {% endfor %}
          </div>

          <div class="bundle-meta">
            <h3 class="bundle-name">{% if block.settings.name != blank %}{{ block.settings.name }}{% else %}{{ bundle_p.title }}{% endif %}</h3>
            <div class="bundle-desc">{{ block.settings.description }}</div>
          </div>
        </div>

        {% if block.settings.layout_style == 'editorial' %}
          <div class="editorial-side-col">
            {{ block.settings.side_description }}
          </div>
        {% endif %}

      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Bundle List",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection Context"
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle Block",
      "settings": [
        {
          "type": "select",
          "id": "layout_style",
          "label": "Block Style",
          "options": [
            { "value": "grid", "label": "Grid (First Row Style)" },
            { "value": "editorial", "label": "Editorial (Large Alt Style)" }
          ],
          "default": "grid"
        },
        { "type": "product", "id": "product", "label": "Bundle Product" },
        { "type": "image_picker", "id": "image", "label": "Bundle Image" },
        { "type": "text", "id": "name", "label": "Bundle Name" },
        { "type": "richtext", "id": "description", "label": "Description (Under Image)" },
        { "type": "richtext", "id": "side_description", "label": "Side Description (Editorial Only)" },
        { "type": "header", "content": "Hotspot 1" },
        { "type": "checkbox", "id": "show_hs_1", "label": "Show Hotspot 1", "default": false },
        { "type": "range", "id": "hs_1_x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "X Position", "default": 50 },
        { "type": "range", "id": "hs_1_y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Y Position", "default": 50 },
        { "type": "header", "content": "Hotspot 2" },
        { "type": "checkbox", "id": "show_hs_2", "label": "Show Hotspot 2", "default": false },
        { "type": "range", "id": "hs_2_x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "X Position", "default": 30 },
        { "type": "range", "id": "hs_2_y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Y Position", "default": 30 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle List",
      "blocks": [
        { "type": "bundle", "settings": { "layout_style": "grid" } },
        { "type": "bundle", "settings": { "layout_style": "grid" } },
        { "type": "bundle", "settings": { "layout_style": "editorial" } }
      ]
    }
  ]
}
{% endschema %}