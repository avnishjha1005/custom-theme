{% assign bar_id = section.id %}

{% style %}
  .sticky-info-bar-{{ bar_id }} {
    --bar-bg: {{ section.settings.background_color }};
    --bar-text: {{ section.settings.text_color }};
    --btn-bg: {{ section.settings.button_background }};
    --btn-text: {{ section.settings.button_text }};

    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    z-index: 499;
    background: var(--bar-bg);
    color: var(--bar-text);
    padding-bottom: env(safe-area-inset-bottom);
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .sticky-info-bar-{{ bar_id }}.is-hidden {
    transform: translateY(100%);
    opacity: 0;
    pointer-events: none;
  }

  /* Mobile - account for tab bar */
  @media screen and (max-width: 768px) {
    .sticky-info-bar-{{ bar_id }} {
      bottom: var(--tab-bar-height, 56px);
    }
  }

  .sticky-info-bar__inner-{{ bar_id }} {
    max-width: 1440px;
    margin: 0 auto;
  }

  /* Two Column Grid Layout + Toggle */
  .sticky-info-bar__row-{{ bar_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr 20px;
    gap: 12px;
    padding-block: 16px;
    padding-inline: 60px;
    align-items: start;
  }

  /* Left Column */
  .sticky-info-bar__left-{{ bar_id }} {
    display: flex;
    align-items: flex-start;
  }

  .sticky-info-bar__label-{{ bar_id }} {
    font-size: 14px;
    font-weight: 400;
    margin: 0;
    line-height: 1.4;
  }

  /* Toggle button */
  .sticky-info-bar__toggle-{{ bar_id }} {
    width: 20px;
    height: 20px;
    min-width: 20px;
    border: none;
    background: transparent;
    color: inherit;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
  }

  .sticky-info-bar__toggle-{{ bar_id }} svg {
    width: 14px;
    height: 14px;
  }

  .sticky-info-bar__toggle-{{ bar_id }} .icon-vertical {
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .sticky-info-bar-{{ bar_id }}.is-expanded .sticky-info-bar__toggle-{{ bar_id }} .icon-vertical {
    opacity: 0;
    transform: scaleY(0);
  }

  /* Right Column - stacked content */
  .sticky-info-bar__right-{{ bar_id }} {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    font-size: 12px;
    line-height: 1.4;
    text-align: start;
  }

  .sticky-info-bar__right-{{ bar_id }} span {
    display: block;
  }

  .sticky-info-bar__right-{{ bar_id }} p {
    margin: 0 0 8px 0;
  }

  .sticky-info-bar__right-{{ bar_id }} p:last-child {
    margin-bottom: 0;
  }

  /* Expanded Content */
  .sticky-info-bar__expanded-{{ bar_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .sticky-info-bar-{{ bar_id }}.is-expanded .sticky-info-bar__expanded-{{ bar_id }} {
    max-height: 400px;
  }

  /* CTA Buttons */
  .sticky-info-bar__cta-{{ bar_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px 24px;
    margin-inline: 65px;
    background: var(--btn-bg);
    color: var(--btn-text);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 12px;
    font-weight: 400;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .sticky-info-bar__cta-{{ bar_id }}:hover {
    opacity: 0.9;
  }

  .sticky-info-bar__directions-{{ bar_id }} {
    margin-bottom: 8px;
  }

  .sticky-info-bar__book-{{ bar_id }} {
    margin-top: 8px;
    margin-bottom: 16px;
  }

  /* Mobile */
  @media screen and (max-width: 768px) {
    .sticky-info-bar__row-{{ bar_id }} {
      padding-inline: 20px;
    }

    .sticky-info-bar__label-{{ bar_id }} {
      font-size: 13px;
    }

    .sticky-info-bar__right-{{ bar_id }} {
      font-size: 11px;
    }

    .sticky-info-bar__cta-{{ bar_id }} {
      padding: 12px 20px;
      font-size: 11px;
      margin-inline: 20px;
    }
  }
{% endstyle %}

<sticky-info-bar
  class="sticky-info-bar-{{ bar_id }}"
  id="sticky-info-bar-{{ bar_id }}"
  data-footer-selector="{{ section.settings.footer_selector }}"
>
  <div class="sticky-info-bar__inner-{{ bar_id }}">
    <!-- Header Row: Two columns + toggle -->
    <div class="sticky-info-bar__row-{{ bar_id }}">
      <!-- Left: Store name -->
      <div class="sticky-info-bar__left-{{ bar_id }}">
        <h5 class="sticky-info-bar__label-{{ bar_id }}">{{ section.settings.store_name }}</h5>
      </div>

      <!-- Right: Address info stacked -->
      <div class="sticky-info-bar__right-{{ bar_id }}">
        {% if section.settings.address_line_1 != blank %}
          <span>{{ section.settings.address_line_1 }}</span>
        {% endif %}
        {% if section.settings.address_line_2 != blank %}
          <span>{{ section.settings.address_line_2 }}</span>
        {% endif %}
        {% if section.settings.phone != blank %}
          <span>{{ section.settings.phone }}</span>
        {% endif %}
        {% if section.settings.email != blank %}
          <span>{{ section.settings.email }}</span>
        {% endif %}
      </div>

      <!-- Toggle button -->
      <button
        class="sticky-info-bar__toggle-{{ bar_id }}"
        data-toggle
        aria-expanded="false"
        aria-label="Toggle store information"
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <line class="icon-vertical" x1="8" y1="3" x2="8" y2="13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <line class="icon-horizontal" x1="3" y1="8" x2="13" y2="8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <!-- Expanded Content -->
    <div class="sticky-info-bar__expanded-{{ bar_id }}" data-expanded>
      <!-- Opening Hours Row: Same grid as header -->
      {% if section.settings.opening_hours != blank %}
        <div class="sticky-info-bar__row-{{ bar_id }}">
          <!-- Left: Opening hours label -->
          <div class="sticky-info-bar__left-{{ bar_id }}">
            <h5 class="sticky-info-bar__label-{{ bar_id }}">Opening hours</h5>
          </div>

          <!-- Right: Hours content -->
          <div class="sticky-info-bar__right-{{ bar_id }}">
            {{ section.settings.opening_hours }}
          </div>

          <!-- Empty placeholder for grid alignment -->
          <div></div>
        </div>
      {% endif %}

      <!-- Get Directions CTA -->
      {% if section.settings.button_1_link != blank and section.settings.button_1_label != blank %}
        <a href="{{ section.settings.button_1_link }}" class="sticky-info-bar__cta-{{ bar_id }} sticky-info-bar__directions-{{ bar_id }}">
          {{ section.settings.button_1_label }}
        </a>
      {% endif %}
    </div>

    <!-- Book Appointment CTA (always visible) -->
    {% if section.settings.button_2_link != blank and section.settings.button_2_label != blank %}
      <a href="{{ section.settings.button_2_link }}" class="sticky-info-bar__cta-{{ bar_id }} sticky-info-bar__book-{{ bar_id }}">
        {{ section.settings.button_2_label }}
      </a>
    {% endif %}
  </div>
</sticky-info-bar>

<script>
  (function() {
    if (customElements.get('sticky-info-bar')) return;

    class StickyInfoBar extends HTMLElement {
      constructor() {
        super();
        this.isExpanded = false;
        this.scrollHandler = null;
        this.resizeHandler = null;
        this.lastScrollY = 0;
        this.scrollThreshold = 10; // Minimum scroll distance to trigger hide/show
      }

      connectedCallback() {
        this.toggleBtn = this.querySelector('[data-toggle]');
        this.expandedContent = this.querySelector('[data-expanded]');

        if (this.toggleBtn) {
          this.toggleBtn.addEventListener('click', () => this.toggle());
        }

        this.initScrollBehavior();
      }

      disconnectedCallback() {
        if (this.scrollHandler) {
          window.removeEventListener('scroll', this.scrollHandler);
        }
        if (this.resizeHandler) {
          window.removeEventListener('resize', this.resizeHandler);
        }
      }

      getFooter() {
        // Try custom selector from settings first
        const customSelector = this.dataset.footerSelector;
        if (customSelector) {
          const customFooter = document.querySelector(customSelector);
          if (customFooter) return customFooter;
        }

        // Fallback selectors
        return document.querySelector('.shopify-section-group-footer-group')
          || document.querySelector('[class*="footer-group"]')
          || document.querySelector('footer')
          || document.querySelector('.footer')
          || document.querySelector('#shopify-section-footer')
          || document.querySelector('[id*="shopify-section-footer"]');
      }

      initScrollBehavior() {
        const self = this;
        this.lastScrollY = window.scrollY;

        const handleScroll = () => {
          const currentScrollY = window.scrollY;
          const scrollDelta = currentScrollY - self.lastScrollY;
          const footer = self.getFooter();

          // Check if footer is visible - always hide when footer is in view
          if (footer) {
            const footerRect = footer.getBoundingClientRect();
            const windowHeight = window.innerHeight;

            if (footerRect.top < windowHeight) {
              self.classList.add('is-hidden');
              self.lastScrollY = currentScrollY;
              return;
            }
          }

          // Only trigger if scroll distance exceeds threshold
          if (Math.abs(scrollDelta) < self.scrollThreshold) {
            return;
          }

          // Scrolling down - hide the bar
          if (scrollDelta > 0 && currentScrollY > 100) {
            self.classList.add('is-hidden');
          }
          // Scrolling up - show the bar
          else if (scrollDelta < 0) {
            self.classList.remove('is-hidden');
          }

          self.lastScrollY = currentScrollY;
        };

        const checkFooterVisibility = () => {
          const footer = self.getFooter();
          if (!footer) return;

          const footerRect = footer.getBoundingClientRect();
          const windowHeight = window.innerHeight;

          if (footerRect.top < windowHeight) {
            self.classList.add('is-hidden');
          }
        };

        // Initial check after a small delay to ensure DOM is ready
        setTimeout(checkFooterVisibility, 100);

        // Listen to scroll events
        window.addEventListener('scroll', handleScroll, { passive: true });

        // Also check on resize
        window.addEventListener('resize', checkFooterVisibility, { passive: true });

        // Store references for cleanup
        this.scrollHandler = handleScroll;
        this.resizeHandler = checkFooterVisibility;
      }

      toggle() {
        this.isExpanded = !this.isExpanded;
        this.classList.toggle('is-expanded', this.isExpanded);

        if (this.toggleBtn) {
          this.toggleBtn.setAttribute('aria-expanded', this.isExpanded);
        }
      }

      close() {
        if (this.isExpanded) {
          this.isExpanded = false;
          this.classList.remove('is-expanded');
          if (this.toggleBtn) {
            this.toggleBtn.setAttribute('aria-expanded', 'false');
          }
        }
      }
    }

    customElements.define('sticky-info-bar', StickyInfoBar);
  })();
</script>

{% schema %}
{
  "name": "Sticky Info Bar",
  "class": "sticky-info-bar-section",
  "settings": [
    {
      "type": "header",
      "content": "Store Info"
    },
    {
      "type": "text",
      "id": "store_name",
      "label": "Store name",
      "default": "The AR Studio"
    },
    {
      "type": "text",
      "id": "address_line_1",
      "label": "Address line 1",
      "default": "Address line 1"
    },
    {
      "type": "text",
      "id": "address_line_2",
      "label": "Address line 2",
      "default": "Address line 2"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "Phone"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "Email"
    },
    {
      "type": "header",
      "content": "Expanded Content"
    },
    {
      "type": "richtext",
      "id": "opening_hours",
      "label": "Opening hours",
      "default": "<p>Monday - Friday<br>10am - 7:30pm</p><p>Saturday & Sunday<br>12pm - 7pm</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Button 1 label (Get Directions)",
      "default": "GET DIRECTIONS"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button 2 label (Book Appointment)",
      "default": "BOOK AN APPOINTMENT"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "text",
      "id": "footer_selector",
      "label": "Footer CSS selector",
      "default": ".shopify-section-group-footer-group",
      "info": "CSS selector for the footer element. The bar will hide when this element is visible."
    }
  ],
  "presets": [
    {
      "name": "Sticky Info Bar"
    }
  ]
}
{% endschema %}
