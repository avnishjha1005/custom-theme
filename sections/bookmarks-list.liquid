{%- comment -%}
  Bookmarks List Section
  Displays saved article bookmarks from localStorage
  Create a page with template "bookmarks" to use this section
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="section color-{{ section.settings.color_scheme }} bookmarks-section"
  style="
    padding-top: {{ section.settings.padding_top | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  "
>
  <div class="page-width">
    <h1 class="bookmarks-title h3">{{ section.settings.title | default: 'My Saved Articles' }}</h1>

    {%- comment -%} Login prompt for non-logged-in users {%- endcomment -%}
    {%- unless customer -%}
      <div class="bookmarks-login-prompt">
        <p>{{ 'blogs.bookmarks.login_message' | t | default: 'Sign in to save articles across your devices' }}</p>
        <a href="{{ routes.account_login_url }}" class="button">
          {{ 'actions.log_in' | t | default: 'Sign in' }}
        </a>
      </div>
    {%- endunless -%}

    {%- comment -%} Bookmarks container - rendered via JavaScript {%- endcomment -%}
    {%- capture blog_handles -%}
      {%- for blog in blogs -%}
        {{ blog.handle }}{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    {%- endcapture -%}
    <div
      class="bookmarks-container js-bookmarks-grid"
      data-blog-handles="{{ blog_handles | strip }}"
      {% if settings.storefront_api_token != blank %}data-storefront-token="{{ settings.storefront_api_token }}"{% endif %}
      {% if customer %}data-customer-id="{{ customer.id }}"{% endif %}
    >
      <div class="bookmarks-loading">
        <span class="visually-hidden">Loading saved articles...</span>
        <svg class="spinner" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="31.4 31.4" stroke-linecap="round">
            <animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="1s" repeatCount="indefinite"/>
          </circle>
        </svg>
      </div>
    </div>

    {%- comment -%} Empty state template (hidden, used by JS) {%- endcomment -%}
    <template id="bookmarks-empty-template">
      <div class="bookmarks-empty-state">
        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 5C5 3.89543 5.89543 3 7 3H17C18.1046 3 19 3.89543 19 5V21L12 17.5L5 21V5Z"/>
        </svg>
        <p>{{ 'blogs.bookmarks.empty' | t | default: 'No saved articles yet.' }}</p>
        <a href="{{ section.settings.empty_state_blog.url | default: '/blogs' }}" class="button button--secondary">
          {{ 'blogs.bookmarks.browse' | t | default: 'Browse Articles' }}
        </a>
      </div>
    </template>

    {%- comment -%} Article card template (hidden, used by JS) - matches main-blog-listings.liquid styling {%- endcomment -%}
    <template id="bookmark-card-template">
      <div class="bookmark-item">
        <article class="bookmark-card">
          <div class="bookmark-card__image">
            <a href="">
              <img src="" alt="" loading="lazy" width="251" height="360">
              <div class="bookmark-card__placeholder" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
              </div>
            </a>
          </div>
          <div class="bookmark-card__content">
            <span class="bookmark-card__tag"></span>
            <h3 class="bookmark-card__title">
              <a href=""></a>
            </h3>
            <p class="bookmark-card__excerpt"></p>
            <div class="bookmark-card__actions">
              <a href="" class="bookmark-card__read-link">READ</a>
              <button type="button" class="bookmark-card__remove" aria-label="{{ 'blogs.bookmarks.remove' | t | default: 'Remove' }}">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="none">
                  <path d="M5 5C5 3.89543 5.89543 3 7 3H17C18.1046 3 19 3.89543 19 5V21L12 17.5L5 21V5Z"/>
                </svg>
              </button>
            </div>
          </div>
        </article>
      </div>
    </template>
  </div>
</div>

{% stylesheet %}
  .bookmarks-section {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
  }

  .bookmarks-title {
    color: rgb(105 44 35 / 1.0);
    text-align: center;
    margin-bottom: 40px;
  }

  .bookmarks-login-prompt {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 24px;
    margin-bottom: 32px;
    background: rgb(var(--color-foreground-rgb) / 0.03);
    border-radius: 8px;
  }

  .bookmarks-login-prompt p {
    margin-bottom: 16px;
  }

  .bookmarks-container {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .bookmarks-loading {
    display: flex;
    justify-content: center;
    padding: 60px 20px;
  }

  .bookmarks-loading .spinner {
    width: 32px;
    height: 32px;
    color: rgb(var(--color-foreground-rgb) / 0.4);
  }

  .bookmark-item {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
  }

  .bookmark-card {
    display: flex;
    flex-direction: row;
    gap: 24px;
    align-items: flex-start;
    justify-content: center;
  }

  .bookmark-card__image {
    flex-shrink: 0;
    width: 251px;
    height: 360px;
    overflow: hidden;
    position: relative;
  }

  .bookmark-card__image a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .bookmark-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bookmark-card__placeholder {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgb(var(--color-foreground-rgb) / 0.05);
    align-items: center;
    justify-content: center;
    color: rgb(var(--color-foreground-rgb) / 0.2);
  }

  .bookmark-card__image--no-image .bookmark-card__placeholder {
    display: flex;
  }

  .bookmark-card__image--no-image img {
    display: none;
  }

  .bookmark-card__content {
    gap: 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
    text-align: left;
    max-width: 251px !important;
  }

  .bookmark-card__tag {
    font-size: 0.75rem;
    line-height: 0.875;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb));
  }

  .bookmark-card__title {
    font-family: var(--font-heading--family);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.2;
    margin: 0;
  }

  .bookmark-card__title a {
    text-decoration: none;
    color: var(--color-foreground-heading);
  }

  .bookmark-card__title a:hover {
    opacity: 0.7;
  }

  .bookmark-card__excerpt {
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgb(var(--color-foreground-rgb) / 0.8);
    margin: 0;
  }

  .bookmark-card__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    font-weight: 600;
  }

  .bookmark-card__read-link {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-decoration: underline;
    text-underline-offset: 4px;
    color: var(--color-foreground-heading);
  }

  .bookmark-card__read-link:hover {
    opacity: 0.7;
  }

  .bookmark-card__remove {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--color-foreground-heading);
    transition: opacity 0.2s ease;
  }

  .bookmark-card__remove:hover {
    opacity: 0.7;
  }

  .bookmarks-empty-state {
    text-align: center;
    padding: 60px 20px;
    max-width: 640px;
    margin: 0 auto;
  }

  .bookmarks-empty-state svg {
    margin-bottom: 20px;
    color: rgb(var(--color-foreground-rgb) / 0.3);
  }

  .bookmarks-empty-state p {
    margin-bottom: 20px;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  /* Mobile Styles - maintain side-by-side layout */
  @media screen and (max-width: 749px) {
    .bookmarks-container {
      gap: 32px;
    }

    .bookmark-item {
      width: 100%;
    }

    .bookmark-card {
      flex-direction: row;
      gap: 16px;
    }

    .bookmark-card__image {
      width: 140px;
      height: 200px;
      flex-shrink: 0;
    }

    .bookmark-card__content {
      padding-top: 0;
      gap: 24px;
      max-width: none !important;
      flex: 1;
    }

    .bookmark-card__title {
      font-size: 1.125rem;
    }

    .bookmark-card__tag {
      font-size: 0.625rem;
    }

    .bookmark-card__excerpt {
      font-size: 0.8rem;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .bookmark-card__read-link {
      font-size: 0.75rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function() {
    // Bookmarks stored in customer metafields via App Proxy
    const container = document.querySelector('.js-bookmarks-grid');
    if (!container) return;

    const emptyTemplate = document.getElementById('bookmarks-empty-template');
    const cardTemplate = document.getElementById('bookmark-card-template');
    const isLoggedIn = container.hasAttribute('data-customer-id');

    function getArticleSlug(handle) {
      if (!handle) return '';
      return handle.split('/').pop();
    }

    // Fetch bookmarks via App Proxy
    async function getBookmarks() {
      console.log('Fetching bookmarks from App Proxy...');
      try {
        const response = await fetch('/apps/bookmarks');
        console.log('Fetch response status:', response.status);
        if (!response.ok) {
          console.error('Fetch failed with status:', response.status);
          return [];
        }
        const data = await response.json();
        console.log('Fetched bookmarks:', data);
        return data.bookmarks || [];
      } catch (error) {
        console.error('Bookmark fetch failed:', error);
        return [];
      }
    }

    // Save bookmarks via App Proxy
    async function saveBookmarks(bookmarks) {
      console.log('Saving bookmarks:', bookmarks);
      try {
        const response = await fetch('/apps/bookmarks', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ bookmarks })
        });
        console.log('Save response status:', response.status);
        const data = await response.json();
        console.log('Save response data:', data);
        if (!response.ok) {
          console.error('Save failed with status:', response.status, data);
          return false;
        }
        return data.success === true;
      } catch (error) {
        console.error('Bookmark save failed:', error);
        return false;
      }
    }

    async function removeBookmark(articleHandle) {
      console.log('Removing bookmark:', articleHandle);
      let bookmarks = await getBookmarks();
      console.log('Current bookmarks before filter:', bookmarks);
      bookmarks = bookmarks.filter(b => {
        const handle = typeof b === 'string' ? b.split('/').pop() : b.handle;
        return handle !== articleHandle;
      });
      console.log('Bookmarks after filter:', bookmarks);

      const success = await saveBookmarks(bookmarks);
      console.log('Remove success:', success);
      if (success) {
        window.dispatchEvent(new CustomEvent('bookmarks:updated', {
          detail: { bookmarks, articleHandle, action: 'removed' }
        }));
        renderBookmarks();
      } else {
        console.error('Failed to remove bookmark');
      }
    }

    // Normalize bookmark data (handles both old string format and new object format)
    function normalizeBookmark(bookmark) {
      if (typeof bookmark === 'string') {
        // Old format: "blog/article-slug" or just "article-slug"
        const parts = bookmark.split('/');
        if (parts.length >= 2) {
          return {
            handle: parts[parts.length - 1],
            blogHandle: parts[parts.length - 2],
            title: parts[parts.length - 1].replace(/-/g, ' '),
            excerpt: '',
            image: '',
            url: `/blogs/${parts[parts.length - 2]}/${parts[parts.length - 1]}`
          };
        }
        return {
          handle: bookmark,
          blogHandle: '',
          title: bookmark.replace(/-/g, ' '),
          excerpt: '',
          image: '',
          url: ''
        };
      }
      // New format: object with all data
      return {
        handle: bookmark.handle || '',
        blogHandle: bookmark.blogHandle || '',
        title: bookmark.title || bookmark.handle?.replace(/-/g, ' ') || '',
        excerpt: bookmark.excerpt || '',
        image: bookmark.image || '',
        url: bookmark.url || `/blogs/${bookmark.blogHandle}/${bookmark.handle}`
      };
    }

    function truncateText(text, wordLimit) {
      if (!text) return '';
      const words = text.split(/\s+/);
      if (words.length <= wordLimit) return text;
      return words.slice(0, wordLimit).join(' ') + '...';
    }

    function stripHtml(html) {
      const tmp = document.createElement('div');
      tmp.innerHTML = html;
      return tmp.textContent || tmp.innerText || '';
    }

    function createArticleCard(article) {
      const clone = cardTemplate.content.cloneNode(true);
      const item = clone.querySelector('.bookmark-item');
      const card = clone.querySelector('.bookmark-card');

      const url = article.url || `/blogs/${article.blogHandle}/${article.handle}`;

      // Set article URLs on all links
      card.querySelectorAll('a').forEach(link => {
        link.href = url;
      });

      // Set title
      const titleLink = card.querySelector('.bookmark-card__title a');
      titleLink.textContent = article.title || article.handle;

      // Hide tag (not stored in bookmark data)
      const tagEl = card.querySelector('.bookmark-card__tag');
      if (tagEl) tagEl.style.display = 'none';

      // Set excerpt
      const excerptEl = card.querySelector('.bookmark-card__excerpt');
      if (excerptEl) {
        if (article.excerpt) {
          excerptEl.textContent = article.excerpt;
        } else {
          excerptEl.style.display = 'none';
        }
      }

      // Set image
      const imgContainer = card.querySelector('.bookmark-card__image');
      const img = card.querySelector('.bookmark-card__image img');
      if (article.image) {
        img.src = article.image;
        img.alt = article.title || '';
      } else {
        imgContainer.classList.add('bookmark-card__image--no-image');
      }

      // Set up remove button
      const removeBtn = card.querySelector('.bookmark-card__remove');
      removeBtn.addEventListener('click', (e) => {
        e.preventDefault();
        removeBookmark(article.handle);
      });

      return item;
    }

    async function renderBookmarks() {
      // Check if user is logged in - if not, just clear container (login prompt handles the CTA)
      if (!isLoggedIn) {
        container.innerHTML = '';
        return;
      }

      // Show loading state
      container.innerHTML = '<div class="bookmarks-loading"><span class="visually-hidden">Loading...</span></div>';

      // Fetch bookmarks via App Proxy
      const bookmarks = await getBookmarks();
      console.log('Bookmarks:', bookmarks);

      if (bookmarks.length === 0) {
        container.innerHTML = '';
        container.appendChild(emptyTemplate.content.cloneNode(true));
        return;
      }

      // Normalize bookmark data (handles both old string format and new object format)
      const articles = bookmarks.map(b => normalizeBookmark(b)).filter(a => a.handle);
      console.log('Normalized articles:', articles);

      // Render cards
      container.innerHTML = '';

      if (articles.length === 0) {
        container.appendChild(emptyTemplate.content.cloneNode(true));
        return;
      }

      articles.forEach(article => {
        const card = createArticleCard(article);
        container.appendChild(card);
      });
    }

    // Initial render
    renderBookmarks();

    // Listen for bookmark updates from other components
    window.addEventListener('bookmarks:updated', renderBookmarks);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Bookmarks List",
  "tag": "section",
  "class": "bookmarks-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "My Saved Articles"
    },
    {
      "type": "blog",
      "id": "empty_state_blog",
      "label": "Empty state blog link",
      "info": "Select the blog to link to when no bookmarks are saved"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Bookmarks List",
      "category": "Blog"
    }
  ]
}
{% endschema %}
