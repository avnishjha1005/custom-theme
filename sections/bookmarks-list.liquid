{%- comment -%}
  Bookmarks List Section
  Displays saved article bookmarks from localStorage
  Create a page with template "bookmarks" to use this section
{%- endcomment -%}

<div class="bookmarks-section color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <h1 class="bookmarks-title h2">{{ section.settings.title | default: 'My Saved Articles' }}</h1>

    {%- comment -%} Login prompt for non-logged-in users {%- endcomment -%}
    {%- unless customer -%}
      <div class="bookmarks-login-prompt">
        <p>{{ 'blogs.bookmarks.login_message' | t | default: 'Sign in to save articles across your devices' }}</p>
        <a href="{{ routes.account_login_url }}" class="button">
          {{ 'actions.log_in' | t | default: 'Sign in' }}
        </a>
      </div>
    {%- endunless -%}

    {%- comment -%} Bookmarks grid - rendered via JavaScript {%- endcomment -%}
    {%- capture blog_handles -%}
      {%- for blog in blogs -%}
        {{ blog.handle }}{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    {%- endcapture -%}
    <div
      class="bookmarks-grid js-bookmarks-grid"
      data-blog-handles="{{ blog_handles | strip }}"
      {% if settings.storefront_api_token != blank %}data-storefront-token="{{ settings.storefront_api_token }}"{% endif %}
      {% if customer %}data-customer-id="{{ customer.id }}"{% endif %}
    >
      <div class="bookmarks-loading">
        <span class="visually-hidden">Loading saved articles...</span>
        <svg class="spinner" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="31.4 31.4" stroke-linecap="round">
            <animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="1s" repeatCount="indefinite"/>
          </circle>
        </svg>
      </div>
    </div>

    {%- comment -%} Empty state template (hidden, used by JS) {%- endcomment -%}
    <template id="bookmarks-empty-template">
      <div class="bookmarks-empty-state">
        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 5C5 3.89543 5.89543 3 7 3H17C18.1046 3 19 3.89543 19 5V21L12 17.5L5 21V5Z"/>
        </svg>
        <p>{{ 'blogs.bookmarks.empty' | t | default: 'No saved articles yet.' }}</p>
        <a href="/blogs" class="button button--secondary">
          {{ 'blogs.bookmarks.browse' | t | default: 'Browse Articles' }}
        </a>
      </div>
    </template>

    {%- comment -%} Article card template (hidden, used by JS) {%- endcomment -%}
    <template id="bookmark-card-template">
      <article class="bookmark-card">
        <a href="" class="bookmark-card__image-link">
          <div class="bookmark-card__image media media--portrait">
            <img src="" alt="" loading="lazy" class="motion-reduce">
          </div>
        </a>
        <div class="bookmark-card__content">
          <h3 class="bookmark-card__title h4">
            <a href=""></a>
          </h3>
          <div class="bookmark-card__meta"></div>
          <button type="button" class="bookmark-card__remove link" aria-label="{{ 'blogs.bookmarks.remove' | t | default: 'Remove' }}">
            {{ 'blogs.bookmarks.remove' | t | default: 'Remove' }}
          </button>
        </div>
      </article>
    </template>
  </div>
</div>

{% stylesheet %}
  .bookmarks-section {
    padding: 40px 0 80px;
  }

  .bookmarks-title {
    text-align: center;
    margin-bottom: 40px;
  }

  .bookmarks-login-prompt {
    text-align: center;
    padding: 24px;
    margin-bottom: 32px;
    background: rgb(var(--color-foreground-rgb) / 0.03);
    border-radius: 8px;
  }

  .bookmarks-login-prompt p {
    margin-bottom: 16px;
  }

  .bookmarks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }

  .bookmarks-loading {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    padding: 60px 20px;
  }

  .bookmarks-loading .spinner {
    width: 32px;
    height: 32px;
    color: rgb(var(--color-foreground-rgb) / 0.4);
  }

  .bookmark-card {
    border-radius: 8px;
    overflow: hidden;
    background: rgb(var(--color-background-rgb));
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
    transition: box-shadow 0.2s ease;
  }

  .bookmark-card:hover {
    box-shadow: 0 4px 12px rgb(var(--color-foreground-rgb) / 0.1);
  }

  .bookmark-card__image-link {
    display: block;
  }

  .bookmark-card__image {
    aspect-ratio: 3/2;
  }

  .bookmark-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bookmark-card__content {
    padding: 16px;
  }

  .bookmark-card__title {
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .bookmark-card__title a {
    text-decoration: none;
    color: inherit;
  }

  .bookmark-card__title a:hover {
    text-decoration: underline;
  }

  .bookmark-card__meta {
    font-size: 0.875rem;
    color: rgb(var(--color-foreground-rgb) / 0.6);
    margin-bottom: 12px;
  }

  .bookmark-card__remove {
    font-size: 0.875rem;
    color: rgb(var(--color-foreground-rgb) / 0.6);
    text-decoration: underline;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
  }

  .bookmark-card__remove:hover {
    color: var(--color-foreground);
  }

  .bookmarks-empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 60px 20px;
  }

  .bookmarks-empty-state svg {
    margin-bottom: 20px;
    color: rgb(var(--color-foreground-rgb) / 0.3);
  }

  .bookmarks-empty-state p {
    margin-bottom: 20px;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  @media screen and (max-width: 749px) {
    .bookmarks-grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function() {
    const STORAGE_KEY = 'saved_articles';
    const grid = document.querySelector('.js-bookmarks-grid');
    if (!grid) return;

    const emptyTemplate = document.getElementById('bookmarks-empty-template');
    const cardTemplate = document.getElementById('bookmark-card-template');

    function getBookmarks() {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
      } catch {
        return [];
      }
    }

    function saveBookmarks(bookmarks) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
    }

    function removeBookmark(articleHandle) {
      let bookmarks = getBookmarks();
      bookmarks = bookmarks.filter(b => (typeof b === 'string' ? b : b.handle) !== articleHandle);
      saveBookmarks(bookmarks);

      // Dispatch event for other components
      window.dispatchEvent(new CustomEvent('bookmarks:updated', {
        detail: { bookmarks, articleHandle, action: 'removed' }
      }));

      renderBookmarks();
    }

    async function fetchArticleData(handle, blogHandle) {
      // If we have a blog handle, try that first
      if (blogHandle) {
        try {
          const response = await fetch(`/blogs/${blogHandle}/${handle}.json`);
          if (response.ok) {
            const data = await response.json();
            return {
              ...data.article,
              handle: handle,
              blogHandle: blogHandle,
              url: `/blogs/${blogHandle}/${handle}`
            };
          }
        } catch (e) {
          // Fall through to search
        }
      }

      // Get blog handles from data attribute, fallback to common names
      const blogHandlesAttr = grid.getAttribute('data-blog-handles');
      const blogs = blogHandlesAttr
        ? blogHandlesAttr.split(',').map(b => b.trim()).filter(Boolean)
        : ['editorial', 'news', 'journal', 'blog', 'articles'];

      for (const blog of blogs) {
        if (blog === blogHandle) continue; // Already tried this one
        try {
          const response = await fetch(`/blogs/${blog}/${handle}.json`);
          if (response.ok) {
            const data = await response.json();
            return {
              ...data.article,
              handle: handle,
              blogHandle: blog,
              url: `/blogs/${blog}/${handle}`
            };
          }
        } catch (e) {
          // Continue to next blog
        }
      }

      // If not found, return null
      return null;
    }

    function createArticleCard(article) {
      const clone = cardTemplate.content.cloneNode(true);
      const card = clone.querySelector('.bookmark-card');

      // Set article URL
      const url = article.url || `#`;
      card.querySelectorAll('a').forEach(link => {
        link.href = url;
      });

      // Set title
      const titleLink = card.querySelector('.bookmark-card__title a');
      titleLink.textContent = article.title || article.handle;

      // Set image
      const img = card.querySelector('.bookmark-card__image img');
      if (article.image) {
        const imgSrc = typeof article.image === 'string'
          ? article.image
          : article.image.src;
        img.src = imgSrc;
        img.alt = article.title || '';
      } else {
        // Hide image container if no image
        card.querySelector('.bookmark-card__image-link').style.display = 'none';
      }

      // Set meta (date if available)
      const meta = card.querySelector('.bookmark-card__meta');
      if (article.published_at || article.savedAt) {
        const dateStr = article.published_at || article.savedAt;
        const date = new Date(dateStr);
        meta.textContent = date.toLocaleDateString(undefined, {
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        });
      }

      // Set up remove button
      const removeBtn = card.querySelector('.bookmark-card__remove');
      removeBtn.addEventListener('click', () => removeBookmark(article.handle));

      return card;
    }

    async function renderBookmarks() {
      const bookmarks = getBookmarks();

      if (bookmarks.length === 0) {
        grid.innerHTML = '';
        grid.appendChild(emptyTemplate.content.cloneNode(true));
        return;
      }

      // Show loading state
      grid.innerHTML = '<div class="bookmarks-loading"><span class="visually-hidden">Loading...</span></div>';

      // Process bookmarks - use stored data when available, fetch for legacy items
      const articles = await Promise.all(
        bookmarks.map(async (bookmark) => {
          // Handle legacy format (just a string handle)
          if (typeof bookmark === 'string') {
            return await fetchArticleData(bookmark, null);
          }

          // New format - use stored data if complete, otherwise fetch
          if (bookmark.title && bookmark.blogHandle) {
            return {
              handle: bookmark.handle,
              title: bookmark.title,
              image: bookmark.image,
              blogHandle: bookmark.blogHandle,
              url: `/blogs/${bookmark.blogHandle}/${bookmark.handle}`,
              savedAt: bookmark.savedAt
            };
          }

          // Incomplete data, fetch from API
          return await fetchArticleData(bookmark.handle, bookmark.blogHandle);
        })
      );

      // Filter out articles that couldn't be found
      const validArticles = articles.filter(a => a && a.url);

      // Only update storage if we successfully found some articles
      // Don't clear bookmarks just because fetch failed
      const hasLegacyBookmarks = bookmarks.some(b => typeof b === 'string');
      const hasIncompleteBookmarks = bookmarks.some(b => typeof b === 'object' && (!b.title || !b.blogHandle));

      if (validArticles.length > 0 && (hasLegacyBookmarks || hasIncompleteBookmarks)) {
        // Migrate legacy bookmarks to new format
        const updatedBookmarks = validArticles.map(a => ({
          handle: a.handle,
          blogHandle: a.blogHandle,
          title: a.title,
          image: a.image,
          savedAt: a.savedAt || new Date().toISOString()
        }));
        saveBookmarks(updatedBookmarks);
      }

      // Render cards
      grid.innerHTML = '';

      if (validArticles.length === 0) {
        grid.appendChild(emptyTemplate.content.cloneNode(true));
        return;
      }

      validArticles.forEach(article => {
        const card = createArticleCard(article);
        grid.appendChild(card);
      });
    }

    // Fetch bookmarks from customer metafield and merge with localStorage
    async function syncFromMetafield() {
      const storefrontToken = grid.getAttribute('data-storefront-token');
      const customerId = grid.getAttribute('data-customer-id');

      if (!storefrontToken || !customerId) return false;

      const query = `
        query getCustomerMetafield($customerId: ID!) {
          customer(id: $customerId) {
            metafield(namespace: "custom", key: "saved_articles") {
              value
            }
          }
        }
      `;

      try {
        const response = await fetch('/api/2024-01/graphql.json', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Shopify-Storefront-Access-Token': storefrontToken
          },
          body: JSON.stringify({
            query,
            variables: {
              customerId: `gid://shopify/Customer/${customerId}`
            }
          })
        });

        if (!response.ok) return false;

        const data = await response.json();
        const metafieldValue = data?.data?.customer?.metafield?.value;

        if (metafieldValue) {
          const metafieldHandles = JSON.parse(metafieldValue);
          const localBookmarks = getBookmarks();

          // Merge: add any metafield bookmarks not in localStorage
          const localHandles = new Set(localBookmarks.map(b => typeof b === 'string' ? b : b.handle));
          let hasNew = false;

          metafieldHandles.forEach(handle => {
            if (!localHandles.has(handle)) {
              localBookmarks.push({
                handle,
                blogHandle: null,
                title: null,
                image: null,
                savedAt: new Date().toISOString()
              });
              hasNew = true;
            }
          });

          if (hasNew) {
            saveBookmarks(localBookmarks);
          }
          return true;
        }
      } catch (error) {
        console.error('Bookmark fetch from metafield failed:', error);
      }
      return false;
    }

    // Initial render - sync from metafield first, then render
    async function init() {
      await syncFromMetafield();
      renderBookmarks();
    }
    init();

    // Listen for bookmark updates from other pages/tabs
    window.addEventListener('bookmarks:updated', renderBookmarks);
    window.addEventListener('storage', (e) => {
      if (e.key === STORAGE_KEY) {
        renderBookmarks();
      }
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Bookmarks List",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "My Saved Articles"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Bookmarks List",
      "category": "Blog"
    }
  ]
}
{% endschema %}
