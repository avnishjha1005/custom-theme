{%- comment -%}
  Bookmarks List Section
  Displays saved article bookmarks from localStorage
  Create a page with template "bookmarks" to use this section
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="section color-{{ section.settings.color_scheme }} bookmarks-section"
  style="
    padding-top: {{ section.settings.padding_top | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  "
>
  <div class="page-width">
    <h1 class="bookmarks-title h2">{{ section.settings.title | default: 'My Saved Articles' }}</h1>

    {%- comment -%} Login prompt for non-logged-in users {%- endcomment -%}
    {%- unless customer -%}
      <div class="bookmarks-login-prompt">
        <p>{{ 'blogs.bookmarks.login_message' | t | default: 'Sign in to save articles across your devices' }}</p>
        <a href="{{ routes.account_login_url }}" class="button">
          {{ 'actions.log_in' | t | default: 'Sign in' }}
        </a>
      </div>
    {%- endunless -%}

    {%- comment -%} Bookmarks container - rendered via JavaScript {%- endcomment -%}
    {%- capture blog_handles -%}
      {%- for blog in blogs -%}
        {{ blog.handle }}{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    {%- endcapture -%}
    <div
      class="bookmarks-container js-bookmarks-grid"
      data-blog-handles="{{ blog_handles | strip }}"
      {% if settings.storefront_api_token != blank %}data-storefront-token="{{ settings.storefront_api_token }}"{% endif %}
      {% if customer %}data-customer-id="{{ customer.id }}"{% endif %}
    >
      <div class="bookmarks-loading">
        <span class="visually-hidden">Loading saved articles...</span>
        <svg class="spinner" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="31.4 31.4" stroke-linecap="round">
            <animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="1s" repeatCount="indefinite"/>
          </circle>
        </svg>
      </div>
    </div>

    {%- comment -%} Empty state template (hidden, used by JS) {%- endcomment -%}
    <template id="bookmarks-empty-template">
      <div class="bookmarks-empty-state">
        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 5C5 3.89543 5.89543 3 7 3H17C18.1046 3 19 3.89543 19 5V21L12 17.5L5 21V5Z"/>
        </svg>
        <p>{{ 'blogs.bookmarks.empty' | t | default: 'No saved articles yet.' }}</p>
        <a href="/blogs" class="button button--secondary">
          {{ 'blogs.bookmarks.browse' | t | default: 'Browse Articles' }}
        </a>
      </div>
    </template>

    {%- comment -%} Article card template (hidden, used by JS) - matches main-blog-listings.liquid styling {%- endcomment -%}
    <template id="bookmark-card-template">
      <div class="bookmark-item">
        <article class="bookmark-card">
          <div class="bookmark-card__image">
            <a href="">
              <img src="" alt="" loading="lazy" width="251" height="360">
            </a>
          </div>
          <div class="bookmark-card__content">
            <span class="bookmark-card__tag"></span>
            <h3 class="bookmark-card__title">
              <a href=""></a>
            </h3>
            <p class="bookmark-card__excerpt"></p>
            <div class="bookmark-card__actions">
              <a href="" class="bookmark-card__read-link">READ</a>
              <button type="button" class="bookmark-card__remove" aria-label="{{ 'blogs.bookmarks.remove' | t | default: 'Remove' }}">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="none">
                  <path d="M5 5C5 3.89543 5.89543 3 7 3H17C18.1046 3 19 3.89543 19 5V21L12 17.5L5 21V5Z"/>
                </svg>
              </button>
            </div>
          </div>
        </article>
      </div>
    </template>
  </div>
</div>

{% stylesheet %}
  .bookmarks-section {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
  }

  .bookmarks-title {
    text-align: center;
    margin-bottom: 40px;
  }

  .bookmarks-login-prompt {
    text-align: center;
    padding: 24px;
    margin-bottom: 32px;
    background: rgb(var(--color-foreground-rgb) / 0.03);
    border-radius: 8px;
  }

  .bookmarks-login-prompt p {
    margin-bottom: 16px;
  }

  .bookmarks-container {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .bookmarks-loading {
    display: flex;
    justify-content: center;
    padding: 60px 20px;
  }

  .bookmarks-loading .spinner {
    width: 32px;
    height: 32px;
    color: rgb(var(--color-foreground-rgb) / 0.4);
  }

  .bookmark-item {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
  }

  .bookmark-card {
    display: flex;
    flex-direction: row;
    gap: 24px;
    align-items: flex-start;
    justify-content: center;
  }

  .bookmark-card__image {
    flex-shrink: 0;
    width: 251px;
    height: 360px;
    overflow: hidden;
  }

  .bookmark-card__image a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .bookmark-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bookmark-card__content {
    gap: 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
    text-align: left;
    max-width: 251px !important;
  }

  .bookmark-card__tag {
    font-size: 0.75rem;
    line-height: 0.875;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb));
  }

  .bookmark-card__title {
    font-family: var(--font-heading--family);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.2;
    margin: 0;
  }

  .bookmark-card__title a {
    text-decoration: none;
    color: var(--color-foreground-heading);
  }

  .bookmark-card__title a:hover {
    opacity: 0.7;
  }

  .bookmark-card__excerpt {
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgb(var(--color-foreground-rgb) / 0.8);
    margin: 0;
  }

  .bookmark-card__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    font-weight: 600;
  }

  .bookmark-card__read-link {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-decoration: underline;
    text-underline-offset: 4px;
    color: var(--color-foreground-heading);
  }

  .bookmark-card__read-link:hover {
    opacity: 0.7;
  }

  .bookmark-card__remove {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--color-foreground-heading);
    transition: opacity 0.2s ease;
  }

  .bookmark-card__remove:hover {
    opacity: 0.7;
  }

  .bookmarks-empty-state {
    text-align: center;
    padding: 60px 20px;
    max-width: 640px;
    margin: 0 auto;
  }

  .bookmarks-empty-state svg {
    margin-bottom: 20px;
    color: rgb(var(--color-foreground-rgb) / 0.3);
  }

  .bookmarks-empty-state p {
    margin-bottom: 20px;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  /* Mobile Styles - maintain side-by-side layout */
  @media screen and (max-width: 749px) {
    .bookmarks-container {
      gap: 32px;
    }

    .bookmark-item {
      width: 100%;
    }

    .bookmark-card {
      flex-direction: row;
      gap: 16px;
    }

    .bookmark-card__image {
      width: 140px;
      height: 200px;
      flex-shrink: 0;
    }

    .bookmark-card__content {
      padding-top: 0;
      gap: 24px;
      max-width: none !important;
      flex: 1;
    }

    .bookmark-card__title {
      font-size: 1.125rem;
    }

    .bookmark-card__tag {
      font-size: 0.625rem;
    }

    .bookmark-card__excerpt {
      font-size: 0.8rem;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .bookmark-card__read-link {
      font-size: 0.75rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function() {
    const STORAGE_KEY = 'saved_articles';
    const container = document.querySelector('.js-bookmarks-grid');
    if (!container) return;

    const emptyTemplate = document.getElementById('bookmarks-empty-template');
    const cardTemplate = document.getElementById('bookmark-card-template');

    function getBookmarks() {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
      } catch {
        return [];
      }
    }

    function saveBookmarks(bookmarks) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
    }

    // Extract just the article slug from a handle (fixes URL duplication bug)
    function getArticleSlug(handle) {
      if (!handle) return '';
      // If handle contains slashes, get the last part (the actual article slug)
      return handle.split('/').pop();
    }

    function removeBookmark(articleHandle) {
      const slug = getArticleSlug(articleHandle);
      let bookmarks = getBookmarks();
      bookmarks = bookmarks.filter(b => {
        const bHandle = typeof b === 'string' ? b : b.handle;
        return getArticleSlug(bHandle) !== slug;
      });
      saveBookmarks(bookmarks);

      // Dispatch event for other components
      window.dispatchEvent(new CustomEvent('bookmarks:updated', {
        detail: { bookmarks, articleHandle: slug, action: 'removed' }
      }));

      renderBookmarks();
    }

    async function fetchArticleData(handle, blogHandle) {
      const slug = getArticleSlug(handle);

      // If we have a blog handle, try that first
      if (blogHandle) {
        try {
          const response = await fetch(`/blogs/${blogHandle}/${slug}.json`);
          if (response.ok) {
            const data = await response.json();
            return {
              ...data.article,
              handle: slug,
              blogHandle: blogHandle,
              url: `/blogs/${blogHandle}/${slug}`
            };
          }
        } catch (e) {
          // Fall through to search
        }
      }

      // Get blog handles from data attribute, fallback to common names
      const blogHandlesAttr = container.getAttribute('data-blog-handles');
      const blogs = blogHandlesAttr
        ? blogHandlesAttr.split(',').map(b => b.trim()).filter(Boolean)
        : ['editorial', 'news', 'journal', 'blog', 'articles'];

      for (const blog of blogs) {
        if (blog === blogHandle) continue; // Already tried this one
        try {
          const response = await fetch(`/blogs/${blog}/${slug}.json`);
          if (response.ok) {
            const data = await response.json();
            return {
              ...data.article,
              handle: slug,
              blogHandle: blog,
              url: `/blogs/${blog}/${slug}`
            };
          }
        } catch (e) {
          // Continue to next blog
        }
      }

      // If not found, return null
      return null;
    }

    function truncateText(text, wordLimit) {
      if (!text) return '';
      const words = text.split(/\s+/);
      if (words.length <= wordLimit) return text;
      return words.slice(0, wordLimit).join(' ') + '...';
    }

    function stripHtml(html) {
      const tmp = document.createElement('div');
      tmp.innerHTML = html;
      return tmp.textContent || tmp.innerText || '';
    }

    function createArticleCard(article) {
      const clone = cardTemplate.content.cloneNode(true);
      const item = clone.querySelector('.bookmark-item');
      const card = clone.querySelector('.bookmark-card');

      // Build clean URL using slug
      const slug = getArticleSlug(article.handle);
      const url = `/blogs/${article.blogHandle}/${slug}`;

      // Set article URLs on all links
      card.querySelectorAll('a').forEach(link => {
        link.href = url;
      });

      // Set title
      const titleLink = card.querySelector('.bookmark-card__title a');
      titleLink.textContent = article.title || slug;

      // Set tag (first tag if available)
      const tagEl = card.querySelector('.bookmark-card__tag');
      if (article.tags && article.tags.length > 0) {
        const firstTag = Array.isArray(article.tags) ? article.tags[0] : article.tags.split(',')[0];
        tagEl.textContent = firstTag.trim();
      } else {
        tagEl.style.display = 'none';
      }

      // Set excerpt
      const excerptEl = card.querySelector('.bookmark-card__excerpt');
      if (article.summary_html || article.body_html || article.excerpt) {
        const rawText = stripHtml(article.summary_html || article.excerpt || article.body_html || '');
        excerptEl.textContent = truncateText(rawText, 20);
      } else {
        excerptEl.style.display = 'none';
      }

      // Set image
      const imgContainer = card.querySelector('.bookmark-card__image');
      const img = card.querySelector('.bookmark-card__image img');
      if (article.image) {
        const imgSrc = typeof article.image === 'string'
          ? article.image
          : article.image.src;
        // Add width parameter for optimization
        img.src = imgSrc.includes('?') ? imgSrc + '&width=600' : imgSrc + '?width=600';
        img.alt = article.title || '';
        img.width = 251;
        img.height = 360;
      } else {
        // Hide image container if no image
        imgContainer.style.display = 'none';
      }

      // Set up remove button
      const removeBtn = card.querySelector('.bookmark-card__remove');
      removeBtn.addEventListener('click', (e) => {
        e.preventDefault();
        removeBookmark(article.handle);
      });

      return item;
    }

    async function renderBookmarks() {
      const bookmarks = getBookmarks();

      if (bookmarks.length === 0) {
        container.innerHTML = '';
        container.appendChild(emptyTemplate.content.cloneNode(true));
        return;
      }

      // Show loading state
      container.innerHTML = '<div class="bookmarks-loading"><span class="visually-hidden">Loading...</span></div>';

      // Process bookmarks - use stored data when available, fetch for legacy items
      const articles = await Promise.all(
        bookmarks.map(async (bookmark) => {
          // Handle legacy format (just a string handle)
          if (typeof bookmark === 'string') {
            return await fetchArticleData(bookmark, null);
          }

          // Always fetch to get full article data (tags, excerpt, etc.)
          const fetched = await fetchArticleData(bookmark.handle, bookmark.blogHandle);
          if (fetched) {
            return fetched;
          }

          // Fallback to stored data if fetch fails
          if (bookmark.title && bookmark.blogHandle) {
            const slug = getArticleSlug(bookmark.handle);
            return {
              handle: slug,
              title: bookmark.title,
              image: bookmark.image,
              blogHandle: bookmark.blogHandle,
              url: `/blogs/${bookmark.blogHandle}/${slug}`,
              savedAt: bookmark.savedAt
            };
          }

          return null;
        })
      );

      // Filter out articles that couldn't be found
      const validArticles = articles.filter(a => a && a.url);

      // Only update storage if we successfully found some articles
      const hasLegacyBookmarks = bookmarks.some(b => typeof b === 'string');
      const hasIncompleteBookmarks = bookmarks.some(b => typeof b === 'object' && (!b.title || !b.blogHandle));

      if (validArticles.length > 0 && (hasLegacyBookmarks || hasIncompleteBookmarks)) {
        // Migrate legacy bookmarks to new format with clean slugs
        const updatedBookmarks = validArticles.map(a => ({
          handle: getArticleSlug(a.handle),
          blogHandle: a.blogHandle,
          title: a.title,
          image: a.image,
          savedAt: a.savedAt || new Date().toISOString()
        }));
        saveBookmarks(updatedBookmarks);
      }

      // Render cards
      container.innerHTML = '';

      if (validArticles.length === 0) {
        container.appendChild(emptyTemplate.content.cloneNode(true));
        return;
      }

      validArticles.forEach(article => {
        const card = createArticleCard(article);
        container.appendChild(card);
      });
    }

    // Fetch bookmarks from customer metafield and merge with localStorage
    async function syncFromMetafield() {
      const storefrontToken = container.getAttribute('data-storefront-token');
      const customerId = container.getAttribute('data-customer-id');

      if (!storefrontToken || !customerId) return false;

      const query = `
        query getCustomerMetafield($customerId: ID!) {
          customer(id: $customerId) {
            metafield(namespace: "custom", key: "saved_articles") {
              value
            }
          }
        }
      `;

      try {
        const response = await fetch('/api/2024-01/graphql.json', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Shopify-Storefront-Access-Token': storefrontToken
          },
          body: JSON.stringify({
            query,
            variables: {
              customerId: `gid://shopify/Customer/${customerId}`
            }
          })
        });

        if (!response.ok) return false;

        const data = await response.json();
        const metafieldValue = data?.data?.customer?.metafield?.value;

        if (metafieldValue) {
          const metafieldHandles = JSON.parse(metafieldValue);
          const localBookmarks = getBookmarks();

          // Merge: add any metafield bookmarks not in localStorage
          const localHandles = new Set(localBookmarks.map(b => {
            const h = typeof b === 'string' ? b : b.handle;
            return getArticleSlug(h);
          }));
          let hasNew = false;

          metafieldHandles.forEach(handle => {
            const slug = getArticleSlug(handle);
            if (!localHandles.has(slug)) {
              localBookmarks.push({
                handle: slug,
                blogHandle: null,
                title: null,
                image: null,
                savedAt: new Date().toISOString()
              });
              hasNew = true;
            }
          });

          if (hasNew) {
            saveBookmarks(localBookmarks);
          }
          return true;
        }
      } catch (error) {
        console.error('Bookmark fetch from metafield failed:', error);
      }
      return false;
    }

    // Initial render - sync from metafield first, then render
    async function init() {
      await syncFromMetafield();
      renderBookmarks();
    }
    init();

    // Listen for bookmark updates from other pages/tabs
    window.addEventListener('bookmarks:updated', renderBookmarks);
    window.addEventListener('storage', (e) => {
      if (e.key === STORAGE_KEY) {
        renderBookmarks();
      }
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Bookmarks List",
  "tag": "section",
  "class": "bookmarks-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "My Saved Articles"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Bookmarks List",
      "category": "Blog"
    }
  ]
}
{% endschema %}
