{%- comment -%}
  Blog Rich Text Section
  Displays centered rich text content between blog sections
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="section color-{{ section.settings.color_scheme }} blog-rich-text-section"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="blog-rich-text-content">
    {{ section.settings.content }}
  </div>
</div>

{% stylesheet %}
  .blog-rich-text-section {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
  }

  .blog-rich-text-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    font-family: var(--font-body-family);
    font-size: 1rem;
    line-height: 1.6;
    color: rgb(var(--color-foreground-rgb));
  }

  .blog-rich-text-content h2,
  .blog-rich-text-content h3 {
    font-family: var(--font-heading-family, 'Marcellus', serif);
    font-weight: 400;
    margin-bottom: 1rem;
  }

  .blog-rich-text-content h2 {
    font-size: 1.75rem;
  }

  .blog-rich-text-content h3 {
    font-size: 1.25rem;
  }

  .blog-rich-text-content p {
    margin-bottom: 1rem;
  }

  .blog-rich-text-content p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .blog-rich-text-content h2 {
      font-size: 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog Rich Text",
  "tag": "section",
  "class": "blog-rich-text-section-wrapper",
  "settings": [
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Add your text content here.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Blog Rich Text"
    }
  ]
}
{% endschema %}
