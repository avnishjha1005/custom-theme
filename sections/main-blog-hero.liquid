{%- comment -%}
  Blog Hero Section
  Displays first 3 articles as hero cards
  Desktop: 3-column grid
  Mobile: Horizontal swipeable slideshow
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="section color-{{ section.settings.color_scheme }} blog-hero-section"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  {%- comment -%} Desktop Hero Grid - 3 columns {%- endcomment -%}
  <div class="blog-hero-desktop">
    <div class="blog-hero-grid">
      {% for article in blog.articles limit: 3 %}
        {%- liquid
          assign slideshow_images = article.metafields.custom.slideshow_images.value | default: empty
        -%}
        <div class="blog-hero-item">
          {% content_for 'block', id: 'static-hero-card', type: '_blog-post-card-hero', article: article, slideshow_images: slideshow_images %}
        </div>
      {% endfor %}
    </div>
  </div>

  {%- comment -%} Mobile Hero Slideshow {%- endcomment -%}
  <div class="blog-hero-mobile">
    {% capture hero_slides %}
      {% for article in blog.articles limit: 3 %}
        {%- liquid
          assign slideshow_images = article.metafields.custom.slideshow_images.value | default: empty
        -%}
        {% capture slide_content %}
          <div class="blog-hero-slide-item">
            {% content_for 'block', id: 'static-hero-card-mobile', type: '_blog-post-card-hero', article: article, slideshow_images: slideshow_images %}
          </div>
        {% endcapture %}
        {% render 'slideshow-slide', index: forloop.index, children: slide_content, slide_id: article.id %}
      {% endfor %}
    {% endcapture %}

    {% capture hero_controls %}
      {% render 'slideshow-controls',
        style: 'dots',
        autoplay: false,
        item_count: 3,
        show_arrows: false
      %}
    {% endcapture %}

    {% render 'slideshow',
      ref: 'blogHeroSlideshow',
      class: 'blog-hero-slideshow',
      slides: hero_slides,
      controls: hero_controls,
      show_arrows: false,
      autoplay: false,
      slide_count: 3,
      infinite: true
    %}
  </div>
</div>

{% stylesheet %}
  .blog-hero-section {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
  }

  /* Desktop Hero Grid - 3 columns */
  .blog-hero-desktop {
    display: block;
  }

  .blog-hero-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .blog-hero-item {
    --blog-post-card-scale: 0.7;
  }

  /* Mobile Hero Slideshow */
  .blog-hero-mobile {
    display: none;
  }

  .blog-hero-slideshow {
    --slide-width: 85%;
  }

  .blog-hero-slideshow slideshow-slides {
    gap: 1rem;
    padding: 0 0.5rem;
  }

  .blog-hero-slide-item {
    --blog-post-card-scale: 0.5;
    width: 100%;
  }

  .blog-hero-slideshow slideshow-controls {
    margin-top: 1rem;
  }

  .blog-hero-slideshow .slideshow-controls__dots {
    justify-content: center;
    gap: 0.5rem;
  }

  .blog-hero-slideshow .slideshow-control {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: rgba(0, 0, 0, 0.2);
    transition: background-color 0.2s ease;
  }

  .blog-hero-slideshow .slideshow-control[aria-selected="true"] {
    background-color: rgba(0, 0, 0, 0.8);
  }

  @media screen and (max-width: 749px) {
    .blog-hero-desktop {
      display: none;
    }

    .blog-hero-mobile {
      display: block;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog Hero",
  "tag": "section",
  "class": "blog-hero-section-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ]
}
{% endschema %}
