{%- comment -%}
  Blog Hero Section
  Displays first 3 articles as hero cards
  Desktop: 3-column grid
  Mobile: Horizontal swipeable slideshow
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="section color-{{ section.settings.color_scheme }} blog-hero-section"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  {%- comment -%} Desktop Hero Grid - 3 columns {%- endcomment -%}
  <div class="blog-hero-desktop">
    <div class="blog-hero-grid">
      {% for article in blog.articles limit: 3 %}
        {%- liquid
          assign slideshow_images = article.metafields.custom.slideshow_images.value | default: empty
        -%}
        <div class="blog-hero-item">
          {% content_for 'block', id: 'static-hero-card', type: '_blog-post-card-hero', article: article, slideshow_images: slideshow_images %}
        </div>
      {% endfor %}
    </div>
  </div>

  {%- comment -%} Mobile Hero Slideshow {%- endcomment -%}
  <div class="blog-hero-mobile">
    {% capture hero_slides %}
      {% for article in blog.articles limit: 3 %}
        {%- liquid
          assign slideshow_images = article.metafields.custom.slideshow_images.value | default: empty
        -%}
        {% capture slide_content %}
          <div class="blog-hero-slide-item">
            {% content_for 'block', id: 'static-hero-card-mobile', type: '_blog-post-card-hero', article: article, slideshow_images: slideshow_images %}
          </div>
        {% endcapture %}
        {% render 'slideshow-slide', index: forloop.index, children: slide_content, slide_id: article.id %}
      {% endfor %}
    {% endcapture %}

    <div class="blog-hero-slideshow-wrapper">
      {% render 'slideshow',
        ref: 'blogHeroSlideshow',
        class: 'blog-hero-slideshow',
        slides: hero_slides,
        show_arrows: false,
        autoplay: false,
        slide_count: 3,
        infinite: true
      %}

      {%- comment -%} Custom indicators for mobile slideshow {%- endcomment -%}
      <div class="blog-hero-indicators">
        <button type="button" class="blog-hero-indicator active" data-slide="0" aria-label="Go to slide 1" onclick="document.querySelector('[ref=blogHeroSlideshow]').select(0, event)"></button>
        <button type="button" class="blog-hero-indicator" data-slide="1" aria-label="Go to slide 2" onclick="document.querySelector('[ref=blogHeroSlideshow]').select(1, event)"></button>
        <button type="button" class="blog-hero-indicator" data-slide="2" aria-label="Go to slide 3" onclick="document.querySelector('[ref=blogHeroSlideshow]').select(2, event)"></button>
      </div>
    </div>

    <script>
      (function() {
        function initBlogHeroIndicators() {
          const slideshow = document.querySelector('[ref="blogHeroSlideshow"]');
          const indicators = document.querySelectorAll('.blog-hero-indicator');

          if (!slideshow || !indicators.length) {
            // Retry if not ready
            setTimeout(initBlogHeroIndicators, 100);
            return;
          }

          const scroller = slideshow.querySelector('slideshow-slides');
          if (!scroller) {
            setTimeout(initBlogHeroIndicators, 100);
            return;
          }

          function updateIndicators() {
            const slides = scroller.querySelectorAll('slideshow-slide');
            if (!slides.length) return;

            const scrollLeft = scroller.scrollLeft;
            const slideWidth = slides[0].offsetWidth + parseFloat(getComputedStyle(scroller).gap || 0);
            const currentIndex = Math.round(scrollLeft / slideWidth);

            indicators.forEach((ind, i) => {
              ind.classList.toggle('active', i === currentIndex);
            });
          }

          // Listen for scroll with debounce
          let scrollTimeout;
          scroller.addEventListener('scroll', () => {
            clearTimeout(scrollTimeout);
            scrollTimeout = setTimeout(updateIndicators, 50);
          }, { passive: true });

          // Also update on scrollend if supported
          scroller.addEventListener('scrollend', updateIndicators, { passive: true });

          // Initial update
          updateIndicators();
        }

        // Start initialization
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initBlogHeroIndicators);
        } else {
          initBlogHeroIndicators();
        }
      })();
    </script>
  </div>
</div>

{% stylesheet %}
  .blog-hero-section {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
  }

  /* Desktop Hero Grid - 3 columns */
  .blog-hero-desktop {
    display: block;
  }

  .blog-hero-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .blog-hero-item {
    --blog-post-card-scale: 0.7;
  }

  /* Mobile Hero Slideshow */
  .blog-hero-mobile {
    display: none;
  }

  .blog-hero-slideshow {
    --slide-width: 100%;
  }

  .blog-hero-slideshow slideshow-slides {
    gap: 1rem;
    padding: 0 0.5rem;
  }

  .blog-hero-slide-item {
    --blog-post-card-scale: 0.5;
    width: 100%;
    position: relative;
  }

  .blog-hero-slideshow slideshow-slide {
    position: relative;
  }

  @media screen and (max-width: 749px) {
    .blog-hero-desktop {
      display: none;
    }

    .blog-hero-mobile {
      display: block;
    }
  }

  /* Mobile slideshow wrapper and indicators */
  .blog-hero-slideshow-wrapper {
    position: relative;
  }

  .blog-hero-indicators {
    position: absolute;
    bottom: 1rem;
    left: calc(1.5% + 1.5rem);
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .blog-hero-indicator {
    --size: 8px;
    width: var(--size);
    height: var(--size);
    min-width: var(--size);
    min-height: var(--size);
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.5);
    padding: 0;
    border: none;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .blog-hero-indicator.active {
    background-color: #fff;
  }

  /* Hide indicators on desktop */
  @media screen and (min-width: 750px) {
    .blog-hero-indicators {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog Hero",
  "tag": "section",
  "class": "blog-hero-section-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ]
}
{% endschema %}
