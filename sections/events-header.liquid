{% comment %}
  Events Header Section
  Displays page title with navigation tabs and integrated search
{% endcomment %}

{% liquid
  assign section_id = section.id | replace: '_', '' | downcase

  # Get current blog
  if blog
    assign current_blog = blog
  else
    assign current_blog = blogs['events']
  endif

  # System tags to exclude from location tabs
  assign system_tags = 'past-events,upcoming' | split: ','

  # Extract unique location tags from articles (excluding system tags)
  assign location_tags = ''
  if current_blog
    for article in current_blog.articles limit: 50
      for tag in article.tags
        assign is_system_tag = false
        for sys_tag in system_tags
          if tag == sys_tag
            assign is_system_tag = true
            break
          endif
        endfor
        unless is_system_tag
          unless location_tags contains tag
            capture location_tags
              echo location_tags
              if location_tags != ''
                echo ','
              endif
              echo tag
            endcapture
          endunless
        endunless
      endfor
    endfor
  endif
  assign location_tag_array = location_tags | split: ','
%}

<div
  class="
    events-header
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    spacing-style
  "
  style="
    {%- render 'spacing-style', settings: section.settings -%}
  "
  data-section-id="{{ section_id }}"
>
  <div class="events-header__content">
    {% if section.settings.heading != blank %}
      <h1 class="events-header__title">{{ section.settings.heading }}</h1>
    {% endif %}

    <div class="events-header__nav-bar">
      {% if section.settings.show_search %}
        <button class="events-header__search-btn" aria-label="Open Search" data-search-trigger>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.35-4.35"/>
          </svg>
        </button>
      {% endif %}

      <nav class="events-header__nav" aria-label="Event filters">
        <ul class="events-header__tabs">
          {% if section.settings.show_view_all %}
            <li class="events-header__tab-item">
              <button
                type="button"
                class="events-header__tab-link events-header__tab-link--view-all is-active"
                data-tab-filter="all"
              >
                View All
              </button>
            </li>
          {% endif %}

          {% comment %} Static tabs: Past Events and Upcoming {% endcomment %}
          <li class="events-header__tab-item">
            <button
              type="button"
              class="events-header__tab-link"
              data-tab-filter="past-events"
            >
              Past Events
            </button>
          </li>
          <li class="events-header__tab-item">
            <button
              type="button"
              class="events-header__tab-link"
              data-tab-filter="upcoming"
            >
              Upcoming
            </button>
          </li>

          {% comment %} Dynamic location tabs from article tags {% endcomment %}
          {% for tag in location_tag_array %}
            {% assign tag_text = tag | strip %}
            {% if tag_text != blank %}
              {% assign tag_handle = tag_text | handleize %}
              {% comment %} Strip "Location-" prefix for display {% endcomment %}
              {% assign display_text = tag_text %}
              {% if tag_text contains 'Location-' %}
                {% assign display_text = tag_text | remove: 'Location-' %}
              {% elsif tag_text contains 'location-' %}
                {% assign display_text = tag_text | remove: 'location-' %}
              {% endif %}
              <li class="events-header__tab-item">
                <button
                  type="button"
                  class="events-header__tab-link"
                  data-tab-filter="{{ tag_handle }}"
                >
                  {{ display_text }}
                </button>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </nav>
    </div>
  </div>

  {% if section.settings.show_search %}
    {% comment %} Search Overlay {% endcomment %}
    <div class="events-search__overlay" data-search-overlay></div>

    {% comment %} Search Modal (Desktop) {% endcomment %}
    <div class="events-search__modal" data-search-modal>
      <div class="events-search__header">
        <button class="events-search__back-btn" data-search-close>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m15 18-6-6 6-6"/>
          </svg>
        </button>
        <input
          type="text"
          class="events-search__input"
          placeholder="{{ section.settings.search_placeholder }}"
          data-search-input
        >
      </div>
      <div class="events-search__results" data-search-results></div>
    </div>

    {% comment %} Search Drawer (Mobile) {% endcomment %}
    <div class="events-search__drawer" data-search-drawer>
      <div class="events-search__header">
        <button class="events-search__back-btn" data-search-close>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m15 18-6-6 6-6"/>
          </svg>
        </button>
        <input
          type="text"
          class="events-search__input"
          placeholder="{{ section.settings.search_placeholder }}"
          data-search-input
        >
      </div>
      <div class="events-search__results" data-search-results></div>
    </div>
  {% endif %}
</div>

<script>
  (function() {
    const section = document.querySelector('[data-section-id="{{ section_id }}"]');
    if (!section) return;

    const searchTrigger = section.querySelector('[data-search-trigger]');
    const overlay = section.querySelector('[data-search-overlay]');
    const modal = section.querySelector('[data-search-modal]');
    const drawer = section.querySelector('[data-search-drawer]');
    const closeButtons = section.querySelectorAll('[data-search-close]');
    const tabButtons = section.querySelectorAll('[data-tab-filter]');

    const blogHandle = '{{ current_blog.handle | default: "events" }}';
    let searchTimer;

    // System tabs that show/hide entire sections
    const systemFilters = ['all', 'past-events', 'upcoming'];

    // Tab filtering functionality
    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.tabFilter;

        // Update active state
        tabButtons.forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');

        // Get all event sections and items
        const eventSections = document.querySelectorAll('[data-events-section]');
        const eventItems = document.querySelectorAll('[data-event-tags]');

        if (systemFilters.includes(filter)) {
          // System filter: show/hide sections, show all items
          eventSections.forEach(sec => {
            const sectionId = sec.dataset.eventsSection;
            if (filter === 'all') {
              sec.style.display = '';
            } else if (sectionId === filter) {
              sec.style.display = '';
            } else {
              sec.style.display = 'none';
            }
          });

          // Show all items and hide filtered empty messages
          eventItems.forEach(item => item.classList.remove('is-hidden'));
          document.querySelectorAll('[data-filtered-empty]').forEach(el => el.style.display = 'none');
        } else {
          // Location filter: show all sections, filter items by tag
          eventSections.forEach(sec => sec.style.display = '');

          eventItems.forEach(item => {
            const tagsRaw = item.dataset.eventTags || '';
            const tags = tagsRaw.split(' ').map(t => t.trim()).filter(t => t);
            if (tags.includes(filter)) {
              item.classList.remove('is-hidden');
            } else {
              item.classList.add('is-hidden');
            }
          });

          // Show filtered empty message if all items in a section are hidden
          eventSections.forEach(sec => {
            const items = sec.querySelectorAll('[data-event-tags]');
            const filteredEmpty = sec.querySelector('[data-filtered-empty]');
            if (filteredEmpty) {
              const visibleItems = Array.from(items).filter(item => !item.classList.contains('is-hidden'));
              filteredEmpty.style.display = visibleItems.length === 0 ? '' : 'none';
            }
          });
        }
      });
    });

    // Search functionality
    if (searchTrigger) {
      function getContainer() {
        return window.innerWidth > 749 ? modal : drawer;
      }

      function toggleSearch(open) {
        if (overlay) overlay.classList.toggle('is-active', open);
        const container = getContainer();
        if (container) {
          container.classList.toggle('is-active', open);
          if (open) {
            setTimeout(() => container.querySelector('[data-search-input]').focus(), 100);
          }
        }
        document.body.style.overflow = open ? 'hidden' : '';
      }

      searchTrigger.addEventListener('click', () => toggleSearch(true));
      if (overlay) overlay.addEventListener('click', () => toggleSearch(false));
      closeButtons.forEach(btn => btn.addEventListener('click', () => toggleSearch(false)));

      section.querySelectorAll('[data-search-input]').forEach(input => {
        input.addEventListener('input', (e) => {
          clearTimeout(searchTimer);
          const query = e.target.value;
          if (query.length < 2) {
            section.querySelectorAll('[data-search-results]').forEach(r => r.innerHTML = '');
            return;
          }
          searchTimer = setTimeout(() => performSearch(query), 300);
        });
      });

      async function performSearch(query) {
        const searchUrl = `/search/suggest.json?q=${encodeURIComponent(query)}*&resources[type]=article&resources[options][fields]=title,body,tag,author`;

        try {
          const response = await fetch(searchUrl);
          const data = await response.json();
          const articles = data.resources?.results?.articles || [];
          const filtered = articles.filter(a => a.url.includes(`/blogs/${blogHandle}`));

          const resultsHtml = filtered.length === 0
            ? '<p class="events-search__no-results">No events found.</p>'
            : filtered.map(a => `
                <a href="${a.url}" class="events-search__result-item">
                  <div class="events-search__result-title">${highlight(a.title, query)}</div>
                  ${a.summary ? `<div class="events-search__result-summary">${highlight(a.summary, query)}</div>` : ''}
                </a>
              `).join('');

          section.querySelectorAll('[data-search-results]').forEach(r => r.innerHTML = resultsHtml);
        } catch (e) {
          console.error('Search error:', e);
        }
      }

      function highlight(text, query) {
        const regex = new RegExp(`(${query})`, 'gi');
        return text.replace(regex, '<mark class="events-search__highlight">$1</mark>');
      }
    }
  })();
</script>

{% stylesheet %}
  .events-header {
    display: block;
    width: 100%;
    font-family: inherit;
    overflow: hidden;
  }

  .events-header__content {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .events-header__title {
    font-size: 48px;
    color: #692c23;
    text-transform: none;
    margin: 0;
    text-align: center;
  }

  .events-header__nav-bar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    background-color: transparent;
    border: none;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    box-sizing: border-box;
    overflow: hidden;
    justify-content: center;
  }

  .events-header__search-btn {
    background: none;
    border: none;
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    min-width: 24px;
    cursor: pointer;
    color: var(--color-foreground);
    transition: color 0.2s;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .events-header__search-btn:hover {
    opacity: 0.7;
  }

  .events-header__nav {
    flex: 1;
    overflow-x: auto;
    scrollbar-width: none;
    min-width: 0;
    -webkit-overflow-scrolling: touch;
  }

  .events-header__nav::-webkit-scrollbar {
    display: none;
  }

  .events-header__tabs {
    display: flex;
    align-items: center;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
    white-space: nowrap;
  }

  .events-header__tab-item {
    flex-shrink: 0;
  }

  .events-header__tab-link {
    display: inline-block;
    background-color: transparent;
    color: var(--color-foreground);
    text-decoration: none;
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
    transition: text-decoration 0.2s;
  }

  .events-header__tab-link:hover {
    text-decoration: underline;
  }

  .events-header__tab-link.is-active {
    text-decoration: underline;
    font-weight: 700;
  }

  /* Desktop centering */
  @media screen and (min-width: 750px) {
    .events-header__nav-bar {
      justify-content: center;
    }

    .events-header__nav {
      flex: none;
    }

    .events-header__tabs {
      justify-content: center;
    }
  }

  /* Search Overlay */
  .events-search__overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: 0.3s;
  }

  .events-search__overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  /* Search Modal & Drawer shared styles */
  .events-search__modal,
  .events-search__drawer {
    position: fixed;
    background: var(--color-background);
    z-index: 9999;
    visibility: hidden;
    transition: 0.3s;
    display: flex;
    flex-direction: column;
  }

  .events-search__header {
    display: flex;
    align-items: center;
    padding: 15px;
    border-bottom: 1px solid #eee;
  }

  .events-search__back-btn {
    background: none;
    border: none;
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    min-width: 24px;
    cursor: pointer;
    color: var(--color-foreground);
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .events-search__input {
    flex: 1;
    border: none;
    padding: 10px;
    font-size: 16px;
    outline: none;
    background: transparent;
    color: var(--color-foreground);
  }

  .events-search__results {
    flex: 1;
    overflow-y: auto;
    padding: 10px;
  }

  .events-search__result-item {
    padding: 12px;
    border-bottom: 1px solid #f0f0f0;
    display: block;
    text-decoration: none;
    color: var(--color-foreground);
    transition: background 0.2s;
  }

  .events-search__result-item:hover {
    background: rgba(var(--color-foreground-rgb), 0.03);
  }

  .events-search__result-title {
    font-weight: 600;
    margin-bottom: 4px;
  }

  .events-search__result-summary {
    font-size: 12px;
    color: #666;
  }

  .events-search__highlight {
    background: rgba(255, 235, 59, 0.4);
    font-weight: bold;
  }

  .events-search__no-results {
    padding: 20px;
    text-align: center;
    opacity: 0.6;
  }

  /* Desktop Modal */
  @media screen and (min-width: 750px) {
    .events-search__modal {
      top: 20%;
      left: 50%;
      transform: translateX(-50%) translateY(-20px);
      width: 600px;
      max-height: 400px;
      border-radius: 12px;
      opacity: 0;
    }

    .events-search__modal.is-active {
      visibility: visible;
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    .events-search__drawer {
      display: none;
    }
  }

  /* Mobile Drawer */
  @media screen and (max-width: 749px) {
    .events-search__drawer {
      bottom: 0;
      left: 0;
      width: 100%;
      height: 80vh;
      transform: translateY(100%);
      border-radius: 20px 20px 0 0;
    }

    .events-search__drawer.is-active {
      visibility: visible;
      transform: translateY(0);
    }

    .events-search__modal {
      display: none;
    }

    .events-header__nav-bar {
      justify-content: center;
      padding: 16px;
      gap: 16px;
      overflow: visible;
    }

    .events-header__nav {
      flex: 1;
      overflow-x: auto;
      min-width: 0;
    }

    .events-header__tabs {
      justify-content: flex-start;
    }

    .events-header__title {
      font-size: 32px;
      padding: 0 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Events Header",
  "tag": "section",
  "class": "events-header-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Events"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' link",
      "default": true
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Enable search",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search events..."
    },
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Events Header",
      "category": "Events"
    }
  ]
}
{% endschema %}
