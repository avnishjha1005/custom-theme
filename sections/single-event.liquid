{% comment %}
  Single Event Section
  Hero layout for individual event pages matching the Figma design
{% endcomment %}

{% liquid
  assign section_id = section.id | replace: '_', '' | downcase

  # Get event metafields
  assign event_rsvp_url = article.metafields.event.registration_url | default: section.settings.default_rsvp_url

  # Get location: try metafield first, then location tag, then default
  assign event_location = article.metafields.event.location
  if event_location == blank
    for tag in article.tags
      if tag contains 'Location-' or tag contains 'location-'
        assign event_location = tag | remove: 'Location-' | remove: 'location-'
        break
      endif
    endfor
  endif
  if event_location == blank
    assign event_location = section.settings.default_location
  endif
%}

<div
  class="
    single-event
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    spacing-style
  "
  style="
    {%- render 'spacing-style', settings: section.settings -%}
  "
  data-section-id="{{ section_id }}"
>
  <div class="single-event__container">
    {% comment %} Header Section {% endcomment %}
    <div class="single-event__header">
      {% if event_location != blank %}
        <span class="single-event__location">{{ event_location }}</span>
      {% endif %}

      <h1 class="single-event__title">{{ article.title }}</h1>

      {% if article.excerpt != blank %}
        <p class="single-event__description">{{ article.excerpt }}</p>
      {% endif %}

      {% comment %} Social Share Block {% endcomment %}
      <div class="single-event__social">
        {% content_for 'blocks' %}
      </div>
    </div>

    {% comment %} Featured Image {% endcomment %}
    {% if article.image %}
      <div class="single-event__image-wrapper">
        <img
          src="{{ article.image | image_url: width: 1474, height: 740, crop: 'center' }}"
          srcset="{{ article.image | image_url: width: 358, height: 326, crop: 'center' }} 358w,
                  {{ article.image | image_url: width: 716, height: 652, crop: 'center' }} 716w,
                  {{ article.image | image_url: width: 737, height: 370, crop: 'center' }} 737w,
                  {{ article.image | image_url: width: 1474, height: 740, crop: 'center' }} 1474w"
          sizes="(max-width: 768px) 100vw, 737px"
          alt="{{ article.image.alt | escape | default: article.title }}"
          width="737"
          height="370"
          loading="eager"
          class="single-event__image"
        >
      </div>
    {% endif %}

    {% comment %} Content Section {% endcomment %}
    <div class="single-event__content">
      {% if article.content != blank %}
        <div class="single-event__body rte">
          {{ article.content }}
        </div>
      {% endif %}

      {% comment %} RSVP Button {% endcomment %}
      {% if section.settings.show_rsvp_button %}
        {% if event_rsvp_url != blank %}
          <a href="{{ event_rsvp_url }}" class="single-event__rsvp-btn" target="_blank" rel="noopener noreferrer">
            {{ section.settings.rsvp_button_text }}
          </a>
        {% else %}
          <button type="button" class="single-event__rsvp-btn" disabled>
            {{ section.settings.rsvp_button_text }}
          </button>
        {% endif %}
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .single-event {
    width: 100%;
  }

  .single-event__container {
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .single-event__header {
    text-align: center;
  }

  .single-event__location {
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-foreground);
    font-weight: 700;
    margin-bottom: 16px;
  }

  .single-event__title {
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 16px 0;
    color: var(--color-foreground);
  }

  .single-event__description {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-foreground);
    opacity: 0.8;
    margin: 0 0 16px 0;
  }

  .single-event__social {
    margin-top: 8px;
  }

  .single-event__image-wrapper {
    width: 100%;
    max-width: 737px;
    height: auto;
    margin: 0 auto;
    overflow: hidden;
  }

  .single-event__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    object-position: center;
    aspect-ratio: 737 / 370;
  }

  .single-event__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    text-align: center;
    max-width: 530px;
    margin: 0 auto;
    width: 100%;
    padding-bottom: 36px;
    border-bottom: 1px solid var(--color-foreground);
  }

  .single-event__body {
    font-size: 14px;
    line-height: 1.7;
    color: var(--color-foreground);
    opacity: 0.85;
    width: 100%;
  }

  .single-event__body p {
    margin: 0 0 16px 0;
  }

  .single-event__body p:last-child {
    margin-bottom: 0;
  }

  .single-event__rsvp-btn {
    display: block;
    width: 100%;
    padding: 14px 48px;
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    color: var(--color-background);
    background-color: var(--color-foreground);
    border: 1px solid var(--color-foreground);
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: inherit;
    box-sizing: border-box;
  }

  .single-event__rsvp-btn:hover {
    color: var(--color-foreground);
    background-color: transparent;
  }

  .single-event__rsvp-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media (max-width: 768px) {
    .single-event__container {
      gap: 32px;
    }

    .single-event__title {
      font-size: 28px;
    }

    .single-event__description {
      font-size: 13px;
    }

    .single-event__body {
      font-size: 13px;
    }

    .single-event__rsvp-btn {
      padding: 12px 36px;
    }

    .single-event__image {
      aspect-ratio: 358 / 326;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Single Event",
  "tag": "section",
  "class": "single-event-section",
  "blocks": [
    {
      "type": "social-share"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "default_location",
      "label": "Default location",
      "info": "Used if event.location metafield is not set",
      "default": "Event Location"
    },
    {
      "type": "header",
      "content": "RSVP Button"
    },
    {
      "type": "checkbox",
      "id": "show_rsvp_button",
      "label": "Show RSVP button",
      "default": true
    },
    {
      "type": "text",
      "id": "rsvp_button_text",
      "label": "Button text",
      "default": "RSVP/JOIN THE WAITLIST"
    },
    {
      "type": "url",
      "id": "default_rsvp_url",
      "label": "Default RSVP URL",
      "info": "Used if event.rsvp_url metafield is not set"
    },
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Single Event",
      "category": "Events",
      "blocks": [
        {
          "type": "social-share",
          "settings": {
            "show_clipboard": false,
            "show_facebook": true,
            "show_instagram": true,
            "show_email": true,
            "show_x": false,
            "show_pinterest": false,
            "show_bookmark": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
