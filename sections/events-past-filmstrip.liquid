{% comment %}
  Events Past Filmstrip Section
  Displays past events in a horizontal filmstrip layout with images from slideshow-images metafield
{% endcomment %}

{% liquid
  # Use section.settings.blog if set, otherwise fallback to global blog object
  if section.settings.blog != blank
    assign current_blog = section.settings.blog
  elsif blog != blank
    assign current_blog = blog
  else
    assign current_blog = blogs['events']
  endif

  assign filter_tag = section.settings.filter_tag | default: 'past-events'
  assign max_events = section.settings.post_limit

  # Pre-count matching articles
  assign matching_count = 0
  if current_blog != blank and current_blog.articles_count > 0
    for article in current_blog.articles
      if matching_count >= max_events
        break
      endif
      assign matches = false
      for tag in article.tags
        if tag == filter_tag
          assign matches = true
          break
        endif
      endfor
      if matches
        assign matching_count = matching_count | plus: 1
      endif
    endfor
  endif
%}

<div
  class="
    events-past-filmstrip
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    spacing-style
  "
  style="
    {%- render 'spacing-style', settings: section.settings -%}
    --filmstrip-gap: {{ section.settings.image_gap }}px;
  "
  {% if section.settings.tab_id != blank %}
    data-events-section="{{ section.settings.tab_id }}"
  {% endif %}
>
  {% if current_blog != blank and current_blog.articles_count > 0 %}
    {% assign article_count = 0 %}
    {% for article in current_blog.articles %}
      {% if article_count >= max_events %}
        {% break %}
      {% endif %}

      {% assign show_article = false %}
      {% for tag in article.tags %}
        {% if tag == filter_tag %}
          {% assign show_article = true %}
          {% break %}
        {% endif %}
      {% endfor %}

      {% if show_article %}
        {% assign article_count = article_count | plus: 1 %}

        {% comment %} Build tag handles for filtering {% endcomment %}
        {% assign tag_handles = '' %}
        {% for tag in article.tags %}
          {% assign tag_handle = tag | handleize %}
          {% if tag_handles == '' %}
            {% assign tag_handles = tag_handle %}
          {% else %}
            {% assign tag_handles = tag_handles | append: ' ' | append: tag_handle %}
          {% endif %}
        {% endfor %}

        {% comment %} Get location tag for label {% endcomment %}
        {% assign location_label = section.settings.default_location_label %}
        {% for tag in article.tags %}
          {% if tag contains 'Location-' or tag contains 'location-' %}
            {% assign location_label = tag | remove: 'Location-' | remove: 'location-' | upcase %}
            {% break %}
          {% endif %}
        {% endfor %}

        <div class="events-past-filmstrip__event" data-event-tags="{{ tag_handles }}">
          <div class="events-past-filmstrip__header">
            <span class="events-past-filmstrip__label">{{ location_label }}</span>
            <h3 class="events-past-filmstrip__title">
              <a href="{{ article.url }}">{{ article.title }}</a>
            </h3>
          </div>

          <div class="events-past-filmstrip__track-wrapper">
            <div class="events-past-filmstrip__track">
              {% comment %} Get images from slideshow-images metafield {% endcomment %}
              {% assign slideshow_images = article.metafields.custom.slideshow_images.value %}

              {% if slideshow_images != blank and slideshow_images.size > 0 %}
                {% for image in slideshow_images %}
                  <div class="events-past-filmstrip__slide">
                    <div class="events-past-filmstrip__image-wrapper">
                      <a href="{{ article.url }}">
                        <img
                          src="{{ image | image_url: width: 400 }}"
                          alt="{{ image.alt | escape | default: article.title }}"
                          width="400"
                          height="533"
                          loading="lazy"
                          class="events-past-filmstrip__image"
                        >
                      </a>
                    </div>
                    {% if section.settings.show_captions and image.alt != blank %}
                      <span class="events-past-filmstrip__caption">{{ image.alt }}</span>
                    {% endif %}
                  </div>
                {% endfor %}
              {% else %}
                {% comment %} Fallback to article featured image if no slideshow images {% endcomment %}
                {% if article.image %}
                  <div class="events-past-filmstrip__slide">
                    <div class="events-past-filmstrip__image-wrapper">
                      <a href="{{ article.url }}">
                        <img
                          src="{{ article.image | image_url: width: 400 }}"
                          alt="{{ article.image.alt | escape | default: article.title }}"
                          width="400"
                          height="533"
                          loading="lazy"
                          class="events-past-filmstrip__image"
                        >
                      </a>
                    </div>
                    {% if section.settings.show_captions and article.image.alt != blank %}
                      <span class="events-past-filmstrip__caption">{{ article.image.alt }}</span>
                    {% endif %}
                  </div>
                {% endif %}
              {% endif %}
            </div>
          </div>
        </div>

        {% unless article_count == matching_count %}
          <div class="events-past-filmstrip__divider"></div>
        {% endunless %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {% if matching_count == 0 %}
    <div class="events-past-filmstrip__empty">
      <p>{{ section.settings.empty_message }}</p>
    </div>
  {% else %}
    <div class="events-past-filmstrip__empty" style="display: none;" data-filtered-empty>
      <p>{{ section.settings.empty_message }}</p>
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .events-past-filmstrip {
    width: 100%;
  }

  .events-past-filmstrip__event {
    margin-bottom: 0;
  }

  .events-past-filmstrip__event.is-hidden {
    display: none;
  }

  .events-past-filmstrip__header {
    margin-bottom: 16px;
  }

  .events-past-filmstrip__label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: black;
    margin-bottom: 8px;
  }

  .events-past-filmstrip__title {
    font-size: 1.5rem;
    font-weight: 400;
    margin: 0;
    line-height: 1.4;
  }

  .events-past-filmstrip__title a {
    color: inherit;
    text-decoration: none;
  }

  .events-past-filmstrip__title a:hover {
    opacity: 0.7;
  }

  .events-past-filmstrip__track-wrapper {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    margin-left: calc(-1 * var(--page-gutter, 24px));
    margin-right: calc(-1 * var(--page-gutter, 24px));
    padding-left: var(--page-gutter, 24px);
    padding-right: var(--page-gutter, 24px);
  }

  .events-past-filmstrip__track-wrapper::-webkit-scrollbar {
    display: none;
  }

  .events-past-filmstrip__track {
    display: flex;
    gap: var(--filmstrip-gap, 16px);
    padding-bottom: 8px;
  }

  .events-past-filmstrip__slide {
    flex: 0 0 auto;
    width: 160px;
  }

  .events-past-filmstrip__image-wrapper {
    width: 282px;
    height: 383px;
    overflow: hidden;
    background-color: var(--color-background-secondary, #f5f5f5);
  }

  .events-past-filmstrip__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .events-past-filmstrip__slide:hover .events-past-filmstrip__image {
    transform: scale(1.05);
  }

  .events-past-filmstrip__caption {
    display: block;
    margin-top: 8px;
    font-size: 11px;
    color: var(--color-foreground);
    opacity: 0.6;
  }

  .events-past-filmstrip__divider {
    height: 1px;
    background-color: var(--color-foreground);
    opacity: 0.1;
    margin: 32px 0;
  }

  .events-past-filmstrip__empty {
    text-align: center;
    padding: 48px 24px;
    opacity: 0.6;
  }

  .events-past-filmstrip__empty p {
    margin: 0;
    font-size: 14px;
  }

  @media screen and (min-width: 750px) {
    .events-past-filmstrip__slide {
      width: 200px;
    }

    .events-past-filmstrip__title {
      font-size: 22px;
    }

    .events-past-filmstrip__divider {
      margin: 48px 0;
    }
  }

  @media screen and (min-width: 990px) {
    .events-past-filmstrip__track-wrapper {
      margin-left: 0;
      margin-right: 0;
      padding-left: 0;
      padding-right: 0;
    }

    .events-past-filmstrip__slide {
      width: 220px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Events Past Filmstrip",
  "tag": "section",
  "class": "events-past-filmstrip-section",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Select the events blog"
    },
    {
      "type": "text",
      "id": "filter_tag",
      "label": "Filter Tag",
      "default": "past-events",
      "info": "Show only events with this tag"
    },
    {
      "type": "text",
      "id": "tab_id",
      "label": "Tab ID",
      "info": "Link this section to a tab in the Events Header"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "default_location_label",
      "label": "Default location label",
      "default": "EVENT LOCATION",
      "info": "Used when no location tag is found"
    },
    {
      "type": "checkbox",
      "id": "show_captions",
      "label": "Show image captions",
      "default": true
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty state message",
      "default": "No past events found"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "Maximum events",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "Image gap",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Events Past Filmstrip",
      "category": "Events"
    }
  ]
}
{% endschema %}
