{% comment %}
  Events Upcoming List Section
  Displays upcoming events in a horizontal list format with image and details
{% endcomment %}

{% liquid
  # Use section.settings.blog if set, otherwise fallback to global blog object (available in blog templates)
  assign current_blog = nil
  if section.settings.blog != blank and section.settings.blog.articles != nil
    assign current_blog = section.settings.blog
  elsif blog != blank and blog.articles != nil
    assign current_blog = blog
  else
    assign current_blog = blogs['events']
  endif

  assign max_items = section.settings.post_limit
  assign filter_tag = section.settings.filter_tag
  assign mobile_layout = section.settings.mobile_layout | default: 'list'

  # Capture current article handle to exclude from suggestions (on article pages)
  assign current_article_handle = nil
  if article != blank
    assign current_article_handle = article.handle
  endif

  # Pre-count matching articles to determine if section should render
  assign matching_count = 0
  if current_blog != blank and current_blog.articles_count > 0
    for article in current_blog.articles
      # Skip current article on article pages
      if current_article_handle != nil and article.handle == current_article_handle
        continue
      endif
      assign matches = true
      if filter_tag != blank
        assign matches = false
        for tag in article.tags
          if tag == filter_tag
            assign matches = true
            break
          endif
        endfor
      endif
      if matches
        assign matching_count = matching_count | plus: 1
      endif
    endfor
  endif
%}

<div
  class="
    events-upcoming-list
    events-upcoming-list--mobile-{{ mobile_layout }}
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    spacing-style
  "
  style="
    {%- render 'spacing-style', settings: section.settings -%}
  "
  {% if section.settings.tab_id != blank %}
    data-events-section="{{ section.settings.tab_id }}"
  {% endif %}
>
  {% if section.settings.heading != blank %}
    <h2 class="events-upcoming-list__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="events-upcoming-list__container">
    {% if current_blog != blank and current_blog.articles_count > 0 %}
      {% comment %} First pass: collect date::handle pairs for sorting {% endcomment %}
      {% assign sorted_entries = '' %}
      {% for a in current_blog.articles %}
        {% if current_article_handle != nil and a.handle == current_article_handle %}
          {% continue %}
        {% endif %}
        {% assign show_a = true %}
        {% if filter_tag != blank %}
          {% assign show_a = false %}
          {% for tag in a.tags %}
            {% if tag == filter_tag %}
              {% assign show_a = true %}
              {% break %}
            {% endif %}
          {% endfor %}
        {% endif %}
        {% if show_a %}
          {% if a.metafields.event.date %}
            {% assign sort_date = a.metafields.event.date | date: '%Y%m%d%H%M' %}
          {% else %}
            {% assign sort_date = a.published_at | date: '%Y%m%d%H%M' %}
          {% endif %}
          {% assign entry = sort_date | append: '::' | append: a.handle %}
          {% if sorted_entries == '' %}
            {% assign sorted_entries = entry %}
          {% else %}
            {% assign sorted_entries = sorted_entries | append: '|||' | append: entry %}
          {% endif %}
        {% endif %}
      {% endfor %}

      {% comment %} Sort entries chronologically and render {% endcomment %}
      {% assign sorted_array = sorted_entries | split: '|||' | sort %}
      {% assign article_count = 0 %}
      {% for entry in sorted_array %}
        {% assign entry_handle = entry | split: '::' | last %}

        {% comment %} Find the article by handle {% endcomment %}
        {% for article in current_blog.articles %}
          {% if article.handle == entry_handle %}
            {% assign article_count = article_count | plus: 1 %}
            {% comment %} Build tag handles for filtering {% endcomment %}
            {% assign tag_handles = '' %}
            {% assign is_tba = false %}
            {% for tag in article.tags %}
              {% assign tag_handle = tag | handleize %}
              {% assign tag_lower = tag | downcase | strip %}
              {% if tag_handle == 'tba' or tag_lower == 'tba' %}
                {% assign is_tba = true %}
              {% endif %}
              {% if tag_handles == '' %}
                {% assign tag_handles = tag_handle %}
              {% else %}
                {% assign tag_handles = tag_handles | append: ' ' | append: tag_handle %}
              {% endif %}
            {% endfor %}

            <!-- DEBUG: tags="{{ article.tags | join: ', ' }}" is_tba="{{ is_tba }}" -->
            <article
              class="events-upcoming-list__item{% if article_count > max_items %} events-upcoming-list__item--hidden{% endif %}{% if is_tba %} events-upcoming-list__item--tba{% endif %}"
              data-event-tags="{{ tag_handles }}"
              data-event-index="{{ article_count }}"
            >
              {% if is_tba %}
                <div class="events-upcoming-list__link events-upcoming-list__link--tba">
              {% else %}
                <a href="{{ article.url }}" class="events-upcoming-list__link">
              {% endif %}
                <div class="events-upcoming-list__image-wrapper">
                  {% if article.image %}
                    <img
                      src="{{ article.image | image_url: width: 400 }}"
                      srcset="{{ article.image | image_url: width: 200 }} 200w,
                              {{ article.image | image_url: width: 400 }} 400w,
                              {{ article.image | image_url: width: 600 }} 600w"
                      sizes="(max-width: 768px) 120px, 200px"
                      alt="{{ article.image.alt | escape | default: article.title }}"
                      width="{{ article.image.width }}"
                      height="{{ article.image.height }}"
                      loading="lazy"
                      class="events-upcoming-list__image"
                    >
                  {% else %}
                    <div class="events-upcoming-list__placeholder">
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {% endif %}
                </div>

                <div class="events-upcoming-list__content">
                  {% if section.settings.show_date and is_tba == false %}
                    <span class="events-upcoming-list__date">
                      {% if article.metafields.event.date %}
                        {% assign event_date = article.metafields.event.date %}
                        {{ event_date | date: section.settings.date_format }}
                        {% if section.settings.show_time %}
                          <span class="events-upcoming-list__time">{{ event_date | date: "%I:%M %p" }}</span>
                        {% endif %}
                      {% else %}
                        {{ article.published_at | date: section.settings.date_format }}
                      {% endif %}
                    </span>
                  {% endif %}

                  <h3 class="events-upcoming-list__title">{{ article.title }}</h3>

                  {% if article.excerpt != blank or article.content != blank %}
                    <p class="events-upcoming-list__description">
                      {% if article.excerpt != blank %}
                        {{ article.excerpt | strip_html | truncate: 150 }}
                      {% else %}
                        {{ article.content | strip_html | truncate: 150 }}
                      {% endif %}
                    </p>
                  {% endif %}

                  <span class="events-upcoming-list__cta">
                    {% if is_tba %}
                      TO BE ANNOUNCED
                    {% else %}
                      {{ section.settings.cta_text }}
                    {% endif %}
                  </span>
                </div>
              {% if is_tba %}
                </div>
              {% else %}
                </a>
              {% endif %}
            </article>
            {% break %}
          {% endif %}
        {% endfor %}
      {% endfor %}
    {% endif %}

    {% if matching_count == 0 %}
      <div class="events-upcoming-list__empty">
        <p>{{ section.settings.empty_message }}</p>
      </div>
    {% else %}
      <div class="events-upcoming-list__empty events-upcoming-list__empty--filtered" style="display: none;" data-filtered-empty>
        <p>{{ section.settings.empty_message }}</p>
      </div>
    {% endif %}
  </div>

  {% if matching_count > max_items %}
    <div class="events-upcoming-list__load-more-wrapper">
      <button
        type="button"
        class="events-upcoming-list__load-more"
        data-load-more
        data-per-page="{{ max_items }}"
      >
        {{ section.settings.load_more_text }}
      </button>
    </div>
  {% endif %}
</div>

<script>
  (function() {
    var section = document.querySelector('.events-upcoming-list-section');
    if (!section) return;
    var btn = section.querySelector('[data-load-more]');
    if (!btn) return;
    var perPage = parseInt(btn.getAttribute('data-per-page'), 10);
    var currentlyShown = perPage;

    btn.addEventListener('click', function() {
      var hiddenItems = section.querySelectorAll('.events-upcoming-list__item--hidden');
      var count = 0;
      hiddenItems.forEach(function(item) {
        if (count < perPage) {
          item.classList.remove('events-upcoming-list__item--hidden');
          count++;
        }
      });
      currentlyShown += count;
      var remaining = section.querySelectorAll('.events-upcoming-list__item--hidden');
      if (remaining.length === 0) {
        btn.parentElement.style.display = 'none';
      }
    });
  })();
</script>

{% stylesheet %}
  .events-upcoming-list {
    width: 100%;
  }

  .events-upcoming-list__heading {
    font-family: 'Inter', sans-serif;
    font-size: 20px;
    font-weight: 400;
    text-transform: capitalize;
    color: var(--color-foreground);
    margin: 0 auto 32px;
    text-align: left;
    max-width: 530px;
    width: 100%;
  }

  .events-upcoming-list__container {
    display: flex;
    flex-direction: column;
    gap: 48px;
    max-width: 640px;
    margin: 0 auto;
  }

  .events-upcoming-list__item {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
  }

  .events-upcoming-list__item.is-hidden,
  .events-upcoming-list__item--hidden {
    display: none;
  }

  .events-upcoming-list__load-more-wrapper {
    display: flex;
    justify-content: center;
    margin-top: 48px;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }

  .events-upcoming-list__load-more {
    background: none;
    border: 1px solid var(--color-foreground);
    color: var(--color-foreground);
    padding: 12px 32px;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .events-upcoming-list__load-more:hover {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  .events-upcoming-list__link {
    display: flex;
    flex-direction: row;
    gap: 24px;
    text-decoration: none;
    color: inherit;
    align-items: flex-start;
    justify-content: center;
  }

  .events-upcoming-list__image-wrapper {
    flex-shrink: 0;
    width: 251px;
    height: 360px;
    overflow: hidden;
    background-color: var(--color-background-secondary, #f5f5f5);
  }

  .events-upcoming-list__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .events-upcoming-list__link:hover .events-upcoming-list__image {
    transform: scale(1.05);
  }

  .events-upcoming-list__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-background-secondary, #f5f5f5);
  }

  .events-upcoming-list__placeholder svg {
    width: 40%;
    height: auto;
    opacity: 0.3;
  }

  .events-upcoming-list__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
    text-align: left;
    max-width: 251px;
  }

  .events-upcoming-list__date {
    font-size: 0.75rem;
    line-height: 0.875;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb));
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .events-upcoming-list__time {
    opacity: 0.8;
  }

  .events-upcoming-list__time::before {
    content: "•";
    margin-right: 8px;
  }

  .events-upcoming-list__title {
    font-family: var(--font-heading--family);
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.2;
    margin: 0;
    color: var(--color-foreground-heading, var(--color-foreground));
  }

  .events-upcoming-list__link:hover .events-upcoming-list__title {
    opacity: 0.7;
  }

  .events-upcoming-list__description {
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgb(var(--color-foreground-rgb) / 0.8);
    margin: 0;
  }

  .events-upcoming-list__cta {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-foreground-heading, var(--color-foreground));
    text-decoration: underline;
    text-underline-offset: 4px;
    margin-top: auto;
  }

  .events-upcoming-list__link:hover .events-upcoming-list__cta {
    opacity: 0.7;
  }

  .events-upcoming-list__link--tba {
    cursor: default;
  }

  .events-upcoming-list__link--tba .events-upcoming-list__cta {
    text-decoration: none;
    opacity: 0.6;
  }

  .events-upcoming-list__empty {
    text-align: center;
    padding: 48px 24px;
    opacity: 0.6;
  }

  .events-upcoming-list__empty p {
    margin: 0;
    font-size: 14px;
  }

  @media (max-width: 768px) {
    .events-upcoming-list__container {
      gap: 32px;
    }

    .events-upcoming-list__item {
      width: 100%;
    }

    .events-upcoming-list__link {
      flex-direction: row;
      gap: 16px;
    }

    .events-upcoming-list__image-wrapper {
      width: 140px;
      height: 200px;
      flex-shrink: 0;
    }

    .events-upcoming-list__content {
      padding-top: 0;
      gap: 24px;
      max-width: none;
      flex: 1;
    }

    .events-upcoming-list__title {
      font-size: 1.125rem;
    }

    .events-upcoming-list__date {
      font-size: 0.625rem;
    }

    .events-upcoming-list__description {
      font-size: 0.8rem;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .events-upcoming-list__cta {
      font-size: 0.75rem;
    }

    /* Mobile Side Scroll Layout */
    .events-upcoming-list--mobile-scroll .events-upcoming-list__container {
      flex-direction: row;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: 16px;
      padding-bottom: 16px;
      margin: 0 -16px;
      padding-left: 16px;
      padding-right: 16px;
    }

    .events-upcoming-list--mobile-scroll .events-upcoming-list__container::-webkit-scrollbar {
      display: none;
    }

    .events-upcoming-list--mobile-scroll .events-upcoming-list__item {
      flex-shrink: 0;
      width: 280px;
      scroll-snap-align: start;
    }

    .events-upcoming-list--mobile-scroll .events-upcoming-list__link {
      flex-direction: column;
      gap: 12px;
    }

    .events-upcoming-list--mobile-scroll .events-upcoming-list__image-wrapper {
      width: 100%;
      height: auto;
      aspect-ratio: 3 / 4;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Events Upcoming List",
  "tag": "section",
  "class": "events-upcoming-list-section",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Select the events blog"
    },
    {
      "type": "text",
      "id": "filter_tag",
      "label": "Filter by Tag",
      "info": "Show only events with this tag (leave blank for all)"
    },
    {
      "type": "text",
      "id": "tab_id",
      "label": "Tab ID",
      "info": "Link this section to a tab in the Events Header (e.g., 'upcoming')"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Upcoming events"
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "Events per page",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 5,
      "info": "Number of events shown initially and per 'Load More' click"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show event date",
      "default": true,
      "info": "Uses event.date metafield if available, falls back to published date"
    },
    {
      "type": "checkbox",
      "id": "show_time",
      "label": "Show event time",
      "default": true,
      "info": "Displays time from the event.date metafield"
    },
    {
      "type": "text",
      "id": "date_format",
      "label": "Date format",
      "default": "%B %d, %Y",
      "info": "Example: %B %d, %Y = January 01, 2024"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "SEE MORE"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty state message",
      "default": "No upcoming events"
    },
    {
      "type": "text",
      "id": "load_more_text",
      "label": "Load more button text",
      "default": "Load More"
    },
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "list",
          "label": "List (vertical)"
        },
        {
          "value": "scroll",
          "label": "Side scroll (horizontal)"
        }
      ],
      "default": "scroll"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Events Upcoming List",
      "category": "Events"
    }
  ]
}
{% endschema %}
