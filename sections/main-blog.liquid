{%- comment -%}
  Main Blog Header Section
  Displays blog title, subtitle, search functionality, and divider
  Article rendering is handled by separate sections:
  - main-blog-hero (articles 1-3)
  - main-blog-listings (articles 4-6)
  - meet-the-experts (expert profiles)
  - blog-rich-text (rich text content)
  - main-blog-discover (articles 7-10 + Read More)
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="section color-{{ section.settings.color_scheme }} blog-header-section spacing-style size-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .blog-header-section {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog Header",
  "tag": "section",
  "class": "blog-header-section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ]
}
{% endschema %}
