

<script
  src="{{ 'blog-posts-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<blog-posts-list section-id="{{ section.id }}">
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div class="section color-{{ section.settings.color_scheme }} blog-posts spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
    
    {%- paginate blog.articles by 12 -%}
      <div ref="grid" class="blog-posts-grid">
  {% for article in blog.articles %}
    
    {% comment %} Check if it's one of the first three articles {% endcomment %}
    {% if forloop.index <= 3 %}
      
      {% comment %} TOP ROW: 3 Columns {% endcomment %}
      <div class="blog-post-card card-featured">
        <div class="card-image-wrapper">
          <a href="{{ article.url }}"><img src="{{ article.image | image_url: width: 400 }}" alt="{{ article.title }}" width="auto" height="auto"></a>
        </div>
        <div class="card-content">
          <span class="card-tag">{{ article.tags.first | default: 'Journal' }}</span>
          <h2 class="card-title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
          <p class="card-excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
          <a href="{{ article.url }}" class="read-more">Read More</a>
        </div>
      </div>

    {% else %}
      
      {% comment %} REMAINING ROWS: Side-by-Side List {% endcomment %}
      <div class="blog-post-card card-list-item">
        <div class="card-image-wrapper">
          <a href="{{ article.url }}"><img src="{{ article.image | image_url: width: 250 }}" alt="{{ article.title }}" width="auto" height="auto"></a>
        </div>
        <div class="card-content">
          <span class="card-tag">{{ article.tags.first | default: 'Journal' }}</span>
          <h2 class="card-title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
          <p class="card-subheading">{{ article.excerpt_or_content | strip_html | truncatewords: 25 }}</p>
          <a href="{{ article.url }}" class="read-more">Read More</a>
        </div>
      </div>

    {% endif %}
  {% endfor %}
  </div>
      <span ref="viewMoreNext"></span>
    {%- endpaginate -%}
  </div>
</blog-posts-list>

{% stylesheet %}
  .blog-posts-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr); /* 3 columns for the top row */
  gap: 40px;
}

/* Featured (Top 3) */
.card-featured {
  display: flex;
  flex-direction: column;
}

/* List Items (Article 4, 5+) - They span all 3 columns to act like a row */
.card-list-item {
  grid-column: span 3; 
  display: grid;
  grid-template-columns: 1fr 1fr; /* Image left, Content right */
  gap: 30px;
  align-items: center;
  border-top: 1px solid #eee;
  padding-top: 40px;
}

.card-image-wrapper img {
  width: 100%;
  height: auto;
  display: block;
}

.card-tag {
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: #888;
}

.card-title {
  font-family: serif; /* Matches AltarRasa's aesthetic */
  font-size: 24px;
  margin: 10px 0;
}

.read-more {
  display: inline-block;
  margin-top: 15px;
  text-decoration: underline;
  font-weight: bold;
}

/* Mobile: Stack everything */
@media (max-width: 767px) {
  .blog-posts-grid { grid-template-columns: 1fr; }
  .card-list-item { 
    grid-column: span 1; 
    grid-template-columns: 1fr; 
  }
}
{% endstylesheet %}
{% schema %}
{
  "name": "t:names.blog_posts",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
