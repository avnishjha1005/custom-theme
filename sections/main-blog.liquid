

<script
  src="{{ 'blog-posts-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<blog-posts-list section-id="{{ section.id }}">
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div class="section color-{{ section.settings.color_scheme }} blog-posts spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
    
    {%- paginate blog.articles by 12 -%}
      <div ref="grid" class="blog-posts-grid">
  {% for article in blog.articles %}
    
    {% comment %} Check if it's one of the first three articles {% endcomment %}
    {% if forloop.index <= 3 %}
      
      {% comment %} TOP ROW: 3 Columns {% endcomment %}
      <div class="blog-post-card card-featured">
        <div class="card-image-wrapper">
          <a href="{{ article.url }}"><img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title }}"></a>
        </div>
        <div class="card-content">
          <span class="card-tag">{{ article.tags.first | default: 'Journal' }}</span>
          <h2 class="card-title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
          <p class="card-excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
          <a href="{{ article.url }}" class="read-more">Read More</a>
        </div>
      </div>

    {% else %}
      
      {% comment %} REMAINING ROWS: Side-by-Side List {% endcomment %}
      <div class="blog-post-card card-list-item">
        <div class="card-image-wrapper">
          <a href="{{ article.url }}"><img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title }}"></a>
        </div>
        <div class="card-content">
          <span class="card-tag">{{ article.tags.first | default: 'Journal' }}</span>
          <h2 class="card-title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
          <p class="card-subheading">{{ article.excerpt_or_content | strip_html | truncatewords: 25 }}</p>
          <a href="{{ article.url }}" class="read-more">Read More</a>
        </div>
      </div>

    {% endif %}
  {% endfor %}
  </div>
      <span ref="viewMoreNext"></span>
    {%- endpaginate -%}
  </div>
</blog-posts-list>

{% stylesheet %}
  .blog-posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px 20px;
    max-width: var(--page-width);
    margin: 0 auto;
  }

  /* --- Featured Top Row (First 3 items) --- */
  .card-featured {
    display: flex;
    flex-direction: column;
    grid-column: span 1;
  }

  .card-featured .card-image-wrapper {
    margin-bottom: 1.5rem;
    aspect-ratio: 4 / 5; /* Matches the tall Figma portraits */
    overflow: hidden;
  }

  /* --- List Rows (Everything after item 3) --- */
  .card-list {
    grid-column: span 3; /* Take full width of the grid */
    display: grid;
    grid-template-columns: 1fr 2fr; /* Image left, content right */
    gap: 30px;
    align-items: start;
    border-top: 1px solid #e0e0e0;
    padding-top: 30px;
  }

  /* Typography & Elements */
  .card-tag {
    display: block;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
    color: #666;
  }

  .card-title {
    font-size: 1.5rem;
    margin: 0.5rem 0;
    line-height: 1.2;
  }

  .card-excerpt {
    font-size: 1rem;
    color: #444;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .read-more-btn {
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: bold;
    font-size: 0.9rem;
  }

  .card-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Mobile Responsive */
  @media screen and (max-width: 768px) {
    .blog-posts-grid {
      grid-template-columns: 1fr;
    }
    .card-featured, .card-list {
      grid-column: span 1;
      grid-template-columns: 1fr; /* Stack on mobile */
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "t:names.blog_posts",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
