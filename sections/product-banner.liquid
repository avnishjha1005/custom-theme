{% comment %}
  Filename: sections/product-banner.liquid
  Pulls products from the article metafield: custom.banner_products (list.product_reference).
  If the metafield is not set, the section renders nothing.
{% endcomment %}

{% assign banner_products = article.metafields.custom.banner_products.value %}

{% if banner_products != blank and banner_products.size > 0 %}
  <div class="product-banner" style="padding: 40px 0;">
    <div class="page-width">
      {% if section.settings.heading != blank %}
        <h2 class="banner-title" style="text-align: center; margin-bottom: 30px;">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      <div class="product-card-grid" style="display: flex; gap: 20px; justify-content: center; flex-wrap: wrap;">
        {% for p in banner_products %}
          <div class="product-card-wrapper" style="flex: 1; min-width: 300px; max-width: 500px;">
            {% render 'product-card',
              product: p,
              children: ''
            %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Product Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products",
      "info": "Products are pulled from the article metafield: custom.banner_products (list.product_reference)"
    }
  ],
  "presets": [
    { "name": "Product Banner" }
  ]
}
{% endschema %}
