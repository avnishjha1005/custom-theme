{{ 'customer.css' | asset_url | stylesheet_tag }}
{{ 'section-login-form.css' | asset_url | stylesheet_tag }}

<div class="login-form-section color-{{ section.settings.color_scheme }} gradient">
  <div class="login-form-section__wrapper page-width page-width--narrow">
    <div class="customer login">
      <h1 class="visually-hidden">{{ 'customer.login_page.title' | t }}</h1>

      {%- form 'customer_login', novalidate: 'novalidate', class: 'customer-form' -%}
        {%- if form.errors -%}
          <div class="form__message" role="alert">
            <h2 class="form-message" tabindex="-1" autofocus>
              {{ 'templates.contact.form.error_heading' | t }}
            </h2>
            <ul>
              {%- for field in form.errors -%}
                <li>
                  {%- if field == 'form' -%}
                    {{ form.errors.messages[field] }}
                  {%- else -%}
                    <a href="#{{ field }}">
                      {{ form.errors.translated_fields[field] | capitalize }}
                      {{ form.errors.messages[field] }}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="field">
          <input
            type="email"
            name="customer[email]"
            id="CustomerEmail"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            placeholder="{{ 'customer.login_page.email' | t }}*"
            aria-required="true"
            {% if form.errors contains 'form' %}
              aria-invalid="true"
              aria-describedby="CustomerEmail-error"
            {% endif %}
          >
          <label for="CustomerEmail" class="visually-hidden">
            {{ 'customer.login_page.email' | t }}
          </label>
          {%- if form.errors contains 'form' -%}
            <small id="CustomerEmail-error" class="form__message">
              {{ form.errors.messages.form }}
            </small>
          {%- endif -%}
        </div>

        <div class="field">
          <input
            type="password"
            value=""
            name="customer[password]"
            id="CustomerPassword"
            autocomplete="current-password"
            placeholder="{{ 'customer.login_page.password' | t }}*"
            aria-required="true"
            {% if form.errors contains 'form' %}
              aria-invalid="true"
            {% endif %}
          >
          <label for="CustomerPassword" class="visually-hidden">
            {{ 'customer.login_page.password' | t }}
          </label>
        </div>

        <div class="login-form__actions">
          <a href="{{ routes.account_recover_url }}" class="login-form__forgot-password">
            {{ 'customer.login_page.forgot_password' | t }}
          </a>
        </div>

        <button type="submit" class="button button--{% if section.settings.button_style %}{{ section.settings.button_style }}{% else %}solid{% endif %} button--full-width">
          {{ 'customer.login_page.sign_in' | t }}
        </button>

        <div class="login-form__register-link">
          <a href="{{ routes.account_register_url }}" class="button button--{% if section.settings.button_style %}{{ section.settings.button_style }}{% else %}solid{% endif %} button--full-width button--secondary">
            {{ 'customer.register.title' | t | upcase }}
          </a>
        </div>

        {%- if shop.checkout.guest_login -%}
          <div class="login-form__guest">
            <a href="{{ routes.cart_url }}">{{ 'customer.login_page.guest_continue' | t }}</a>
          </div>
        {%- endif -%}

        {%- if section.settings.show_social_login -%}
          {%- if section.settings.show_divider -%}
            <div class="login-form__divider">
              <span>{{ 'customer.login_page.alternate_provider_separator' | t }}</span>
            </div>
          {%- endif -%}

          <div class="login-form__social">
            <p class="login-form__social-text">{{ section.settings.social_login_text }}</p>
            <div class="login-form__social-buttons">
              {%- comment -%} Google Login Button {%- endcomment -%}
              <button type="button" class="button button--social button--google">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M17.64 9.20443C17.64 8.56625 17.5827 7.95262 17.4764 7.36353H9V10.8449H13.8436C13.635 11.9699 13.0009 12.9231 12.0477 13.5613V15.8194H14.9564C16.6582 14.2526 17.64 11.9453 17.64 9.20443Z" fill="#4285F4"/>
                  <path d="M8.99976 18C11.4298 18 13.467 17.1941 14.9561 15.8195L12.0475 13.5613C11.2416 14.1013 10.2107 14.4204 8.99976 14.4204C6.65567 14.4204 4.67158 12.8372 3.96385 10.71H0.957031V13.0418C2.43794 15.9831 5.48158 18 8.99976 18Z" fill="#34A853"/>
                  <path d="M3.96409 10.7098C3.78409 10.1698 3.68182 9.59301 3.68182 8.99983C3.68182 8.40665 3.78409 7.82983 3.96409 7.28983V4.95801H0.957273C0.347727 6.17301 0 7.54756 0 8.99983C0 10.4521 0.347727 11.8266 0.957273 13.0416L3.96409 10.7098Z" fill="#FBBC05"/>
                  <path d="M8.99976 3.57955C10.3211 3.57955 11.5075 4.03364 12.4402 4.92545L15.0216 2.34409C13.4629 0.891818 11.4257 0 8.99976 0C5.48158 0 2.43794 2.01682 0.957031 4.95818L3.96385 7.29C4.67158 5.16273 6.65567 3.57955 8.99976 3.57955Z" fill="#EA4335"/>
                </svg>
                <span>Google</span>
              </button>

              {%- comment -%} Facebook Login Button {%- endcomment -%}
              <button type="button" class="button button--social button--facebook">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M18 9C18 4.02944 13.9706 0 9 0C4.02944 0 0 4.02944 0 9C0 13.4922 3.29115 17.2155 7.59375 17.8907V11.6016H5.30859V9H7.59375V7.01719C7.59375 4.76156 8.93742 3.51562 10.9932 3.51562C11.9776 3.51562 13.0078 3.69141 13.0078 3.69141V5.90625H11.8729C10.755 5.90625 10.4062 6.60001 10.4062 7.3125V9H12.9023L12.5033 11.6016H10.4062V17.8907C14.7089 17.2155 18 13.4922 18 9Z" fill="#1877F2"/>
                </svg>
                <span>Facebook</span>
              </button>
            </div>
            <p class="login-form__social-disclaimer">
              {{ section.settings.social_login_disclaimer }}
            </p>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Login Form",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_social_login",
      "default": true,
      "label": "Show Social Login Options"
    },
    {
      "type": "text",
      "id": "social_login_text",
      "default": "YOU CAN ALSO ACCESS WITH",
      "label": "Social Login Text"
    },
    {
      "type": "text",
      "id": "social_login_disclaimer",
      "default": "By logging in with my social login, I agree to link my account as per the Privacy Policy",
      "label": "Social Login Disclaimer"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "default": true,
      "label": "Show Divider Before Social Login"
    },
    {
      "type": "select",
      "id": "button_style",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "outline",
          "label": "Outline"
        }
      ],
      "default": "solid",
      "label": "Button Style"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "accent-1",
          "label": "Accent 1"
        },
        {
          "value": "accent-2",
          "label": "Accent 2"
        },
        {
          "value": "background-1",
          "label": "Background 1"
        },
        {
          "value": "background-2",
          "label": "Background 2"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ],
      "default": "background-1",
      "label": "Color Scheme"
    }
  ],
  "presets": [
    {
      "name": "Login Form"
    }
  ]
}
{% endschema %}
