{%- comment -%}
  Blog Grid Section
  Displays all blog articles in a uniform 2-column grid layout
  Use this section instead of the editorial sections (hero, listings, discover)
  for a simpler grid-based blog layout
{%- endcomment -%}

<script
  src="{{ 'blog-posts-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<blog-posts-list section-id="{{ section.id }}">
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>

  <div
    class="section color-{{ section.settings.color_scheme }} blog-grid-section"
    style="
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    {%- paginate blog.articles by section.settings.articles_per_page -%}
      <span ref="viewMorePrevious"></span>

      <div
        ref="grid"
        class="blog-grid-container"
        data-last-page="{{ paginate.pages }}"
      >
        {% for article in blog.articles %}
          <div
            class="blog-grid-item"
            ref="cards[]"
            data-page="{{ paginate.current_page }}"
          >
            {% content_for 'block', id: 'static-grid-card', type: '_blog-post-card-grid', article: article, card_index: forloop.index %}
          </div>
        {% endfor %}
      </div>

      <span ref="viewMoreNext"></span>

      {% if paginate.pages > 1 %}
        {% if section.settings.load_more_enabled %}
          <div class="blog-grid-load-more" id="blog-grid-load-more-{{ section.id }}">
            <button
              type="button"
              class="blog-grid-load-more-button"
              aria-label="{{ section.settings.load_more_text | default: 'Read More' }}"
              data-current-page="{{ paginate.current_page }}"
              data-total-pages="{{ paginate.pages }}"
            >
              <span class="button-text">{{ section.settings.load_more_text | default: 'Read More' }}</span>
              <span class="button-loading" style="display: none;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10" opacity="0.25"/>
                  <path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round">
                    <animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="1s" repeatCount="indefinite"/>
                  </path>
                </svg>
              </span>
            </button>
          </div>
        {% else %}
          <div class="blog-grid-pagination">
            {{ paginate | default_pagination }}
          </div>
        {% endif %}
      {% endif %}
    {%- endpaginate -%}
  </div>
</blog-posts-list>

{% stylesheet %}
  .blog-grid-section {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
  }

  .blog-grid-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    width: 100%;
  }

  @media screen and (max-width: 749px) {
    .blog-grid-container {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  .blog-grid-item {
    --blog-post-card-scale: 0.6;
    width: 100%;
    height: auto;
  }

  @media screen and (max-width: 749px) {
    .blog-grid-item {
      --blog-post-card-scale: 0.5;
    }
  }

  .blog-grid-pagination {
    margin-top: 3rem;
    text-align: center;
  }

  .blog-grid-pagination .pagination {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .blog-grid-pagination .pagination a,
  .blog-grid-pagination .pagination span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0.5rem;
    font-size: 0.875rem;
    text-decoration: none;
    color: rgb(var(--color-foreground-rgb));
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.2);
    transition: all 0.2s ease;
  }

  .blog-grid-pagination .pagination a:hover {
    background-color: rgb(var(--color-foreground-rgb));
    color: rgb(var(--color-background-rgb));
  }

  .blog-grid-pagination .pagination span.current {
    background-color: rgb(var(--color-foreground-rgb));
    color: rgb(var(--color-background-rgb));
  }

  /* Load More Button Styles */
  .blog-grid-load-more {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  .blog-grid-load-more-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-body-family);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb));
    background-color: transparent;
    border: 1px solid rgb(var(--color-foreground-rgb));
    padding: 12px 32px;
    cursor: pointer;
    min-width: 160px;
    transition: all 0.2s ease;
  }

  .blog-grid-load-more-button:hover:not(:disabled) {
    background-color: rgb(var(--color-foreground-rgb));
    color: rgb(var(--color-background-rgb));
  }

  .blog-grid-load-more-button:disabled {
    opacity: 0.7;
    cursor: wait;
  }

  .blog-grid-load-more-button .button-loading {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (max-width: 749px) {
    .blog-grid-load-more {
      margin-top: 2rem;
    }

    .blog-grid-load-more-button {
      width: 100%;
      max-width: 280px;
    }
  }
{% endstylesheet %}

<script>
  (function() {
    const sectionId = '{{ section.id }}';
    const loadMoreWrapper = document.getElementById('blog-grid-load-more-' + sectionId);

    if (!loadMoreWrapper) return;

    const button = loadMoreWrapper.querySelector('.blog-grid-load-more-button');
    if (!button) return;

    const blogPostsList = document.querySelector('blog-posts-list[section-id="' + sectionId + '"]');
    const grid = blogPostsList?.querySelector('[ref="grid"]');
    const viewMoreNext = blogPostsList?.querySelector('[ref="viewMoreNext"]');

    if (!grid || !viewMoreNext) return;

    let currentPage = parseInt(button.dataset.currentPage);
    const totalPages = parseInt(button.dataset.totalPages);
    let loading = false;

    button.addEventListener('click', async function() {
      if (loading || currentPage >= totalPages) return;

      loading = true;
      const buttonText = button.querySelector('.button-text');
      const buttonLoading = button.querySelector('.button-loading');

      buttonText.style.display = 'none';
      buttonLoading.style.display = 'inline-flex';
      button.disabled = true;

      try {
        const nextPage = currentPage + 1;
        const url = new URL(window.location.href);
        url.searchParams.set('page', nextPage.toString());

        const response = await fetch(url.toString(), {
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });

        if (!response.ok) throw new Error('Failed to load');

        const html = await response.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');

        const newSection = doc.querySelector('blog-posts-list[section-id="' + sectionId + '"]');
        const newGrid = newSection?.querySelector('[ref="grid"]');

        if (newGrid) {
          const newItems = newGrid.querySelectorAll('[ref="cards[]"]');
          newItems.forEach(item => {
            grid.appendChild(item.cloneNode(true));
          });

          currentPage = nextPage;
          history.pushState('', '', url.toString());

          if (currentPage >= totalPages) {
            loadMoreWrapper.style.display = 'none';
          }
        }
      } catch (error) {
        console.error('Error loading more articles:', error);
      } finally {
        loading = false;
        const buttonText = button.querySelector('.button-text');
        const buttonLoading = button.querySelector('.button-loading');
        buttonText.style.display = 'inline';
        buttonLoading.style.display = 'none';
        button.disabled = false;
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Blog Grid",
  "tag": "section",
  "class": "blog-grid-section-wrapper",
  "settings": [
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles per page",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 12
    },
    {
      "type": "header",
      "content": "Load More"
    },
    {
      "type": "checkbox",
      "id": "load_more_enabled",
      "label": "Enable Load More button",
      "default": false
    },
    {
      "type": "text",
      "id": "load_more_text",
      "label": "Button text",
      "default": "Read More"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Blog Grid"
    }
  ]
}
{% endschema %}
