{% comment %}
  Events Past Grid Section
  Displays past events from a blog in a grid layout
{% endcomment %}

{% liquid
  # Use section.settings.blog if set, otherwise fallback to global blog object (available in blog templates)
  if section.settings.blog != blank
    assign current_blog = section.settings.blog
  elsif blog != blank
    assign current_blog = blog
  else
    assign current_blog = blogs['events']
  endif

  assign filter_tag = section.settings.filter_tag | default: 'past-events'
  assign max_items = section.settings.post_limit

  # Pre-count matching articles to determine if section should render
  assign matching_count = 0
  if current_blog != blank and current_blog.articles_count > 0
    for article in current_blog.articles
      if matching_count >= max_items
        break
      endif
      assign matches = false
      for tag in article.tags
        if tag == filter_tag
          assign matches = true
          break
        endif
      endfor
      if matches
        assign matching_count = matching_count | plus: 1
      endif
    endfor
  endif
%}

<div
  class="
    events-location-grid
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    spacing-style
  "
  style="
    {%- render 'spacing-style', settings: section.settings -%}
    --grid-columns: {{ section.settings.columns }};
    --grid-gap: {{ section.settings.grid_gap }}px;
  "
  {% if section.settings.tab_id != blank %}
    data-events-section="{{ section.settings.tab_id }}"
  {% endif %}
>
  <div class="events-location-grid__header">
    {% if section.settings.location_label != blank %}
      <span class="events-location-grid__label">{{ section.settings.location_label }}</span>
    {% endif %}
    {% if section.settings.description != blank %}
      <p class="events-location-grid__description">{{ section.settings.description }}</p>
    {% endif %}
  </div>

  <div class="events-location-grid__grid">
    {% if current_blog != blank and current_blog.articles_count > 0 %}
      {% assign article_count = 0 %}
      {% for article in current_blog.articles %}
        {% if article_count >= max_items %}
          {% break %}
        {% endif %}

        {% assign show_article = false %}
        {% for tag in article.tags %}
          {% if tag == filter_tag %}
            {% assign show_article = true %}
            {% break %}
          {% endif %}
        {% endfor %}

        {% if show_article %}
          {% assign article_count = article_count | plus: 1 %}
          {% comment %} Build tag handles for filtering {% endcomment %}
          {% assign tag_handles = '' %}
          {% for tag in article.tags %}
            {% assign tag_handle = tag | handleize %}
            {% if tag_handles == '' %}
              {% assign tag_handles = tag_handle %}
            {% else %}
              {% assign tag_handles = tag_handles | append: ' ' | append: tag_handle %}
            {% endif %}
          {% endfor %}
          <a href="{{ article.url }}" class="events-location-grid__item" data-event-tags="{{ tag_handles }}">
            <div class="events-location-grid__image-wrapper">
              {% if article.image %}
                <img
                  src="{{ article.image | image_url: width: 600 }}"
                  alt="{{ article.image.alt | escape | default: article.title }}"
                  width="{{ article.image.width }}"
                  height="{{ article.image.height }}"
                  loading="lazy"
                  class="events-location-grid__image"
                >
              {% else %}
                <div class="events-location-grid__placeholder">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}
            </div>
            {% if section.settings.show_title %}
              <span class="events-location-grid__item-title">{{ article.title }}</span>
            {% endif %}
          </a>
        {% endif %}
      {% endfor %}
    {% endif %}

    {% if matching_count == 0 %}
      <div class="events-location-grid__empty">
        <p>{{ section.settings.empty_message }}</p>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .events-location-grid {
    width: 100%;
  }

  .events-location-grid__header {
    margin-bottom: 24px;
  }

  .events-location-grid__label {
    display: block;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-foreground);
    margin-bottom: 8px;
    opacity: 0.7;
  }

  .events-location-grid__description {
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-foreground);
    margin: 0;
    max-width: 600px;
  }

  .events-location-grid__grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns, 4), 1fr);
    gap: var(--grid-gap, 16px);
  }

  .events-location-grid__item {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .events-location-grid__item.is-hidden {
    display: none;
  }

  .events-location-grid__image-wrapper {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: var(--color-background-secondary, #f5f5f5);
  }

  .events-location-grid__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .events-location-grid__item:hover .events-location-grid__image {
    transform: scale(1.05);
  }

  .events-location-grid__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-background-secondary, #f5f5f5);
  }

  .events-location-grid__placeholder svg {
    width: 50%;
    height: auto;
    opacity: 0.3;
  }

  .events-location-grid__item-title {
    display: block;
    margin-top: 8px;
    font-size: 12px;
    text-align: center;
    opacity: 0.8;
  }

  .events-location-grid__empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 48px 24px;
    opacity: 0.6;
  }

  .events-location-grid__empty p {
    margin: 0;
    font-size: 14px;
  }

  @media (max-width: 768px) {
    .events-location-grid__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Events Past Grid",
  "tag": "section",
  "class": "events-location-grid-section",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Select the events blog"
    },
    {
      "type": "text",
      "id": "filter_tag",
      "label": "Filter Tag",
      "default": "past-events",
      "info": "Show only events with this tag (e.g., 'past-events')"
    },
    {
      "type": "text",
      "id": "tab_id",
      "label": "Tab ID",
      "info": "Link this section to a tab in the Events Header (e.g., 'past-events')"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "location_label",
      "label": "Section Label",
      "default": "PAST EVENTS"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty state message",
      "default": "No events found"
    },
    {
      "type": "header",
      "content": "Grid Layout"
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "Maximum events",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show event titles",
      "default": false
    },
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Events Past Grid",
      "category": "Events"
    }
  ]
}
{% endschema %}
