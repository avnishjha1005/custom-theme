{%- comment -%}
  Blog Listings Section
  Displays articles 4-6 as non-hero card listings
{%- endcomment -%}

{%- liquid
  # Get saved articles for bookmark state
  assign saved_articles = nil
  if customer
    assign saved_articles = customer.metafields.custom.saved_articles.value
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="section color-{{ section.settings.color_scheme }} blog-listings-section"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="blog-listings-container">
    {% for article in blog.articles offset: 3 limit: 3 %}
      <div class="blog-listing-item">
        <div class="blog-listing-card">
          {%- if article.image -%}
            <div class="blog-listing-card__image">
              <a href="{{ article.url }}">
                <img
                  src="{{ article.image | image_url: width: 600 }}"
                  alt="{{ article.image.alt | escape }}"
                  loading="lazy"
                  width="{{ article.image.width }}"
                  height="{{ article.image.height }}"
                >
              </a>
            </div>
          {%- endif -%}

          <div class="blog-listing-card__content">
            {%- if article.tags.size > 0 -%}
              <span class="blog-listing-card__tag">{{ article.tags.first }}</span>
            {%- endif -%}

            <h3 class="blog-listing-card__title">
              <a href="{{ article.url }}">{{ article.title }}</a>
            </h3>

            <p class="blog-listing-card__excerpt">
              {{ article.excerpt | default: article.content | strip_html | truncatewords: 20 }}
            </p>

            <div class="blog-listing-card__actions">
              <a href="{{ article.url }}" class="blog-listing-card__read-link">READ</a>
              {%- liquid
                assign is_bookmarked = false
                if saved_articles
                  for saved in saved_articles
                    assign saved_handle = saved.handle | default: saved
                    if saved_handle == article.handle
                      assign is_bookmarked = true
                      break
                    endif
                  endfor
                endif
              -%}
              <button
                type="button"
                class="blog-listing-card__bookmark{% if is_bookmarked %} blog-listing-card__bookmark--active{% endif %}"
                aria-label="Bookmark article"
                aria-pressed="{{ is_bookmarked }}"
                data-bookmark-button
                data-article-handle="{{ article.handle }}"
                data-blog-handle="{{ blog.handle }}"
                data-article-title="{{ article.title | escape }}"
                data-article-excerpt="{{ article.excerpt_or_content | strip_html | truncate: 150 | escape }}"
                {%- if article.image %}data-article-image="{{ article.image | image_url: width: 600 }}"{% endif %}
                {% unless customer %}data-require-login="true"{% endunless %}
              >
                <span class="bookmark-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                  </svg>
                </span>
                <span class="bookmark-icon bookmark-icon--filled">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                  </svg>
                </span>
              </button>
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .blog-listings-section {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
  }

  .blog-listings-container {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .blog-listing-item {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
  }

  .blog-listing-card {
    display: flex;
    flex-direction: row;
    gap: 24px;
    align-items: flex-start;
    justify-content: center;
  }

  .blog-listing-card__image {
    flex-shrink: 0;
    width: 251px;
    height: 360px;
    overflow: hidden;
  }

  .blog-listing-card__image a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .blog-listing-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-listing-card__content {
    gap:24px;
    flex: 1;
    display: flex;
    flex-direction: column;
    text-align: left;
    max-width: 251px !important;
  }

  .blog-listing-card__tag {
    font-size: 0.75rem;
    line-height: 0.875;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb));
  }

  .blog-listing-card__title {
    font-family: var(--font-heading--family);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.2;
    margin: 0;
  }

  .blog-listing-card__title a {
    text-decoration: none;
    color: var(--color-foreground-heading);
  }

  .blog-listing-card__title a:hover {
    opacity: 0.7;
  }

  .blog-listing-card__excerpt {
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgb(white / 0.8);
    margin: 0;
  }

  .blog-listing-card__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    font-weight: 600;
  }

  .blog-listing-card__read-link {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-decoration: underline;
    text-underline-offset: 4px;
    color: var(--color-foreground-heading);
  }

  .blog-listing-card__read-link:hover {
    opacity: 0.7;
  }

  .blog-listing-card__bookmark {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--color-foreground-heading);
    position: relative;
    width: 20px;
    height: 20px;
  }

  .blog-listing-card__bookmark:hover {
    opacity: 0.7;
  }

  .blog-listing-card__bookmark .bookmark-icon {
    position: absolute;
    top: 0;
    left: 0;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .blog-listing-card__bookmark .bookmark-icon--filled {
    opacity: 0;
    transform: scale(0);
  }

  .blog-listing-card__bookmark--active .bookmark-icon:not(.bookmark-icon--filled) {
    opacity: 0;
    transform: scale(0);
  }

  .blog-listing-card__bookmark--active .bookmark-icon--filled {
    opacity: 1;
    transform: scale(1);
  }

  /* Mobile Styles - maintain side-by-side layout */
  @media screen and (max-width: 749px) {
    .blog-listings-container {
      gap: 32px;
    }

    .blog-listing-item {
      width: 100%;
    }

    .blog-listing-card {
      flex-direction: row;
      gap: 16px;
    }

    .blog-listing-card__image {
      width: 140px;
      height: 200px;
      flex-shrink: 0;
    }

    .blog-listing-card__content {
      padding-top: 0;
      gap:24px;
      max-width: none !important;
      flex: 1;
    }

    .blog-listing-card__title {
      font-size: 1.125rem;
    }

    .blog-listing-card__tag {
      font-size: 0.625rem;
    }

    .blog-listing-card__excerpt {
      font-size: 0.8rem;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .blog-listing-card__read-link {
      font-size: 0.75rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function() {
    function showNotification(message) {
      const existing = document.querySelector('.bookmark-notification');
      if (existing) existing.remove();

      const notification = document.createElement('div');
      notification.className = 'bookmark-notification';
      notification.textContent = message;
      document.body.appendChild(notification);

      setTimeout(() => {
        notification.classList.add('bookmark-notification--hiding');
        setTimeout(() => notification.remove(), 300);
      }, 2500);
    }

    async function getBookmarks() {
      try {
        const response = await fetch('/apps/bookmarks');
        if (!response.ok) return [];
        const data = await response.json();
        return data.bookmarks || [];
      } catch (error) {
        console.error('Bookmark fetch failed:', error);
        return [];
      }
    }

    async function saveBookmarks(bookmarks) {
      try {
        const response = await fetch('/apps/bookmarks', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ bookmarks })
        });
        if (!response.ok) return false;
        const data = await response.json();
        return data.success === true;
      } catch (error) {
        console.error('Bookmark save failed:', error);
        return false;
      }
    }

    function initBookmarks() {
      document.querySelectorAll('[data-bookmark-button]').forEach(btn => {
        if (btn._bookmarkBound) return;
        btn._bookmarkBound = true;

        btn.addEventListener('click', async (e) => {
          e.preventDefault();

          if (btn.hasAttribute('data-require-login')) {
            window.location.href = '/account/login';
            return;
          }

          const articleHandle = btn.getAttribute('data-article-handle');
          const blogHandle = btn.getAttribute('data-blog-handle');
          if (!articleHandle || !blogHandle) return;

          const articleData = {
            handle: articleHandle,
            blogHandle: blogHandle,
            title: btn.getAttribute('data-article-title') || '',
            excerpt: btn.getAttribute('data-article-excerpt') || '',
            image: btn.getAttribute('data-article-image') || '',
            url: `/blogs/${blogHandle}/${articleHandle}`
          };

          btn.disabled = true;
          const isActive = btn.getAttribute('aria-pressed') === 'true';

          let bookmarks = await getBookmarks();

          if (isActive) {
            bookmarks = bookmarks.filter(b => {
              const h = typeof b === 'string' ? b : b.handle;
              return h !== articleHandle;
            });
            showNotification('Article removed from saved');
          } else {
            const exists = bookmarks.some(b => {
              const h = typeof b === 'string' ? b : b.handle;
              return h === articleHandle;
            });
            if (!exists) {
              bookmarks.push(articleData);
            }
            showNotification('Article saved');
          }

          const success = await saveBookmarks(bookmarks);

          if (success) {
            btn.setAttribute('aria-pressed', String(!isActive));
            btn.classList.toggle('blog-listing-card__bookmark--active', !isActive);
            window.dispatchEvent(new CustomEvent('bookmarks:updated', {
              detail: { bookmarks, articleHandle, action: isActive ? 'removed' : 'added' }
            }));
          } else {
            showNotification('Failed to save. Please try again.');
          }

          btn.disabled = false;
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBookmarks);
    } else {
      initBookmarks();
    }

    document.addEventListener('shopify:section:load', initBookmarks);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Blog Listings",
  "tag": "section",
  "class": "blog-listings-section-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ]
}
{% endschema %}
