{%- comment -%}
  Blog Listings Section
  Displays articles 4-6 as non-hero card listings
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="section color-{{ section.settings.color_scheme }} blog-listings-section"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="blog-listings-container">
    {% for article in blog.articles offset: 3 limit: 3 %}
      <div class="blog-listing-item">
        <div class="blog-listing-card">
          {%- if article.image -%}
            <div class="blog-listing-card__image">
              <a href="{{ article.url }}">
                <img
                  src="{{ article.image | image_url: width: 600 }}"
                  alt="{{ article.image.alt | escape }}"
                  loading="lazy"
                  width="{{ article.image.width }}"
                  height="{{ article.image.height }}"
                >
              </a>
            </div>
          {%- endif -%}

          <div class="blog-listing-card__content">
            {%- if article.tags.size > 0 -%}
              <span class="blog-listing-card__tag">{{ article.tags.first }}</span>
            {%- endif -%}

            <h3 class="blog-listing-card__title">
              <a href="{{ article.url }}">{{ article.title }}</a>
            </h3>

            <p class="blog-listing-card__excerpt">
              {{ article.excerpt | default: article.content | strip_html | truncatewords: 20 }}
            </p>

            <div class="blog-listing-card__actions">
              <a href="{{ article.url }}" class="blog-listing-card__read-link">READ</a>
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .blog-listings-section {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
  }

  .blog-listings-container {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .blog-listing-item {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
  }

  .blog-listing-card {
    display: flex;
    flex-direction: row;
    gap: 24px;
    align-items: flex-start;
    justify-content: center;
  }

  .blog-listing-card__image {
    flex-shrink: 0;
    width: 251px;
    height: 316px;
    overflow: hidden;
  }

  .blog-listing-card__image a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .blog-listing-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-listing-card__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    text-align: left;
    padding-top: 8px;
    max-width: 251px !important;
    gap: 24px;
  }

  .blog-listing-card__tag {
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: 500;
    margin: 0 !important;
  }

  .blog-listing-card__title {
    font-family: var(--font-heading--family);
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.3;
    margin: 0 !important;
  }

  .blog-listing-card__title a {
    text-decoration: none;
    color: var(--color-foreground-heading);
  }

  .blog-listing-card__title a:hover {
    opacity: 0.7;
  }

  .blog-listing-card__excerpt {
    font-size: 0.75rem;
    line-height: 1.25;
    margin: 0 !important;
  }

  .blog-listing-card__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
  }

  .blog-listing-card__read-link {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-decoration: underline;
    text-underline-offset: 4px;
    color: var(--color-foreground-heading);
  }

  .blog-listing-card__read-link:hover {
    opacity: 0.7;
  }

  .blog-listing-card__bookmark {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--color-foreground-heading);
  }

  .blog-listing-card__bookmark:hover {
    opacity: 0.7;
  }

  /* Mobile Styles - maintain side-by-side layout */
  @media screen and (max-width: 749px) {
    .blog-listings-container {
      gap: 32px;
    }

    .blog-listing-item {
      width: 100%;
    }

    .blog-listing-card {
      flex-direction: row;
      gap: 16px;
    }

    .blog-listing-card__image {
      width: 140px;
      height: 200px;
      flex-shrink: 0;
    }

    .blog-listing-card__content {
      padding-top: 0;
      max-width: none !important;
      flex: 1;
    }

    .blog-listing-card__title {
      font-size: 1.125rem;
      margin-bottom: 8px;
    }

    .blog-listing-card__tag {
      font-size: 0.625rem;
      margin-bottom: 8px;
    }

    .blog-listing-card__excerpt {
      font-size: 0.8rem;
      margin-bottom: 12px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .blog-listing-card__read-link {
      font-size: 0.75rem;

    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog Listings",
  "tag": "section",
  "class": "blog-listings-section-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ]
}
{% endschema %}
