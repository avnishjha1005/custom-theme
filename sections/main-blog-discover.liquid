{%- comment -%}
  Blog Discover More Section
  Displays "Discover More" heading + articles 7-10 + Read More button
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="section color-{{ section.settings.color_scheme }} blog-discover-section"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  {%- comment -%} Discover More Heading {%- endcomment -%}
  <div class="blog-discover-header">
    <h2 class="blog-discover-heading">{{ section.settings.heading | default: 'Discover More' }}</h2>
  </div>

  {%- comment -%} Articles 7-10 {%- endcomment -%}
  <div class="blog-discover-container">
    {% for article in blog.articles offset: 6 limit: 4 %}
      <div class="blog-discover-item">
        {% content_for 'block', id: 'static-discover-card', type: '_blog-post-card', article: article %}
      </div>
    {% endfor %}
  </div>

  {%- comment -%} Read More Button {%- endcomment -%}
  {% if blog.articles.size > 10 %}
    <div class="blog-discover-read-more">
      <a href="{{ blog.url }}?page=2" class="blog-read-more-button">
        {{ section.settings.button_text | default: 'Read More' }}
      </a>
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .blog-discover-section {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
  }

  /* Discover More Heading */
  .blog-discover-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .blog-discover-heading {
    font-family: var(--font-heading-family, 'Marcellus', serif);
    font-size: 1.75rem;
    font-weight: 400;
    color: rgb(var(--color-foreground-rgb));
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .blog-discover-heading {
      font-size: 1.5rem;
    }
  }

  /* Articles Container */
  .blog-discover-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    width: 100%;
  }

  .blog-discover-item {
    --blog-post-card-scale: 0.6;
    justify-self: center;
    width: 544px;
    max-width: 100%;
  }

  @media screen and (max-width: 749px) {
    .blog-discover-item {
      --blog-post-card-scale: 0.5;
      width: 100%;
    }
  }

  /* Read More Button */
  .blog-discover-read-more {
    text-align: center;
    margin-top: 3rem;
  }

  .blog-read-more-button {
    display: inline-block;
    padding: 1rem 2.5rem;
    font-family: var(--font-body-family);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgb(var(--color-foreground-rgb));
    background-color: transparent;
    border: 1px solid rgb(var(--color-foreground-rgb));
    transition: all 0.2s ease;
  }

  .blog-read-more-button:hover {
    background-color: rgb(var(--color-foreground-rgb));
    color: rgb(var(--color-background-rgb));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog Discover More",
  "tag": "section",
  "class": "blog-discover-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover More"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Read More"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ]
}
{% endschema %}
