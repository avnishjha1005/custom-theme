{%- comment -%}
  Blog Discover More Section
  Displays "Discover More" heading + articles 7-10 + Load More button
{%- endcomment -%}

{% assign initial_offset = 6 %}
{% assign initial_limit = 4 %}
{% assign articles_per_load = section.settings.articles_per_load | default: 4 %}
{% assign total_articles = blog.articles.size %}
{% assign initial_shown = initial_offset | plus: initial_limit %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<blog-discover-loader
  class="section color-{{ section.settings.color_scheme }} blog-discover-section"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  data-blog-url="{{ blog.url }}"
  data-total-articles="{{ total_articles }}"
  data-current-offset="{{ initial_shown }}"
  data-articles-per-load="{{ articles_per_load }}"
  data-section-id="{{ section.id }}"
>
  {%- comment -%} Discover More Heading {%- endcomment -%}
  <div class="blog-discover-header">
    <h2 class="blog-discover-heading">{{ section.settings.heading | default: 'Discover More' }}</h2>
  </div>

  {%- comment -%} Articles 7-10 {%- endcomment -%}
  <div class="blog-discover-container" id="blog-discover-container-{{ section.id }}">
    {% for article in blog.articles offset: 6 limit: 4 %}
      <div class="blog-discover-item">
        <div class="blog-discover-card">
          {%- if article.image -%}
            <div class="blog-discover-card__image">
              <a href="{{ article.url }}">
                <img
                  src="{{ article.image | image_url: width: 600 }}"
                  alt="{{ article.image.alt | escape }}"
                  loading="lazy"
                  width="{{ article.image.width }}"
                  height="{{ article.image.height }}"
                >
              </a>
            </div>
          {%- endif -%}

          <div class="blog-discover-card__content">
            {%- if article.tags.size > 0 -%}
              <span class="blog-discover-card__tag">{{ article.tags.first }}</span>
            {%- endif -%}

            <h3 class="blog-discover-card__title">
              <a href="{{ article.url }}">{{ article.title }}</a>
            </h3>

            <p class="blog-discover-card__excerpt">
              {{ article.excerpt | default: article.content | strip_html | truncatewords: 20 }}
            </p>

            <div class="blog-discover-card__actions">
              <a href="{{ article.url }}" class="blog-discover-card__read-link">READ</a>
              <button type="button" class="blog-discover-card__bookmark" aria-label="Bookmark article">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  {%- comment -%} Load More Button {%- endcomment -%}
  {% if total_articles > initial_shown %}
    <div class="blog-discover-load-more" id="blog-discover-load-more-{{ section.id }}">
      <button type="button" class="blog-load-more-button" aria-label="{{ section.settings.button_text | default: 'Load More' }}">
        <span class="button-text">{{ section.settings.button_text | default: 'Load More' }}</span>
        <span class="button-loading" style="display: none;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" opacity="0.25"/>
            <path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round">
              <animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="1s" repeatCount="indefinite"/>
            </path>
          </svg>
        </span>
      </button>
    </div>
  {% endif %}
</blog-discover-loader>

<script>
  if (!customElements.get('blog-discover-loader')) {
    customElements.define('blog-discover-loader', class extends HTMLElement {
      constructor() {
        super();
        this.button = this.querySelector('.blog-load-more-button');
        this.container = this.querySelector('.blog-discover-container');
        this.loadMoreWrapper = this.querySelector('.blog-discover-load-more');

        this.blogUrl = this.dataset.blogUrl;
        this.totalArticles = parseInt(this.dataset.totalArticles);
        this.articlesPerLoad = parseInt(this.dataset.articlesPerLoad);
        this.currentOffset = parseInt(this.dataset.currentOffset);
        this.sectionId = this.dataset.sectionId;
        this.loading = false;

        if (this.button) {
          this.button.addEventListener('click', this.loadMore.bind(this));
        }
      }

      async loadMore() {
        if (this.loading) return;
        this.loading = true;

        const buttonText = this.button.querySelector('.button-text');
        const buttonLoading = this.button.querySelector('.button-loading');
        buttonText.style.display = 'none';
        buttonLoading.style.display = 'inline-flex';
        this.button.disabled = true;

        try {
          // Fetch articles using Shopify's paginate with page parameter
          const page = Math.floor(this.currentOffset / this.articlesPerLoad) + 1;
          const response = await fetch(
            `${this.blogUrl}?view=ajax-articles&offset=${this.currentOffset}&limit=${this.articlesPerLoad}`,
            { headers: { 'X-Requested-With': 'XMLHttpRequest' } }
          );

          if (!response.ok) throw new Error('Failed to load');

          const html = await response.text();

          // Parse the response and extract article items
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');
          const newItems = doc.querySelectorAll('.blog-discover-item');

          if (newItems.length > 0) {
            newItems.forEach(item => {
              this.container.appendChild(item);
            });
            this.currentOffset += newItems.length;
          }

          // Hide button if no more articles
          if (this.currentOffset >= this.totalArticles) {
            this.loadMoreWrapper.style.display = 'none';
          }
        } catch (error) {
          console.error('Error loading more articles:', error);
        } finally {
          this.loading = false;
          buttonText.style.display = 'inline';
          buttonLoading.style.display = 'none';
          this.button.disabled = false;
        }
      }
    });
  }
</script>

{% stylesheet %}
  .blog-discover-section {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
  }

  /* Discover More Heading */
  .blog-discover-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .blog-discover-heading {
    font-family: var(--font-heading--family);
    font-size: 1.75rem;
    font-weight: 400;
    color: #692C23;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .blog-discover-heading {
      font-size: 1.5rem;
    }
  }

  /* Articles Container */
  .blog-discover-container {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .blog-discover-item {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
  }

  /* Card Styling - matching blog-listings */
  .blog-discover-card {
    display: flex;
    flex-direction: row;
    gap: 24px;
    align-items: flex-start;
    justify-content: center;
  }

  .blog-discover-card__image {
    flex-shrink: 0;
    width: 251px;
    height: 360px;
    overflow: hidden;
  }

  .blog-discover-card__image a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .blog-discover-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-discover-card__content {
    gap:24px;
    flex: 1;
    display: flex;
    flex-direction: column;
    text-align: left;
    max-width: 251px !important;
  }

  .blog-discover-card__tag {
    font-size: 0.75rem;
    line-height: 0.875;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb));
  }

  .blog-discover-card__title {
    font-family: var(--font-heading--family);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.2;
    margin: 0;
  }

  .blog-discover-card__title a {
    text-decoration: none;
    color: var(--color-foreground-heading);
  }

  .blog-discover-card__title a:hover {
    opacity: 0.7;
  }

  .blog-discover-card__excerpt {
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgb(var(--color-foreground-rgb) / 0.8);
    margin: 0;
  }

  .blog-discover-card__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    font-weight: 600;
  }

  .blog-discover-card__read-link {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-decoration: underline;
    text-underline-offset: 4px;
    color: var(--color-foreground-heading);
  }

  .blog-discover-card__read-link:hover {
    opacity: 0.7;
  }

  .blog-discover-card__bookmark {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--color-foreground-heading);
  }

  .blog-discover-card__bookmark:hover {
    opacity: 0.7;
  }

  /* Mobile Styles - maintain side-by-side layout */
  @media screen and (max-width: 749px) {
    .blog-discover-container {
      gap: 32px;
    }

    .blog-discover-item {
      width: 100%;
    }

    .blog-discover-card {
      flex-direction: row;
      gap: 16px;
    }

    .blog-discover-card__image {
      width: 140px;
      height: 200px;
      flex-shrink: 0;
    }

    .blog-discover-card__content {
      padding-top: 0;
      gap:24px;
      max-width: none !important;
      flex: 1;
    }

    .blog-discover-card__title {
      font-size: 1.125rem;
    }

    .blog-discover-card__tag {
      font-size: 0.625rem;
    }

    .blog-discover-card__excerpt {
      font-size: 0.8rem;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .blog-discover-card__read-link {
      font-size: 0.75rem;
    }
  }

  /* Load More Button */
  .blog-discover-load-more {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  .blog-load-more-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-body-family);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb));
    background-color: transparent;
    border: none;
    cursor: pointer;
    min-width: 160px;
  }

  .blog-load-more-button:hover:not(:disabled) {
    text-decoration: underline;
    transition: all 0.2s ease;
  }

  .blog-load-more-button:disabled {
    opacity: 0.7;
    cursor: wait;
  }

  .blog-load-more-button .button-loading {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (max-width: 749px) {
    .blog-discover-load-more {
      margin-top: 2rem;
    }

    .blog-load-more-button {
      width: 100%;
      max-width: 280px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog Discover More",
  "tag": "section",
  "class": "blog-discover-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover More"
    },
    {
      "type": "header",
      "content": "Load More"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Load More"
    },
    {
      "type": "range",
      "id": "articles_per_load",
      "label": "Articles per load",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ]
}
{% endschema %}
