              "blocks": {
                "text_L6mQfR": {
                  "type": "text",
                  "settings": {
                    "text": "<p>AltaRasa is a considered edit.</p><p>We curate fashion pieces that demonstrate:</p><ul><li>Strength of design and silhouette</li><li>Integrity of textile and construction</li><li>Cultural awareness without performance</li><li>Versatility across lives, not just occasions</li></ul><p>Every piece earns its place. Nothing exists here by accident.</p>",
                    "width": "100%",
                    "max_width": "none",
