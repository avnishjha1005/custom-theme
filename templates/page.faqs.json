            "accordion_row_VKqMR6": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Order Tracking & Shipping",
                "open_by_default": true,
                "keywords": "Return, Exchange",
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_Din7MH": {
                  "type": "text",
                  "settings": {
                    "text": "<p><strong>Order tracking:</strong></p><p>\t•\tOnce an order is dispatched, AltaRasa shares the tracking number and tracking link via email, enabling customers to track their shipment through the assigned courier partner.</p><p><strong>Shipping details:</strong></p><p>\t•\tOrders are shipped via trusted courier partners such as FedEx, UPS, Delhivery, etc.</p><p>\t•\tDelivery timelines are calculated from the date of order confirmation.</p><p>\t•\tIn the event of delays extending beyond one week of the estimated delivery timeline, AltaRasa will proactively reach out to confirm whether the customer wishes to proceed with the order.</p><p>\t•\tFor international orders, customs duties and local taxes are borne by the customer and are payable at the time of delivery, subject to destination country regulations.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
