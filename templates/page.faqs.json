              "blocks": {
                "text_TNAetT": {
                  "type": "text",
                  "settings": {
                    "text": "<p><strong>Accepted payment methods include:</strong></p><p>\t•\tNet banking</p><p>\t•\tAll major credit and debit cards</p><p>\t•\tUPI payments</p><p>\t•\tPayPal (for international orders)</p><p>\t•\tSecure payment gateways for both domestic and international checkouts</p>",
