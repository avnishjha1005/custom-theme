{% doc %}
  @prompt
    Generate a blog post block that kinda resembles a product card in terms of aspect ratio, it should have an overlay over the image darker towards the bottom. Then have Tag, Title, excerpt and read more under that have the same slideshow-control dots.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-card-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-blog-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.aspect_ratio }}%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-blog-card-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-blog-card-image-wrapper-{{ ai_gen_id }} svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-blog-card-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0.1) 40%,
      rgba(0, 0, 0, {{ block.settings.overlay_opacity }}) 100%
    );
    pointer-events: none;
  }

  .ai-blog-card-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.content_padding }}px;
    color: {{ block.settings.text_color }};
    z-index: 2;
  }

  .ai-blog-card-tag-{{ ai_gen_id }} {
    display: inline-block;
    font-size: {{ block.settings.tag_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
    color: {{ block.settings.tag_color }};
  }

  .ai-blog-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    line-height: 1.2;
    margin: 0 0 8px 0;
    color: {{ block.settings.text_color }};
  }

  .ai-blog-card-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.excerpt_size }}px;
    line-height: 1.5;
    margin: 0 0 12px 0;
    color: {{ block.settings.text_color }};
    opacity: 0.9;
  }

  .ai-blog-card-read-more-{{ ai_gen_id }} {
    display: inline-block;
    font-size: {{ block.settings.read_more_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: {{ block.settings.read_more_color }};
    text-decoration: none;
    margin-bottom: 16px;
  }

  .ai-blog-card-read-more-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-blog-card-dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    justify-content: flex-start;
  }

  .ai-blog-card-dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: {{ block.settings.dot_opacity }};
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .ai-blog-card-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-blog-card-dot-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-blog-card-content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding | times: 0.75 }}px;
    }

    .ai-blog-card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.85 }}px;
    }

    .ai-blog-card-excerpt-{{ ai_gen_id }} {
      font-size: {{ block.settings.excerpt_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<blog-post-card-{{ ai_gen_id }}
  class="ai-blog-card-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <a href="{{ block.settings.article.url }}" class="ai-blog-card-link-{{ ai_gen_id }}">
    <div class="ai-blog-card-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.article.image %}
        <img
          src="{{ block.settings.article.image | image_url: width: 800 }}"
          alt="{{ block.settings.article.image.alt | escape }}"
          loading="lazy"
          width="800"
          height="{{ 800 | times: block.settings.aspect_ratio | divided_by: 100 }}"
          class="ai-blog-card-image-{{ ai_gen_id }}"
        >
      {% else %}
        {{ 'image' | placeholder_svg_tag }}
      {% endif %}
      <div class="ai-blog-card-overlay-{{ ai_gen_id }}"></div>
    </div>

    <div class="ai-blog-card-content-{{ ai_gen_id }}">
      {% if block.settings.show_tag and block.settings.article.tags.size > 0 %}
        <div class="ai-blog-card-tag-{{ ai_gen_id }}">
          {{ block.settings.article.tags.first }}
        </div>
      {% endif %}

      {% if block.settings.article.title %}
        <h3 class="ai-blog-card-title-{{ ai_gen_id }}">
          {{ block.settings.article.title }}
        </h3>
      {% endif %}

      {% if block.settings.show_excerpt and block.settings.article.excerpt %}
        <div class="ai-blog-card-excerpt-{{ ai_gen_id }}">
          {{ block.settings.article.excerpt | strip_html | truncate: block.settings.excerpt_length }}
        </div>
      {% endif %}

      {% if block.settings.show_read_more %}
        <span class="ai-blog-card-read-more-{{ ai_gen_id }}">
          {{ block.settings.read_more_text }}
        </span>
      {% endif %}

      {% if block.settings.show_dots %}
        <div class="ai-blog-card-dots-{{ ai_gen_id }}">
          {% for i in (1..block.settings.dot_count) %}
            <div
              class="ai-blog-card-dot-{{ ai_gen_id }} {% if i == block.settings.active_dot %}active{% endif %}"
              data-dot-index="{{ i }}"
            ></div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </a>
</blog-post-card-{{ ai_gen_id }}>

<script>
  (function() {
    class BlogPostCard{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.dots = [];
        this.currentDot = {{ block.settings.active_dot | minus: 1 }};
      }

      connectedCallback() {
        this.dots = Array.from(this.querySelectorAll('.ai-blog-card-dot-{{ ai_gen_id }}'));
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', (e) => {
            e.preventDefault();
            this.setActiveDot(index);
          });
        });
      }

      setActiveDot(index) {
        this.dots.forEach((dot, i) => {
          if (i === index) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
        this.currentDot = index;
      }
    }

    customElements.define('blog-post-card-{{ ai_gen_id }}', BlogPostCard{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Blog post card",
  "tag": null,
  "settings": [
    {
      "type": "article",
      "id": "article",
      "label": "Article"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "range",
      "id": "aspect_ratio",
      "label": "Aspect ratio",
      "min": 75,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 125,
      "info": "100% is square, 125% is portrait like product cards"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay darkness",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.7
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Content padding",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "show_tag",
      "label": "Show tag",
      "default": true
    },
    {
      "type": "range",
      "id": "tag_size",
      "label": "Tag size",
      "min": 8,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "color",
      "id": "tag_color",
      "label": "Tag color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "range",
      "id": "excerpt_size",
      "label": "Excerpt size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "excerpt_length",
      "label": "Excerpt length",
      "min": 50,
      "max": 200,
      "step": 10,
      "default": 100
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Read more"
    },
    {
      "type": "checkbox",
      "id": "show_read_more",
      "label": "Show read more",
      "default": true
    },
    {
      "type": "text",
      "id": "read_more_text",
      "label": "Read more text",
      "default": "Read more"
    },
    {
      "type": "range",
      "id": "read_more_size",
      "label": "Read more size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "color",
      "id": "read_more_color",
      "label": "Read more color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Navigation dots"
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    },
    {
      "type": "range",
      "id": "dot_count",
      "label": "Number of dots",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "active_dot",
      "label": "Active dot",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 1,
      "info": "Which dot appears active"
    },
    {
      "type": "range",
      "id": "dot_size",
      "label": "Dot size",
      "min": 4,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "dot_opacity",
      "label": "Inactive dot opacity",
      "min": 0.1,
      "max": 1,
      "step": 0.1,
      "default": 0.4
    }
  ],
  "presets": [
    {
      "name": "Blog post card"
    }
  ]
}
{% endschema %}
