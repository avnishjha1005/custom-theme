{% doc %}
  @prompt
    Create a section with a image with a text overlay. The text has three components. A line 1, line 2 and a subheading. I should be able to control the text position over the image. The image should span the entire the width of the page ., I want even finer control over the text style, text position . There should be sliders for vertical position, horizontal position etc
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-overlay-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    display: block;
    overflow: hidden;
  }

  .ai-image-text-overlay__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.image_height_desktop }}px;
  }

  .ai-image-text-overlay__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-image-text-overlay__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-image-text-overlay__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-image-text-overlay__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-image-text-overlay__content-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.vertical_position }}%;
    left: {{ block.settings.horizontal_position }}%;
    transform: translate(-50%, -50%);
    z-index: 1;
    padding: {{ block.settings.text_padding }}px;
  }

  .ai-image-text-overlay__text-container-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    max-width: {{ block.settings.text_max_width }}px;
  }

  .ai-image-text-overlay__line1-{{ ai_gen_id }} {
    color: {{ block.settings.line1_color }};
    font-size: {{ block.settings.line1_size }}px;
    font-weight: {{ block.settings.line1_weight }};
    letter-spacing: {{ block.settings.line1_letter_spacing }}px;
    line-height: {{ block.settings.line1_line_height }};
    margin: 0 0 {{ block.settings.line1_margin }}px 0;
    {% if block.settings.line1_text_transform != 'none' %}
      text-transform: {{ block.settings.line1_text_transform }};
    {% endif %}
  }

  .ai-image-text-overlay__line2-{{ ai_gen_id }} {
    color: {{ block.settings.line2_color }};
    font-size: {{ block.settings.line2_size }}px;
    font-weight: {{ block.settings.line2_weight }};
    letter-spacing: {{ block.settings.line2_letter_spacing }}px;
    line-height: {{ block.settings.line2_line_height }};
    margin: 0 0 {{ block.settings.line2_margin }}px 0;
    {% if block.settings.line2_text_transform != 'none' %}
      text-transform: {{ block.settings.line2_text_transform }};
    {% endif %}
  }

  .ai-image-text-overlay__subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size }}px;
    font-weight: {{ block.settings.subheading_weight }};
    letter-spacing: {{ block.settings.subheading_letter_spacing }}px;
    line-height: {{ block.settings.subheading_line_height }};
    margin: 0;
    {% if block.settings.subheading_text_transform != 'none' %}
      text-transform: {{ block.settings.subheading_text_transform }};
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .ai-image-text-overlay__image-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.image_height_mobile }}px;
    }

    .ai-image-text-overlay__content-{{ ai_gen_id }} {
      top: {{ block.settings.vertical_position_mobile }}%;
      left: {{ block.settings.horizontal_position_mobile }}%;
      padding: {{ block.settings.text_padding_mobile }}px;
    }

    .ai-image-text-overlay__line1-{{ ai_gen_id }} {
      font-size: {{ block.settings.line1_size_mobile }}px;
    }

    .ai-image-text-overlay__line2-{{ ai_gen_id }} {
      font-size: {{ block.settings.line2_size_mobile }}px;
    }

    .ai-image-text-overlay__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-image-text-overlay-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-text-overlay__image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.image %}
      <img
        src="{{ block.settings.image | image_url: width: 2000 }}"
        alt="{{ block.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
        class="ai-image-text-overlay__image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-image-text-overlay__placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-image-text-overlay__empty-state-{{ ai_gen_id }}">
          Add an image to get started
        </div>
      </div>
    {% endif %}

    <div class="ai-image-text-overlay__content-{{ ai_gen_id }}">
      <div class="ai-image-text-overlay__text-container-{{ ai_gen_id }}">
        {% if block.settings.line1 != blank %}
          <h2 class="ai-image-text-overlay__line1-{{ ai_gen_id }}">
            {{ block.settings.line1 }}
          </h2>
        {% endif %}

        {% if block.settings.line2 != blank %}
          <h3 class="ai-image-text-overlay__line2-{{ ai_gen_id }}">
            {{ block.settings.line2 }}
          </h3>
        {% endif %}

        {% if block.settings.subheading != blank %}
          <p class="ai-image-text-overlay__subheading-{{ ai_gen_id }}">
            {{ block.settings.subheading }}
          </p>
        {% endif %}
      </div>
    </div>
  </div>
</div>

