        {{ block.settings.empty_message }}
      </div>
    </div>
  </div>
</blog-search-{{ ai_gen_id }}>

<script>
  (function() {
    class BlogSearch{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.searchIcon = this.querySelector('.ai-blog-search-icon-{{ ai_gen_id }}');
        this.overlay = this.querySelector('.ai-blog-search-overlay-{{ ai_gen_id }}');
        this.modal = this.querySelector('.ai-blog-search-modal-{{ ai_gen_id }}');
        this.drawer = this.querySelector('.ai-blog-search-drawer-{{ ai_gen_id }}');
        this.backButtons = this.querySelectorAll('.ai-blog-search-back-{{ ai_gen_id }}');
        this.inputs = this.querySelectorAll('.ai-blog-search-input-{{ ai_gen_id }}');
        this.resultsContainers = this.querySelectorAll('.ai-blog-search-results-{{ ai_gen_id }}');
        this.blogHandle = '{{ block.settings.blog.handle }}';
        this.searchTimeout = null;
      }

      connectedCallback() {
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.searchIcon.addEventListener('click', () => this.openSearch());
        this.overlay.addEventListener('click', () => this.closeSearch());
        
        this.backButtons.forEach(button => {
          button.addEventListener('click', () => this.closeSearch());
        });

        this.inputs.forEach(input => {
          input.addEventListener('input', (e) => this.handleSearch(e.target.value));
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            this.closeSearch();
          }
        });
      }

      openSearch() {
        this.overlay.classList.add('active');
        this.modal.classList.add('active');
        this.drawer.classList.add('active');
        document.body.style.overflow = 'hidden';
        
        setTimeout(() => {
          this.inputs[0].focus();
        }, 100);
      }

      closeSearch() {
        this.overlay.classList.remove('active');
        this.modal.classList.remove('active');
        this.drawer.classList.remove('active');
        document.body.style.overflow = '';
        
        this.inputs.forEach(input => {
          input.value = '';
        });
        
        this.resultsContainers.forEach(container => {
          container.innerHTML = '<div class="ai-blog-search-empty-{{ ai_gen_id }}">{{ block.settings.empty_message }}</div>';
        });
      }

      handleSearch(query) {
        clearTimeout(this.searchTimeout);
        
        if (query.length < 2) {
          this.resultsContainers.forEach(container => {
            container.innerHTML = '<div class="ai-blog-search-empty-{{ ai_gen_id }}">{{ block.settings.empty_message }}</div>';
          });
          return;
        }

        this.resultsContainers.forEach(container => {
          container.innerHTML = '<div class="ai-blog-search-loading-{{ ai_gen_id }}">Searching...</div>';
        });

        this.searchTimeout = setTimeout(() => {
          this.performSearch(query);
        }, 300);
      }

      async performSearch(query) {
        try {
          const blogHandle = this.blogHandle || 'news';
          const response = await fetch(`/search?q=${encodeURIComponent(query)}&type=article&options[prefix]=last`);
          const html = await response.text();
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');
          
          const articles = doc.querySelectorAll('.search__result');
          
          if (articles.length === 0) {
            this.resultsContainers.forEach(container => {
              container.innerHTML = '<div class="ai-blog-search-empty-{{ ai_gen_id }}">{{ block.settings.no_results_message }}</div>';
            });
            return;
          }

          let resultsHTML = '';
          articles.forEach(article => {
            const link = article.querySelector('a');
            const title = article.querySelector('.search__result-title, h3, h2');
            const excerpt = article.querySelector('.search__result-excerpt, p');
            
            if (link && title) {
              const articleTitle = title.textContent.trim();
              const articleExcerpt = excerpt ? excerpt.textContent.trim() : '';
              const articleUrl = link.getAttribute('href');
              
              resultsHTML += `
                <a href="${articleUrl}" class="ai-blog-search-result-{{ ai_gen_id }}">
                  <h3 class="ai-blog-search-result-title-{{ ai_gen_id }}">${articleTitle}</h3>
                  ${articleExcerpt ? `<p class="ai-blog-search-result-excerpt-{{ ai_gen_id }}">${articleExcerpt}</p>` : ''}
                </a>
              `;
            }
          });

          if (resultsHTML === '') {
            this.fetchArticlesDirectly(query);
          } else {
            this.resultsContainers.forEach(container => {
              container.innerHTML = resultsHTML;
            });
          }
        } catch (error) {
          this.fetchArticlesDirectly(query);
        }
      }

      async fetchArticlesDirectly(query) {
        try {
          const blogHandle = this.blogHandle || 'news';
          const response = await fetch(`/blogs/${blogHandle}?view=json`);
          
          if (!response.ok) {
            throw new Error('Failed to fetch articles');
          }

          const data = await response.json();
          const articles = data.articles || [];
          
          const filteredArticles = articles.filter(article => {
            const searchText = query.toLowerCase();
            return article.title.toLowerCase().includes(searchText) || 
                   (article.excerpt && article.excerpt.toLowerCase().includes(searchText));
          });

          if (filteredArticles.length === 0) {
            this.resultsContainers.forEach(container => {
              container.innerHTML = '<div class="ai-blog-search-empty-{{ ai_gen_id }}">{{ block.settings.no_results_message }}</div>';
            });
            return;
          }

          let resultsHTML = '';
          filteredArticles.forEach(article => {
            resultsHTML += `
              <a href="${article.url}" class="ai-blog-search-result-{{ ai_gen_id }}">
                <h3 class="ai-blog-search-result-title-{{ ai_gen_id }}">${article.title}</h3>
                ${article.excerpt ? `<p class="ai-blog-search-result-excerpt-{{ ai_gen_id }}">${article.excerpt}</p>` : ''}
              </a>
            `;
          });

          this.resultsContainers.forEach(container => {
            container.innerHTML = resultsHTML;
          });
        } catch (error) {
          this.resultsContainers.forEach(container => {
            container.innerHTML = '<div class="ai-blog-search-empty-{{ ai_gen_id }}">{{ block.settings.error_message }}</div>';
          });
        }
      }
    }

    customElements.define('blog-search-{{ ai_gen_id }}', BlogSearch{{ ai_gen_id }});
  })();
</script>

