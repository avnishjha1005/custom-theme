{% doc %}
  @prompt
    Create a search component, The layout should be a search icon on the left, and a list of tags to the right of the search icon. Allow scroll if overflowing horizontally. On desktop clicking search should open a modal that lets me search for blog posts by keyword. It has a left pointing icon and a text input. On mobile it should open up a drawer that opens up upwards.Search results should populate under the search bar in the modal / drawer
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-search-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-blog-search-bar-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.gap }}px;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-blog-search-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    cursor: pointer;
    color: {{ block.settings.icon_color }};
    transition: color 0.2s ease;
  }

  .ai-blog-search-icon-{{ ai_gen_id }}:hover {
    color: {{ block.settings.icon_hover_color }};
  }

  .ai-blog-search-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-blog-search-tags-{{ ai_gen_id }} {
    flex: 1;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .ai-blog-search-tags-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-blog-search-tags-list-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.tag_gap }}px;
    list-style: none;
    margin: 0;
    padding: 0;
    white-space: nowrap;
  }

  .ai-blog-search-tag-{{ ai_gen_id }} {
    flex-shrink: 0;
  }

  .ai-blog-search-tag-link-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.tag_padding_vertical }}px {{ block.settings.tag_padding_horizontal }}px;
    background-color: {{ block.settings.tag_background }};
    color: {{ block.settings.tag_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.tag_border_radius }}px;
    font-size: {{ block.settings.tag_font_size }}px;
    transition: all 0.2s ease;
    border: 1px solid {{ block.settings.tag_border_color }};
  }

  .ai-blog-search-tag-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.tag_hover_background }};
    color: {{ block.settings.tag_hover_text_color }};
    border-color: {{ block.settings.tag_hover_border_color }};
  }

  .ai-blog-search-overlay-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .ai-blog-search-overlay-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-blog-search-modal-{{ ai_gen_id }} {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.9);
    width: 90%;
    max-width: 600px;
    max-height: 80vh;
    background-color: {{ block.settings.modal_background }};
    border-radius: {{ block.settings.modal_border_radius }}px;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  }

  .ai-blog-search-modal-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
  }

  .ai-blog-search-drawer-{{ ai_gen_id }} {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    max-height: 80vh;
    background-color: {{ block.settings.modal_background }};
    border-radius: {{ block.settings.modal_border_radius }}px {{ block.settings.modal_border_radius }}px 0 0;
    z-index: 9999;
    transform: translateY(100%);
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
    box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.2);
  }

  .ai-blog-search-drawer-{{ ai_gen_id }}.active {
    transform: translateY(0);
  }

  .ai-blog-search-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px;
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-blog-search-back-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    cursor: pointer;
    color: {{ block.settings.icon_color }};
    background: none;
    border: none;
    padding: 0;
    transition: color 0.2s ease;
  }

  .ai-blog-search-back-{{ ai_gen_id }}:hover {
    color: {{ block.settings.icon_hover_color }};
  }

  .ai-blog-search-back-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-blog-search-input-{{ ai_gen_id }} {
    flex: 1;
    padding: 12px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: 16px;
    background-color: {{ block.settings.input_background }};
    color: {{ block.settings.input_text_color }};
  }

  .ai-blog-search-input-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.input_focus_border_color }};
  }

  .ai-blog-search-results-{{ ai_gen_id }} {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
  }

  .ai-blog-search-result-{{ ai_gen_id }} {
    padding: 16px;
    border-bottom: 1px solid {{ block.settings.border_color }};
    cursor: pointer;
    transition: background-color 0.2s ease;
    text-decoration: none;
    display: block;
    color: inherit;
  }

  .ai-blog-search-result-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.result_hover_background }};
  }

  .ai-blog-search-result-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-blog-search-result-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.result_title_size }}px;
    font-weight: 600;
    margin: 0 0 8px 0;
    color: {{ block.settings.result_title_color }};
  }

  .ai-blog-search-result-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.result_excerpt_size }}px;
    color: {{ block.settings.result_excerpt_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-blog-search-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: {{ block.settings.result_excerpt_color }};
  }

  .ai-blog-search-loading-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: {{ block.settings.result_excerpt_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-blog-search-drawer-{{ ai_gen_id }} {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-blog-search-modal-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<blog-search-{{ ai_gen_id }} class="ai-blog-search-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-blog-search-bar-{{ ai_gen_id }}">
    <button class="ai-blog-search-icon-{{ ai_gen_id }}" aria-label="Search blog posts">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
    </button>

    <div class="ai-blog-search-tags-{{ ai_gen_id }}">
      <ul class="ai-blog-search-tags-list-{{ ai_gen_id }}">
        {% if block.settings.tag_1 != blank %}
          <li class="ai-blog-search-tag-{{ ai_gen_id }}">
            <a href="{{ block.settings.tag_1_link }}" class="ai-blog-search-tag-link-{{ ai_gen_id }}">
              {{ block.settings.tag_1 }}
            </a>
          </li>
        {% endif %}
        {% if block.settings.tag_2 != blank %}
          <li class="ai-blog-search-tag-{{ ai_gen_id }}">
            <a href="{{ block.settings.tag_2_link }}" class="ai-blog-search-tag-link-{{ ai_gen_id }}">
              {{ block.settings.tag_2 }}
            </a>
          </li>
        {% endif %}
        {% if block.settings.tag_3 != blank %}
          <li class="ai-blog-search-tag-{{ ai_gen_id }}">
            <a href="{{ block.settings.tag_3_link }}" class="ai-blog-search-tag-link-{{ ai_gen_id }}">
              {{ block.settings.tag_3 }}
            </a>
          </li>
        {% endif %}
        {% if block.settings.tag_4 != blank %}
          <li class="ai-blog-search-tag-{{ ai_gen_id }}">
            <a href="{{ block.settings.tag_4_link }}" class="ai-blog-search-tag-link-{{ ai_gen_id }}">
              {{ block.settings.tag_4 }}
            </a>
          </li>
        {% endif %}
        {% if block.settings.tag_5 != blank %}
          <li class="ai-blog-search-tag-{{ ai_gen_id }}">
            <a href="{{ block.settings.tag_5_link }}" class="ai-blog-search-tag-link-{{ ai_gen_id }}">
              {{ block.settings.tag_5 }}
            </a>
          </li>
        {% endif %}
        {% if block.settings.tag_6 != blank %}
          <li class="ai-blog-search-tag-{{ ai_gen_id }}">
            <a href="{{ block.settings.tag_6_link }}" class="ai-blog-search-tag-link-{{ ai_gen_id }}">
              {{ block.settings.tag_6 }}
            </a>
          </li>
        {% endif %}
