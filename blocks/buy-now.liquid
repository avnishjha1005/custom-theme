

{%- doc -%}
  This block is used to display a Buy Now button that adds to cart and redirects to checkout.
  Intended for product-form.liquid block.

  @param {string} can_add_to_cart - Whether the product can be added to the cart

  @example
  {% content_for 'block', type: 'buy-now', id: 'buy-now', can_add_to_cart: can_add_to_cart %}
{%- enddoc -%}

{% liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign is_price_on_request = false
  assign selected_variant = product.selected_or_first_available_variant
  if product.metafields.custom.price_on_request == true or product.metafields.custom.price_on_request.value == true
    assign is_price_on_request = true
  endif

  comment
    Check if this is a bundle product
  endcomment
  assign bundle_products = product.metafields.custom.bundle_products.value
  assign is_bundle = false
  assign bundle_count = 0
  assign non_por_bundle_items_count = 0
  if bundle_products and bundle_products.size > 0
    assign is_bundle = true
    for bp in bundle_products
      assign bundle_item_is_por = false
      if bp.metafields.custom.price_on_request == true or bp.metafields.custom.price_on_request.value == true
        assign bundle_item_is_por = true
      endif

      if bundle_item_is_por == false
        assign non_por_bundle_items_count = non_por_bundle_items_count | plus: 1
        assign bundle_count = bundle_count | plus: 1
      endif
    endfor
  endif

  if is_price_on_request == false and is_bundle and non_por_bundle_items_count == 0
    assign is_price_on_request = true
  endif
%}

<div
  class="buy-now-block"
  {{ block.shopify_attributes }}
  {% if request.visual_preview_mode %}
    data-shopify-visual-preview
  {% endif %}
  {% unless can_add_to_cart %}
    hidden
  {% endunless %}
  {% if is_price_on_request %}
    hidden
  {% endif %}
>
  {% if product != blank %}
    <button
      type="{% if is_bundle %}button{% else %}submit{% endif %}"
      {% unless is_bundle %}name="add"{% endunless %}
      class="button buy-now-button"
      {% unless can_add_to_cart %}
        disabled
      {% endunless %}
      {% if is_bundle %}
        data-bundle-buy-now="true"
        data-bundle-count="{{ bundle_count }}"
        onclick="window.openBundleSizeDrawer && window.openBundleSizeDrawer()"
      {% else %}
        data-buy-now="true"
      {% endif %}
    >
      
        Buy Now

    </button>
  {% endif %}
</div>

{% stylesheet %}
  .buy-now-block {
    position: relative;
  }

  .buy-now-block[data-shopify-visual-preview] {
    width: 300px;
  }

  .buy-now-button {
    width: 100%;
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('click', function(e) {
    // Skip if it's a bundle buy now button - those are handled separately
    if (e.target.matches('[data-bundle-buy-now="true"]') || e.target.closest('[data-bundle-buy-now="true"]')) {
      return;
    }

    if (e.target.matches('[data-buy-now="true"]') || e.target.closest('[data-buy-now="true"]')) {
      e.preventDefault();
      const button = e.target.closest('[data-buy-now="true"]') || e.target;
      const form = button.closest('form');
      if (form) {
        const formData = new FormData(form);
        fetch('/cart/add.js', {
          method: 'POST',
          body: formData
        }).then(function() {
          window.location.href = '/checkout';
        });
      }
    }
  });
{% endjavascript %}

{% schema %}
{
  "name": "Buy Now",
  "tag": null
}
{% endschema %}
