    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "line_weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "label": "Main Lines Weight",
      "default": 400
    },
    {
      "type": "header",
      "content": "Line 1 (Top)"
    },
    {
      "type": "text",
      "id": "line1",
      "label": "Text",
      "default": "LOREM IPSUM"
    },
    {
      "type": "range",
      "id": "line1_size",
      "min": 20,
      "max": 150,
      "step": 2,
      "label": "Desktop Font Size",
      "default": 80
    },
    {
      "type": "range",
      "id": "line1_h_pos",
      "min": 0,
      "max": 100,
      "label": "Desktop Horizontal (%)",
      "default": 25
    },
    {
      "type": "range",
      "id": "line1_v_pos",
      "min": 0,
      "max": 100,
      "label": "Desktop Vertical (%)",
      "default": 35
    },
    {
      "type": "range",
      "id": "line1_size_m",
      "min": 20,
      "max": 80,
      "label": "Mobile Font Size",
      "default": 40
    },
    {
      "type": "range",
      "id": "line1_h_pos_m",
      "min": 0,
      "max": 100,
      "label": "Mobile Horizontal (%)",
      "default": 10
    },
    {
      "type": "range",
      "id": "line1_v_pos_m",
      "min": 0,
      "max": 100,
      "label": "Mobile Vertical (%)",
      "default": 30
    },
    {
      "type": "header",
      "content": "Line 2 (Offset)"
    },
    {
      "type": "text",
      "id": "line2",
      "label": "Text",
      "default": "DOLOR"
    },
    {
      "type": "range",
      "id": "line2_size",
      "min": 20,
      "max": 150,
      "step": 2,
      "label": "Desktop Font Size",
      "default": 80
    },
    {
      "type": "range",
      "id": "line2_h_pos",
      "min": 0,
      "max": 100,
      "label": "Desktop Horizontal (%)",
      "default": 55
    },
    {
      "type": "range",
      "id": "line2_v_pos",
      "min": 0,
      "max": 100,
      "label": "Desktop Vertical (%)",
      "default": 45
    },
    {
      "type": "range",
      "id": "line2_size_m",
      "min": 20,
      "max": 80,
      "label": "Mobile Font Size",
      "default": 40
    },
    {
      "type": "range",
      "id": "line2_h_pos_m",
      "min": 0,
      "max": 100,
      "label": "Mobile Horizontal (%)",
      "default": 45
    },
    {
      "type": "range",
      "id": "line2_v_pos_m",
      "min": 0,
      "max": 100,
      "label": "Mobile Vertical (%)",
      "default": 38
    },
    {
      "type": "header",
      "content": "Subheading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Text",
      "default": "Exclusive Collection 2025/26"
    },
    {
      "type": "range",
      "id": "sub_size",
      "min": 10,
      "max": 40,
      "label": "Desktop Font Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "sub_h_pos",
      "min": 0,
      "max": 100,
      "label": "Desktop Horizontal (%)",
      "default": 55
    },
    {
      "type": "range",
      "id": "sub_v_pos",
      "min": 0,
      "max": 100,
      "label": "Desktop Vertical (%)",
      "default": 55
