{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .hero-overlay-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: #f4f4f4;
    height: {{ block.settings.height_desktop }}px;
  }

  .hero-overlay__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Shared Text Styling */
  .hero-overlay__text-{{ ai_gen_id }} {
    position: absolute;
    margin: 0;
    line-height: 1.1;
    z-index: 2;
    text-transform: uppercase;
    transition: all 0.2s ease-in-out;
  }

  /* Desktop Positions */
  .line-1-{{ ai_gen_id }} {
    top: {{ block.settings.line1_v_pos }}%;
    left: {{ block.settings.line1_h_pos }}%;
    font-size: {{ block.settings.line1_size }}px;
    font-weight: {{ block.settings.line_weight }};
    color: {{ block.settings.text_color }};
  }

  .line-2-{{ ai_gen_id }} {
    top: {{ block.settings.line2_v_pos }}%;
    left: {{ block.settings.line2_h_pos }}%;
    font-size: {{ block.settings.line2_size }}px;
    font-weight: {{ block.settings.line_weight }};
    color: {{ block.settings.text_color }};
  }

  .subheading-{{ ai_gen_id }} {
    top: {{ block.settings.sub_v_pos }}%;
    left: {{ block.settings.sub_h_pos }}%;
    font-size: {{ block.settings.sub_size }}px;
    font-weight: 400;
    text-transform: none;
    color: {{ block.settings.text_color }};
    max-width: 300px;
  }

  /* Mobile Adjustments */
  @media screen and (max-width: 768px) {
    .hero-overlay-{{ ai_gen_id }} {
      height: {{ block.settings.height_mobile }}px;
    }
    
    .line-1-{{ ai_gen_id }} {
      top: {{ block.settings.line1_v_pos_m }}%;
      left: {{ block.settings.line1_h_pos_m }}%;
      font-size: {{ block.settings.line1_size_m }}px;
    }

    .line-2-{{ ai_gen_id }} {
      top: {{ block.settings.line2_v_pos_m }}%;
      left: {{ block.settings.line2_h_pos_m }}%;
      font-size: {{ block.settings.line2_size_m }}px;
    }

    .subheading-{{ ai_gen_id }} {
      top: {{ block.settings.sub_v_pos_m }}%;
      left: {{ block.settings.sub_h_pos_m }}%;
      font-size: {{ block.settings.sub_size_m }}px;
      max-width: 200px;
    }
  }
{% endstyle %}

<section class="hero-overlay-{{ ai_gen_id }}">
  {% if block.settings.image != blank %}
    <img 
      src="{{ block.settings.image | image_url: width: 2500 }}" 
      alt="{{ block.settings.image.alt }}" 
      class="hero-overlay__image-{{ ai_gen_id }}"
      loading="lazy"
      width="{{ block.settings.image.width }}"
height="{{ block.settings.image.height }}"
    >
  {% else %}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-overlay__image-ai' }}
  {% endif %}

  {% if block.settings.line1 != blank %}
    <h2 class="hero-overlay__text-{{ ai_gen_id }} line-1-{{ ai_gen_id }}">
      {{ block.settings.line1 }}
    </h2>
  {% endif %}

  {% if block.settings.line2 != blank %}
    <h2 class="hero-overlay__text-{{ ai_gen_id }} line-2-{{ ai_gen_id }}">
      {{ block.settings.line2 }}
    </h2>
  {% endif %}

  {% if block.settings.subheading != blank %}
    <p class="hero-overlay__text-{{ ai_gen_id }} subheading-{{ ai_gen_id }}">
      {{ block.settings.subheading }}
    </p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Editorial Hero Overlay",
  "settings": [
    {
      "type": "header",
      "content": "Global Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
