{%- liquid
  assign blockid = block.id

  assign bg_color = block.settings.bg_color
  assign border_color = block.settings.border_color
  assign has_bg = false
  assign has_border = false
  if bg_color != blank and bg_color != 'rgba(0,0,0,0)'
    assign has_bg = true
  endif
  if border_color != blank and border_color != 'rgba(0,0,0,0)'
    assign has_border = true
  endif

  assign spacing = block.settings.spacing
  assign dt_padding = block.settings.dt_padding
  assign mb_padding = block.settings.mb_padding
  assign padding_top = block.settings.padding_top
  assign padding_bottom = block.settings.padding_bottom
  assign padding_left = block.settings.padding_left
  assign padding_right = block.settings.padding_right

  assign dt_flex = block.settings.dt_flex
  assign dt_gap = block.settings.dt_gap
  assign dt_align_items = block.settings.dt_align_items
  assign dt_justify_content = block.settings.dt_justify_content
  assign dt_column_alignment = block.settings.dt_column_alignment

  assign adjust_mobile_layout = block.settings.adjust_mobile_layout
  assign mb_flex = block.settings.mb_flex
  assign mb_gap = block.settings.mb_gap
  assign mb_align_items = block.settings.mb_align_items
  assign mb_justify_content = block.settings.mb_justify_content
  assign mb_column_alignment = block.settings.mb_column_alignment

  assign width = block.settings.width
  assign max_width = block.settings.max_width

  assign dev_mode = block.settings.dev_mode
  assign custom_class = block.settings.custom_class
  assign css_code = block.settings.css_code
-%}

{%- style -%}
  #shopify-block-{{ blockid }} {
      height: 100%;
  }
  {% if width == 'full' or width == 'fixed' %}
      #shopify-block-{{ blockid }} {
          width: 100%;
      }
  {% endif %}
  #{{ blockid }} {
      max-width: {% if width == 'fixed' %}{{ max_width }}px{% elsif width == 'fill' %}100%{% endif %};
  }
  {% if has_bg %}
      #{{ blockid }} {
          background-color: {{ bg_color }};
          border-radius: var(--flexi-card-border-radius);
      }
  {% endif %}
  {% if has_border  %}
  #{{ blockid }} {
      border: 1px solid {{ border_color }};
      border-radius: var(--flexi-card-border-radius);
  }
  {% endif %}
  {% if spacing == 'basic' %}
  #{{ blockid }} {
      padding-top: {{ padding_top }}px;
      padding-bottom: {{ padding_bottom }}px;
      padding-left: {{ padding_left }}px;
      padding-right: {{ padding_right }}px;
  }
  {% elsif spacing == 'custom' %}
  @media only screen and (min-width: 768px) {
      #{{ blockid }} {
          padding: {{ dt_padding }};
      }
  }
  @media only screen and (max-width: 767.8px) {
      #{{ blockid }} {
          padding: {{ mb_padding }};
      }
  }
  {% endif %}
  #{{ blockid }} .flexi-group-content {
      display: flex;
      flex-direction: {{ dt_flex }};
      {% if dt_flex == 'row' %}
          align-items: {{ dt_align_items }};
          justify-content: {{ dt_justify_content }};
      {% elsif dt_flex == 'column' %}
          align-items: {{ dt_column_alignment }};
      {% endif %}
      gap: {{ dt_gap }}px;
  }
  {% if adjust_mobile_layout == true %}
      @media only screen and (max-width: 768px) {
          #{{ blockid }} .flexi-group-content {
              display: flex;
              flex-direction: {{ mb_flex }};
              {% if mb_flex == 'row' %}
                  align-items: {{ mb_align_items }};
                  justify-content: {{ mb_justify_content }};
              {% elsif mb_flex == 'column' %}
                  align-items: {{ mb_column_alignment }};
              {% endif %}
              gap: {{ mb_gap }}px;
          }
      }
  {% endif %}
  {% if css_code != blank %}{{ css_code }}{% endif %}
{%- endstyle -%}

<div
  id="{{ blockid }}"
  class="flexi-group flexi-library u-block u-w-full u-h-full {% if dev_mode %}{{ custom_class }}{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="flexi-group-content">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "Group",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "select",
      "id": "editor",
      "label": "Editing Mode",
      "options": [
        {
          "value": "simple",
          "label": "Content"
        },
        {
          "value": "advanced",
          "label": "Customize"
        }
      ],
      "default": "simple"
    },
    {
      "type": "header",
      "content": "Desktop layout",
      "visible_if": "{{ block.settings.editor == 'advanced' }}"
    },
    {
      "type": "select",
      "id": "dt_flex",
      "label": "Direction",
      "info": "Desktop",
      "options": [
        {
          "value": "row",
          "label": "Vertical"
        },
        {
          "value": "column",
          "label": "Horizontal"
        }
      ],
      "default": "column",
      "visible_if": "{{ block.settings.editor == 'advanced' }}"
    },
    {
      "type": "range",
      "id": "dt_gap",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Gap",
      "default": 12,
      "visible_if": "{{ block.settings.editor == 'advanced' }}"
    },
    {
      "type": "select",
      "id": "dt_align_items",
      "label": "Position",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.editor == 'advanced' and block.settings.dt_flex == 'row' }}"
    },
    {
      "type": "select",
      "id": "dt_justify_content",
      "label": "Alignment",
      "options": [
        {
          "value": "space-between",
          "label": "Space bewtween"
        },
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "start",
      "visible_if": "{{ block.settings.editor == 'advanced' and block.settings.dt_flex == 'row' }}"
    },
    {
      "type": "select",
      "id": "dt_column_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "start",
      "visible_if": "{{ block.settings.editor == 'advanced' and block.settings.dt_flex == 'column' }}"
    },
    {
      "type": "header",
      "content": "Mobile layout",
      "visible_if": "{{ block.settings.editor == 'advanced' }}"
    },
    {
      "type": "checkbox",
      "id": "adjust_mobile_layout",
      "label": "Adjust mobile layout",
      "default": false,
      "visible_if": "{{ block.settings.editor == 'advanced' }}"
    },
    {
      "type": "select",
      "id": "mb_flex",
      "label": "Direction",
      "info": "Mobile",
      "options": [
        {
          "value": "row",
          "label": "Vertical"
        },
        {
          "value": "column",
          "label": "Horizontal"
        }
      ],
      "default": "row",
      "visible_if": "{{ block.settings.editor == 'advanced' and block.settings.adjust_mobile_layout == true }}"
    },
    {
      "type": "range",
      "id": "mb_gap",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Gap",
      "default": 12,
      "visible_if": "{{ block.settings.editor == 'advanced' and block.settings.adjust_mobile_layout == true }}"
    },
    {
      "type": "select",
      "id": "mb_align_items",
      "label": "Alignment",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.editor == 'advanced' and block.settings.adjust_mobile_layout == true and block.settings.mb_flex == 'row' }}"
    },
    {
      "type": "select",
      "id": "mb_justify_content",
      "label": "Position",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "start",
      "visible_if": "{{ block.settings.editor == 'advanced' and block.settings.adjust_mobile_layout == true and block.settings.mb_flex == 'row' }}"
    },
    {
      "type": "select",
      "id": "mb_column_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "start",
      "visible_if": "{{ block.settings.editor == 'advanced' and block.settings.adjust_mobile_layout == true and block.settings.mb_flex == 'column' }}"
    },
    {
      "type": "header",
      "content": "Width",
      "visible_if": "{{ block.settings.editor == 'advanced' }}"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Group width",
      "options": [
        {
          "value": "fixed",
          "label": "Fixed"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ],
      "default": "fixed",
      "visible_if": "{{ block.settings.editor == 'advanced' }}"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 24,
      "max": 2400,
      "step": 24,
      "unit": "px",
      "label": "Max width",
      "default": 2400,
      "visible_if": "{{ block.settings.editor == 'advanced' and block.settings.width == 'fixed' }}"
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Padding",
      "options": [
        {
          "value": "basic",
          "label": "Basic"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "basic",
      "visible_if": "{{ block.settings.editor == 'advanced' }}"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 6,
      "visible_if": "{{ block.settings.spacing == 'basic' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 6,
      "visible_if": "{{ block.settings.spacing == 'basic' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Left padding",
      "default": 0,
      "visible_if": "{{ block.settings.spacing == 'basic' and block.settings.editor == 'advanced' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Right padding",
      "default": 0,
      "visible_if": "{{ block.settings.spacing == 'basic' and block.settings.editor == 'advanced' }}"
    },
    {
      "type": "text",
      "id": "dt_padding",
      "label": "Padding (desktop)",
      "default": "60px 0px",
      "visible_if": "{{ block.settings.spacing == 'custom' and block.settings.editor == 'advanced' }}",
      "info": "Pass in CSS padding options below. Visit our documentation for a cheatsheet."
    },
    {
      "type": "text",
      "id": "mb_padding",
      "label": "Padding (mobile)",
      "default": "30px 0px",
      "visible_if": "{{ block.settings.spacing == 'custom' and block.settings.editor == 'advanced' }}"
    },
    {
      "type": "header",
      "content": "Advanced",
      "visible_if": "{{ block.settings.editor == 'advanced' }}"
    },
    {
      "type": "checkbox",
      "id": "dev_mode",
      "label": "Enable developer mode",
      "default": false,
      "info": "Enable dev mode for additional styling and debugging features.",
      "visible_if": "{{ block.settings.editor == 'advanced' }}"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom classes",
      "info": "Apply custom classes to the outer container. [View docs](https://flexi-library.gitbook.io/flexi-theme-library/docs/custom-classes)",
      "visible_if": "{{ block.settings.dev_mode == true and block.settings.editor == 'advanced' }}"
    },
    {
      "type": "liquid",
      "id": "css_code",
      "label": "Custom CSS",
      "info": "Add custom CSS specific to this block. [View docs](https://flexi-library.gitbook.io/flexi-theme-library/docs/custom-css)",
      "visible_if": "{{ block.settings.dev_mode == true and block.settings.editor == 'advanced' }}"
    }
  ],
  "presets": [
    {
      "name": "Group",
      "category": "Flexi Groups"
    }
  ]
}
{% endschema %}
