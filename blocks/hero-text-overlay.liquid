{% doc %}
  @prompt
    Create a three image hero section. I should be able to choose the background colour and the three images to put. There should be a text overlay and be able to type some text. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-three-image-hero-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0; /* Removed horizontal padding to allow full-width scroll */
    position: relative;
    overflow: hidden;
  }

  .ai-three-image-hero__container-{{ ai_gen_id }} {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
  }

  .ai-three-image-hero__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.desktop_columns }}, 1fr);
    gap: {{ block.settings.image_gap }}px;
    position: relative;
  }

  .ai-three-image-hero__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-width: 0;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-three-image-hero__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-three-image-hero__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-three-image-hero__text-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    width: 90%;
    z-index: 2;
    pointer-events: none;
  }

  .ai-three-image-hero__heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.text_spacing }}px 0;
    text-shadow: {{ block.settings.text_shadow_x }}px {{ block.settings.text_shadow_y }}px {{ block.settings.text_shadow_blur }}px {{ block.settings.text_shadow_color }};
    line-height: 1.2;
  }

  .ai-three-image-hero__subheading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0;
    text-shadow: {{ block.settings.text_shadow_x }}px {{ block.settings.text_shadow_y }}px {{ block.settings.text_shadow_blur }}px {{ block.settings.text_shadow_color }};
    line-height: 1.4;
  }

  /* Tablet Adjustments */
  @media screen and (max-width: 989px) {
    .ai-three-image-hero__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(min({{ block.settings.desktop_columns }}, 2), 1fr);
    }
  }

  /* Mobile: Scrollable Layout */
  @media screen and (max-width: 749px) {
    .ai-three-image-hero__container-{{ ai_gen_id }} {
       padding: 0; /* Full width for the scrollable area */
    }

    .ai-three-image-hero__grid-{{ ai_gen_id }} {
      display: grid;
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 85%; /* Shows a peek of the next image */
      gap: 12px;
      overflow-x: auto;
      padding: 0 20px;
      scroll-snap-type: x mandatory;
      scrollbar-width: none; /* Hide scrollbar Firefox */
      -webkit-overflow-scrolling: touch;
    }

    .ai-three-image-hero__grid-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none; /* Hide scrollbar Chrome/Safari */
    }

    .ai-three-image-hero__image-wrapper-{{ ai_gen_id }} {
      scroll-snap-align: center;
    }

    .ai-three-image-hero__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.6);
    }

    .ai-three-image-hero__subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.8);
    }
  }
{% endstyle %}

<three-image-hero-{{ ai_gen_id }} class="ai-three-image-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-three-image-hero__container-{{ ai_gen_id }}">
    
    <div class="ai-three-image-hero__grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign image = block.settings[image_key]
        %}
        <div class="ai-three-image-hero__image-wrapper-{{ ai_gen_id }}">
          {% if image %}
            <img
              src="{{ image | image_url: width: 1200 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
              class="ai-three-image-hero__image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-three-image-hero__placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if block.settings.show_text_overlay %}
        <div class="ai-three-image-hero__text-overlay-{{ ai_gen_id }}">
          {% if block.settings.heading != blank %}
            <h2 class="ai-three-image-hero__heading-{{ ai_gen_id }}">
              {{ block.settings.heading }}
            </h2>
          {% endif %}
          {% if block.settings.subheading != blank %}
            <p class="ai-three-image-hero__subheading-{{ ai_gen_id }}">
              {{ block.settings.subheading }}
            </p>
          {% endif %}
        </div>
      {% endif %}

  </div>
</three-image-hero-{{ ai_gen_id }}>

<script>
  (function() {
    if (!customElements.get('three-image-hero-{{ ai_gen_id }}')) {
      class ThreeImageHero{{ ai_gen_id }} extends HTMLElement {
        constructor() { super(); }
      }
      customElements.define('three-image-hero-{{ ai_gen_id }}', ThreeImageHero{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Three image hero",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Desktop columns",
      "default": 3
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "16 / 9", "label": "Wide (16:9)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "2 / 3", "label": "Tall (2:3)" }
      ],
      "default": "4 / 3"
    },
    {
      "type": "range",
      "id": "image_gap",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Gap between images",
      "default": 16
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Image border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Text overlay"
    },
    {
      "type": "checkbox",
      "id": "show_text_overlay",
      "label": "Show text overlay",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to our store"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover our latest collection"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Heading size",
      "default": 48
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Subheading size",
      "default": 18
    },
    {
      "type": "range",
      "id": "text_spacing",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Space between heading and subheading",
      "default": 12
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Text shadow"
    },
    {
      "type": "range",
      "id": "text_shadow_x",
      "min": -10,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Horizontal offset",
      "default": 0
    },
    {
      "type": "range",
      "id": "text_shadow_y",
      "min": -10,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Vertical offset",
      "default": 2
    },
    {
      "type": "range",
      "id": "text_shadow_blur",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Blur radius",
      "default": 8
    },
    {
      "type": "color",
      "id": "text_shadow_color",
      "label": "Shadow color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section padding",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Three image hero"
    }
  ]
}
{% endschema %}