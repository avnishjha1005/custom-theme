

{%- assign block_settings = block.settings -%}

{% capture title %}
  {% content_for 'block', id: 'heading', type: '_heading', text: article.title %}
{% endcapture %}

{% capture details %}
  {% content_for 'block',
    id: 'blog-post-details',
    type: '_blog-post-info-text',
    alignment: block_settings.alignment,
    article: article
  %}
{% endcapture %}

{% capture description %}
  {% content_for 'block', id: 'content', type: '_blog-post-description', article: article, show_read_more: true %}
{% endcapture %}

<div
  class="blog-post-card-grid"
  style="--text-align: {{ block_settings.alignment }}"
>
  {%- if article.image -%}
    <div class="blog-post-card-grid__media">
      <a href="{{ article.url }}" class="blog-post-card-grid__media-link">
        <img
          src="{{ article.image | image_url: width: 1200 }}"
          alt="{{ article.title }}"
          loading="lazy"
          width="{{ article.image.width }}"
          height="{{ article.image.height }}"
          class="blog-post-card-grid__image"
        >
      </a>
    </div>
  {%- endif -%}

  <div class="blog-post-card-grid__overlay"></div>

  <a href="{{ article.url }}" class="blog-post-card-grid__content">
    {%- if article.tags.size > 0 -%}
      <span class="blog-post-card-grid__tag">{{ article.tags.first | upcase }}</span>
    {%- endif -%}

    <div class="blog-post-card-grid__title">{{ title }}</div>

    {{ details }}

    {{ description }}

    <span class="blog-post-card-grid__read-more">
      READ MORE
    </span>
  </a>
</div>

{% schema %}
{
  "name": "blog post card grid",
  "settings": [
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    }
  ]
}
{% endschema %}
{% stylesheet %}
  .blog-post-card-grid {
    position: relative;
    text-align: var(--text-align);
    overflow: hidden;
    aspect-ratio: 1 / 1.1;
  }

  .blog-post-card-grid__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .blog-post-card-grid__media-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .blog-post-card-grid__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .blog-post-card-grid__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.7) 0%,
      rgba(0, 0, 0, 0.4) 40%,
      rgba(0, 0, 0, 0.1) 70%,
      rgba(0, 0, 0, 0) 100%
    );
    pointer-events: none;
    z-index: 2;
  }

  .blog-post-card-grid__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    z-index: 3;
    text-decoration: none;
    color: #fff;
  }

  .blog-post-card-grid__tag {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.8);
    display: block;
  }

  .blog-post-card-grid__title {
    display: block;
    color: #fff;
    font-weight: 400;
    font-family: 'Marcellus';
    font-size: 1.25rem;
  }

  .blog-post-card-grid__title * {
    color: #fff !important;
  }

  .blog-post-card-grid__content:hover .blog-post-card-grid__title,
  .blog-post-card-grid__content:hover .blog-post-card-grid__title * {
    opacity: 0.85;
  }

  .blog-post-card-grid__content * {
    color: rgba(255, 255, 255, 0.85) !important;
  }

  .blog-post-card-grid__read-more {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #fff !important;
    font-family: 'Inter';
    text-decoration: underline;
    margin-top: 0.25rem;
    display: inline-block;
    transition: opacity 0.2s ease;
  }

  .blog-post-card-grid__content:hover .blog-post-card-grid__read-more {
    opacity: 0.85;
  }
{% endstylesheet %}
