

{%- assign block_settings = block.settings -%}

{% capture title %}
  {% content_for 'block', id: 'heading', type: '_heading', text: article.title %}
{% endcapture %}

{% capture details %}
  {% content_for 'block',
    id: 'blog-post-details',
    type: '_blog-post-info-text',
    alignment: block_settings.alignment,
    article: article
  %}
{% endcapture %}

{% capture description %}
  {% content_for 'block', id: 'content', type: '_blog-post-description', article: article, show_read_more: true %}
{% endcapture %}

<div
  class="blog-post-card-hero"
  style="--text-align: {{ block_settings.alignment }}"
>
  {%- if slideshow_images.size > 0 -%}
    {% capture slides %}
      {%- for image in slideshow_images -%}
        {% capture slide_content %}
          <a href="{{ article.url }}" class="blog-post-card-hero__media-link">
            <img
              src="{{ image | image_url: width: 1200 }}"
              alt="{{ article.title }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              width="{{ image.width }}"
              height="{{ image.height }}"
              class="blog-post-card-hero__image"
            >
          </a>
        {% endcapture %}
        {% render 'slideshow-slide', index: forloop.index, children: slide_content, slide_id: forloop.index, media_fit: 'cover' %}
      {%- endfor -%}
    {% endcapture %}

    {% if slideshow_images.size > 1 %}
      {% capture controls %}
        {%- render 'slideshow-controls',
          style: 'dots',
          autoplay: false,
          item_count: slideshow_images.size,
          show_arrows: false,
          controls_on_media: true,
          pagination_position: 'left'
          
        -%}
      {% endcapture %}
    {% endif %}

    {% render 'slideshow',
      class: 'blog-post-card-hero__slideshow',
      controls: controls,
      show_arrows: false,
      autoplay: false,
      autoplay_speed: 3,
      slides: slides,
      slide_count: slideshow_images.size,
      slide_size: 'auto'
    %}
  {%- elsif article.image -%}
    <div class="blog-post-card-hero__media">
      <a href="{{ article.url }}" class="blog-post-card-hero__media-link">
        <img
          src="{{ article.image | image_url: width: 1200 }}"
          alt="{{ article.title }}"
          loading="lazy"
          width="{{ article.image.width }}"
          height="{{ article.image.height }}"
          class="blog-post-card-hero__image"
        >
      </a>
    </div>
  {%- endif -%}

  <div class="blog-post-card-hero__overlay"></div>

  <a href="{{ article.url }}" class="blog-post-card-hero__content">
    {%- if article.tags.size > 0 -%}
      <span class="blog-post-card-hero__tag">{{ article.tags.first | upcase }}</span>
    {%- endif -%}

    <div class="blog-post-card-hero__title">{{ title }}</div>

    {{ details }}

    <span class="blog-post-card-hero__read-more">
      READ MORE
    </span>
  </a>
</div>

{% schema %}
{
  "name": "blog post card hero",
  "settings": [
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    }
  ]
}
{% endschema %}
{% stylesheet %}
.blog-post-card__image{
  height: unset !important;
  }
  .blog-post-card-hero {
    position: relative;
    text-align: var(--text-align);
    overflow: hidden;
    aspect-ratio: 1/1.25;
  }

  .blog-post-card-hero__slideshow,
  .blog-post-card-hero__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .blog-post-card-hero__slideshow slideshow-slides {
    height: 100%;
  }

  .blog-post-card-hero__slideshow slideshow-slide {
    height: 100%;
  }

  .blog-post-card-hero__media-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .blog-post-card-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .blog-post-card-hero__slideshow{
    z-index:unset;
  }
.slideshow-controls__dots button{
  --size:0.2rem;
}
  .blog-post-card-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.7) 0%,
      rgba(0, 0, 0, 0.4) 40%,
      rgba(0, 0, 0, 0.1) 70%,
      rgba(0, 0, 0, 0) 100%
    );
    pointer-events: none;
    z-index: 0;
  }

  .blog-post-card-hero__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 3rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    z-index: 2;
    text-decoration: none;
    color: #fff;
  }

  .blog-post-card-hero__tag {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.8);
    display: block;
  }

  .blog-post-card-hero__title {
    display: block;
    color: #fff;
    font-weight: 400;
    font-family: 'Marcellus';
    font-size: 1.5rem;
  }

  .blog-post-card-hero__title * {
    color: #fff !important;
  }

  .blog-post-card-hero__content:hover .blog-post-card-hero__title,
  .blog-post-card-hero__content:hover .blog-post-card-hero__title * {
    opacity: 0.85;
  }

  .blog-post-card-hero__excerpt {
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
  }

  .blog-post-card-hero__excerpt * {
    color: rgba(255, 255, 255, 0.85) !important;
  }

  .blog-post-card-hero__read-more {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #fff;
    font-family: 'Inter';
    text-decoration: underline;
    margin-top: 0.25rem;
    display: inline-block;
    transition: opacity 0.2s ease;
  }

  .blog-post-card-hero__content:hover .blog-post-card-hero__read-more {
    opacity: 0.85;
  }

  .blog-post-card-hero slideshow-controls {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 3;
    padding-bottom: 0.75rem;
  }

  .blog-post-card-hero .slideshow-controls__dots {
    justify-content: left;
    gap:20px;
    padding-left: 2rem;
  }

  .blog-post-card-hero .slideshow-control {
    background-color: rgba(255, 255, 255, 0.5);
  }

  .blog-post-card-hero .slideshow-control[aria-selected="true"] {
    background-color: #fff;
  }

  /* Ensure details text is white in hero cards */
  .blog-post-card-hero .blog-post-details {
    color: rgba(255, 255, 255, 0.8);
  }

  .blog-post-card-hero .blog-post-details span {
    color: rgba(255, 255, 255, 0.8);
  }
{% endstylesheet %}
