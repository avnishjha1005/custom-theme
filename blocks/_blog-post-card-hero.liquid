{%- assign block_settings = block.settings -%}

{% capture title %}
  {% content_for 'block', id: 'heading', type: '_heading', text: article.title %}
{% endcapture %}

{% capture details %}
  {% content_for 'block',
    id: 'blog-post-details',
    type: '_blog-post-info-text',
    alignment: block_settings.alignment,
    article: article
  %}
{% endcapture %}

{% capture description %}
  {% content_for 'block', id: 'content', type: '_blog-post-description', article: article, show_read_more: true %}
{% endcapture %}

<div class="blog-post-card" style="--text-align: {{ block_settings.alignment }}">
  <a href="{{ article.url }}" class="blog-post-card__link-wrapper">
    {%- if article.image -%}
      <div class="blog-post-card__image-container">
          {% content_for 'block', id: 'image', type: '_blog-post-image', image: article.image %}
      </div>
    {%- endif -%}

    <div class="blog-post-card__overlay">
      <div class="blog-post-card__content">
        <div class="blog-post-card__meta">{{ details }}</div>
        <h3 class="blog-post-card__title">{{ title }}</h3>
        <div class="blog-post-card__description">{{ description }}</div>
      </div>
    </div>
  </a>
</div>

{% stylesheet %}
  .blog-post-card {
    position: relative;
    overflow: hidden;
    height: 100%;
    min-height: 450px; /* Adjust based on your design */
    display: flex;
  }

  .blog-post-card__link-wrapper {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    text-decoration: none;
    color: #ffffff; /* White text for overlay */
  }

  .blog-post-card__image-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .blog-post-card__image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The Gradient Overlay to make text readable */
  .blog-post-card__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 60%; /* Only covers bottom half */
    background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0) 100%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2rem;
    text-align: var(--text-align);
  }

  .blog-post-card__content {
    z-index: 3;
    pointer-events: none; /* Allows clicks to go through to the link */
  }

  /* Specific styling for the elements inside the overlay */
  .blog-post-card__title {
    margin: 0.5rem 0;
    font-size: 1.5rem;
    color: #ffffff !important;
  }

  .blog-post-card__meta, 
  .blog-post-card__description {
    color: rgba(255,255,255,0.8);
    font-size: 0.9rem;
  }

  /* Remove default link padding from your previous version */
  .blog-post-card__content a {
    padding: 0;
    display: inline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "blog post card hero",
  "settings": [
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    }
  ]
}
{% endschema %}
