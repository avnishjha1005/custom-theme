{% doc %}
  Modular parallax scroll container that accepts nested parallax-slide blocks.
  Each slide uses sticky positioning to create a layered scroll effect.
{% enddoc %}

{% assign container_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .parallax-scroll-{{ container_id }} {
    display: block;
    width: 100%;
    position: relative;
    background-color: {{ block.settings.background_color }};
  }

  .parallax-scroll-{{ container_id }} > * + * {
    margin-top: {{ block.settings.section_gap }}px;
  }

  @media screen and (max-width: 749px) {
    .parallax-scroll-{{ container_id }} > * + * {
      margin-top: {{ block.settings.section_gap | times: 0.5 }}px;
    }
  }
{% endstyle %}

<parallax-scroll-{{ container_id }}
  class="parallax-scroll-{{ container_id }}"
  data-parallax-intensity="{{ block.settings.parallax_intensity }}"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</parallax-scroll-{{ container_id }}>

<script>
  (function() {
    if (customElements.get('parallax-scroll-{{ container_id }}')) return;

    class ParallaxScroll{{ container_id }} extends HTMLElement {
      constructor() {
        super();
        this.slides = [];
        this.ticking = false;
        this.intensity = parseFloat(this.dataset.parallaxIntensity) || 0.5;
        this.boundUpdateParallax = this.updateParallax.bind(this);
      }

      connectedCallback() {
        this.initSlides();
        this.setupScrollListener();
      }

      initSlides() {
        const slides = this.querySelectorAll('[data-parallax-slide]');
        slides.forEach((slide) => {
          const images = slide.querySelectorAll('[data-parallax-image]');
          images.forEach((image) => {
            this.slides.push({
              element: slide,
              image: image,
              speed: this.intensity
            });
          });
        });
      }

      setupScrollListener() {
        window.addEventListener('scroll', () => {
          if (!this.ticking) {
            window.requestAnimationFrame(() => {
              this.boundUpdateParallax();
              this.ticking = false;
            });
            this.ticking = true;
          }
        });

        this.boundUpdateParallax();
      }

      updateParallax() {
        const windowHeight = window.innerHeight;

        this.slides.forEach((item) => {
          const rect = item.element.getBoundingClientRect();

          if (rect.top <= windowHeight && rect.bottom >= 0) {
            const scrollProgress = (windowHeight - rect.top) / (windowHeight + rect.height);
            const translateY = -(scrollProgress * item.speed * 100);
            item.image.style.transform = 'translateY(' + translateY + 'px)';
          }
        });
      }

      disconnectedCallback() {
        window.removeEventListener('scroll', this.boundUpdateParallax);
      }
    }

    customElements.define('parallax-scroll-{{ container_id }}', ParallaxScroll{{ container_id }});
  })();
</script>

{% schema %}
{
  "name": "Parallax scroll",
  "tag": null,
  "blocks": [
    { "type": "parallax-slide" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Parallax Effect"
    },
    {
      "type": "range",
      "id": "parallax_intensity",
      "label": "Parallax intensity",
      "info": "Higher values create stronger parallax effect",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "default": 0.5
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "section_gap",
      "label": "Gap between slides",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Parallax scroll",
      "blocks": [
        { "type": "parallax-slide" },
        { "type": "parallax-slide" }
      ]
    }
  ]
}
{% endschema %}
