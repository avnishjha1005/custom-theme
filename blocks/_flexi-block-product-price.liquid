{%- liquid
  assign blockid = block.id

  assign spacing = block.settings.spacing
  if spacing == 'custom'
    assign dt_padding = block.settings.dt_padding
    assign mb_padding = block.settings.mb_padding
  elsif spacing == 'basic'
    assign padding_top = block.settings.padding_top
    assign padding_bottom = block.settings.padding_bottom
    assign padding_left = block.settings.padding_left
    assign padding_right = block.settings.padding_right
  endif

  assign product = block.settings.product
  assign selected_variant = product.selected_or_first_available_variant

  if product == blank
    assign price = 2495
  else
    assign price = selected_variant.price
  endif

  assign cheapest_price = product.price_max
  for variant in product.variants
    if variant.price < cheapest_price
      assign cheapest_price = variant.price
    endif
  endfor

  assign compare_at_price = selected_variant.compare_at_price
  if compare_at_price == blank or compare_at_price < cheapest_price
    assign compare_at_price = product.compare_at_price
  endif

  assign use_from = block.settings.use_from

  assign font_size = block.settings.font_size
  assign mb_font_size = block.settings.mb_font_size
  assign font_color = block.settings.font_color
  assign text_align = block.settings.text_align

  assign dev_mode = block.settings.dev_mode
  assign custom_class = block.settings.custom_class
  assign css_code = block.settings.css_code
-%}

{%- style -%}
  {% if spacing == 'basic' %}
  #{{ blockid }} {
      padding-top: {{ padding_top }}px;
      padding-bottom: {{ padding_bottom }}px;
      padding-left: {{ padding_left }}px;
      padding-right: {{ padding_right }}px;
  }
  {% elsif spacing == 'custom' %}
  @media only screen and (min-width: 768px) {
      #{{ blockid }} {
          padding: {{ dt_padding }};
      }
  }
  @media only screen and (max-width: 767.8px) {
      #{{ blockid }} {
          padding: {{ mb_padding }};
      }
  }
  {% endif %}
  #{{ blockid }} .flexi-block-wrapper {
      text-align: {{ text_align }};
  }
  #{{ blockid }} .flexi-price {
    color: {{ font_color }};
  }
  @media (min-width: 768px) {
      #{{ blockid }} .flexi-price {
          font-size: {{ font_size }}px;
      }
  }
  @media (max-width: 767.8px) {
      #{{ blockid }} .flexi-price {
          font-size: {{ mb_font_size }}px;
      }
  }
  {% if css_code != blank %}{{ css_code }}{% endif %}
{%- endstyle -%}

<div
  id="{{ blockid }}"
  class="flexi-product-price-block flexi-library u-flex u-w-fit u-h-full {% if dev_mode %}{{ custom_class }}{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="flexi-block-wrapper u-w-full">
    <h3 class="flexi-text flexi-price u-m-0 u-p-0">
      {% if compare_at_price > cheapest_price %}
        <span
          flexi-data-price-id="flexi-product-{{ product.id }}-compare"
          class="flexi-compare-at-price u-line-through u-opacity-50 u-mr-2"
        >
          {{- compare_at_price | money -}}
        </span>
      {% endif %}
      <span flexi-data-price-id="flexi-product-{{ product.id }}" class="flexi-regular-price">
        {% if use_from and product.price_varies %}
          From {{ cheapest_price | money }}
        {% else %}
          {{ price | money }}
        {% endif %}
      </span>
    </h3>
  </div>
</div>

{% schema %}
{
  "name": "Product price",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "editor",
      "label": "Editing Mode",
      "options": [
        {
          "value": "simple",
          "label": "Content"
        },
        {
          "value": "advanced",
          "label": "Customize"
        }
      ],
      "default": "simple"
    },
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "checkbox",
      "id": "use_from",
      "label": "Use 'From' prefix",
      "default": false,
      "info": "If the product price varies between options, you can display 'from' in front of the price to display the cheapest option."
    },
    {
      "type": "header",
      "content": "Price"
    },
    {
      "type": "text_alignment",
      "id": "text_align",
      "label": "Price alignment",
      "default": "left"
    },
    {
      "type": "color",
      "id": "font_color",
      "label": "Font color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 20,
      "visible_if": "{{ block.settings.editor == 'advanced' }}"
    },
    {
      "type": "range",
      "id": "mb_font_size",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 18,
      "visible_if": "{{ block.settings.editor == 'advanced' }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Padding",
      "options": [
        {
          "value": "basic",
          "label": "Basic"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "basic",
      "visible_if": "{{ block.settings.editor == 'advanced' }}"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 0,
      "visible_if": "{{ block.settings.spacing == 'basic' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0,
      "visible_if": "{{ block.settings.spacing == 'basic' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Left padding",
      "default": 0,
      "visible_if": "{{ block.settings.spacing == 'basic' and block.settings.editor == 'advanced' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Right padding",
      "default": 0,
      "visible_if": "{{ block.settings.spacing == 'basic' and block.settings.editor == 'advanced' }}"
    },
    {
      "type": "text",
      "id": "dt_padding",
      "label": "Padding (desktop)",
      "default": "0px 0px",
      "visible_if": "{{ block.settings.spacing == 'custom' and block.settings.editor == 'advanced' }}",
      "info": "Pass in CSS padding options below. Visit our documentation for a cheatsheet."
    },
    {
      "type": "text",
      "id": "mb_padding",
      "label": "Padding (mobile)",
      "default": "0px 0px",
      "visible_if": "{{ block.settings.spacing == 'custom' and block.settings.editor == 'advanced' }}"
    },
    {
      "type": "header",
      "content": "Advanced",
      "visible_if": "{{ block.settings.editor == 'advanced' }}"
    },
    {
      "type": "checkbox",
      "id": "dev_mode",
      "label": "Enable developer mode",
      "default": false,
      "info": "Enable dev mode for additional styling and debugging features.",
      "visible_if": "{{ block.settings.editor == 'advanced' }}"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom classes",
      "info": "Apply custom classes to the outer container. [View docs](https://flexi-library.gitbook.io/flexi-theme-library/docs/custom-classes)",
      "visible_if": "{{ block.settings.dev_mode == true and block.settings.editor == 'advanced' }}"
    },
    {
      "type": "liquid",
      "id": "css_code",
      "label": "Custom CSS",
      "info": "Add custom CSS specific to this block. [View docs](https://flexi-library.gitbook.io/flexi-theme-library/docs/custom-css)",
      "visible_if": "{{ block.settings.dev_mode == true and block.settings.editor == 'advanced' }}"
    }
  ],
  "presets": [
    {
      "name": "Product price",
      "category": "Flexi Blocks",
      "settings": {
        "product": "{{ closest.product }}"
      }
    }
  ]
}
{% endschema %}
