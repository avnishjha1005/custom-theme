{%- liquid
    assign blockid = block.id

    assign width = block.settings.width
    assign max_width = block.settings.max_width
  
    assign spacing = block.settings.spacing
    if spacing == 'custom'
      assign dt_padding = block.settings.dt_padding
      assign mb_padding = block.settings.mb_padding
    elsif spacing == 'basic'
      assign padding_top = block.settings.padding_top
      assign padding_bottom = block.settings.padding_bottom
      assign padding_left = block.settings.padding_left
      assign padding_right = block.settings.padding_right
    endif
  
    assign border_color = block.settings.border_color
    assign font_color = block.settings.font_color
    assign icon_color = block.settings.icon_color
    assign open = block.settings.open

    assign dev_mode = block.settings.dev_mode
    assign custom_class = block.settings.custom_class
    assign css_code = block.settings.css_code
  -%}
  
{%- style -%}
#{{ blockid }} {
  max-width: {% if width == 'fixed' %}{{ max_width }}px{% elsif width == 'full' %}100%{% endif %};
}
{% if spacing == 'basic' %}
#{{ blockid }} {
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    padding-left: {{ padding_left }}px;
    padding-right: {{ padding_right }}px;
}
{% elsif spacing == 'custom' %}
@media only screen and (min-width: 768px) {
    #{{ blockid }} {
        padding: {{ dt_padding }};
    }
}
@media only screen and (max-width: 767.8px) {
    #{{ blockid }} {
        padding: {{ mb_padding }};
    }
}
{% endif %}
#{{ blockid }} .flexi-accordion-item {
  border-color: {{ border_color }};
}
#{{ blockid }} .flexi-accordion-button {
  color: {{ font_color }};
}
#{{ blockid }} .flexi-accordion-text p,
#{{ blockid }} .flexi-accordion-text h1,
#{{ blockid }} .flexi-accordion-text h2,
#{{ blockid }} .flexi-accordion-text h3,
#{{ blockid }} .flexi-accordion-text h4,
#{{ blockid }} .flexi-accordion-text h5,
#{{ blockid }} .flexi-accordion-text ul,
#{{ blockid }} .flexi-accordion-text ol,
#{{ blockid }} .flexi-accordion-text li {
  color: {{ font_color }};
}
{% if css_code != blank %}{{ css_code }}{% endif %}
{%- endstyle -%}

  <div id="{{ blockid }}" class="flexi-accordion-block flexi-library u-w-full u-h-full {% if dev_mode %}{{ custom_class }}{% endif %}" {{ block.shopify_attributes }}>
    <div class="u-w-full u-overflow-hidden">
        {% for i in (1..5) %}
            {% assign text_var = "accordion_" | append: i | append: "_text" %}
            {% assign desc_var = "accordion_" | append: i | append: "_description" %}
            {% assign text = block.settings[text_var] %}
            {% assign description = block.settings[desc_var] %}
            {% if text != blank %}
                <div 
                    x-data="{% if forloop.index == 1 and open %}{ isExpanded: true }{% else %}{ isExpanded: false }{% endif %}" 
                    x-cloak 
                    class="flexi-accordion-item u-border-solid u-border-r-0 u-border-l-0 u-border-b first:u-border-t"
                >
                    <button 
                        id="controlsAccordionItem{{ forloop.index }}" 
                        type="button" 
                        class="flexi-accordion-button !u-flex u-w-full u-items-center u-justify-between u-gap-4 u-p-4 u-text-left u-underline-offset-2 u-bg-transparent u-border-none u-cursor-pointer" 
                        aria-controls="accordionItem{{ forloop.index }}" 
                        @click="isExpanded = ! isExpanded" :aria-expanded="isExpanded ? 'true' : 'false'"
                    >
                        {{ text }}
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke="{{ icon_color }}" class="u-size-4 u-shrink-0 flexi-rotate-icon" aria-hidden="true" :class="isExpanded  ?  'flexi-rotate-icon--active'  :  ''">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
                        </svg>
                    </button>
                    <div 
                        x-cloak 
                        x-show="isExpanded" 
                        id="accordionItem{{ forloop.index }}" 
                        role="region" 
                        aria-labelledby="controlsAccordionItem{{ forloop.index }}" 
                        x-collapse
                    >
                        <div class="flexi-accordion-text flexi-description p-default u-text-left u-p-4 u-pt-0">
                            {{ description }}
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    </div>
  </div>
  
