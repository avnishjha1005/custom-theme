{% comment %}
  Size Guide Drawer Block
  Uses a Metaobject list to handle multiple vendors.
  Structure: product.metafields.custom.selected_size_guide.value

  How to Measure: Auto-matched based on product.type
  Categories: clothing, footwear, jewelry (add more as needed)
{% endcomment %}

{%- assign guides = product.metafields.custom.selected_size_guide.value -%}

{% comment %}
  PRODUCT TYPE → MEASUREMENT CATEGORY MAPPING
  Edit these lists to match your store's product types
{% endcomment %}
{%- assign footwear_types = 'shoes,shoe,footwear,sandals,sandal,boots,boot,heels,heel,sneakers,sneaker,loafers,flats,mules,slides' | split: ',' -%}
{%- assign jewelry_types = 'rings,ring,bracelets,bracelet,necklaces,necklace,earrings,earring,jewelry,jewellery,bangles,pendant,chain' | split: ',' -%}
{%- assign bags_types = 'bags,bag,handbags,handbag,purse,clutch,tote,backpack,satchel' | split: ',' -%}
{%- assign product_type_lower = product.type | downcase | strip -%}
{%- assign measurement_category = 'clothing' -%}

{%- for type in footwear_types -%}
  {%- if product_type_lower contains type -%}
    {%- assign measurement_category = 'footwear' -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- if measurement_category == 'clothing' -%}
  {%- for type in jewelry_types -%}
    {%- if product_type_lower contains type -%}
      {%- assign measurement_category = 'jewelry' -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if measurement_category == 'clothing' -%}
  {%- for type in bags_types -%}
    {%- if product_type_lower contains type -%}
      {%- assign measurement_category = 'bags' -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{% comment %} Fallback: Tops, Jackets, Dresses, Pants, etc. all map to 'clothing' {% endcomment %}

{% comment %}
  Find matching measurement instructions directly from metaobjects.
  The metaobject entry HANDLE must match the category key (clothing, footwear, jewelry, bags)
{% endcomment %}
{% assign how_to_measure = shop.metaobjects['measurement_instructions'][measurement_category] %}


{%- if guides != blank -%}
  <div class="btn-wrapper">
  <button type="button" class="sg-trigger-btn" onclick="toggleSizeDrawer(true)">
    Size Guide
  </button>
</div>

  <div id="SizeDrawerOverlay" class="sg-overlay" onclick="toggleSizeDrawer(false)"></div>

  <div id="SizeDrawer" class="sg-drawer">
    <div class="sg-header">
      <h2 class="sg-title">Product Measurements</h2>
      <button class="sg-close-icon" onclick="toggleSizeDrawer(false)" aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <div class="sg-body">
      <div class="sg-vendor-tabs">
        {% comment %} How to Measure tab - always first if available {% endcomment %}
        {%- if how_to_measure -%}
          <button class="sg-tab-link active"
                  onclick="openVendorTab(event, 'how-to-measure')">
            HOW TO MEASURE
          </button>
        {%- endif -%}

        {% comment %} Vendor/Brand tabs {% endcomment %}
        {%- for guide in guides -%}
          <button class="sg-tab-link {% if how_to_measure == nil and forloop.first %}active{% endif %}"
                  onclick="openVendorTab(event, 'vendor-{{ forloop.index }}')">
            {{ guide.vendor_name | upcase }} SIZE GUIDE
          </button>
        {%- endfor -%}
      </div>

      {% comment %} How to Measure content panel {% endcomment %}
      {%- if how_to_measure -%}
        <div id="how-to-measure" class="sg-vendor-content active">
          {%- if how_to_measure.image -%}
            <div class="sg-illustration">
              <img src="{{ how_to_measure.image | image_url: width: 700 }}" loading="lazy" alt="{{ how_to_measure.title | default: 'How to Measure' }}" height="auto" width="auto">
            </div>
          {%- endif -%}
          <div class="sg-htm-instructions">
            {{ how_to_measure.instructions }}
          </div>
        </div>
      {%- endif -%}

      {% comment %} Vendor size guide content panels {% endcomment %}
      {%- for guide in guides -%}
        <div id="vendor-{{ forloop.index }}" class="sg-vendor-content {% if how_to_measure == nil and forloop.first %}active{% endif %}">
          
          <p class="sg-disclaimer">
            {{ guide.disclaimer | default: "Each item is measured to help you choose the correct fit. Please refer to the garment's measurements below to select the appropriate size." }}
          </p>

          {%- if guide.image -%}
            <div class="sg-illustration">
              <img src="{{ guide.image | image_url: width: 700 }}" loading="lazy" alt="Measurement Guide" height="auto" width="auto">
            </div>
          {%- endif -%}

          {%- assign has_cm = guide.sizes.value.centimeters | size | plus: 0 -%}
          {%- assign has_in = guide.sizes.value.inches | size | plus: 0 -%}

          {%- if has_cm > 0 and has_in > 0 -%}
            <div class="sg-unit-toggle">
              <button class="unit-btn active" onclick="switchSgUnit(this, 'cm', '{{ forloop.index }}')">CM</button>
              <button class="unit-btn" onclick="switchSgUnit(this, 'in', '{{ forloop.index }}')">IN</button>
            </div>
          {%- endif -%}

          <div class="sg-table-container-{{ forloop.index }}">
            {%- if has_cm > 0 -%}
              {% comment %} Centimeters Table {% endcomment %}
              <div class="sg-unit-table unit-cm" style="display: block;">
                <table>
                  <thead>
                    <tr>
                      {%- for col in guide.sizes.value.centimeters[0] -%}
                        <th>{{ col[0] }}</th>
                      {%- endfor -%}
                    </tr>
                  </thead>
                  <tbody>
                    {%- for row in guide.sizes.value.centimeters -%}
                      <tr>
                        {%- for cell in row -%}<td>{{ cell[1] }}</td>{%- endfor -%}
                      </tr>
                    {%- endfor -%}
                  </tbody>
                </table>
              </div>
            {%- endif -%}

            {%- if has_in > 0 -%}
              {% comment %} Inches Table {% endcomment %}
              <div class="sg-unit-table unit-in" style="display: {% if has_cm > 0 %}none{% else %}block{% endif %};">
                <table>
                  <thead>
                    <tr>
                      {%- for col in guide.sizes.value.inches[0] -%}
                        <th>{{ col[0] }}</th>
                      {%- endfor -%}
                    </tr>
                  </thead>
                  <tbody>
                    {%- for row in guide.sizes.value.inches -%}
                      <tr>
                        {%- for cell in row -%}<td>{{ cell[1] }}</td>{%- endfor -%}
                      </tr>
                    {%- endfor -%}
                  </tbody>
                </table>
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <style>
     .group-block-content:has(> variant-picker) {
      justify-content:space-between;
      align-items:end;
      display:flex;
    }
    @media screen and (max-width:768px){
      .btn-wrapper{
      width:100%;
      display:flex;
      justify-content:flex-end;
      }
      .group-block-content:has(> variant-picker) {
      justify-content:flex-end;
      align-items:end;
      display:flex;
      flex-direction: column;
      }
    }

    /* Trigger */
    .sg-trigger-btn {
      background: none;
      border:none;
      cursor: pointer;
      font-size: 10px;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    /* Drawer Core */
    .sg-drawer {
      position: fixed;
      top: 0;
      right: -100%;
      width: 450px;
      height: 100%;
      background: #fff;
      z-index: 9999;
      transition: right 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      display: flex;
      flex-direction: column;
      box-shadow: -10px 0 20px rgba(0,0,0,0.05);
    }
    .sg-drawer.is-open { right: 0; }
    
    .sg-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.4);
      z-index: 9998;
      opacity: 0;
      visibility: hidden;
      transition: 0.3s;
    }
    .sg-overlay.is-open { opacity: 1; visibility: visible; }

    @media (max-width: 768px) {
      .sg-drawer { width: 100%; }
    }

    /* Header & Tabs */
    .sg-header {
      padding: 25px 25px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .sg-title {
      font-family: Inter, sans-serif;
      font-weight: 400;
      font-size: 16px;
      line-height: 20px;
      letter-spacing: 0;
      margin: 0;
    }
    .sg-close-icon { background: none; border: none; cursor: pointer; }

    .sg-body { padding: 0 25px 25px; overflow-y: auto; }
    .sg-vendor-tabs { display: flex; flex-wrap: wrap; gap: 15px 20px; margin-bottom: 20px; padding-bottom: 0; }
    
    .sg-tab-link {
      background: none;
      border: none;
      padding: 10px 0;
      font-family: Inter, sans-serif;
      font-weight: 500;
      font-size: 10px;
      line-height: 12px;
      letter-spacing: 0;
      text-transform: uppercase;
      color: #aaa;
      cursor: pointer;
      border-bottom: 2px solid transparent;
    }
    .sg-tab-link.active {
      font-family: Inter, sans-serif;
      font-weight: 700;
      font-size: 10px;
      line-height: 12px;
      letter-spacing: 0;
      text-transform: uppercase;
      text-decoration: underline;
      text-decoration-style: solid;
      color: #000;
      border-bottom: none;
    }

    .sg-vendor-content { display: none; }
    .sg-vendor-content.active { display: block; }

    /* Content & Table */
    .sg-disclaimer { font-size: 11px; line-height: 1.6; color: #666; margin-bottom: 20px; }
    .sg-illustration img { width: 100%; height: auto; margin-bottom: 20px; }

    .sg-unit-toggle { display: flex; gap: 15px; margin-bottom: 15px; }
    .unit-btn { background: none; border: none; font-size: 11px; font-weight: bold; cursor: pointer; color: #ccc; padding: 0; }
    .unit-btn.active { color: #000; text-decoration: underline; text-underline-offset: 4px; }

    .sg-unit-table table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .sg-unit-table th { text-align: left; padding: 12px 5px; border-bottom: 1px solid #000; text-transform: uppercase; font-size: 10px; }
    .sg-unit-table td { padding: 12px 5px; border-bottom: 1px solid #eee; color: #444; }

    /* How to Measure Instructions */
    .sg-htm-instructions {
      font-size: 13px;
      line-height: 1.7;
      color: #444;
    }
    .sg-htm-instructions ol,
    .sg-htm-instructions ul {
      padding-left: 20px;
      margin: 10px 0;
    }
    .sg-htm-instructions li { margin-bottom: 8px; }
  </style>

  <script>
    function toggleSizeDrawer(open) {
      const drawer = document.getElementById('SizeDrawer');
      const overlay = document.getElementById('SizeDrawerOverlay');
      if (open) {
        drawer.classList.add('is-open');
        overlay.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      } else {
        drawer.classList.remove('is-open');
        overlay.classList.remove('is-open');
        document.body.style.overflow = '';
      }
    }

    function openVendorTab(evt, tabId) {
      const body = evt.currentTarget.closest('.sg-body');
      body.querySelectorAll('.sg-vendor-content').forEach(c => c.classList.remove('active'));
      body.querySelectorAll('.sg-tab-link').forEach(t => t.classList.remove('active'));
      document.getElementById(tabId).classList.add('active');
      evt.currentTarget.classList.add('active');
    }

    function switchSgUnit(btn, unit, index) {
      const container = document.querySelector('.sg-table-container-' + index);
      btn.parentElement.querySelectorAll('.unit-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      container.querySelector('.unit-cm').style.display = (unit === 'cm') ? 'block' : 'none';
      container.querySelector('.unit-in').style.display = (unit === 'in') ? 'block' : 'none';
    }

  </script>
{%- endif -%}

{% schema %}
{
  "name": "Size Guide Drawer",
  "settings": [
    {
      "type": "paragraph",
      "content": "This block automatically pulls data from the 'selected_size_guide' product metafield. Ensure your Metaobject entries contain the required JSON structure."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Size Guide"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Text Color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Size Guide Drawer"
    }
  ]
}
{% endschema %}
