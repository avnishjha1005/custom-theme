{% comment %}
  Blog post content with embedded featured products banner
  Splits content at midpoint and inserts product banner in between
  Uses _product-card blocks for consistent styling (same as _bundle-products.liquid)
{% endcomment %}

{% liquid
  # Get products from article metafield (list.product_reference)
  assign banner_products = article.metafields.custom.banner_products.value

  # Split article content by paragraphs to insert banner in the middle
  assign content_html = article.content

  # Split by closing </p> tags to count paragraphs
  assign paragraphs = content_html | split: '</p>'
  assign total_paragraphs = paragraphs.size
  assign midpoint = total_paragraphs | divided_by: 2

  # Build first half and second half
  assign content_before = ''
  assign content_after = ''

  for para in paragraphs
    if para != blank
      if forloop.index <= midpoint
        assign content_before = content_before | append: para | append: '</p>'
      else
        assign content_after = content_after | append: para | append: '</p>'
      endif
    endif
  endfor
%}

<div class="blog-post-content-with-products">
  {% comment %} First half of blog content {% endcomment %}
  <div class="blog-post-content rte">
    <rte-formatter>
      {{ content_before }}
    </rte-formatter>
  </div>

  {% comment %} Featured Products Banner — only renders if metafield is set {% endcomment %}
  {% if banner_products != blank and banner_products.size > 0 %}
    <div class="blog-featured-products color-{{ block.settings.color_scheme }} gradient">
      <div class="blog-featured-products__inner page-width">
        {% if block.settings.heading != blank %}
          <h4 class="blog-featured-products__heading">{{ block.settings.heading }}</h4>
        {% endif %}

        {% capture slideshow_arrows %}
          {% render 'slideshow-arrows', icon_style: 'chevron_large', icon_shape: 'circle', arrows_position: 'center' %}
        {% endcapture %}

        {% capture all_slides %}
          {% for product in banner_products %}
            {% capture slide_content %}
              {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
            {% endcapture %}
            {% render 'slideshow-slide', index: forloop.index0, children: slide_content, class: 'resource-list__slide blog-featured-products__slide' %}
          {% endfor %}
        {% endcapture %}

        <div class="blog-featured-products__carousel resource-list__carousel">
          {% render 'slideshow',
            ref: 'blogFeaturedProducts',
            slides: all_slides,
            slideshow_arrows: slideshow_arrows,
            slide_count: banner_products.size,
            infinite: false,
            initial_slide: 0,
            auto_hide_controls: false,
            slideshow_gutters: 'start end'
          %}
        </div>
      </div>
    </div>
  {% endif %}

  {% comment %} Second half of blog content {% endcomment %}
  {% if content_after != blank %}
    <div class="blog-post-content rte">
      <rte-formatter>
        {{ content_after }}
      </rte-formatter>
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .blog-post-content-with-products {
    width: 100%;
  }

  .blog-post-content {
    max-width: inherit;
    margin: 0 auto;
  }

  /* Full-width filmstrip — same pattern as .article-filmstrip-container */
  .blog-featured-products {
    width: 100vw;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    padding: 48px 0;
    margin: 48px 0;
    overflow-x: hidden;
  }

  .quick-add__button {
    color: white !important;
  }

  .blog-featured-products__inner {
    margin: 0 auto;
  }

  .blog-featured-products__heading {
    font-size: 0.875rem;
    font-weight: 500;
    /* Align heading with the article text left edge */
    padding-inline-start: max(var(--page-margin, 1.5rem), calc((100vw - 800px) / 2));
    margin: 0 0 16px;
    text-align: left;
  }

  .blog-featured-products__carousel {
    --slide-width-max: 300px;
    --resource-list-column-gap: 16px;
    /* Align first slide with article text left edge — mirrors .article-filmstrip padding-left */
    --gutter-slide-width: max(var(--page-margin, 1.5rem), calc((100vw - 800px) / 2));
    width: 100%;
    position: relative;
  }

  .blog-featured-products__slide {
    width: 260px;
  }

  /* Force consistent portrait aspect ratio for all product images in the slider */
  .blog-featured-products__slide .product-media-container {
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .blog-featured-products__slide .product-media-container img,
  .blog-featured-products__slide .product-media-container video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  /* Ensure the slideshow inside the product card fills the fixed container */
  .blog-featured-products__slide .product-media-gallery__slideshow,
  .blog-featured-products__slide slideshow-slides {
    height: 100%;
  }

  @media screen and (max-width: 749px) {
    .blog-featured-products {
      padding: 32px 0;
      margin: 32px 0;
    }

    .blog-featured-products__heading {
      padding-inline-start: var(--page-margin, 1rem);
    }

    .blog-featured-products__carousel {
      --gutter-slide-width: var(--page-margin, 1rem);
    }

    .blog-featured-products__slide {
      width: 60vw;
    }

    .blog-featured-products__slide .product-media-container {
      aspect-ratio: 3 / 4;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Content with Products",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Featured Products Banner"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the Look"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Content with Products"
    }
  ]
}
{% endschema %}
