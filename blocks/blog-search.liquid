<script>
  (function() {
    class BlogSearch{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.searchIcon = this.querySelector('.ai-blog-search-icon-{{ ai_gen_id }}');
        this.overlay = this.querySelector('.ai-blog-search-overlay-{{ ai_gen_id }}');
        this.modal = this.querySelector('.ai-blog-search-modal-{{ ai_gen_id }}');
        this.drawer = this.querySelector('.ai-blog-search-drawer-{{ ai_gen_id }}');
        this.backButtons = this.querySelectorAll('.ai-blog-search-back-{{ ai_gen_id }}');
        this.inputs = this.querySelectorAll('.ai-blog-search-input-{{ ai_gen_id }}');
        this.resultsContainers = this.querySelectorAll('.ai-blog-search-results-{{ ai_gen_id }}');
        this.blogHandle = this.getAttribute('data-blog-handle');
        this.searchTimeout = null;
      }

      connectedCallback() {
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.searchIcon.addEventListener('click', () => this.openSearch());
        this.overlay.addEventListener('click', () => this.closeSearch());
        
        this.backButtons.forEach(button => {
          button.addEventListener('click', () => this.closeSearch());
        });

        this.inputs.forEach(input => {
          input.addEventListener('input', (e) => {
            const otherInput = Array.from(this.inputs).find(i => i !== e.target);
            if (otherInput) {
              otherInput.value = e.target.value;
            }
            this.handleSearch(e.target.value);
          });
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            this.closeSearch();
          }
        });
      }

      openSearch() {
        this.overlay.classList.add('active');
        this.modal.classList.add('active');
        this.drawer.classList.add('active');
        document.body.style.overflow = 'hidden';
        
        setTimeout(() => {
          this.inputs[0].focus();
        }, 100);
      }

      closeSearch() {
        this.overlay.classList.remove('active');
        this.modal.classList.remove('active');
        this.drawer.classList.remove('active');
        document.body.style.overflow = '';
        
        this.inputs.forEach(input => {
          input.value = '';
        });
        
        this.resultsContainers.forEach(container => {
          container.innerHTML = '<div class="ai-blog-search-empty-{{ ai_gen_id }}">{{ block.settings.empty_message }}</div>';
        });
      }

      handleSearch(query) {
        clearTimeout(this.searchTimeout);
        
        if (query.length < 1) {
          this.resultsContainers.forEach(container => {
            container.innerHTML = '<div class="ai-blog-search-empty-{{ ai_gen_id }}">{{ block.settings.empty_message }}</div>';
          });
          return;
        }

        this.resultsContainers.forEach(container => {
          container.innerHTML = '<div class="ai-blog-search-loading-{{ ai_gen_id }}">Searching...</div>';
        });

        this.searchTimeout = setTimeout(() => {
          this.performSearch(query);
        }, 300);
      }

      async performSearch(query) {
        try {
          // Fetch articles directly from the blog
          let articles = [];
          const queryLower = query.toLowerCase();
          
          if (this.blogHandle) {
            // Try to fetch from the blog's articles
            const blogUrl = `/blogs/${this.blogHandle}`;
            
            // First, try to get articles via the Shopify API
            try {
              const response = await fetch(`${blogUrl}/articles.json`);
              if (response.ok) {
                const data = await response.json();
                articles = data.articles || [];
              }
            } catch (e) {
              console.log('Articles API not available, trying search suggest');
            }
            
            // Fallback to search suggest API
            if (articles.length === 0) {
              const searchParams = new URLSearchParams({
                q: query,
                type: 'article',
                resources: JSON.stringify({
                  type: 'article',
                  limit: 20
                })
              });

              const response = await fetch(`/search/suggest.json?${searchParams.toString()}`);
              
              if (response.ok) {
                const data = await response.json();
                articles = data.resources?.results?.articles || [];
                
                // Filter to current blog
                articles = articles.filter(article => {
                  const articleBlogHandle = article.url.split('/blogs/')[1]?.split('/')[0];
                  return articleBlogHandle === this.blogHandle;
                });
              }
            }
          } else {
            // Search all blogs
            const searchParams = new URLSearchParams({
              q: query,
              type: 'article',
              resources: JSON.stringify({
                type: 'article',
                limit: 20
              })
            });

            const response = await fetch(`/search/suggest.json?${searchParams.toString()}`);
            
            if (response.ok) {
              const data = await response.json();
              articles = data.resources?.results?.articles || [];
            }
          }

          // Perform client-side filtering for partial matches
          const filteredArticles = articles.filter(article => {
            const title = (article.title || '').toLowerCase();
            const body = (article.body_safe || article.content || '').toLowerCase();
            const tags = (article.tags || []).map(tag => tag.toLowerCase());
            
            // Check if query matches title (partial)
            const titleMatch = title.includes(queryLower);
            
            // Check if query matches any tag (partial)
            const tagMatch = tags.some(tag => tag.includes(queryLower));
            
            // Check if query matches body content (partial)
            const bodyMatch = body.includes(queryLower);
            
            return titleMatch || tagMatch || bodyMatch;
          });

          if (filteredArticles.length === 0) {
            this.resultsContainers.forEach(container => {
              container.innerHTML = '<div class="ai-blog-search-empty-{{ ai_gen_id }}">{{ block.settings.no_results_message }}</div>';
            });
            return;
          }

          const searchTermsLower = query.toLowerCase().split(' ').filter(term => term.length > 0);
          let resultsHTML = '';

          filteredArticles.forEach(article => {
            const title = this.escapeHtml(article.title);
            const bodyContent = article.body_safe || article.content || article.body_html || '';
            const excerpt = bodyContent ? this.stripHtml(bodyContent).substring(0, 150) + '...' : '';
            const tags = article.tags || [];
            
            const highlightedTitle = this.highlightText(title, searchTermsLower);
            const highlightedExcerpt = this.highlightText(excerpt, searchTermsLower);

            let tagsHTML = '';
            if (tags.length > 0 && {{ block.settings.show_tags }}) {
              tagsHTML = '<div class="ai-blog-search-result-tags-{{ ai_gen_id }}">';
              tags.forEach(tag => {
                const highlightedTag = this.highlightText(this.escapeHtml(tag), searchTermsLower);
                tagsHTML += `<span class="ai-blog-search-result-tag-{{ ai_gen_id }}">${highlightedTag}</span>`;
              });
              tagsHTML += '</div>';
            }

            resultsHTML += `
              <a href="${article.url}" class="ai-blog-search-result-{{ ai_gen_id }}">
                <h3 class="ai-blog-search-result-title-{{ ai_gen_id }}">${highlightedTitle}</h3>
                ${highlightedExcerpt ? `<p class="ai-blog-search-result-excerpt-{{ ai_gen_id }}">${highlightedExcerpt}</p>` : ''}
                ${tagsHTML}
              </a>
            `;
          });

          this.resultsContainers.forEach(container => {
            container.innerHTML = resultsHTML;
          });
        } catch (error) {
          console.error('Search error:', error);
          this.resultsContainers.forEach(container => {
            container.innerHTML = '<div class="ai-blog-search-empty-{{ ai_gen_id }}">{{ block.settings.error_message }}</div>';
          });
        }
      }

      highlightText(text, searchTerms) {
        let highlightedText = text;
        
        searchTerms.forEach(term => {
          if (term.length < 2) return;
          
          const regex = new RegExp(`(${this.escapeRegex(term)})`, 'gi');
          highlightedText = highlightedText.replace(regex, '<span class="ai-blog-search-highlight-{{ ai_gen_id }}">$1</span>');
        });
        
        return highlightedText;
      }

      escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      }

      stripHtml(html) {
        const div = document.createElement('div');
        div.innerHTML = html;
        return div.textContent || div.innerText || '';
      }

      escapeRegex(string) {
        return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      }
    }

    customElements.define('blog-search-{{ ai_gen_id }}', BlogSearch{{ ai_gen_id }});
  })();
</script>

