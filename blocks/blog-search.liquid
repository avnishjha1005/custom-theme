{% doc %}
  @prompt
    Create a search component... [Refined for partial matches, tag search, and blog-specific filtering]
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% comment %} Detect the current blog or fallback {% endcomment %}
{% if blog %}
  {% assign current_blog = blog %}
{% elsif article %}
  {% assign current_blog = blogs[article.blog_handle] %}
{% else %}
  {% assign current_blog = blogs[block.settings.fallback_blog] %}
{% endif %}

{% comment %} Extract unique tags from the last 50 articles, limit to 6 {% endcomment %}
{% assign all_tags = '' %}
{% if current_blog %}
  {% for article in current_blog.articles limit: 50 %}
    {% for tag in article.tags %}
      {% unless all_tags contains tag %}
        {% capture all_tags %}{{ all_tags }}{% if all_tags != '' %},{% endif %}{{ tag }}{% endcapture %}
      {% endunless %}
    {% endfor %}
  {% endfor %}
{% endif %}
{% assign tag_array = all_tags | split: ',' %}

{% style %}
  .ai-blog-search-{{ ai_gen_id }} { display: block; width: 100%; font-family: inherit; overflow: hidden; }
  .ai-blog-search-bar-{{ ai_gen_id }} {
    justify-self: center;
    display: flex; align-items: center; gap: {{ block.settings.gap }}px;
    padding: {{ block.settings.padding }}px;
    background-color: transparent;
    border: none;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }
  .ai-blog-search-icon-{{ ai_gen_id }} {
    background: none; border: none; flex-shrink: 0;
    width: {{ block.settings.icon_size }}px; height: {{ block.settings.icon_size }}px;
    min-width: {{ block.settings.icon_size }}px;
    cursor: pointer; color: {{ block.settings.icon_color }}; transition: color 0.2s;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ai-blog-search-tags-{{ ai_gen_id }} { flex: 1; overflow-x: auto; scrollbar-width: none; min-width: 0; }
  .ai-blog-search-tags-{{ ai_gen_id }}::-webkit-scrollbar { display: none; }
  .ai-blog-search-tags-list-{{ ai_gen_id }} { display: flex; align-items: center; gap: 24px; list-style: none; margin: 0; padding: 0; white-space: nowrap; }

  /* Mobile specific fixes */
  @media screen and (max-width: 749px) {
    .ai-blog-search-bar-{{ ai_gen_id }} {
      justify-self: start;
      padding-left: 0;
      gap: {{ block.settings.gap | divided_by: 2 }}px;
    }
    .ai-blog-search-icon-{{ ai_gen_id }} {
      margin-left: 0;
    }
  }
  .ai-blog-search-view-all-{{ ai_gen_id }} {
    display: inline-block;
    color: {{ block.settings.tag_text_color }};
    text-decoration: underline;
    font-size:  {{ block.settings.tag_font_size }}
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-blog-search-tag-link-{{ ai_gen_id }} {
    display: inline-block;
    background-color: transparent;
    color: {{ block.settings.tag_text_color }};
    text-decoration: none;
    font-size: {{ block.settings.tag_font_size }}
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border: none;
    padding: 0;
  }
  .ai-blog-search-tag-link-{{ ai_gen_id }}:hover {
    text-decoration: underline;
  }

  /* Overlay and Modals */
  .ai-blog-search-overlay-{{ ai_gen_id }} {
    position: fixed; inset: 0; background: rgba(0,0,0,0.5);
    z-index: 9998; opacity: 0; visibility: hidden; transition: 0.3s;
  }
  .ai-blog-search-overlay-{{ ai_gen_id }}.active { opacity: 1; visibility: visible; }

  .ai-blog-search-modal-{{ ai_gen_id }}, .ai-blog-search-drawer-{{ ai_gen_id }} {
    position: fixed; background: {{ block.settings.modal_background }};
    z-index: 9999; visibility: hidden; transition: 0.3s; display: flex; flex-direction: column;
  }

  /* Desktop Modal */
  @media screen and (min-width: 750px) {
    .ai-blog-search-modal-{{ ai_gen_id }} {
      top: 20%; left: 50%; transform: translateX(-50%) translateY(-20px);
      width: 600px; max-height: 400px; border-radius: 12px; opacity: 0;
    }
    .ai-blog-search-modal-{{ ai_gen_id }}.active { visibility: visible; opacity: 1; transform: translateX(-50%) translateY(0); }
    .ai-blog-search-drawer-{{ ai_gen_id }} { display: none; }
  }

  /* Mobile Drawer */
  @media screen and (max-width: 749px) {
    .ai-blog-search-drawer-{{ ai_gen_id }} {
      bottom: 0; left: 0; width: 100%; height: 80vh;
      transform: translateY(100%); border-radius: 20px 20px 0 0;
    }
    .ai-blog-search-drawer-{{ ai_gen_id }}.active { visibility: visible; transform: translateY(0); }
    .ai-blog-search-modal-{{ ai_gen_id }} { display: none; }
  }

  .ai-blog-search-header-{{ ai_gen_id }} { display: flex; align-items: center; padding: 15px; border-bottom: 1px solid #eee; }
  .ai-blog-search-input-{{ ai_gen_id }} { flex: 1; border: none; padding: 10px; font-size: 16px; outline: none; background: transparent; }
  .ai-blog-search-results-{{ ai_gen_id }} { flex: 1; overflow-y: auto; padding: 10px; }
  .ai-blog-search-result-item { padding: 12px; border-bottom: 1px solid #f0f0f0; display: block; text-decoration: none; color: #333; }
  .ai-blog-search-highlight-{{ ai_gen_id }} { background: {{ block.settings.highlight_color }}; font-weight: bold; }
{% endstyle %}

<blog-search-{{ ai_gen_id }} data-blog-handle="{{ current_blog.handle }}">
  <div class="ai-blog-search-bar-{{ ai_gen_id }}">
    <button class="ai-blog-search-icon-{{ ai_gen_id }}" aria-label="Open Search">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
    </button>
    <div class="ai-blog-search-tags-{{ ai_gen_id }}">
      <ul class="ai-blog-search-tags-list-{{ ai_gen_id }}">
        <li><a href="{{ current_blog.url }}" class="ai-blog-search-view-all-{{ ai_gen_id }}">View All</a></li>
        {% for tag in tag_array limit: 6 %}
          <li><a href="{{ current_blog.url }}/tagged/{{ tag | handle }}" class="ai-blog-search-tag-link-{{ ai_gen_id }}">{{ tag }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="ai-blog-search-overlay-{{ ai_gen_id }}"></div>

  {% capture search_ui %}
    <div class="ai-blog-search-header-{{ ai_gen_id }}">
      <button class="ai-blog-search-icon-{{ ai_gen_id }} back-btn" style="transform: rotate(180deg)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      </button>
      <input type="text" class="ai-blog-search-input-{{ ai_gen_id }}" placeholder="Search posts or tags...">
    </div>
    <div class="ai-blog-search-results-{{ ai_gen_id }}"></div>
  {% endcapture %}

  <div class="ai-blog-search-modal-{{ ai_gen_id }}">{{ search_ui }}</div>
  <div class="ai-blog-search-drawer-{{ ai_gen_id }}">{{ search_ui }}</div>
</blog-search-{{ ai_gen_id }}>

<script>
  if (!customElements.get('blog-search-{{ ai_gen_id }}')) {
    customElements.define('blog-search-{{ ai_gen_id }}', class extends HTMLElement {
      constructor() {
        super();
        this.blogHandle = this.dataset.blogHandle;
        this.overlay = this.querySelector('.ai-blog-search-overlay-{{ ai_gen_id }}');
        this.container = window.innerWidth > 749 
          ? this.querySelector('.ai-blog-search-modal-{{ ai_gen_id }}') 
          : this.querySelector('.ai-blog-search-drawer-{{ ai_gen_id }}');
        
        this.input = this.container.querySelector('input');
        this.resultsDiv = this.container.querySelector('.ai-blog-search-results-{{ ai_gen_id }}');
        
        this.querySelector('.ai-blog-search-icon-{{ ai_gen_id }}').onclick = () => this.toggle(true);
        this.overlay.onclick = () => this.toggle(false);
        this.container.querySelector('.back-btn').onclick = () => this.toggle(false);
        
        this.input.oninput = (e) => this.debounceSearch(e.target.value);
      }

      toggle(open) {
        this.overlay.classList.toggle('active', open);
        this.container.classList.toggle('active', open);
        if (open) setTimeout(() => this.input.focus(), 100);
      }

      debounceSearch(query) {
        clearTimeout(this.timer);
        if (query.length < 2) { this.resultsDiv.innerHTML = ''; return; }
        this.timer = setTimeout(() => this.performSearch(query), 300);
      }

      async performSearch(query) {
        // Fix 1: Use wildcard * for partial matches and explicitly request tag fields
        const searchUrl = `/search/suggest.json?q=${encodeURIComponent(query)}*&resources[type]=article&resources[options][fields]=title,body,tag,author`;
        
        try {
          const response = await fetch(searchUrl);
          const data = await response.json();
          const articles = data.resources.results.articles || [];

          // Fix 2: Better blog filtering
          const filtered = articles.filter(a => a.url.includes(`/blogs/${this.blogHandle}`));

          if (filtered.length === 0) {
            this.resultsDiv.innerHTML = '<p style="padding:20px; text-align:center;">No results found.</p>';
            return;
          }

          this.resultsDiv.innerHTML = filtered.map(a => `
            <a href="${a.url}" class="ai-blog-search-result-item">
              <div style="font-weight:600">${this.highlight(a.title, query)}</div>
              <div style="font-size:12px; color: #666">${a.summary ? this.highlight(a.summary, query) : ''}</div>
            </a>
          `).join('');
        } catch (e) {
          console.error("Search error", e);
        }
      }

      highlight(text, query) {
        const regex = new RegExp(`(${query})`, 'gi');
        return text.replace(regex, `<span class="ai-blog-search-highlight-{{ ai_gen_id }}">$1</span>`);
      }
    });
  }
</script>

