{% comment %}
  Blog Search Component for AltaRasa - Styled to match design
  Preserves all existing functionality
{% endcomment %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% if blog %}
  {% assign current_blog = blog %}
{% else %}
  {% assign current_blog = blogs[block.settings.fallback_blog] %}
{% endif %}

{% assign all_tags = '' %}
{% if current_blog %}
  {% for article in current_blog.articles limit: 50 %}
    {% for tag in article.tags %}
      {% unless all_tags contains tag %}
        {% if all_tags == '' %}
          {% assign all_tags = tag %}
        {% else %}
          {% assign all_tags = all_tags | append: ',' | append: tag %}
        {% endif %}
      {% endunless %}
    {% endfor %}
  {% endfor %}
{% endif %}

{% assign tag_array = all_tags | split: ',' %}

{% style %}
  .ai-blog-search-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-blog-search-bar-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 0;
    background-color: transparent;
    border: none;
    border-radius: 0;
  }

  .ai-blog-search-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    cursor: pointer;
    color: #2c2c2c;
    transition: color 0.2s ease;
  }

  .ai-blog-search-icon-{{ ai_gen_id }}:hover {
    color: #000000;
  }

  .ai-blog-search-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-blog-search-tags-{{ ai_gen_id }} {
    flex: 1;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .ai-blog-search-tags-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-blog-search-tags-list-{{ ai_gen_id }} {
    display: flex;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
    white-space: nowrap;
  }

  .ai-blog-search-tag-{{ ai_gen_id }} {
    flex-shrink: 0;
  }

  .ai-blog-search-tag-link-{{ ai_gen_id }} {
    display: inline-block;
    padding: 8px 0;
    background-color: transparent;
    color: #666666;
    text-decoration: none;
    border-radius: 0;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 1px;
    text-transform: uppercase;
    transition: all 0.2s ease;
    border: none;
    border-bottom: 2px solid transparent;
    position: relative;
  }

  .ai-blog-search-tag-link-{{ ai_gen_id }}:hover {
    background-color: transparent;
    color: #2c2c2c;
    border-bottom-color: #2c2c2c;
  }

  .ai-blog-search-overlay-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .ai-blog-search-overlay-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-blog-search-modal-{{ ai_gen_id }} {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.95);
    width: 90%;
    max-width: 700px;
    max-height: 80vh;
    background-color: #ffffff;
    border-radius: 2px;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }

  .ai-blog-search-modal-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
  }

  .ai-blog-search-drawer-{{ ai_gen_id }} {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    max-height: 85vh;
    background-color: #ffffff;
    border-radius: 12px 12px 0 0;
    z-index: 9999;
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.2);
  }

  .ai-blog-search-drawer-{{ ai_gen_id }}.active {
    transform: translateY(0);
  }

  .ai-blog-search-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 24px;
    border-bottom: 1px solid #e5e5e5;
  }

  .ai-blog-search-back-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    cursor: pointer;
    color: #2c2c2c;
    background: none;
    border: none;
    padding: 0;
    transition: color 0.2s ease;
  }

  .ai-blog-search-back-{{ ai_gen_id }}:hover {
    color: #000000;
  }

  .ai-blog-search-back-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-blog-search-input-{{ ai_gen_id }} {
    flex: 1;
    padding: 14px 0;
    border: none;
    border-bottom: 1px solid #e5e5e5;
    font-size: 16px;
    background-color: transparent;
    color: #2c2c2c;
    font-family: inherit;
  }

  .ai-blog-search-input-{{ ai_gen_id }}::placeholder {
    color: #999999;
  }

  .ai-blog-search-input-{{ ai_gen_id }}:focus {
    outline: none;
    border-bottom-color: #2c2c2c;
  }

  .ai-blog-search-results-{{ ai_gen_id }} {
    flex: 1;
    overflow-y: auto;
    padding: 0;
  }

  .ai-blog-search-result-{{ ai_gen_id }} {
    padding: 24px;
    border-bottom: 1px solid #e5e5e5;
    cursor: pointer;
    transition: background-color 0.2s ease;
    text-decoration: none;
    display: block;
    color: inherit;
  }

  .ai-blog-search-result-{{ ai_gen_id }}:hover {
    background-color: #fafafa;
  }

  .ai-blog-search-result-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-blog-search-result-title-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 500;
    margin: 0 0 8px 0;
    color: #2c2c2c;
    letter-spacing: 0.3px;
  }

  .ai-blog-search-result-excerpt-{{ ai_gen_id }} {
    font-size: 14px;
    color: #666666;
    margin: 0 0 12px 0;
    line-height: 1.6;
  }

  .ai-blog-search-result-tags-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .ai-blog-search-result-tag-{{ ai_gen_id }} {
    display: inline-block;
    padding: 4px 12px;
    background-color: #f5f5f5;
    color: #666666;
    border-radius: 2px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-blog-search-highlight-{{ ai_gen_id }} {
    background-color: #fff4e6;
    font-weight: 500;
    padding: 0 2px;
  }

  .ai-blog-search-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #999999;
    font-size: 14px;
  }

  .ai-blog-search-loading-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #999999;
    font-size: 14px;
  }

  @media screen and (min-width: 750px) {
    .ai-blog-search-drawer-{{ ai_gen_id }} {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-blog-search-modal-{{ ai_gen_id }} {
      display: none;
    }
    
    .ai-blog-search-bar-{{ ai_gen_id }} {
      gap: 16px;
    }
    
    .ai-blog-search-tags-list-{{ ai_gen_id }} {
      gap: 20px;
    }
  }
{% endstyle %}

<blog-search-{{ ai_gen_id }} class="ai-blog-search-{{ ai_gen_id }}" data-blog-handle="{% if current_blog %}{{ current_blog.handle }}{% endif %}" {{ block.shopify_attributes }}>
  <div class="ai-blog-search-bar-{{ ai_gen_id }}">
    <button class="ai-blog-search-icon-{{ ai_gen_id }}" aria-label="Search blog posts">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
    </button>

    <div class="ai-blog-search-tags-{{ ai_gen_id }}">
      <ul class="ai-blog-search-tags-list-{{ ai_gen_id }}">
        {% if current_blog %}
          <li class="ai-blog-search-tag-{{ ai_gen_id }}">
            <a href="{{ current_blog.url }}" class="ai-blog-search-tag-link-{{ ai_gen_id }}">VIEW ALL</a>
          </li>
          {% for tag in tag_array limit: 6 %}
            <li class="ai-blog-search-tag-{{ ai_gen_id }}">
              <a href="{{ current_blog.url }}/tagged/{{ tag | handle }}" class="ai-blog-search-tag-link-{{ ai_gen_id }}">
                {{ tag | upcase }}
              </a>
            </li>
          {% endfor %}
        {% endif %}
      </ul>
    </div>
  </div>

  <div class="ai-blog-search-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-blog-search-modal-{{ ai_gen_id }}">
    <div class="ai-blog-search-header-{{ ai_gen_id }}">
      <button class="ai-blog-search-back-{{ ai_gen_id }}" aria-label="Close search">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 18-6-6 6-6"></path>
        </svg>
      </button>
      <input 
        type="text" 
        class="ai-blog-search-input-{{ ai_gen_id }}" 
        placeholder="{{ block.settings.search_placeholder }}"
        aria-label="Search blog posts"
      >
    </div>
    <div class="ai-blog-search-results-{{ ai_gen_id }}">
      <div class="ai-blog-search-empty-{{ ai_gen_id }}">
        {{ block.settings.empty_message }}
      </div>
    </div>
  </div>

  <div class="ai-blog-search-drawer-{{ ai_gen_id }}">
    <div class="ai-blog-search-header-{{ ai_gen_id }}">
      <button class="ai-blog-search-back-{{ ai_gen_id }}" aria-label="Close search">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 18-6-6 6-6"></path>
        </svg>
      </button>
      <input 
        type="text" 
        class="ai-blog-search-input-{{ ai_gen_id }}" 
        placeholder="{{ block.settings.search_placeholder }}"
        aria-label="Search blog posts"
      >
    </div>
    <div class="ai-blog-search-results-{{ ai_gen_id }}">
      <div class="ai-blog-search-empty-{{ ai_gen_id }}">
        {{ block.settings.empty_message }}
      </div>
    </div>
  </div>
</blog-search-{{ ai_gen_id }}>

