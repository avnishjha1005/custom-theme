{%- liquid
  assign blockid = block.id

  assign width = block.settings.width
  assign max_width = block.settings.max_width

  assign spacing = block.settings.spacing
  if spacing == 'custom'
    assign dt_padding = block.settings.dt_padding
    assign mb_padding = block.settings.mb_padding
  elsif spacing == 'basic'
    assign padding_top = block.settings.padding_top
    assign padding_bottom = block.settings.padding_bottom
    assign padding_left = block.settings.padding_left
    assign padding_right = block.settings.padding_right
  endif

  assign subheading = block.settings.subheading
  assign type = block.settings.type
  assign background_color = block.settings.background_color
  assign gradient_bg_color = block.settings.gradient_bg_color
  assign font_size = block.settings.font_size
  assign font_color = block.settings.font_color
  assign border_color = block.settings.border_color
  assign scaled_font_size = font_size | times: 0.9 | round
  assign border_radius = block.settings.border_radius
  assign height = block.settings.height
  assign adjusted_width = height | times: 3 | round

  assign dev_mode = block.settings.dev_mode
  assign custom_class = block.settings.custom_class
  assign block_class = block.settings.block_class
  assign css_code = block.settings.css_code
-%}

{%- style -%}
  #{{ blockid }} {
    max-width: {% if width == 'fixed' %}{{ max_width }}px{% elsif width == 'full' %}100%{% elsif width == 'fit' %}fit-content{% endif %};
  }
  {% if spacing == 'basic' %}
  #{{ blockid }} {
      padding-top: {{ padding_top }}px;
      padding-bottom: {{ padding_bottom }}px;
      padding-left: {{ padding_left }}px;
      padding-right: {{ padding_right }}px;
  }
  {% elsif spacing == 'custom' %}
  @media only screen and (min-width: 768px) {
      #{{ blockid }} {
          padding: {{ dt_padding }};
      }
  }
  @media only screen and (max-width: 767.8px) {
      #{{ blockid }} {
          padding: {{ mb_padding }};
      }
  }
  {% endif %}
  #{{ blockid }} .flexi-subheading,
  #{{ blockid }} .flexi-subheading a {
      font-size: {{ font_size }}px;
      color: {{ font_color }};
  }
  @media (max-width: 768px) {
    #{{ blockid }} .flexi-subheading,
    #{{ blockid }} .flexi-subheading a {
      font-size: {{ scaled_font_size }}px !important;
    }
  }
  #{{ blockid }} .flexi-subheading {
    {% if width == 'full' %}
        width: 100%;
    {% elsif width == 'fit' %}
       width: fit-content;
    {% endif %}
    {% if background_color != blank and background_color != 'rgba(0,0,0,0)' %}
      background-color: {{ background_color }};
      border-radius: {{ border_radius }}px;
      padding: {{ height }}px {{ adjusted_width }}px;
    {% elsif gradient_bg_color != blank and gradient_bg_color != 'rgba(0,0,0,0)' %}
      background: {{ gradient_bg_color }};
      border-radius: {{ border_radius }}px;
      padding: {{ height }}px {{ adjusted_width }}px;
    {% endif %}
    {% if border_color != blank and border_color != 'rgba(0,0,0,0)' %}
      border: solid 1px {{ border_color }};
      border-radius: {{ border_radius }}px;
      padding: {{ height }}px {{ adjusted_width }}px;
    {% endif %}
    }
  {% if css_code != blank %}{{ css_code }}{% endif %}
{%- endstyle -%}

{% if subheading != blank %}
  <div
    id="{{ blockid }}"
    class="flexi-subheading-block flexi-library u-flex u-w-full u-h-full {% if dev_mode %}{{ custom_class }}{% endif %}"
    {{ block.shopify_attributes }}
  >
    <div class="flexi-block-wrapper u-w-full u-text-center">
      <{{ type }} class="{% if block_class != blank %}{{ block_class }}{% endif %}">
        <span class="flexi-subheading-inner u-block u-bg-transparent">{{ subheading }}</span>
      </{{ type }}>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Subheading",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "editor",
      "label": "Editing Mode",
      "options": [
        {
          "value": "simple",
          "label": "Content"
        },
        {
          "value": "advanced",
          "label": "Customize"
        }
      ],
      "default": "simple"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading text",
      "default": "NEW"
    },
    {
      "type": "select",
      "id": "type",
      "label": "Type",
      "default": "h4",
      "options": [
        {
          "label": "h2",
          "value": "h2"
        },
        {
          "label": "h3",
          "value": "h3"
        },
        {
          "label": "h4",
          "value": "h4"
        },
        {
          "label": "h5",
          "value": "h5"
        },
        {
          "label": "p",
          "value": "p"
        }
      ]
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "font_color",
      "label": "Font color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color_background",
      "id": "gradient_bg_color",
      "label": "Gradient background"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Border radius",
      "default": 4,
      "visible_if": "{{ block.settings.editor == 'advanced' }}"
    },
    {
      "type": "header",
      "content": "Width",
      "visible_if": "{{ block.settings.editor == 'advanced' }}"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Block width",
      "options": [
        {
          "value": "fit",
          "label": "Fit"
        },
        {
          "value": "fixed",
          "label": "Fixed"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ],
      "default": "fit",
      "visible_if": "{{ block.settings.editor == 'advanced' }}"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 24,
      "max": 2400,
      "step": 24,
      "unit": "px",
      "label": "Max width",
      "default": 2400,
      "visible_if": "{{ block.settings.editor == 'advanced' and block.settings.width == 'fixed' }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "height",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px",
      "label": "Space around text",
      "default": 4,
      "visible_if": "{{ block.settings.editor == 'advanced' }}"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Padding",
      "options": [
        {
          "value": "basic",
          "label": "Basic"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "basic",
      "visible_if": "{{ block.settings.editor == 'advanced' }}"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 0,
      "visible_if": "{{ block.settings.spacing == 'basic' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0,
      "visible_if": "{{ block.settings.spacing == 'basic' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Left padding",
      "default": 0,
      "visible_if": "{{ block.settings.spacing == 'basic' and block.settings.editor == 'advanced' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Right padding",
      "default": 0,
      "visible_if": "{{ block.settings.spacing == 'basic' and block.settings.editor == 'advanced' }}"
    },
    {
      "type": "text",
      "id": "dt_padding",
      "label": "Padding (desktop)",
      "default": "0px 0px",
      "visible_if": "{{ block.settings.spacing == 'custom' and block.settings.editor == 'advanced' }}",
      "info": "Pass in CSS padding options below. Visit our documentation for a cheatsheet."
    },
    {
      "type": "text",
      "id": "mb_padding",
      "label": "Padding (mobile)",
      "default": "0px 0px",
      "visible_if": "{{ block.settings.spacing == 'custom' and block.settings.editor == 'advanced' }}"
    },
    {
      "type": "header",
      "content": "Advanced",
      "visible_if": "{{ block.settings.editor == 'advanced' }}"
    },
    {
      "type": "checkbox",
      "id": "dev_mode",
      "label": "Enable developer mode",
      "default": false,
      "info": "Enable dev mode for additional styling and debugging features.",
      "visible_if": "{{ block.settings.editor == 'advanced' }}"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom classes",
      "info": "Apply custom classes to the outer container. [View docs](https://flexi-library.gitbook.io/flexi-theme-library/docs/custom-classes)",
      "visible_if": "{{ block.settings.dev_mode == true and block.settings.editor == 'advanced' }}"
    },
    {
      "type": "text",
      "id": "block_class",
      "label": "Block classes",
      "default": "flexi-subheading u-m-0 u-p-0 u-bg-transparent",
      "info": "Adjust default Flexi classes at the content level. [View docs](https://flexi-library.gitbook.io/flexi-theme-library/docs/block-classes)",
      "visible_if": "{{ block.settings.dev_mode == true and block.settings.editor == 'advanced' }}"
    },
    {
      "type": "liquid",
      "id": "css_code",
      "label": "Custom CSS",
      "info": "Add custom CSS specific to this block. [View docs](https://flexi-library.gitbook.io/flexi-theme-library/docs/custom-css)",
      "visible_if": "{{ block.settings.dev_mode == true and block.settings.editor == 'advanced' }}"
    }
  ],
  "presets": [
    {
      "name": "Subheading",
      "category": "Flexi Blocks"
    }
  ]
}
{% endschema %}
