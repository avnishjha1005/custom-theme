{%- assign block_settings = block.settings -%}

<div
  class="product-actions"
  data-product-actions
  data-sticky-mobile="{{ block_settings.sticky_on_mobile }}"
  {{ block.shopify_attributes }}
>
  <div class="product-actions__inner">
    {% capture children %}
      {% content_for 'blocks' %}
    {% endcapture %}

    {% render 'group', children: children, settings: block_settings %}
  </div>
</div>

<script>
  (function() {
    const productActions = document.querySelector('[data-product-actions][data-sticky-mobile="true"]');
    if (!productActions || window.innerWidth >= 750) return;

    const productSection = productActions.closest('.product-information');
    if (!productSection) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          productActions.classList.add('product-actions--sticky-active');
        } else {
          productActions.classList.remove('product-actions--sticky-active');
        }
      });
    }, {
      threshold: 0,
      rootMargin: '0px 0px -100px 0px'
    });

    observer.observe(productSection);

    // Handle resize
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 750) {
        productActions.classList.remove('product-actions--sticky-active');
      }
    });
  })();
</script>

{% stylesheet %}
  .product-actions {
    width: 100%;
  }

  .product-actions__inner {
    width: 100%;
  }

  /* Desktop - hide the mobile sticky bar */
  @media screen and (min-width: 750px) {
    [data-sticky-mobile="true"].product-actions {
      display: none !important;
    }
  }

  /* Mobile sticky styles */
  @media screen and (max-width: 749px) {
    [data-sticky-mobile="true"].product-actions {
      position: fixed;
      bottom: -100%;
      left: 0;
      right: 0;
      z-index: 7;
      background: var(--color-background, #fff);
      border-top: 1px solid rgba(0, 0, 0, 0.1);
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
      padding: 12px 16px;
      padding-bottom: calc(12px + env(safe-area-inset-bottom, 0px));
      transition: bottom 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    [data-sticky-mobile="true"].product-actions.product-actions--sticky-active {
      bottom: 56px;
    }

    [data-sticky-mobile="true"].product-actions .product-actions__inner {
      max-width: 100%;
    }

    /* Clean up group styling in sticky bar */
    [data-sticky-mobile="true"].product-actions .group-block {
      padding: 0;
      background: transparent;
      border: none;
    }

    [data-sticky-mobile="true"].product-actions .group-block-content {
      gap: 8px;
    }

    /* Make buttons full width in sticky bar */
    [data-sticky-mobile="true"].product-actions .buy-buttons {
      width: 100%;
    }

    [data-sticky-mobile="true"].product-actions .buy-buttons__content {
      width: 100%;
      gap: 8px;
    }

    [data-sticky-mobile="true"].product-actions .buy-buttons__content > * {
      flex: 1;
    }

    [data-sticky-mobile="true"].product-actions .button,
    [data-sticky-mobile="true"].product-actions [type="submit"] {
      width: 100%;
      min-height: 48px;
      font-size: 14px;
      font-weight: 500;
    }

    /* Hide elements we don't need in sticky bar */
    [data-sticky-mobile="true"].product-actions .buy-buttons__pickup-availability,
    [data-sticky-mobile="true"].product-actions .gift-card-form {
      display: none;
    }
  }
{% endstylesheet %}

