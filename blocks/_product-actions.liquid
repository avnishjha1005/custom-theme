{% liquid
  assign block_settings = block.settings
  assign bundle_products = closest.product.metafields.custom.bundle_products.value
  assign is_bundle = false
  if bundle_products and bundle_products.size > 0
    assign is_bundle = true
  endif
%}

<div
  class="product-actions"
  data-product-actions
  data-sticky-mobile="{{ block_settings.sticky_on_mobile }}"
  data-is-bundle="{% if is_bundle %}true{% else %}false{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="product-actions__inner">
    {% capture children %}
      {% content_for 'blocks' %}
    {% endcapture %}

    {% render 'group', children: children, settings: block_settings %}

    {% if block_settings.sticky_on_mobile %}
      <div class="product-actions__wishlist">
        <wishlist-button data-product-id="{{ closest.product.id }}" data-product-handle="{{ closest.product.handle }}" data-variant-id="{{ closest.product.selected_or_first_available_variant.id }}">
          <button
            type="button"
            class="product-actions__wishlist-btn"
            data-wishlist-button
            aria-label="Add to wishlist"
            aria-pressed="false"
          >
            <svg class="wishlist-icon wishlist-icon--outline" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              {{ 'icon-heart.svg' | inline_asset_content }}
            </svg>
            <svg class="wishlist-icon wishlist-icon--filled" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M19.3 5.71002C18.841 5.24601 18.2943 4.87797 17.6917 4.62731C17.0891 4.37666 16.4426 4.2484 15.79 4.25002C15.1373 4.2484 14.4909 4.37666 13.8883 4.62731C13.2857 4.87797 12.739 5.24601 12.28 5.71002L12 6.00002L11.72 5.72001C10.7917 4.79182 9.53273 4.27037 8.22 4.27037C6.90726 4.27037 5.64829 4.79182 4.72 5.72001C3.80386 6.65466 3.29071 7.91125 3.29071 9.22002C3.29071 10.5288 3.80386 11.7854 4.72 12.72L11.49 19.51C11.6306 19.6505 11.8212 19.7294 12.02 19.7294C12.2187 19.7294 12.4094 19.6505 12.55 19.51L19.32 12.72C20.2365 11.7823 20.7479 10.5221 20.7442 9.21092C20.7405 7.89973 20.2218 6.64248 19.3 5.71002Z" fill="currentColor"/>
            </svg>
          </button>
        </wishlist-button>
      </div>
    {% endif %}
  </div>
</div>

<script>
  (function() {
    const productActions = document.querySelector('[data-product-actions][data-sticky-mobile="true"]');
    if (!productActions || window.innerWidth >= 750) return;

    const productSection = productActions.closest('.product-information');
    if (!productSection) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          productActions.classList.add('product-actions--sticky-active');
        } else {
          productActions.classList.remove('product-actions--sticky-active');
        }
      });
    }, {
      threshold: 0,
      rootMargin: '0px 0px -100px 0px'
    });

    observer.observe(productSection);

    // Handle resize
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 750) {
        productActions.classList.remove('product-actions--sticky-active');
      }
    });
  })();
</script>

{% stylesheet %}
  .product-actions {
    width: 100%;
  }

  .product-actions__inner {
    width: 100%;
  }

  /* Desktop - hide the mobile sticky bar */
  @media screen and (min-width: 750px) {
    [data-sticky-mobile="true"].product-actions {
      display: none !important;
    }
  }

  /* Mobile sticky styles */
  @media screen and (max-width: 749px) {
    [data-sticky-mobile="true"].product-actions {
      --sticky-actions-padding-top: 12px;
      --sticky-actions-padding-inline: 16px;
      position: fixed;
      bottom: -100%;
      left: 0;
      right: 0;
      z-index: 7;
      background: var(--color-background, #fff);
      border-top: 1px solid rgba(0, 0, 0, 0.1);
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
      padding: var(--sticky-actions-padding-top) var(--sticky-actions-padding-inline);
      padding-bottom: calc(12px + env(safe-area-inset-bottom, 0px));
      transition: bottom 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    [data-sticky-mobile="true"].product-actions.product-actions--sticky-active {
      bottom: 56px;
    }

    [data-sticky-mobile="true"].product-actions .product-actions__inner {
      max-width: 100%;
    }

    /* Clean up group styling in sticky bar */
    [data-sticky-mobile="true"].product-actions .group-block {
      padding: 0;
      background: transparent;
      border: none;
    }

    /* Left metadata column only: remove top gap above first text line */
    [data-sticky-mobile="true"].product-actions .group-block:has(.product-title-block) > .group-block-content.layout-panel-flex--column {
      justify-content: flex-start;
    }


    /* Make buttons full width in sticky bar */
    [data-sticky-mobile="true"].product-actions .buy-buttons {
      width: 100%;
    }

    [data-sticky-mobile="true"].product-actions .buy-buttons__content {
      width: 100%;
      gap: 8px;
    }

    [data-sticky-mobile="true"].product-actions .buy-buttons__content > * {
      flex: 1;
    }

    [data-sticky-mobile="true"].product-actions .button,
    [data-sticky-mobile="true"].product-actions [type="submit"] {
      width: 100%;
      min-height: 48px;
      font-size: 14px;
      font-weight: 500;
    }

    /* Hide elements we don't need in sticky bar */
    [data-sticky-mobile="true"].product-actions .buy-buttons__pickup-availability,
    [data-sticky-mobile="true"].product-actions .gift-card-form {
      display: none;
    }

    /* Bundle sticky bar: remove vendor block entirely so no flex gap remains before title */
    [data-sticky-mobile="true"][data-is-bundle="true"].product-actions .product-vendor-block {
      display: none !important;
    }

    /* Wishlist button in sticky bar */
    .product-actions__wishlist {
      height: 25px;
      width: 25px;
      position: absolute;
      top: var(--sticky-actions-padding-top);
      right: var(--sticky-actions-padding-inline);
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .product-actions__wishlist-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      background: none;
      border: none;
      cursor: pointer;
      padding: 3px;
      color: #000;
      transition: transform 0.2s ease;
    }

    .product-actions__wishlist-btn:active {
      transform: scale(0.9);
    }

    .product-actions__wishlist-btn .wishlist-icon--filled {
      display: none;
    }

    .product-actions__wishlist-btn.wishlist-button--active .wishlist-icon--outline {
      display: none;
    }

    .product-actions__wishlist-btn.wishlist-button--active .wishlist-icon--filled {
      display: block;
      color: #692c23;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product actions",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "button"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "price"
    },
    {
      "type": "variant-picker"
    },
    {
      "type": "buy-buttons"
    },
    {
      "type": "product-vendor"
    },
    {
      "type": "product-title"
    },
    {
      "type": "size-guide"
    },
    {
      "type": "_divider"
    }
  ],
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Mobile behavior"
    },
    {
      "type": "checkbox",
      "id": "sticky_on_mobile",
      "label": "Sticky on mobile",
      "info": "Shows as a fixed bar at the bottom on mobile while viewing the product",
      "default": true
