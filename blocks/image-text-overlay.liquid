{% assign id = block.id | replace: '_', '' | downcase %}

{% style %}
  .hero-{{ id }} {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 520px;
    height:100%;
  }

  .hero-{{ id }}__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    height:100%;
  }

  .hero-{{ id }}__media img,
  .hero-{{ id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-{{ id }}__content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 700px;
    padding: 60px 24px;
    box-sizing: border-box;
  }

  .hero-{{ id }}__line {
    color: {{ block.settings.text_color }};
    font-size: 80px;
    font-family: 'Marcellus', serif;
    font-weight: 400;
    text-transform: uppercase;
    line-height: 1;
    margin: 0;
  }

  .hero-{{ id }}__line--right {
    text-align: right;
  }

  .hero-{{ id }}__sub {
    color: {{ block.settings.text_color }};
    font-size: 16px;
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    line-height: 1.4;
    margin: 12px 0 0;
    text-align: right;
  }

  @media screen and (max-width: 749px) {
    .hero-{{ id }} {
      min-height: 360px;
    }

    .hero-{{ id }}__content {
      padding: 40px 16px;
    }

    .hero-{{ id }}__line {
      font-size: 48px;
    }

    .hero-{{ id }}__sub {
      font-size: 14px;
    }
  }
{% endstyle %}

<section class="hero-{{ id }}" {{ block.shopify_attributes }}>
  <div class="hero-{{ id }}__media">
    {% if block.settings.image != blank %}
      {{
        block.settings.image
        | image_url: width: 3000
        | image_tag:
            loading: 'lazy',
            widths: '375, 750, 1100, 1500, 2200, 3000',
            sizes: '100vw'
      }}
    {% else %}
      {{ 'lifestyle-2' | placeholder_svg_tag }}
    {% endif %}
  </div>

  <div class="hero-{{ id }}__content">
    {% if block.settings.line1 != blank %}
      <p class="hero-{{ id }}__line">{{ block.settings.line1 }}</p>
    {% endif %}
    {% if block.settings.line2 != blank %}
      <p class="hero-{{ id }}__line hero-{{ id }}__line--right">{{ block.settings.line2 }}</p>
    {% endif %}
    {% if block.settings.subheading != blank %}
      <p class="hero-{{ id }}__sub">{{ block.settings.subheading }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Image with text Overlay",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "line1",
      "label": "Line 1",
      "default": "LOREM IPSUM"
    },
    {
      "type": "text",
      "id": "line2",
      "label": "Line 2",
      "default": "DOLOR"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Exclusive Collection 2025/26"
    }
  ],
  "presets": [
    {
      "name": "Full-Width Offset Hero"
    }
  ]
}
{% endschema %}
