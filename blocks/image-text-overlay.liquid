{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  /* Full Width Breakout Container */
  .hero-full-width-{{ ai_gen_id }} {
    width: 100vw;
    position: relative;
    overflow: hidden;
    height: {{ block.settings.height_desktop }}px;
    background-color: #f4f4f4;
  }

  .hero-full-width__img-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Text Positioning Logic */
  .hero-text-item-{{ ai_gen_id }} {
    position: absolute;
    margin: 0;
    line-height: 1;
    z-index: 5;
    white-space: nowrap;
    color: {{ block.settings.text_color }};
    text-transform: uppercase;
    font-family:'Marcellus'
  }

  /* Desktop Settings */
  .line-1-{{ ai_gen_id }} {
    top: {{ block.settings.line1_v }}%;
    left: {{ block.settings.line1_h }}%;
    font-size: {{ block.settings.line1_size }}px;
    font-weight: {{ block.settings.font_weight }};
  }

  .line-2-{{ ai_gen_id }} {
    top: {{ block.settings.line2_v }}%;
    left: {{ block.settings.line2_h }}%;
    font-size: {{ block.settings.line2_size }}px;
    font-weight: {{ block.settings.font_weight }};
  }

  .sub-{{ ai_gen_id }} {
    top: {{ block.settings.sub_v }}%;
    left: {{ block.settings.sub_h }}%;
    font-size: {{ block.settings.sub_size }}px;
    font-weight: 300;
    text-transform: none; /* Subheading usually sentence case */
  }

  /* Mobile Responsive Adjustments */
  @media screen and (max-width: 768px) {
    .hero-full-width-{{ ai_gen_id }} {
      height: {{ block.settings.height_mobile }}px;
    }

    .line-1-{{ ai_gen_id }} {
      top: {{ block.settings.line1_v_m }}%;
      left: {{ block.settings.line1_h_m }}%;
      font-size: {{ block.settings.line1_size_m }}px;
    }

    .line-2-{{ ai_gen_id }} {
      top: {{ block.settings.line2_v_m }}%;
      left: {{ block.settings.line2_h_m }}%;
      font-size: {{ block.settings.line2_size_m }}px;
    }

    .sub-{{ ai_gen_id }} {
      top: {{ block.settings.sub_v_m }}%;
      left: {{ block.settings.sub_h_m }}%;
      font-size: {{ block.settings.sub_size_m }}px;
    }
  }
{% endstyle %}

<section class="hero-full-width-{{ ai_gen_id }}">
  {% if block.settings.image != blank %}
    <img 
      src="{{ block.settings.image | image_url: width: 3000 }}" 
      alt="{{ block.settings.image.alt }}" 
      class="hero-full-width__img-{{ ai_gen_id }}"
      height="auto"
      width="auto"
    >
  {% else %}
    {{ 'lifestyle-2' | placeholder_svg_tag: 'hero-full-width__img-ai' }}
  {% endif %}

  <div class="hero-text-item-{{ ai_gen_id }} line-1-{{ ai_gen_id }}">{{ block.settings.line1 }}</div>
  <div class="hero-text-item-{{ ai_gen_id }} line-2-{{ ai_gen_id }}">{{ block.settings.line2 }}</div>
  <div class="hero-text-item-{{ ai_gen_id }} sub-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
</section>

