
{%- doc -%}
  Renders a quick add component as a block in product card groups.

  @param {object} product - The product object (from closest.product)
  @param {string} section_id - The section ID
{%- enddoc -%}

{% liquid
  assign product = closest.product
  unless product == blank
    assign product_form_id = 'QuickAdd-ProductForm-' | append: product.id | append: '-' | append: block.id
    assign add_to_cart_text = 'actions.add' | t

    # Logic to determine which variant to use (matching swatch selection logic from product-card)
    assign variant_to_use = product.selected_or_first_available_variant
    assign combined_listing_count = product.options_with_values | map: 'values' | map: 'product_url' | compact | size

    unless combined_listing_count > 0
      assign first_image = product.media.first
      assign variant_images = product.images | where: 'attached_to_variant?', true
      # Get swatchable options (options that have swatch values)
      assign swatch_variant_picker = null
      for option in product.options_with_values
        assign swatch_count = option.values | map: 'swatch' | compact | size
        if swatch_count > 0
          assign swatch_variant_picker = option
          break
        endif
      endfor

      if swatch_variant_picker
        assign swatch_count = swatch_variant_picker.values | map: 'swatch' | compact | size

        if swatch_count == 1
          # Single swatch: use that variant
          assign variant_to_use = swatch_variant_picker.values.first.variant
        elsif swatch_count > 1
          if first_image and variant_images contains first_image
            # First image is a variant image - find which variant it belongs to
            for option_value in swatch_variant_picker.values
              if option_value.variant.featured_media.id == first_image.id
                assign variant_to_use = option_value.variant
                break
              endif
            endfor
          elsif variant_images.size == 0
            # No variants have images - use first swatch variant
            assign variant_to_use = swatch_variant_picker.values.first.variant
          endif
          # else: First image is NOT a variant image - keep default (selected_or_first_available_variant)
        endif
      endif
    endunless

    # Check if product is "price on request" (metafield-driven)
    assign is_price_on_request = false
    if product.metafields.custom.price_on_request == true or product.metafields.custom.price_on_request.value == true
      assign is_price_on_request = true
    endif

    assign bundle_products = product.metafields.custom.bundle_products.value
    if is_price_on_request == false and bundle_products and bundle_products.size > 0
      assign non_por_bundle_items_count = 0
      for bundle_item in bundle_products
        assign bundle_item_is_por = false
        if bundle_item.metafields.custom.price_on_request == true or bundle_item.metafields.custom.price_on_request.value == true
          assign bundle_item_is_por = true
        endif

        if bundle_item_is_por == false
          assign non_por_bundle_items_count = non_por_bundle_items_count | plus: 1
        endif
      endfor

      if non_por_bundle_items_count == 0
        assign is_price_on_request = true
      endif
    endif

    if variant_to_use.available
      assign can_add_to_cart = true
    else
      assign can_add_to_cart = false
    endif
  endunless
%}

{% unless product == blank %}
  <div
    class="product-card-quick-add-block spacing-style"
    style="{% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    {% if is_price_on_request %}
      {%- comment -%} Show chat icon for "Price on Request" items - links to WhatsApp {%- endcomment -%}
      {%- liquid
        assign whatsapp_message = settings.whatsapp_price_request_message | default: "Hi! I'd like to request a price for {{product_name}}"
        assign whatsapp_message = whatsapp_message | replace: '{{product_name}}', product.title
        assign encoded_message = whatsapp_message | url_encode
        assign whatsapp_url = 'https://wa.me/' | append: settings.whatsapp_phone | append: '?text=' | append: encoded_message
      -%}
      <a
        href="{{ whatsapp_url }}"
        target="_blank"
        rel="noopener noreferrer"
        class="quick-add--inline quick-add__chat-button button"
        aria-label="Contact us on WhatsApp about this product"
        title="{{ product.title }} - Inquire about price on WhatsApp"
      >
        <span class="svg-wrapper quick-add__chat-icon">
          {{- 'icon-chat.svg' | inline_asset_content -}}
        </span>
      </a>
    {% else %}
      <quick-add-component
        class="quick-add {% if settings.quick_add_color_scheme %}color-{{ settings.quick_add_color_scheme }}{% endif %} quick-add--inline"
        ref="quickAdd"
        data-product-title="{{ product.title }}"
        style="width: 97%;"
      >
        <product-form-component
          data-section-id="{{ section.id }}"
          data-product-id="{{ product.id }}"
          on:submit="/handleSubmit"
          class="
            quick-add__product-form-component
            {% if product.options.size == 1 %} quick-add__product-form-component--single-option {% else %} quick-add__product-form-component--multi-option {% endif %}
            {% if product.variants.size == 1 %} quick-add__product-form-component--single-variant {% else %} quick-add__product-form-component--multi-variant {% endif %}
          "
        >
          <div
            class="visually-hidden"
            aria-live="assertive"
            role="status"
            aria-atomic="true"
            ref="liveRegion"
          ></div>
          {%- form 'product', product, id: product_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
            <input
              type="hidden"
              name="id"
              ref="variantId"
              value="{{ variant_to_use.id }}"
              {% if variant_to_use.available == false %}
                disabled
              {% endif %}
            >
            <input
              type="hidden"
              name="quantity"
              value="{% if variant_to_use.quantity_rule.min %}{{ variant_to_use.quantity_rule.min }}{% else %}1{% endif %}"
            >
            {% comment %} If there is one variant option but it's swatches or if it's a single variant product, then use add to cart button {% endcomment %}
            {%- if product.variants.size == 1 or product.options.size == 1 -%}
              {% render 'add-to-cart-button',
                add_to_cart_text: add_to_cart_text,
                class: 'button quick-add__button quick-add__button--add',
                can_add_to_cart: can_add_to_cart,
                icon_only_on_mobile: true,
                product: product
              %}
            {%- endif -%}
            {%- if product.variants.size > 1 -%}
              <button
                class="button quick-add__button quick-add__button--choose"
                {% comment %} type="submit" is the default, so we explicitly set it to "button" to prevent the ProductFormComponent.handleSubmit from being triggered {% endcomment %}
                type="button"
                name="add"
                on:click="quick-add-component/handleClick"
              >
                <span
                  class="add-to-cart-text"
                >
                  <span class="svg-wrapper add-to-cart-icon">
            {{- 'icon-plus.svg' | inline_asset_content -}}
          </span>
                </span>
              </button>
            {%- endif -%}
          {%- endform -%}
        </product-form-component>
      </quick-add-component>
    {% endif %}
  </div>
{% endunless %}

{% stylesheet %}

  .product-card-quick-add-block {
    display: flex;
    align-items: flex-end;
    margin-left: auto;
    flex-shrink: 0;
    flex-grow: 0;
    width: auto;
    align-self: flex-end;
    height: auto;
    margin-bottom: 0px !important;
  }

  /* Prevent the parent group from stretching and pushing quick-add down */
  .group-block:has(.product-card-quick-add-block) {
    flex-grow: 0 !important;
    flex-shrink: 0;
    height: auto !important;
    align-self: flex-end;
  }

  .quick-add.quick-add--inline {
    position: static;
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: flex-end;
    width: auto;
    inset: auto;
    pointer-events: auto;
  }

  /* Chat button should not span full width */
  a.quick-add--inline.quick-add__chat-button {
    width: auto;
    justify-content: center;
  }

  /* Ensure quick-add-component only takes needed space */
  .product-card-quick-add-block quick-add-component {
    width: auto;
  }

  .product-card-quick-add-block product-form-component {
    width: auto;
  }

  .product-card-quick-add-block .shopify-product-form {
    width: auto;
  }

  .quick-add.quick-add--inline .quick-add__button {
    --quick-add-inline-icon-box-size: 2rem;
    --quick-add-inline-icon-size: 1.6rem;
    display: flex;
    position: relative;
    pointer-events: all;
    color: currentColor;
    background: none;
    background-color: transparent;
    box-shadow: none;
    border: none;
    border-radius: 0;
    padding: 0;
    min-width: auto;
    min-height: auto;
    width: var(--quick-add-inline-icon-box-size);
    height: var(--quick-add-inline-icon-box-size);
    min-width: var(--quick-add-inline-icon-box-size);
    min-height: var(--quick-add-inline-icon-box-size);
    align-items: flex-end;
    justify-content: flex-end;
    overflow: visible;
  }

  .quick-add--inline .quick-add__button:is(:hover, :focus) {
    opacity: 0.8;
  }

  .quick-add--inline .quick-add__button .svg-wrapper {
    display: flex;
    align-items: flex-end;
    align-self: flex-end;
    justify-content: end;
  }

  .quick-add--inline .quick-add__button .svg-wrapper svg {
    width: 2rem;
    height: 2rem;
  }

  .quick-add--inline .quick-add__button .add-to-cart-text__content {
    width: fit-content;
    opacity: 1;
    transform: translateX(0);
  }

  .quick-add.quick-add--inline .quick-add__button .add-to-cart-text {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-inline: 0 !important;
    padding-inline: 0 !important;
    padding-bottom: 0 !important;
    gap: 0 !important;
    height: var(--quick-add-inline-icon-box-size);
    min-width: var(--quick-add-inline-icon-box-size);
    pointer-events: none;
  }

  .quick-add.quick-add--inline .quick-add__button .add-to-cart-text--added {
    inset: auto 0 0 0;
    position: absolute;
    height: var(--quick-add-inline-icon-box-size);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  /* Force plus/checkmark wrappers to share the exact same center point */
  .quick-add.quick-add--inline .quick-add__button :is(.add-to-cart-icon, .add-to-cart-icon--added) {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-width: 0 !important;
    min-height: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    justify-content: center !important;
    align-items: center !important;
  }

  .quick-add.quick-add--inline .quick-add__button :is(.add-to-cart-icon, .add-to-cart-icon--added) svg {
    width: var(--quick-add-inline-icon-size);
    height: var(--quick-add-inline-icon-size);
  }

  .quick-add--inline .quick-add__button:is(:focus, :hover) .add-to-cart-text {
    margin-inline: 0 !important;
    padding-inline: 0 !important;
    gap: 0 !important;
  }

  .quick-add__chat-button {
    display: flex;
    background: none;
    background-color: transparent;
    box-shadow: none;
    border: none;
    color: currentColor;
    position: relative;
    pointer-events: all;
    min-height: 4.4rem;
    padding: 1rem;
    text-decoration: none;
    padding-right: 0px;
    align-items: flex-end;
    padding-bottom: 0px;
  }

  .quick-add__chat-button:is(:hover, :focus) {
    opacity: 0.8;
  }

  .quick-add__chat-icon {
    display: flex;
    align-items: flex-end;
    align-self: flex-end;
    justify-content: end;
  }

  .quick-add__chat-icon svg {
    width: 2rem;
    height: 2rem;
  }

  @media screen and (max-width: 749px) {
    .quick-add.quick-add--inline .quick-add__button {
      --quick-add-inline-icon-box-size: 1.5rem;
      --quick-add-inline-icon-size: 1.25rem;
    }

    /* Keep title/price + inline quick add on one row in product cards */
    .group-block-content:has(.product-card-quick-add-block) {
      flex-wrap: nowrap !important;
    }

    .group-block-content:has(.product-card-quick-add-block) > .group-block:has(.product-card-quick-add-block) {
      width: fit-content;
      flex: 0 0 auto;
    }

    .group-block-content:has(.product-card-quick-add-block) > .group-block:not(:has(.product-card-quick-add-block)) {
      flex: 1 1 auto;
      min-width: 0;
    }

    .quick-add--inline .quick-add__button {
      min-width: 2.5rem;
      min-height: 2.5rem;
      padding: 0.25rem;
      align-items: flex-end;
      align-self: flex-end;
      justify-content: center;
    }
    .quick-add__chat-button{
      min-width: 2.5rem;
      min-height: 2.5rem;
      padding: 0.25rem;
      align-items: flex-end;
      align-self: flex-end;
      justify-content: end !important;
    }
    .quick-add__chat-icon svg,
    .quick-add--inline .quick-add__button .svg-wrapper svg {
      width: 1.5rem;
      height: 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Quick Add",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.quick_add",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
