{% liquid
  assign product = closest.product
  assign bundle_products = product.metafields.custom.bundle_products.value
  assign bundle_count = bundle_products.size | default: 0
%}

{%- if bundle_products != blank and bundle_count > 0 -%}
  <div class="bundle-products-block">
    <h4 class="bundle-products-block__heading">Look of {{ bundle_count }} items</h4>

    <div class="bundle-products-block__grid resource-list resource-list--grid">
      {%- for item in bundle_products limit: 4 -%}
        <div class="resource-list__item">
          {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: item %}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .bundle-products-block {
    margin-bottom: 16px;
  }

  .bundle-products-block__heading {
    font-size: 0.875rem;
    font-weight: 500;
    margin: 0 0 12px 0;
  }

  .bundle-products-block__grid {
    --resource-list-columns: repeat(2, 1fr);
    --resource-list-columns-mobile: repeat(2, 1fr);
    --resource-list-column-gap-desktop: 8px;
    --resource-list-row-gap-desktop: 8px;
    gap: 8px;
  }

  @media screen and (max-width: 749px) {
    .bundle-products-block__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bundle Products",
  "settings": [],
  "blocks": [
    { "type": "_product-card" }
  ],
  "presets": [
    {
      "name": "Bundle Products",
      "blocks": {
        "product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 4
          },
          "blocks": {
            "product-media-gallery": {
              "type": "_product-media-gallery"
            },
            "product_title": {
              "type": "product-title"
            },
            "product_vendor": {
              "type": "product-vendor"
            },
            "price": {
              "type": "price"
            }
          },
          "block_order": ["product-media-gallery", "product_title", "product_vendor", "price"]
        }
      }
    }
  ]
}
{% endschema %}
