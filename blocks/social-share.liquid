{% stylesheet %}
  .social-share {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5em;
  }

  .social-share__button {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 3em;
    height: 3em;
    padding: 0;
    border: none;
    border-radius: 50%;
    background-color: var(--color-background);
    color: var(--color-foreground);
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.625, 0.05, 0, 1);
    -webkit-appearance: none;
    appearance: none;
  }

  .social-share__button:hover {
    transform: scale(1.1) rotate(0.001deg);
  }

  .social-share:has(.social-share__button:hover) .social-share__button:not(:hover) {
    transform: scale(0.9) rotate(0.001deg);
  }

  .social-share__icon {
    display: flex;
    width: 1.5em;
    transition: transform 0.4s cubic-bezier(0.625, 0.05, 0, 1);
  }

  .social-share__icon svg {
    width: 100%;
    height: auto;
  }

  .social-share__icon--success {
    position: absolute;
    color: #009E3B;
    transform: translateY(200%) rotate(0.001deg);
  }

  /* Clipboard success state */
  [data-social-share-type="clipboard"][data-social-share-success] .social-share__icon:not(.social-share__icon--success) {
    transform: translateY(-200%) rotate(0.001deg);
  }

  [data-social-share-type="clipboard"][data-social-share-success] .social-share__icon--success {
    transform: translateY(0%) rotate(0.001deg);
  }

  /* Platform-specific colors */
  .social-share__button--linkedin {
    color: #0A66C2;
  }

  .social-share__button--x {
    color: #000000;
  }

  .social-share__button--facebook {
    color: #1877F2;
  }

  .social-share__button--pinterest {
    color: #E60023;
  }

  .social-share__button--whatsapp {
    color: #25D366;
  }

  .social-share__button--reddit {
    color: #FF4500;
  }

  .social-share__button--telegram {
    color: #0088CC;
  }

  .social-share__button--instagram {
    color: #E4405F;
  }

  /* Instagram success state (same as clipboard) */
  [data-social-share-type="instagram"][data-social-share-success] .social-share__icon:not(.social-share__icon--success) {
    transform: translateY(-200%) rotate(0.001deg);
  }

  [data-social-share-type="instagram"][data-social-share-success] .social-share__icon--success {
    transform: translateY(0%) rotate(0.001deg);
  }

  /* Bookmark button */
  .social-share__button--bookmark {
    color: var(--color-foreground);
  }

  .social-share__button--bookmark .social-share__icon--filled {
    position: absolute;
    color: #ff6b35;
    transform: scale(0) rotate(0.001deg);
  }

  .social-share__button--bookmark.social-share__button--active .social-share__icon:not(.social-share__icon--filled) {
    transform: scale(0) rotate(0.001deg);
  }

  .social-share__button--bookmark.social-share__button--active .social-share__icon--filled {
    transform: scale(1) rotate(0.001deg);
  }

  /* Bookmark notification toast */
  .bookmark-notification {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-foreground);
    color: var(--color-background);
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    z-index: 9999;
    font-size: 0.875rem;
    animation: bookmarkSlideUp 0.3s ease;
  }

  .bookmark-notification--hiding {
    animation: bookmarkSlideDown 0.3s ease forwards;
  }

  @keyframes bookmarkSlideUp {
    from { transform: translateX(-50%) translateY(100%); opacity: 0; }
    to { transform: translateX(-50%) translateY(0); opacity: 1; }
  }

  @keyframes bookmarkSlideDown {
    from { transform: translateX(-50%) translateY(0); opacity: 1; }
    to { transform: translateX(-50%) translateY(100%); opacity: 0; }
  }
{% endstylesheet %}

{% javascript %}
  (function() {
    const BOOKMARK_STORAGE_KEY = 'saved_articles';

    function getBookmarks() {
      try {
        return JSON.parse(localStorage.getItem(BOOKMARK_STORAGE_KEY)) || [];
      } catch {
        return [];
      }
    }

    function saveBookmarks(bookmarks) {
      localStorage.setItem(BOOKMARK_STORAGE_KEY, JSON.stringify(bookmarks));
    }

    function showNotification(message) {
      // Remove existing notification
      const existing = document.querySelector('.bookmark-notification');
      if (existing) existing.remove();

      const notification = document.createElement('div');
      notification.className = 'bookmark-notification';
      notification.textContent = message;
      document.body.appendChild(notification);

      setTimeout(() => {
        notification.classList.add('bookmark-notification--hiding');
        setTimeout(() => notification.remove(), 300);
      }, 2500);
    }

    function initBookmarkState() {
      // On page load, sync bookmark button states with localStorage
      document.querySelectorAll('[data-social-share-type="bookmark"]').forEach(btn => {
        const root = btn.closest('[data-social-share]');
        const articleHandle = root?.getAttribute('data-article-handle');
        if (!articleHandle) return;

        const bookmarks = getBookmarks();
        const isBookmarked = bookmarks.includes(articleHandle);

        btn.setAttribute('aria-pressed', String(isBookmarked));
        btn.classList.toggle('social-share__button--active', isBookmarked);
      });
    }

    function initSocialShare() {
      document.querySelectorAll('[data-social-share]').forEach(root => {
        if (root._socialShareBound) return;
        root._socialShareBound = true;

        const link = root.getAttribute('data-social-share-link') || location.href;
        const title = root.getAttribute('data-social-share-title') || document.title;

        root.addEventListener('click', e => {
          const btn = e.target.closest('[data-social-share-type]');
          if (!btn) return;
          e.preventDefault();

          const type = btn.getAttribute('data-social-share-type');
          const u = encodeURIComponent(link);
          const t = encodeURIComponent(title);

          // Handle bookmark
          if (type === 'bookmark') {
            // Check if login required
            if (btn.hasAttribute('data-require-login')) {
              window.location.href = '/account/login';
              return;
            }

            const articleHandle = root.getAttribute('data-article-handle');
            const blogHandle = root.getAttribute('data-blog-handle');
            if (!articleHandle) return;

            const isActive = btn.getAttribute('aria-pressed') === 'true';
            let bookmarks = getBookmarks();

            if (isActive) {
              // Remove bookmark
              bookmarks = bookmarks.filter(h => h !== articleHandle);
              showNotification('Article removed from saved');
            } else {
              // Add bookmark (store handle and blog info)
              if (!bookmarks.includes(articleHandle)) {
                bookmarks.push(articleHandle);
              }
              showNotification('Article saved');
            }

            saveBookmarks(bookmarks);

            // Update UI
            btn.setAttribute('aria-pressed', String(!isActive));
            btn.classList.toggle('social-share__button--active', !isActive);

            // Dispatch custom event for other components
            window.dispatchEvent(new CustomEvent('bookmarks:updated', {
              detail: { bookmarks, articleHandle, action: isActive ? 'removed' : 'added' }
            }));

            return;
          }

          const map = {
            x: `https://twitter.com/intent/tweet?text=${t}&url=${u}`,
            linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`,
            reddit: `https://www.reddit.com/submit?url=${u}&title=${t}`,
            telegram: `https://t.me/share/url?url=${u}&text=${t}`,
            whatsapp: `https://api.whatsapp.com/send?text=${t}%20${u}`,
            mail: `mailto:?subject=${t}&body=${t}%0A%0A${u}`,
            facebook: `https://www.facebook.com/sharer/sharer.php?u=${u}`,
            pinterest: `https://www.pinterest.com/pin/create/button/?url=${u}&description=${t}`,
          };

          if (type === 'clipboard' || type === 'instagram') {
            navigator.clipboard.writeText(link).then(() => {
              btn.setAttribute('data-social-share-success', '');
              setTimeout(() => btn.removeAttribute('data-social-share-success'), 2000);
            });
            return;
          }

          const url = map[type];
          if (url) window.open(url, '_blank', 'noopener,noreferrer');
        });
      });

      initBookmarkState();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSocialShare);
    } else {
      initSocialShare();
    }

    // Re-initialize when Shopify sections are loaded/updated
    document.addEventListener('shopify:section:load', initSocialShare);

    // Sync bookmark state across tabs
    window.addEventListener('storage', (e) => {
      if (e.key === BOOKMARK_STORAGE_KEY) {
        initBookmarkState();
      }
    });
  })();
{% endjavascript %}

