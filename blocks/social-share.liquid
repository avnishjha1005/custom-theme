{%- liquid
  assign share_url = request.origin | append: request.path
  assign share_title = page_title | default: shop.name

  if article
    assign share_title = article.title
  elsif product
    assign share_title = product.title
  elsif collection
    assign share_title = collection.title
  endif

  # Bookmark: Check if current article is bookmarked (for initial state)
  assign is_bookmarked = false
  if customer and article
    assign saved_articles = customer.metafields.custom.saved_articles.value
    if saved_articles
      for saved_handle in saved_articles
        if saved_handle == article.handle
          assign is_bookmarked = true
          break
        endif
      endfor
    endif
  endif
-%}

<div
  class="social-share"
  data-social-share
  data-social-share-link="{{ share_url }}"
  data-social-share-title="{{ share_title | escape }}"
  {% if article %}
    data-article-id="{{ article.id }}"
    data-article-handle="{{ article.handle }}"
    data-blog-handle="{{ blog.handle }}"
  {% endif %}
  {{ block.shopify_attributes }}
