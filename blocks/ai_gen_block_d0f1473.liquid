{% doc %}
  @prompt
    create a section where the image takes up full width and full screen height and i can add more blocks in the center overlayed over the image 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-fullscreen-hero-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    display: block;
  }

  .ai-fullscreen-hero__image-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-fullscreen-hero__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ block.settings.image_position }};
  }

  .ai-fullscreen-hero__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-fullscreen-hero__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 600px;
    max-height: 600px;
  }

  .ai-fullscreen-hero__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    padding: 16px 24px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-fullscreen-hero__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .ai-fullscreen-hero__content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: {{ block.settings.vertical_alignment }};
    justify-content: {{ block.settings.horizontal_alignment }};
    z-index: 2;
    padding: 40px 20px;
  }

  .ai-fullscreen-hero__content-inner-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.content_max_width }}px;
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.text_alignment }};
    gap: 24px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-fullscreen-hero__heading-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
  }

  .ai-fullscreen-hero__text-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
  }

  .ai-fullscreen-hero__buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: {{ block.settings.text_alignment }};
  }

  .ai-fullscreen-hero__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 32px;
    text-decoration: underline;
    font-weight: 500;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    text-transform: uppercase;
    font-size: 14px;
    letter-spacing: 0.5px;
  }

  .ai-fullscreen-hero__button-primary-{{ ai_gen_id }} {
    color: {{ block.settings.button_primary_text }};
  }

  .ai-fullscreen-hero__button-primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_primary_hover_bg }};
    transform: translateY(-2px);
  }

  .ai-fullscreen-hero__button-secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_secondary_bg }};
    color: {{ block.settings.button_secondary_text }};
    
  }

  .ai-fullscreen-hero__button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_secondary_hover_bg }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 749px) {
    .ai-fullscreen-hero-{{ ai_gen_id }} {
      height: calc( 100vh - 112px );
    }

    .ai-fullscreen-hero__content-{{ ai_gen_id }} {
      padding: 20px;
    }

    .ai-fullscreen-hero__content-inner-{{ ai_gen_id }} {
      max-width: 100%;
      gap: 16px;
    }

    .ai-fullscreen-hero__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.6 }}px;
    }

    .ai-fullscreen-hero__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-fullscreen-hero__button-{{ ai_gen_id }} {
      padding: 12px 24px;
      font-size: 12px;
    }

    .ai-fullscreen-hero__buttons-{{ ai_gen_id }} {
      width: 100%;
      flex-direction: column;
    }

    .ai-fullscreen-hero__button-{{ ai_gen_id }} {
      width: 100%;
      text-align: center;
    }
  }
{% endstyle %}

<fullscreen-hero-{{ ai_gen_id }}
  class="ai-fullscreen-hero-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-fullscreen-hero__image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.image %}
      <img
        src="{{ block.settings.image | image_url: width: 2400 }}"
        srcset="{{ block.settings.image | image_url: width: 750 }} 750w,
                {{ block.settings.image | image_url: width: 1100 }} 1100w,
                {{ block.settings.image | image_url: width: 1500 }} 1500w,
                {{ block.settings.image | image_url: width: 2000 }} 2000w,
                {{ block.settings.image | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        alt="{{ block.settings.image.alt | escape }}"
        loading="eager"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
        class="ai-fullscreen-hero__image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-fullscreen-hero__placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-fullscreen-hero__empty-state-{{ ai_gen_id }}">
          Add a background image to get started
        </div>
      </div>
    {% endif %}
  </div>

  {% if block.settings.show_overlay %}
    <div class="ai-fullscreen-hero__overlay-{{ ai_gen_id }}"></div>
  {% endif %}

  <div class="ai-fullscreen-hero__content-{{ ai_gen_id }}">
    <div class="ai-fullscreen-hero__content-inner-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h1 class="ai-fullscreen-hero__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h1>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="ai-fullscreen-hero__text-{{ ai_gen_id }}">
          {{ block.settings.text }}
        </div>
      {% endif %}

      {% if block.settings.button_primary_label != blank or block.settings.button_secondary_label != blank %}
        <div class="ai-fullscreen-hero__buttons-{{ ai_gen_id }}">
          {% if block.settings.button_primary_label != blank %}
            <a
              href="{{ block.settings.button_primary_link }}"
              class="ai-fullscreen-hero__button-{{ ai_gen_id }} ai-fullscreen-hero__button-primary-{{ ai_gen_id }}"
            >
              {{ block.settings.button_primary_label }}
            </a>
          {% endif %}

          {% if block.settings.button_secondary_label != blank %}
            <a
              href="{{ block.settings.button_secondary_link }}"
              class="ai-fullscreen-hero__button-{{ ai_gen_id }} ai-fullscreen-hero__button-secondary-{{ ai_gen_id }}"
            >
              {{ block.settings.button_secondary_label }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</fullscreen-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class FullscreenHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.updateViewportHeight();
        window.addEventListener('resize', this.updateViewportHeight.bind(this));
      }

      disconnectedCallback() {
        window.removeEventListener('resize', this.updateViewportHeight.bind(this));
      }

      updateViewportHeight() {
        const vh = window.innerHeight * 0.01;
        this.style.setProperty('--vh', `${vh}px`);
      }
    }

    customElements.define('fullscreen-hero-{{ ai_gen_id }}', FullscreenHero{{ ai_gen_id }});
  })();
</script>

